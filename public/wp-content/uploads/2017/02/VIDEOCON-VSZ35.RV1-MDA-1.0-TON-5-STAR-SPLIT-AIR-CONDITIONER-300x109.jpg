/*# sourceURL=woocommerce-inline-inline-css */</style><link rel='stylesheet' id='atlas-icons-css' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css?ver=6.4.0' media='all' /> <script id="google_gtagjs-js" type="litespeed/javascript" data-src="https://www.googletagmanager.com/gtag/js?id=GT-NNQ4GWH7"></script> <script id="google_gtagjs-js-after" type="litespeed/javascript">window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}
gtag("set","linker",{"domains":["www.atlasaircons.com"]});gtag("js",new Date());gtag("set","developer_id.dZTNiMT",!0);gtag("config","GT-NNQ4GWH7");window._googlesitekit=window._googlesitekit||{};window._googlesitekit.throttledEvents=[];window._googlesitekit.gtagEvent=(name,data)=>{var key=JSON.stringify({name,data});if(!!window._googlesitekit.throttledEvents[key]){return}window._googlesitekit.throttledEvents[key]=!0;setTimeout(()=>{delete window._googlesitekit.throttledEvents[key]},5);gtag("event",name,{...data,event_source:"site-kit"})}</script> <script id="jquery-core-js" type="litespeed/javascript" data-src="https://www.atlasaircons.com/wp-includes/js/jquery/jquery.min.js"></script> <link rel="EditURI" type="application/rsd+xml" title="RSD" href="https://www.atlasaircons.com/xmlrpc.php?rsd" /><meta name="generator" content="Site Kit by Google 1.187.0" /><style id="atlas-engineering-styles">/* Global Calculator Variables & Resets */
        .atlas-calc-wrap, .atlas-roi-wrapper, .atlas-diag-box { 
            background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 30px; 
            max-width: 600px; margin: 30px auto; box-shadow: 0 10px 25px rgba(0,0,0,0.05); font-family: 'Inter', sans-serif; 
        }
        .atlas-roi-wrapper, .atlas-diag-box { background: #0f172a; border: 1px solid #1e293b; color: #fff; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3); max-width: 800px; position: relative; overflow: hidden; }
        .atlas-calc-wrap h3 { color: #0f172a; font-weight: 900; text-transform: uppercase; border-bottom: 2px solid #0ea5e9; padding-bottom: 10px; margin: 0 0 20px 0; font-size: 20px; }
        .atlas-roi-header h3, .atlas-diag-header h3 { color: #38bdf8; font-size: 24px; font-weight: 900; margin: 0 0 10px; text-transform: uppercase; text-align: center; }
        .atlas-roi-header p, .atlas-diag-header p { color: #cbd5e1; font-size: 14px; text-align: center; margin: 0 0 25px; }
        
        /* Shared Form Inputs */
        .atlas-calc-row { margin-bottom: 15px; }
        .atlas-calc-row label, .atlas-input-group label { display: block; font-size: 12px; font-weight: 700; color: #475569; margin-bottom: 8px; text-transform: uppercase; }
        .atlas-input-group label { color: #94a3b8; }
        .atlas-calc-row input, .atlas-calc-row select, .atlas-input-group input { width: 100%; padding: 12px; border: 2px solid #cbd5e1; border-radius: 8px; font-size: 16px; box-sizing: border-box; transition: 0.3s; background: #fff; }
        .atlas-input-group input { background: #1e293b; border-color: #475569; color: #fff; }
        .atlas-calc-row input:focus, .atlas-calc-row select:focus, .atlas-input-group input:focus { border-color: #0ea5e9; outline: none; box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.2); }
        
        /* Shared Buttons */
        .atlas-calc-btn, .atlas-roi-btn, .atlas-diag-cta { 
            background: #0f172a; color: #fff; width: 100%; border: none; padding: 16px; font-size: 16px; 
            font-weight: 900; border-radius: 8px; cursor: pointer; text-transform: uppercase; transition: 0.3s; margin-top: 10px; text-align: center; display: inline-block; text-decoration: none; box-sizing: border-box;
        }
        .atlas-calc-btn:hover { background: #0ea5e9; transform: translateY(-2px); }
        .atlas-roi-btn, .atlas-diag-cta { background: #22c55e; box-shadow: 0 10px 15px -3px rgba(34,197,94,0.3); border-radius: 12px; }
        .atlas-roi-btn:hover, .atlas-diag-cta:hover { background: #16a34a; transform: translateY(-2px); color: #fff; }
        
        /* Shared Results Box */
        .atlas-calc-result { background: #f0f9ff; border: 2px dashed #0ea5e9; border-radius: 8px; padding: 20px; margin-top: 20px; text-align: center; display: none; }
        .atlas-calc-result span { display: block; font-size: 32px; font-weight: 900; color: #0369a1; }
        .atlas-calc-result p { margin: 5px 0 0; color: #0f172a; font-size: 14px; font-weight: 600; }
        
        /* ROI Specific */
        .atlas-roi-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .atlas-roi-results { margin-top: 30px; background: #fef2f2; border-left: 6px solid #ef4444; padding: 25px; border-radius: 0 12px 12px 0; color: #0f172a; text-align: center; }
        .atlas-roi-results .waste-amount { font-size: 36px; font-weight: 900; color: #dc2626; margin: 10px 0; line-height: 1; }
        
        /* Diag Specific */
        .atlas-diag-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
        .atlas-diag-btn { background: #1e293b; border: 1px solid #334155; color: #cbd5e1; padding: 15px; border-radius: 8px; font-weight: 600; font-size: 14px; cursor: pointer; transition: 0.3s; text-align: left; display: flex; align-items: center; gap: 10px; }
        .atlas-diag-btn:hover { background: rgba(14, 165, 233, 0.1); border-color: #0ea5e9; color: #38bdf8; }
        
        /* AMC Specific */
        .atlas-amc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin: 40px 0; font-family: 'Inter', sans-serif; }
        .atlas-amc-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 30px; text-align: center; transition: 0.3s; position: relative; overflow: hidden; }
        .atlas-amc-card:hover { transform: translateY(-10px); box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1); border-color: #0ea5e9; }
        .atlas-amc-card.popular { border: 2px solid #0ea5e9; background: #f8fafc; box-shadow: 0 10px 15px -3px rgba(14, 165, 233, 0.2); }
        .atlas-amc-badge { position: absolute; top: 15px; right: -30px; background: #0ea5e9; color: #fff; font-size: 10px; font-weight: 900; text-transform: uppercase; padding: 5px 30px; transform: rotate(45deg); letter-spacing: 1px; }
        .atlas-amc-features { list-style: none; padding: 0; margin: 0 0 30px 0; text-align: left; }
        .atlas-amc-features li { font-size: 14px; color: #475569; margin-bottom: 12px; display: flex; align-items: center; gap: 10px; font-weight: 600; }
        
        @media(max-width: 600px) { .atlas-roi-grid, .atlas-diag-grid { grid-template-columns: 1fr; } }</style><meta name="google-site-verification" content="QN7fWINoLyDvibJWJHBI_kb-rXoZJDxLd4Nkou1tGlY" />
<noscript><style>.woocommerce-product-gallery{ opacity: 1 !important; }</style></noscript> <script type="litespeed/javascript">document.addEventListener("DOMContentLiteSpeedLoaded",function(){let marks={25:!1,50:!1,75:!1,100:!1};window.addEventListener('scroll',function(){let docHeight=document.documentElement.scrollHeight-document.documentElement.clientHeight;if(docHeight<=0)return;let scrollPercent=(window.scrollY/docHeight)*100;[25,50,75,100].forEach(mark=>{if(scrollPercent>=mark&&!marks[mark]){marks[mark]=!0;if(typeof gtag!=='undefined'){gtag('event','scroll_depth',{'event_category':'Atlas Engagement','event_label':mark+'% Depth Reached'})}}})},{passive:!0})})</script><style class="wpcode-css-snippet">/* ATLAS UI SILENCER: Hides accidental hardcoded duplicates across all 500 pages */

/* Hide the duplicate sticky bars */
.mobile-sticky-bar { display: none !important; }
#atlas-mobile-bar { display: none !important; }
.atlas-mobile-bar { display: none !important; }

/* Hide the annoying floating nudge bubble that blocks reading */
#atlas-ai-nudge { display: none !important; }

/* Hide the duplicate Action Sheet if it is hardcoded */
#atlasActionSheet { display: none !important; }

/* ONLY KEEP THE CLEAN WHATSAPP BUTTON & SIDE BUTTON VISIBLE */
/* Create a single, clean mobile bar at the bottom natively */
@media (max-width: 768px) {
    body { padding-bottom: 60px !important; }
    .atlas-safe-contact {
        display: flex !important;
        position: fixed !important;
        bottom: 0 !important;
        right: 0 !important;
        left: 0 !important;
        width: 100% !important;
        border-radius: 0 !important;
        justify-content: center !important;
        font-size: 16px !important;
        padding: 18px !important;
        z-index: 999999 !important;
    }
}</style><script type="speculationrules">{
  "prerender": [
    {
      "source": "document",
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "not": {"href_matches": "/wp-admin/*"} },
          { "not": {"href_matches": "/*?add-to-cart=*"} },
          { "not": {"href_matches": "/checkout/*"} },
          { "not": {"href_matches": "/cart/*"} }
        ]
      },
      "eagerness": "moderate"
    }
  ],
  "prefetch": [
    {
      "source": "document",
      "where": {
        "and": [
          { "href_matches": "/*" }
        ]
      },
      "eagerness": "conservative"
    }
  ]
}</script><script id="atlas-geo-sniper" type="litespeed/javascript">document.addEventListener("DOMContentLiteSpeedLoaded",function(){fetch('https://ipapi.co/json/').then(response=>response.json()).then(data=>{if(data.city&&data.region==="Gujarat"){const cityTargets=document.querySelectorAll('.atlas-auto-city');cityTargets.forEach(el=>{el.innerHTML=`<span style="color:#22c55e; font-weight:900; background:rgba(34,197,94,0.1); padding:2px 8px; border-radius:4px;"><i class="fas fa-crosshairs"></i> Radar Lock: ${data.city}</span>`})}}).catch(err=>console.log('Radar stealth mode active.'))})</script><link rel="preconnect" href="https://cdnjs.cloudflare.com"><style>/* 1. LOCAL FONT ENGINE */
    @font-face{  font-family: 'Inter'; font-style: normal; font-weight: 400; font-display: swap; src: url('/fonts/inter-v20-latin-regular.woff2') format('woff2');  }
    @font-face{  font-family: 'Inter'; font-style: normal; font-weight: 900; font-display: swap; src: url('/fonts/inter-v20-latin-900.woff2') format('woff2');  }

    /* 2. PERFORMANCE CORE - Purged old Hero Backgrounds to allow Tailwind to control the design */
    body { 
        font-family: 'Inter', sans-serif; 
        background-color: #0F172A !important; 
        color: #F8FAFC; 
        margin: 0; 
        overflow-x: hidden; /* Prevents horizontal scroll breaking on mobile */
    }
    
    /* 3. THE TITANIUM GOLD THEME (Preserved for legacy inner pages) */
    .text-gold { color: #D4AF37; }
    .bg-gold { background: linear-gradient(45deg, #BF953F, #AA771C); color: #FFF; }
    .gold-border { border: 1px solid rgba(212, 175, 55, 0.3); }</style><style>/* =========================================
   ATLAS COMMERCE GRID v2.0 (GOD MODE)
   ========================================= */

/* 1. NUCLEAR CONTAINER RESET */
/* We force the container to expand, destroying sidebar overlap issues. */
.woocommerce-page .site-content, 
.woocommerce-page .content-area,
.woocommerce-page div#primary {
    width: 100% !important;
    max-width: 100% !important;
    float: none !important;
    margin: 0 auto !important;
}

/* 2. THE GRID ENGINE (Responsive & Rigid) */
.woocommerce ul.products {
    display: grid !important;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)) !important; 
    gap: 30px !important;
    margin: 40px 0 !important;
    padding: 0 !important;
}

/* 3. PRODUCT CARD (The "Money" Box) */
.woocommerce ul.products li.product {
    display: flex !important;
    flex-direction: column !important;
    background: #ffffff !important;
    border: 1px solid #e2e8f0 !important;
    border-radius: 16px !important; /* Modern rounded look */
    padding: 20px !important;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05) !important;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    overflow: hidden !important;
    position: relative !important;
}

/* HOVER EFFECT: The "Lift & Glow" */
.woocommerce ul.products li.product:hover {
    transform: translateY(-8px) !important;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04) !important;
    border-color: #3b82f6 !important; /* Atlas Blue Glow */
}

/* 4. IMAGE STABILIZER (Google Core Web Vitals Fix) */
.woocommerce ul.products li.product a img {
    width: 100% !important;
    height: auto !important;
    aspect-ratio: 1 / 1 !important; /* FORCES SQUARE. NO JUMPING. */
    object-fit: contain !important;
    margin-bottom: 20px !important;
    filter: brightness(1.02); /* Subtle pop */
}

/* 5. TYPOGRAPHY (Readable & Bold) */
.woocommerce ul.products li.product .woocommerce-loop-product__title {
    font-size: 1.1rem !important;
    font-weight: 700 !important;
    color: #1e293b !important;
    line-height: 1.4 !important;
    margin-bottom: auto !important; /* Pushes price/button down */
    min-height: 3em; /* Aligns all cards perfectly */
}

/* 6. PRICE TAG (The Trigger) */
.woocommerce ul.products li.product .price {
    font-size: 1.25rem !important;
    font-weight: 800 !important;
    color: #0ea5e9 !important; /* Atlas Blue */
    margin: 15px 0 !important;
    display: block !important;
}

.woocommerce ul.products li.product .price del {
    color: #94a3b8 !important; /* Muted original price */
    font-size: 0.9rem !important;
    opacity: 0.7;
}

/* 7. THE "BUY" BUTTON (Nuclear Option) */
.woocommerce ul.products li.product .button {
    background: #0f172a !important; /* Midnight Black */
    color: #fff !important;
    width: 100% !important;
    padding: 14px !important;
    border-radius: 8px !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 1px !important;
    font-size: 0.85rem !important;
    transition: 0.2s !important;
    margin-top: 10px !important;
    text-align: center !important;
    display: block !important;
}

.woocommerce ul.products li.product .button:hover {
    background: #0ea5e9 !important; /* Lightning Blue */
    box-shadow: 0 4px 12px rgba(14, 165, 233, 0.4) !important;
    transform: scale(1.02);
}

/* 8. SALE BADGE (If it exists) */
.woocommerce span.onsale {
    background: #ef4444 !important; /* Red Alert */
    color: white !important;
    font-weight: 800 !important;
    padding: 5px 12px !important;
    border-radius: 20px !important;
    position: absolute !important;
    top: 15px !important;
    left: 15px !important;
    z-index: 10 !important;
    box-shadow: 0 2px 5px rgba(239, 68, 68, 0.3) !important;
    min-height: auto !important;
    line-height: 1 !important;
}

/* 9. MOBILE DOMINATION (iPhone/Android Optimization) */
@media (max-width: 768px) {
    .woocommerce ul.products {
        grid-template-columns: repeat(2, 1fr) !important; /* 2 Columns */
        gap: 12px !important; /* Tighter gap */
        margin: 20px 0 !important;
    }

    .woocommerce ul.products li.product {
        padding: 12px !important; /* Less padding on phone */
        border-radius: 12px !important;
    }

    .woocommerce ul.products li.product .woocommerce-loop-product__title {
        font-size: 0.9rem !important; /* Smaller text */
        min-height: 2.8em !important; 
    }

    .woocommerce ul.products li.product .price {
        font-size: 1rem !important;
        margin: 8px 0 !important;
    }

    .woocommerce ul.products li.product .button {
        padding: 10px !important;
        font-size: 0.75rem !important;
    }
}</style><script id="google_gtagjs" type="litespeed/javascript" data-src="https://www.googletagmanager.com/gtag/js?id=G-MER4RZ5SCW"></script> <script id="google_gtagjs-inline" type="litespeed/javascript">window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-MER4RZ5SCW',{})</script> <link rel="icon" href="https://www.atlasaircons.com/wp-content/uploads/2023/03/cropped-favicon-32x32.gif" sizes="32x32" /><link rel="icon" href="https://www.atlasaircons.com/wp-content/uploads/2023/03/cropped-favicon-192x192.gif" sizes="192x192" /><link rel="apple-touch-icon" href="https://www.atlasaircons.com/wp-content/uploads/2023/03/cropped-favicon-180x180.gif" /><meta name="msapplication-TileImage" content="https://www.atlasaircons.com/wp-content/uploads/2023/03/cropped-favicon-270x270.gif" /> <script type="litespeed/javascript" data-src="https://www.googletagmanager.com/gtag/js?id=AW-11137442967"></script> <script type="litespeed/javascript">window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}
