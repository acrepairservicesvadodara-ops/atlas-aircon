<button class="atlas-diag-btn" onclick="runDiag('Strange Noise','Mechanical friction. Overhaul needed.')"><i class="fas fa-volume-up"></i> Noises</button>
<button class="atlas-diag-btn" onclick="runDiag('Power Tripping','PCB short-circuit. Fire hazard. Keep powered off.')"><i class="fas fa-bolt"></i> Tripping</button></div><div id="diag-result" style="display:none; text-align:center; padding:20px;"><h4 style="color:#ef4444; margin-bottom:10px;"><i class="fas fa-exclamation-triangle"></i> Critical Fault</h4><p id="diag-msg" style="margin-bottom:20px; font-weight:bold;"></p>
<a href="#" id="diag-wa" target="_blank" class="atlas-diag-cta"><i class="fab fa-whatsapp"></i> Request Dispatch to your area</a></div></div> <script type="litespeed/javascript">function runDiag(issue,msg){document.getElementById("diag-options").style.display="none";let r=document.getElementById("diag-result");r.style.display="block";document.getElementById("diag-msg").innerText=msg;document.getElementById("diag-wa").href=`https://wa.me/919727257141?text=Diagnostic: ${issue} in your area. Need engineer.`}</script> </div><div class="bg-slate-800/50 p-6 md:p-8 rounded-2xl border border-slate-700 shadow-2xl backdrop-blur-sm"><h3 class="text-2xl font-black text-white mb-6 uppercase border-b border-slate-700 pb-4 flex items-center gap-3"><i class="fas fa-bolt text-amber-400"></i> Industrial Power Calculator</h3><div class="atlas-roi-wrapper"><div class="atlas-roi-header"><h3>⚡ Industrial Power Waste Calculator</h3><p>Calculate money lost due to degraded chiller efficiency.</p></div><div class="atlas-roi-grid"><div class="atlas-input-group"><label>Capacity (TR)</label><input type="number" id="roi-tr" value="100" oninput="calcROI()"></div><div class="atlas-input-group"><label>Age (Years)</label><input type="number" id="roi-age" value="5" oninput="calcROI()"></div><div class="atlas-input-group"><label>Daily Hours</label><input type="number" id="roi-hours" value="16" oninput="calcROI()"></div><div class="atlas-input-group"><label>Rate (₹/kWh)</label><input type="number" id="roi-rate" value="8" oninput="calcROI()"></div></div><div class="atlas-roi-results"><h4>Annual Financial Leak</h4><div class="waste-amount">₹<span id="roi-waste">0</span></div></div>
<button class="atlas-roi-btn" onclick="sendROIChat()"><i class="fab fa-whatsapp"></i> Stop The Bleeding - Chat with Director</button></div> <script type="litespeed/javascript">function calcROI(){let tr=parseFloat(document.getElementById("roi-tr").value)||0,a=parseFloat(document.getElementById("roi-age").value)||0,h=parseFloat(document.getElementById("roi-hours").value)||0,r=parseFloat(document.getElementById("roi-rate").value)||0,eff=(0.65+(a*0.025))-0.70,waste=eff>0?eff*tr*h*300*r:0;document.getElementById("roi-waste").innerText=Math.round(waste).toLocaleString("en-IN")}
function sendROIChat(){let w=document.getElementById("roi-waste").innerText;window.open(`https://wa.me/919727257141?text=*URGENT ROI INQUIRY*%0AEstimated Loss: ₹${w} / Year. We need an overhaul.`,"_blank")}
document.addEventListener("DOMContentLiteSpeedLoaded",calcROI)</script> </div></div></div></section></div></div></div></article></main><style>.atlas-footer { background-color: #0f172a; color: #94a3b8; font-family: system-ui, -apple-system, sans-serif; padding-top: 60px; padding-bottom: 40px; border-top: 4px solid #0ea5e9; position: relative; }
