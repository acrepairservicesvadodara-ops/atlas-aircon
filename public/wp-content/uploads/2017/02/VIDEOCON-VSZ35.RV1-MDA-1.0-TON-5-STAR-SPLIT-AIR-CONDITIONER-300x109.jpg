            // SCROLL ENGINE
            window.addEventListener("scroll", function() {
                let doc = document.documentElement;
                let scrollBar = document.getElementById("atlas-scroll-bar");
                if(scrollBar) {
                    let scrolled = ((document.body.scrollTop || doc.scrollTop) / (doc.scrollHeight - doc.clientHeight)) * 100;
                    scrollBar.style.width = scrolled + "%";
                }
            }, { passive: true });

            // CHRONO-SHIFT ENGINE
            const currentHour = new Date().getHours();
            const isNightShift = (currentHour >= 18 || currentHour < 8);
            const chronoBar = document.createElement("div");
            chronoBar.style.cssText = "position:fixed; top:0; left:0; width:100%; z-index:1000000; box-shadow:0 4px 10px rgba(0,0,0,0.3);";

            if (isNightShift) {
                chronoBar.innerHTML = '<div style="background:#7f1d1d; color:#fecaca; text-align:center; padding:10px; font-family:sans-serif; font-size:13px; font-weight:900; text-transform:uppercase; letter-spacing:1px;">🌙 AFTER-HOURS EMERGENCY PROTOCOL ACTIVE.</div>';
                document.querySelectorAll('a[href*="wa.me/"]').forEach(btn => {
                    if (!btn.href.includes('DEFCON')) {
                        btn.href = btn.href.split('?')[0] + '?text=' + encodeURIComponent("I am experiencing an after-hours breakdown. I need the Night-Shift Engineer dispatched immediately.");
                    }
                });
            } else {
                chronoBar.innerHTML = '<div style="background:#064e3b; color:#a7f3d0; text-align:center; padding:8px; font-family:sans-serif; font-size:12px; font-weight:900; text-transform:uppercase; letter-spacing:1px; border-bottom:2px solid #059669;">☀️ DAY SHIFT ACTIVE: ALL ENGINEERING UNITS DEPLOYED.</div>';
            }
            document.body.appendChild(chronoBar);
            
            const siteHeader = document.querySelector('.site-header');
            if(siteHeader) {
                siteHeader.style.marginTop = isNightShift ? "38px" : "35px";
                siteHeader.style.transition = "margin-top 0.4s ease";
            }

            // LIVE RADAR ENGINE
            const liveOps = [{"title":"Inverter AC PCB Repair &amp; Gas Charge in Sayajigunj, Vadodara","time":"7 months ago"},{"title":"Industrial Dispatch: Control Panel AC Repair &amp; Servicing in Makarpura GIDC","time":"7 months ago"},{"title":"Emergency Dispatch: Industrial Chiller Repair &amp; Overhaul in Manjusar GIDC, Alindra Savli","time":"7 months ago"}];
            if(liveOps.length > 0) {
                let currentIndex = 0;
                function showRadar() {
                    const op = liveOps[currentIndex];
                    document.getElementById('radar-text').innerHTML = `<strong>Verified Record:</strong><br>${op.title}`;
                    document.getElementById('radar-time').innerText = op.time;
                    
                    const toast = document.getElementById('atlas-radar');
                    toast.classList.add('show');
                    setTimeout(() => { toast.classList.remove('show'); }, 7000); 
                    
                    currentIndex = (currentIndex + 1) % liveOps.length;
                }
                setTimeout(showRadar, 18000);
                setInterval(showRadar, 35000);
            }
        });</script> <noscript><img src="https://p.tgtag.io/event?property_id=tg-017399-001&event_name=pageview&no_script=1" width="1" height="1" border="0" alt=""/></noscript> <script data-no-optimize="1" data-no-defer="1" data-optimized="0">let atlasScriptsLoaded = false;
