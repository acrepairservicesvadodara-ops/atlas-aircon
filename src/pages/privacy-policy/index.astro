---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
---

<BaseLayout
  title="Privacy Policy | Atlas Aircon"
  description="Privacy policy and data protection guidelines of Atlas Aircon Vadodara."
>
  <section class="page-header">
    <div class="header-bg"></div>
    <div class="container relative z-10 text-center">
      <div class="section-badge"><Icon name="shield" size={14} strokeWidth={2} /> Legal</div>
      <h1 class="page-title">Privacy <span>Policy</span></h1>
      <p class="page-subtitle">How Atlas Aircon collects, uses, and safeguards your information.</p>
    </div>
  </section>

  <section class="section">
    <div class="container max-w-4xl mx-auto prose-content card p-8">
      <h2>1. Information We Collect</h2>
      <p>
        When you book a service, request an emergency dispatch, or contact us via our website, WhatsApp, or phone, we collect basic contact details including your name, phone number, address, and equipment service requirements.
      </p>

      <h2>2. How We Use Your Information</h2>
      <p>
        Your information is used solely to dispatch our HVAC technicians to your premises, provide technical diagnostics, generate accurate billing and AMC contracts, and follow up regarding warranty support. We never sell, rent, or trade your personal information to third-party marketing companies.
      </p>

      <h2>3. Communication via WhatsApp & Phone</h2>
      <p>
        By submitting your phone number or messaging us via WhatsApp, you consent to receive direct communications regarding technician arrival time, spare parts pricing, diagnostic reports, and service invoices.
      </p>

      <h2>4. Data Security</h2>
      <p>
        We employ industry-standard operational and digital safeguards to keep your contact information secure. Our website does not store sensitive payment card details directly.
      </p>

      <h2>5. Contact Us</h2>
      <p>
        If you have any questions regarding our privacy practices, you can contact us at:
      </p>
      <ul>
        <li><strong>Email:</strong> atlasaircon1@gmail.com</li>
        <li><strong>Phone:</strong> +91 97272 57141</li>
        <li><strong>Address:</strong> Payal Complex, 27, Opp. M.S. University, Sarod, Sayajiganj, Vadodara — 390005</li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    position: relative;
    padding: var(--space-20) 0 var(--space-12);
    overflow: hidden;
  }
  .header-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(6,182,212,0.1) 0%, transparent 70%), var(--color-navy);
  }
  .page-title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 800;
    color: #F8FAFC;
    margin: var(--space-3) 0;
  }
  .page-title span {
    background: linear-gradient(135deg, #06B6D4, #22D3EE);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .page-subtitle {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
  }
  .prose-content h2 {
    color: #F8FAFC;
    font-size: var(--text-xl);
    font-weight: 700;
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
    border-bottom: 1px solid rgba(255,255,255,0.08);
    padding-bottom: var(--space-2);
  }
  .prose-content p, .prose-content li {
    color: var(--color-text-secondary);
    line-height: 1.8;
  }
  .prose-content ul {
    margin-left: var(--space-6);
    margin-bottom: var(--space-4);
  }
</style>
