---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import WhatsAppForm from '@components/WhatsAppForm.astro';
import locations from '@data/locations.json';

// Generate paths for all cities in locations.json
export async function getStaticPaths() {
  return locations.map(loc => ({
    params: { city: loc.slug },
    props: { city: loc.name, type: loc.type },
  }));
}

const { city, type } = Astro.props;

// Specific services we highlight on city pages
const localServices = [
  { icon: 'wrench', title: `AC Repair in ${city}` },
  { icon: 'gear', title: 'AC Installation' },
  { icon: 'circuit', title: 'Inverter PCB Repair' },
  { icon: 'thermometer', title: 'Gas Charging' },
  { icon: 'factory', title: 'Industrial HVAC' },
  { icon: 'air-vent', title: 'Cassette/VRF Systems' },
];
---

<BaseLayout
  title={`Expert AC Repair & Service in ${city} | Atlas Aircon`}
  description={`Looking for military-grade AC repair in ${city}? Atlas Aircon provides 24/7 emergency service, PCB repair, and industrial HVAC solutions.`}
>
  <!-- City Hero Section -->
  <section class="city-hero">
    <div class="hero-bg">
      <div class="hero-orb hero-orb-1"></div>
    </div>
    
    <div class="container relative z-10">
      <div class="hero-grid">
        <div class="city-hero-content" style="position: relative; opacity: 1; visibility: visible; z-index: 50;">
          <div class="section-badge mb-4" style="color: #06B6D4; background: rgba(6,182,212,0.15); display: inline-block;">
            <Icon name="map-pin" size={14} strokeWidth={2} /> Serving {city} ({type})
          </div>
          <h1 class="page-title" style="color: #F8FAFC;">
            #1 AC Repair & Service<br />
            in <span style="background: linear-gradient(135deg, #06B6D4, #22D3EE); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">{city}</span>
          </h1>
          <p class="page-subtitle mt-4" style="color: #94A3B8;">
            From emergency residential split AC gas charging to heavy-tonnage Industrial Chiller overhauls — Atlas Aircon delivers precision climate control and component-level PCB repairs directly in <strong>{city}</strong>. We arrive within 90 minutes.
          </p>

          <div class="hero-ctas mt-8" style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <a
              href={`https://wa.me/919727257141?text=EMERGENCY:%20I%20need%20rapid%20AC%20Repair%20in%20${city}.`}
              class="hero-emergency-btn"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="emergency-pulse"></span>
              <Icon name="alert-circle" size={18} strokeWidth={2.5} /> Request Emergency Dispatch
            </a>
            <a href="tel:+919727257141" class="btn btn-outline" style="border: 1px solid #06B6D4; color: #06B6D4; padding: 0.75rem 1.5rem; border-radius: 999px; text-decoration: none; display: flex; align-items: center; gap: 0.5rem; font-weight: 600;">
              <Icon name="phone" size={16} /> Call Engineer
            </a>
          </div>
        </div>
        
        <div class="hero-form-wrapper">
           <WhatsAppForm defaultLocation={city} />
        </div>
      </div>
    </div>
  </section>

  <!-- Local Services Grid -->
  <section class="section bg-surface">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="section-title">Our Capabilities in <span>{city}</span></h2>
        <div class="gold-line mx-auto mt-4"></div>
      </div>

      <div class="local-services-grid">
        {localServices.map(svc => (
          <div class="card local-svc-card text-center p-6 flex flex-col items-center">
            <div class="svc-icon-wrap mb-4">
              <Icon name={svc.icon} size={32} strokeWidth={1.5} />
            </div>
            <h3 class="text-lg font-bold text-white">{svc.title}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Local Booking CTA -->
  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <div class="cta-banner-inner">
          <div>
            <h2>Book Service in {city} Today</h2>
            <p>Our fast-response engineers are active in your area.</p>
          </div>
          <div class="cta-buttons">
             <a
              href={`https://wa.me/919727257141?text=Hi,%20I%20would%20like%20to%20book%20AC%20Service%20in%20${city}.`}
              class="btn btn-whatsapp btn-lg"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="whatsapp" size={18} /> WhatsApp Booking
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .city-hero {
    position: relative;
    padding: var(--space-24) 0 var(--space-20);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(6,182,212,0.15) 0%, transparent 65%), var(--color-navy);
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.25;
    animation: floatOrb 8s ease-in-out infinite;
  }

  .hero-orb-1 {
    width: 300px; height: 300px;
    background: radial-gradient(circle, #06B6D4, transparent 70%);
    top: 10%; left: 50%;
    transform: translateX(-50%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .page-title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    color: #F8FAFC;
    margin: 0;
  }

  .page-title span {
    background: linear-gradient(135deg, #06B6D4, #22D3EE);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .hero-emergency-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    position: relative;
    background: linear-gradient(135deg, #F59E0B, #FBBF24);
    color: #0B1628;
    font-family: 'Poppins', sans-serif;
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-full);
    box-shadow: 0 4px 24px rgba(245,158,11,0.4);
    transition: all var(--transition-base);
  }
  
  .hero-emergency-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(245,158,11,0.6);
  }

  .emergency-pulse {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-full);
    box-shadow: 0 0 0 0 rgba(245,158,11,0.5);
    animation: pulse-gold 2s infinite;
  }

  /* Utilities */
  .mx-auto { margin-left: auto; margin-right: auto; }
  .max-w-2xl { max-width: 42rem; }
  .mt-4 { margin-top: var(--space-4); }
  .mt-8 { margin-top: var(--space-8); }
  .mb-4 { margin-bottom: var(--space-4); }
  .mb-12 { margin-bottom: var(--space-12); }
  .justify-center { justify-content: center; }
  .text-center { text-align: center; }
  .bg-surface { background: var(--color-surface-1); }

  /* Local Services Grid */
  .local-services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .svc-icon-wrap {
    width: 64px;
    height: 64px;
    background: rgba(6,182,212,0.1);
    color: #06B6D4;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
  }

  /* CTA Banner */
  .cta-banner {
    background: linear-gradient(135deg, rgba(6,182,212,0.1), rgba(11,22,40,0.8));
    border: 1px solid rgba(6,182,212,0.3);
    border-radius: var(--radius-2xl);
    padding: var(--space-10);
  }

  .cta-banner-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-8);
  }

  .cta-banner h2 {
    font-family: 'Poppins', sans-serif;
    font-size: var(--text-2xl);
    font-weight: 700;
    color: #F8FAFC;
    margin: 0 0 var(--space-2);
  }

  .cta-banner p {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin: 0;
  }

  @media (max-width: 900px) {
    .local-services-grid { grid-template-columns: repeat(2, 1fr); }
    .cta-banner-inner { flex-direction: column; text-align: center; }
    .hero-grid { grid-template-columns: 1fr; gap: var(--space-8); }
    .city-hero-content { text-align: center; }
    .section-badge { margin: 0 auto 1rem; }
    .hero-ctas { justify-content: center; }
  }

  @media (max-width: 640px) {
    .local-services-grid { grid-template-columns: 1fr; }
    .btn-outline.ml-4 { margin-left: 0; margin-top: 1rem; }
  }
</style>
