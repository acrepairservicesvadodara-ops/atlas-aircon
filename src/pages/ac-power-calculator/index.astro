---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';

const faqs = [
  {
    q: 'How much electricity does a 1.5 Ton 5-Star Inverter AC consume per hour?',
    a: 'After initial room pull-down, a well-serviced 1.5 Ton 5-Star Inverter AC set to 24°C–25°C modulates down to 0.75–1.05 kWh (units) per hour, compared to 1.45–1.65 units/hour on an older non-inverter or dirty-coil AC.',
  },
  {
    q: 'Why did my monthly AC electricity bill jump suddenly without extra usage?',
    a: 'Dust-choked outdoor condenser fins, matted indoor blower wheels, or a 15% refrigerant undercharge raises head pressure and prevents compressor modulation—increasing kWh consumption by 22% to 35% until serviced.',
  },
];

const schemaData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Atlas Aircon AC Power & Monthly Electricity Bill Calculator',
      url: 'https://www.atlasaircons.com/ac-power-calculator/',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'All',
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.atlasaircons.com/' },
        { '@type': 'ListItem', position: 2, name: 'AC Power Cost Calculator', item: 'https://www.atlasaircons.com/ac-power-calculator/' },
      ],
    },
  ],
};
---

<BaseLayout
  title="AC Power Consumption & Monthly Electricity Bill Calculator (₹/Unit) | Atlas Aircon"
  description="Estimate daily and monthly AC electricity consumption in units (kWh) and Rupees for 1 Ton, 1.5 Ton & 2 Ton 3-Star/5-Star Inverter and Non-Inverter ACs in Gujarat."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </Fragment>

  <section class="page-header">
    <div class="header-bg"></div>
    <div class="container relative z-10 text-center">
      <div class="section-badge"><Icon name="zap" size={14} strokeWidth={2} /> Energy & Tariff Estimator</div>
      <h1 class="page-title">AC Electricity & Power <span>Cost Calculator</span></h1>
      <p class="page-subtitle">Compare real kWh units and monthly MGVCL / DGVCL / Torrent electricity bills by tonnage, BEE star rating, and thermostat setting.</p>
    </div>
  </section>

  <section class="section">
    <div class="container calc-layout">
      <div class="card calc-card">
        <h2>Configure Your Air Conditioner Usage</h2>
        <div class="form-grid">
          <label>
            <span>AC Capacity</span>
            <select id="pc-ton">
              <option value="1.0">1.0 Ton</option>
              <option value="1.5" selected>1.5 Ton</option>
              <option value="2.0">2.0 Ton</option>
              <option value="3.0">3.0 Ton Cassette / Commercial</option>
            </select>
          </label>
          <label>
            <span>Technology & BEE Rating</span>
            <select id="pc-star">
              <option value="0.62" selected>5-Star Inverter (ISEER ~5.0)</option>
              <option value="0.76">3-Star Inverter (ISEER ~3.9)</option>
              <option value="0.95">Old Non-Inverter Fixed Speed</option>
            </select>
          </label>
          <label>
            <span>Daily Usage (Hours / Day)</span>
            <input type="number" id="pc-hrs" value="8" min="1" max="24" />
          </label>
          <label>
            <span>Days Used per Month</span>
            <input type="number" id="pc-days" value="30" min="1" max="31" />
          </label>
          <label>
            <span>Thermostat Setpoint (°C)</span>
            <select id="pc-temp">
              <option value="1.24">18°C – 20°C (Heavy Load)</option>
              <option value="1.08">22°C</option>
              <option value="1.0" selected>24°C – 25°C (BEE Optimum)</option>
              <option value="0.88">26°C – 27°C + Ceiling Fan</option>
            </select>
          </label>
          <label>
            <span>Electricity Tariff (₹ / kWh Unit)</span>
            <input type="number" id="pc-rate" value="7.5" step="0.25" min="3" max="20" />
          </label>
        </div>

        <div class="result-panel">
          <div class="res-label">Estimated Monthly AC Power Cost</div>
          <div class="res-main" id="pc-cost">₹1,674 / month</div>
          <div class="res-sub" id="pc-kwh">~223 kWh units/month (7.4 units/day)</div>
        </div>
      </div>

      <article class="card guide-card">
        <h2>3 Proven Engineering Ways to Cut AC Power Bills by 25%</h2>
        <p>
          Every 1°C increase in your thermostat setpoint between 20°C and 25°C saves approximately <strong>6% electricity</strong> by lowering compressor compression ratios and allowing DC inverter drives to ramp down to partial speed once room humidity is removed.
        </p>
        <ul>
          <li><strong>Pre-Summer Foam-Jet Coil Cleaning:</strong> Just 1.5 mm of compacted dust on outdoor condenser fins raises condensing pressure by 35–50 PSI, forcing your AC to burn 20%–30% extra power for the same cooling.</li>
          <li><strong>Correct Refrigerant Charge Weight:</strong> Both undercharged and overcharged systems lose latent heat efficiency and prevent thermostat cut-offs.</li>
          <li><strong>Right Room Sizing:</strong> Unsure if your AC matches your room area? Check our <a href="/ac-tonnage-calculator/">AC Tonnage Size Calculator</a> or book a <a href="/services/power-jet-cleaning/">₹599 Power-Jet Service</a>.</li>
        </ul>

        {faqs.map((f) => (
          <div class="faq">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </article>
    </div>
  </section>

  <script is:inline>
    (function () {
      const ids = ['pc-ton', 'pc-star', 'pc-hrs', 'pc-days', 'pc-temp', 'pc-rate'];
      const els = ids.map((id) => document.getElementById(id));
      const costEl = document.getElementById('pc-cost');
      const kwhEl = document.getElementById('pc-kwh');
      function calc() {
        const ton = parseFloat(els[0].value) || 1.5;
        const factor = parseFloat(els[1].value) || 0.62;
        const hrs = parseFloat(els[2].value) || 8;
        const days = parseFloat(els[3].value) || 30;
        const tempMult = parseFloat(els[4].value) || 1.0;
        const rate = parseFloat(els[5].value) || 7.5;
        const kwPerHr = ton * factor * tempMult;
        const dailyKwh = kwPerHr * hrs;
        const monthlyKwh = dailyKwh * days;
        const monthlyRs = Math.round(monthlyKwh * rate);
        costEl.textContent = '₹' + monthlyRs.toLocaleString('en-IN') + ' / month';
        kwhEl.textContent = '~' + Math.round(monthlyKwh) + ' kWh units/month (' + dailyKwh.toFixed(1) + ' units/day)';
      }
      els.forEach((el) => el && el.addEventListener('input', calc));
      calc();
    })();
  </script>
</BaseLayout>

<style>
  .page-header { position: relative; padding: var(--space-20) 0 var(--space-12); overflow: hidden; }
  .header-bg { position: absolute; inset: 0; background: radial-gradient(ellipse at center, rgba(6,182,212,0.12) 0%, transparent 70%), var(--color-navy); }
  .page-title { font-family: 'Poppins', sans-serif; font-size: clamp(2.1rem, 4vw, 3.4rem); font-weight: 800; color: #f8fafc; margin: var(--space-3) 0; }
  .page-title span { color: #22d3ee; }
  .page-subtitle { color: var(--color-text-secondary); max-width: 680px; margin: 0 auto; }
  .calc-layout { display: grid; grid-template-columns: 1fr 1.15fr; gap: var(--space-8); align-items: start; }
  .calc-card, .guide-card { padding: var(--space-8); }
  .calc-card h2, .guide-card h2 { color: #f8fafc; margin-bottom: var(--space-4); }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  label { display: flex; flex-direction: column; gap: 6px; font-size: var(--text-sm); color: #cbd5e1; font-weight: 600; }
  input, select { padding: 10px 12px; border-radius: 8px; border: 1px solid var(--color-border); background: #0f172a; color: #f8fafc; font-size: var(--text-base); }
  .result-panel { margin-top: var(--space-6); padding: var(--space-5); border-radius: 10px; background: rgba(6,182,212,0.12); border: 1px solid rgba(6,182,212,0.4); text-align: center; }
  .res-label { font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em; color: #22d3ee; font-weight: 700; }
  .res-main { font-size: var(--text-2xl); font-weight: 800; color: #f8fafc; margin: 6px 0; }
  .res-sub { font-size: var(--text-sm); color: #cbd5e1; }
  .guide-card p, .guide-card li { color: var(--color-text-secondary); line-height: 1.75; }
  .guide-card ul { padding-left: 1.25rem; display: grid; gap: var(--space-2); margin: var(--space-4) 0; }
  .guide-card a { color: var(--color-gold); }
  .faq { border-top: 1px solid var(--color-border); padding-top: var(--space-3); margin-top: var(--space-4); }
  .faq h3 { color: #22d3ee; font-size: var(--text-sm); margin-bottom: 4px; }
  @media (max-width: 960px) { .calc-layout, .form-grid { grid-template-columns: 1fr; } .calc-card, .guide-card { padding: var(--space-5); } }
</style>

