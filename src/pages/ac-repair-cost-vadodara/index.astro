---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';

const prices = [
  { service: 'Standard AC Visit & Inspection', cost: '₹299', notes: 'Waived if repair is booked.' },
  { service: 'AC Gas Charging (R32 / R410a)', cost: '₹2,200 - ₹2,800', notes: 'By weight. Includes vacuuming.' },
  { powerJet: true, service: 'Power Jet Descaling Wash', cost: '₹599', notes: '120-Bar pressure wash + coil cleaning.' },
  { service: 'Inverter PCB Repair (Component Level)', cost: '₹1,500 - ₹3,500', notes: '70% cheaper than board replacement.' },
  { service: 'AC Installation (Split)', cost: '₹1,500', notes: 'Diamond core cutting included.' },
  { service: 'AC Uninstallation / Pump Down', cost: '₹700', notes: 'Safe gas recovery.' },
  { service: 'Compressor Replacement Labour', cost: '₹1,500', notes: 'Excludes cost of compressor/gas.' },
];
---

<BaseLayout
  title="AC Repair Cost in Vadodara | Atlas Aircon Price List"
  description="Transparent and upfront pricing for AC repair, gas charging, and installation in Vadodara. No hidden charges. View our 2024 price list."
>
  <section class="page-header">
    <div class="header-bg"></div>
    <div class="container relative z-10 text-center">
      <div class="section-badge"><Icon name="award" size={14} strokeWidth={2} /> Transparent Pricing</div>
      <h1 class="page-title">AC Service <span>Price List</span></h1>
      <p class="page-subtitle">No hidden fees. Just honest engineering.</p>
    </div>
  </section>

  <section class="section">
    <div class="container max-w-4xl mx-auto">
      
      <div class="pricing-card card">
        <div class="pricing-header">
          <h2>Standard Rates for Vadodara</h2>
          <p>Prices may vary slightly based on tonnage and brand.</p>
        </div>
        
        <div class="table-responsive">
          <table class="pricing-table">
            <thead>
              <tr>
                <th>Service Type</th>
                <th>Estimated Cost</th>
                <th>Details</th>
              </tr>
            </thead>
            <tbody>
              {prices.map(item => (
                <tr class={item.powerJet ? 'highlight-row' : ''}>
                  <td>
                    <div class="svc-name">
                      {item.powerJet && <Icon name="zap" size={16} class="text-amber-500" />} 
                      {item.service}
                    </div>
                  </td>
                  <td class="font-bold text-cyan-400">{item.cost}</td>
                  <td class="text-sm text-slate-400">{item.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="mt-12 text-center">
        <p class="mb-6 text-slate-300">Need a custom quote for Industrial Chillers or VRF Systems?</p>
        <a href="tel:+919727257141" class="btn btn-primary btn-lg">
          <Icon name="phone" size={18} strokeWidth={2.5} /> Call for Industrial Quote
        </a>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    position: relative;
    padding: var(--space-24) 0 var(--space-16);
    overflow: hidden;
  }
  .header-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(6,182,212,0.1) 0%, transparent 70%), var(--color-navy);
  }
  .page-title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    color: #F8FAFC;
    margin: var(--space-4) 0;
  }
  .page-title span {
    background: linear-gradient(135deg, #06B6D4, #22D3EE);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }
  
  .max-w-4xl { max-width: 56rem; }
  .mx-auto { margin-left: auto; margin-right: auto; }
  
  .pricing-card {
    padding: 0;
    overflow: hidden;
  }
  
  .pricing-header {
    padding: var(--space-8);
    background: rgba(6,182,212,0.05);
    border-bottom: 1px solid rgba(6,182,212,0.1);
    text-align: center;
  }
  .pricing-header h2 {
    font-family: 'Poppins', sans-serif;
    font-size: var(--text-2xl);
    color: #F8FAFC;
    margin: 0 0 var(--space-2);
  }
  .pricing-header p {
    color: var(--color-text-secondary);
    margin: 0;
  }
  
  .table-responsive {
    overflow-x: auto;
  }
  
  .pricing-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  
  .pricing-table th {
    padding: var(--space-4) var(--space-6);
    background: rgba(15,30,53,0.5);
    color: #94A3B8;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 700;
  }
  
  .pricing-table td {
    padding: var(--space-5) var(--space-6);
    border-bottom: 1px solid rgba(255,255,255,0.05);
    color: #E2E8F0;
  }
  
  .pricing-table tr:last-child td {
    border-bottom: none;
  }
  
  .pricing-table tr:hover td {
    background: rgba(255,255,255,0.02);
  }
  
  .highlight-row td {
    background: rgba(6,182,212,0.03);
  }
  
  .svc-name {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
  }
  
  .text-amber-500 { color: #F59E0B; }
  .text-cyan-400 { color: #22D3EE; }
  .font-bold { font-weight: 700; }
  .text-sm { font-size: var(--text-sm); }
  .text-slate-400 { color: #94A3B8; }
  .text-slate-300 { color: #CBD5E1; }
  .mt-12 { margin-top: var(--space-12); }
  .mb-6 { margin-bottom: var(--space-6); }
</style>
