---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import WhatsAppForm from '@components/WhatsAppForm.astro';
---

<BaseLayout
  title="Franchise Opportunity | Atlas Aircon Partner Network"
  description="Partner with Gujarat's leading HVAC engineering brand. Explore Atlas Aircon franchise and authorized service partner opportunities."
>
  <section class="page-header">
    <div class="header-bg"></div>
    <div class="container relative z-10 text-center">
      <div class="section-badge"><Icon name="award" size={14} strokeWidth={2} /> Business Growth</div>
      <h1 class="page-title">Atlas Aircon <span>Franchise</span></h1>
      <p class="page-subtitle">Join Gujarat's highest-rated HVAC engineering & service network.</p>
    </div>
  </section>

  <section class="section">
    <div class="container max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <div class="card p-6 text-center">
          <div class="text-3xl font-extrabold text-cyan-400 mb-2">20+ Years</div>
          <p class="text-slate-300 font-semibold mb-1">Established Brand</p>
          <p class="text-xs text-slate-400">Trusted since 2005 across Gujarat's industrial & residential sectors.</p>
        </div>
        <div class="card p-6 text-center">
          <div class="text-3xl font-extrabold text-cyan-400 mb-2">High ROI</div>
          <p class="text-slate-300 font-semibold mb-1">Lucrative B2B Contracts</p>
          <p class="text-xs text-slate-400">Access to ongoing GIDC industrial chiller & commercial AMC contracts.</p>
        </div>
        <div class="card p-6 text-center">
          <div class="text-3xl font-extrabold text-cyan-400 mb-2">Full Tech Stack</div>
          <p class="text-slate-300 font-semibold mb-1">Technical Training & Spares</p>
          <p class="text-xs text-slate-400">Complete training on inverter PCB diagnostics & direct OEM parts supply.</p>
        </div>
      </div>

      <div class="card p-8 text-center max-w-2xl mx-auto">
        <h2 class="text-2xl font-bold text-white mb-3">Apply for a Franchise Territory</h2>
        <p class="text-slate-300 mb-6">Territories currently open in Bharuch, Ankleshwar, Anand, Nadiad, Dahej, and Halol.</p>
        <a
          href="https://wa.me/919727257141?text=Hi%2C%20I%20am%20interested%20in%20an%20Atlas%20Aircon%20Franchise%20partnership."
          class="btn btn-whatsapp btn-lg inline-flex"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="whatsapp" size={18} /> Inquire via WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    position: relative;
    padding: var(--space-20) 0 var(--space-12);
    overflow: hidden;
  }
  .header-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(6,182,212,0.1) 0%, transparent 70%), var(--color-navy);
  }
  .page-title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 800;
    color: #F8FAFC;
    margin: var(--space-3) 0;
  }
  .page-title span {
    background: linear-gradient(135deg, #06B6D4, #22D3EE);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .page-subtitle {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
  }
</style>
