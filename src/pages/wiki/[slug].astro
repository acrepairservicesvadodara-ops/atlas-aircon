---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import WhatsAppForm from '@components/WhatsAppForm.astro';
import wikiArticles from '@data/wiki-articles.json';

export async function getStaticPaths() {
  return wikiArticles.map((article, idx) => ({
    params: { slug: article.slug },
    props: {
      article,
      related: [
        wikiArticles[(idx + 1) % wikiArticles.length],
        wikiArticles[(idx + 2) % wikiArticles.length],
        wikiArticles[(idx + 3) % wikiArticles.length],
      ],
    },
  }));
}

const { article, related } = Astro.props;
const canonicalUrl = `https://www.atlasaircons.com/wiki/${article.slug}/`;

const schemaData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      '@id': `${canonicalUrl}#article`,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
      headline: article.title,
      description: article.summary,
      datePublished: `${article.date}T09:00:00+05:30`,
      dateModified: `${article.date}T09:00:00+05:30`,
      author: { '@type': 'Organization', name: 'Atlas Aircon', url: 'https://www.atlasaircons.com/' },
      publisher: { '@id': 'https://www.atlasaircons.com/#organization' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: article.faqs.map((f: { q: string; a: string }) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.atlasaircons.com/' },
        { '@type': 'ListItem', position: 2, name: 'Atlas Wiki', item: 'https://www.atlasaircons.com/wiki/' },
        { '@type': 'ListItem', position: 3, name: article.title, item: canonicalUrl },
      ],
    },
  ],
};
---

<BaseLayout title={`${article.title} | Atlas Wiki`} description={article.summary}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </Fragment>

  <section class="page-header">
    <div class="header-bg"></div>
    <div class="container relative z-10 hero-grid">
      <div>
        <nav aria-label="Breadcrumb" class="crumbs">
          <a href="/">Home</a> <span>/</span> <a href="/wiki/">Atlas Wiki</a> <span>/</span> <span>{article.category}</span>
        </nav>
        <div class="section-badge"><Icon name="book" size={14} strokeWidth={2} /> {article.category}</div>
        <h1 class="page-title">{article.title}</h1>
        <p class="hero-intro">{article.summary}</p>
        <div class="spec-banner">
          <strong>{article.metric_label}:</strong> {article.metric_val}
        </div>
      </div>
      <div>
        <WhatsAppForm />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container content-wrap">
      <article class="card prose-card">
        {article.sections.map((sec: { heading: string; body?: string; bullets?: string[] }) => (
          <div class="sec-block">
            <h2>{sec.heading}</h2>
            {sec.body && <p>{sec.body}</p>}
            {sec.bullets && (
              <ul>
                {sec.bullets.map((b: string) => <li>{b}</li>)}
              </ul>
            )}
          </div>
        ))}

        <div class="sec-block">
          <h2>Frequently Asked Engineering Questions</h2>
          {article.faqs.map((f: { q: string; a: string }) => (
            <div class="faq-item">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </div>
      </article>

      <aside class="related-wrap">
        <div class="card side-card">
          <h2>Related Engineering Guides</h2>
          <ul class="rel-list">
            {related.map((r: { slug: string; title: string; category: string }) => (
              <li>
                <a href={`/wiki/${r.slug}/`}>
                  <span class="rel-cat">{r.category}</span>
                  <span>{r.title}</span>
                </a>
              </li>
            ))}
          </ul>
          <div class="hub-links">
            <a href="/wiki/" class="btn btn-outline">All Wiki Guides</a>
            <a href="/services/" class="btn btn-primary">Explore Services</a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header { position: relative; padding: var(--space-16) 0 var(--space-12); overflow: hidden; }
  .header-bg { position: absolute; inset: 0; background: radial-gradient(ellipse at top left, rgba(6,182,212,0.14) 0%, transparent 65%), var(--color-navy); }
  .hero-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: var(--space-8); align-items: center; }
  .crumbs { font-size: var(--text-xs); color: var(--color-text-muted); margin-bottom: var(--space-3); display: flex; flex-wrap: wrap; gap: 6px; }
  .crumbs a { color: var(--color-gold); text-decoration: none; }
  .page-title { font-family: 'Poppins', sans-serif; font-size: clamp(1.9rem, 3.6vw, 2.9rem); font-weight: 800; color: #f8fafc; line-height: 1.2; margin: var(--space-3) 0; }
  .hero-intro { color: var(--color-text-secondary); line-height: 1.7; margin-bottom: var(--space-4); }
  .spec-banner { padding: var(--space-3) var(--space-4); border-left: 3px solid #06b6d4; background: rgba(6,182,212,0.1); border-radius: 6px; color: #e2e8f0; font-size: var(--text-sm); }
  .content-wrap { display: grid; grid-template-columns: 1fr 340px; gap: var(--space-8); align-items: start; }
  .prose-card, .side-card { padding: var(--space-8); }
  .sec-block { margin-bottom: var(--space-8); }
  .sec-block h2, .side-card h2 { font-family: var(--font-heading); font-size: var(--text-xl); color: #f8fafc; margin-bottom: var(--space-3); }
  .sec-block p, .sec-block li { color: var(--color-text-secondary); line-height: 1.8; }
  .sec-block ul { padding-left: 1.25rem; display: grid; gap: var(--space-2); }
  .faq-item { padding: var(--space-4); border: 1px solid var(--color-border); border-radius: 8px; margin-top: var(--space-3); }
  .faq-item h3 { font-size: var(--text-base); color: #22d3ee; margin-bottom: var(--space-2); }
  .rel-list { list-style: none; padding: 0; margin: 0 0 var(--space-6); display: grid; gap: var(--space-3); }
  .rel-list a { display: flex; flex-direction: column; gap: 4px; padding: var(--space-3); border: 1px solid var(--color-border); border-radius: 8px; color: #f8fafc; text-decoration: none; font-size: var(--text-sm); }
  .rel-list a:hover { border-color: #06b6d4; color: #22d3ee; }
  .rel-cat { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: #06b6d4; font-weight: 700; }
  .hub-links { display: flex; flex-direction: column; gap: var(--space-3); }
  @media (max-width: 960px) {
    .hero-grid, .content-wrap { grid-template-columns: 1fr; }
    .prose-card, .side-card { padding: var(--space-5); }
  }
</style>

