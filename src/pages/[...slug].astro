    diagnostics: [
      'Alkaline foaming coil wash to strip sticky NH-48 highway carbon film from outdoor condensers',
      'On-site inverter PCB surge-varistor (MOV) & IPM inspection for rural MGVCL feeder fluctuations',
      '350 PSI dry nitrogen leak verification & 500-micron two-stage vacuum pump dehydration',
      'Wire-mesh anti-rodent guard installation for farmhouse & ground-floor outdoor units',
    ],
    faqs: [
      {
        q: 'How fast do Atlas Aircon technicians reach Alamgir near Jambuva?',
        a: 'Our southern Vadodara mobile van dispatches directly from Makarpura via the NH-48 Jambuva bypass, reaching Alamgir homes, farmhouses, and highway warehouses within 60 to 75 minutes.',
      },
      {
        q: 'Do you charge extra travel fees for AC service in Alamgir?',
        a: 'No hidden highway surcharge applies. Standard inspection is ₹299 (waived upon repair approval) and 120-bar foam-jet split AC deep cleaning starts at ₹599.',
      },
    ],
  },
  'ac-service-in-sankarda': {
    corridor: 'North Vadodara NH-48 / Bhadarva Industrial & Agro Corridor',
    landmarks: 'Sankarda Chokdi, Ranoli GIDC North Gate, Fazalpur Approach, Vasad Toll Plaza & Nandesari Link Road',
    sla: '60–80 Minutes from Chhani / Sama Dispatch Hub',
    technicalSummary:
