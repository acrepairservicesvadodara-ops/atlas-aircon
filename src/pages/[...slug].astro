---
// Catch-all route: renders every WordPress page/post at its ORIGINAL URL + restored root pages.
// CONTENT = exact text/headings/lists/tables/images from WordPress (cleaned of WP/Tailwind markup)
//           plus structured engineering content for restored & enriched pages.
// UI      = this Astro site's own design system (BaseLayout, page-header, cards, CTA).
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import WhatsAppForm from '@components/WhatsAppForm.astro';
import { cleanWpHtml } from '../lib/wp-clean';
import { wpEntries, relatedFor, REMOVED_WP_SLUGS } from '../lib/wp-data';
import locations from '@data/locations.json';

export async function getStaticPaths() {
  const dir = path.resolve('wp-export');
  const read = (f: string) => JSON.parse(fs.readFileSync(path.join(dir, f), 'utf8'));
  const seoFile = path.join(dir, 'seo.json');
  const seo: Record<string, any> = fs.existsSync(seoFile) ? read('seo.json') : {};

  // Dedicated Astro routes that take precedence over [...slug].astro
  const handBuiltSlugs = new Set<string>([
    '404',
    'about-us',
    'ac-gas-charging',
    'ac-installation',
    'ac-power-calculator',
    'ac-repair-cost-vadodara',
    'ac-technician-jobs',
    'ac-tonnage-calculator',
    'blogs',
    'book-appointment',
    'cassette-ac-service',
    'contact-us',
    'fault-codes',
    'franchise',
    'gallery',
    'industrial-hvac',
    'inverter-pcb-repair',
    'privacy-policy',
    'recent-projects',
    'service-areas',
    'services',
    'shop',
    'sitemap',
    'terms-and-conditions',
    'testimonials',
    'wiki',
    ...locations.map((l) => `ac-repair-${l.slug}`),
  ]);

  const items = [...read('pages.json'), ...read('posts.json')];
  const seen = new Set<string>();
  const out: any[] = [];

  for (const it of items) {
    const p = new URL(it.link).pathname; // e.g. /ac-repair-vadodara/
    const slug = decodeURIComponent(p).replace(/^\/|\/$/g, '');
    if (!slug || seen.has(slug) || REMOVED_WP_SLUGS.has(slug) || handBuiltSlugs.has(slug)) continue;
    const itemSeo = seo[p] ?? null;
    if (itemSeo?.noindex) continue;
    seen.add(slug);
    out.push({
      params: { slug },
      props: {
        raw: it.content.rendered as string,
        wpTitle: it.title.rendered as string,
        excerpt: it.excerpt?.rendered as string,
        date: it.date as string,
        modified: it.modified as string,
        seo: itemSeo,
        type: it.type as string,
        restored: null,
      },
    });
  }

  // Add all restored root-level HVAC service, equipment, spare-part, and technical guide pages
  const restoredFile = path.resolve('src/data/restored-pages.json');
  if (fs.existsSync(restoredFile)) {
    const restoredItems = JSON.parse(fs.readFileSync(restoredFile, 'utf8'));
    for (const r of restoredItems) {
      if (!r.slug || seen.has(r.slug) || REMOVED_WP_SLUGS.has(r.slug) || handBuiltSlugs.has(r.slug)) continue;
      seen.add(r.slug);
      out.push({
        params: { slug: r.slug },
        props: {
          raw: '',
          wpTitle: r.title,
          excerpt: r.intro,
          date: '2026-10-15T10:00:00',
          modified: '2026-11-01T12:00:00',
          seo: null,
          type: 'page',
          restored: r,
        },
      });
    }
  }

  return out;
}

const { raw, wpTitle, excerpt, date, modified, seo, type, restored } = Astro.props;
const currentSlug = String(Astro.params.slug || '');

const decode = (s: string) =>
  s
    .replace(/&#0*38;|&amp;/g, '&')
    .replace(/&#8217;|&#8216;/g, "'")
    .replace(/&#8220;|&#8221;|&quot;/g, '"')
    .replace(/&#8211;|&#8212;/g, '-')
    .replace(/&#0*39;/g, "'")
    .replace(/<[^>]+>/g, '')
    .trim();

const cleaned = restored ? { title: restored.title, html: '' } : cleanWpHtml(raw);
const h1FromContent = cleaned.title;
const html = cleaned.html;

const rawTitle = decode(wpTitle);
const pageTitle = restored ? restored.title : (h1FromContent || rawTitle);

// Clean SEO Title: prefer verified live title, else natural brand-anchored title
const seoTitle = seo?.title
  ? decode(seo.title)
  : pageTitle.includes('Atlas Aircon')
    ? pageTitle
    : `${pageTitle} | Atlas Aircon`;

// Clean Description
const description = restored
  ? `${restored.intro} Book 24/7 certified engineers across Vadodara & Gujarat (${restored.priceNote}).`.slice(0, 160)
  : seo?.description
    ? decode(seo.description)
    : excerpt
      ? decode(excerpt).slice(0, 155)
      : `Looking for expert ${pageTitle}? Atlas Aircon delivers fast technician dispatch, genuine parts, and guaranteed cooling solutions across Vadodara and Gujarat.`;

const isPost = type === 'post';
const dateLabel = date
  ? new Date(date).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';
const waText = encodeURIComponent(`Hi, I need help with: ${pageTitle}`);

// Enriched localized/brand engineering supplements for Crawled-Not-Indexed WP pages
const ENRICHED_SUPPLEMENTS: Record<
  string,
  {
    corridor: string;
    landmarks: string;
    sla: string;
    technicalSummary: string;
    diagnostics: string[];
    faqs: Array<{ q: string; a: string }>;
  }
> = {
  'ac-service-in-alamgir': {
    corridor: 'NH-48 Jambuva–Varnama Southern Vadodara Belt',
    landmarks: 'Alamgir Village, Jambuva River Bridge, Sundarpura Crossroads, Kapurai–Tarsali Bypass & NH-48 Warehousing Hub',
    sla: '60–75 Minutes from Makarpura Dispatch Hub',
    technicalSummary:
