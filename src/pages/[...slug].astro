---
// Catch-all route: renders every WordPress page/post at its ORIGINAL URL.
// CONTENT = exact text/headings/lists/tables/images from WordPress (cleaned of WP/Tailwind markup).
// UI      = this Astro site's own design system (BaseLayout, page-header, cards, CTA).
// Hand-built Astro pages (e.g. /about-us/, /ac-repair-[city]) take priority over this route.
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import WhatsAppForm from '@components/WhatsAppForm.astro';
import { cleanWpHtml } from '../lib/wp-clean';
import { wpEntries, relatedFor } from '../lib/wp-data';

export async function getStaticPaths() {
  const dir = path.resolve('wp-export');
  const read = (f: string) => JSON.parse(fs.readFileSync(path.join(dir, f), 'utf8'));
  const seoFile = path.join(dir, 'seo.json');
  const seo: Record<string, any> = fs.existsSync(seoFile) ? read('seo.json') : {};

  const items = [...read('pages.json'), ...read('posts.json')];
  const seen = new Set<string>();
  const out: any[] = [];

  for (const it of items) {
    const p = new URL(it.link).pathname; // e.g. /ac-repair-vadodara/
    const slug = decodeURIComponent(p).replace(/^\/|\/$/g, '');
    if (!slug || seen.has(slug)) continue; // "/" is handled by index.astro
    seen.add(slug);
    out.push({
      params: { slug },
      props: {
        raw: it.content.rendered as string,
        wpTitle: it.title.rendered as string,
        excerpt: it.excerpt?.rendered as string,
        date: it.date as string,
        modified: it.modified as string,
        seo: seo[p] ?? null,
        type: it.type as string,
      },
    });
  }
  return out;
}

const { raw, wpTitle, excerpt, date, modified, seo, type } = Astro.props;

const decode = (s: string) =>
  s
    .replace(/&#0*38;|&amp;/g, '&')
    .replace(/&#8217;|&#8216;/g, "'")
    .replace(/&#8220;|&#8221;/g, '"')
    .replace(/&#8211;|&#8212;/g, '-')
    .replace(/&#0*39;/g, "'")
    .replace(/<[^>]+>/g, '')
    .trim();

const { title: h1FromContent, html } = cleanWpHtml(raw);

const rawTitle = decode(wpTitle);
const pageTitle = h1FromContent || rawTitle;

// Clean SEO Title: prefer verified live title, else natural brand-anchored title
const seoTitle = seo?.title
  ? decode(seo.title)
  : `${pageTitle} | Atlas Aircon Vadodara & Gujarat`;

// Clean Description: prefer verified live description, else naturally composed summary
const description = seo?.description
  ? decode(seo.description)
  : excerpt
    ? decode(excerpt).slice(0, 155)
    : `Looking for expert ${pageTitle}? Atlas Aircon delivers fast technician dispatch, genuine parts, and guaranteed cooling solutions across Vadodara and Gujarat. Call now!`;
const isPost = type === 'post';
const dateLabel = date
  ? new Date(date).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';
const waText = encodeURIComponent(`Hi, I need help with: ${pageTitle}`);

// Related pages (internal linking): prev/next + most similar slugs
const self = wpEntries().find((e) => e.slug === Astro.params.slug);
const related = self ? relatedFor(self) : [];

// Breadcrumbs: Home > (Blogs for posts) > current page. Does not affect any URL.
const ORIGIN = 'https://www.atlasaircons.com';
const canonicalUrl = ORIGIN + Astro.url.pathname;
const crumbs = [
  { name: 'Home', href: '/' },
  ...(isPost ? [{ name: 'Blogs', href: '/blogs/' }] : []),
  { name: pageTitle, href: Astro.url.pathname },
];
const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: crumbs.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: ORIGIN + c.href,
      })),
    },
    ...(isPost
      ? [
          {
            '@type': 'Article',
            '@id': `${canonicalUrl}#article`,
            mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
            headline: pageTitle.slice(0, 110),
            datePublished: date ? new Date(date).toISOString() : undefined,
            dateModified: modified ? new Date(modified).toISOString() : undefined,
            author: { '@type': 'Organization', name: 'Atlas Aircon', url: `${ORIGIN}/` },
            publisher: { '@id': `${ORIGIN}/#organization` },
          },
        ]
      : []),
  ],
};
---

<BaseLayout title={seoTitle} description={description} noindex={seo?.noindex}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  </Fragment>
  <section class="page-header">
    <div class="header-bg"></div>
    <div class="container relative z-10 hero-grid">
      <div class="hero-text">
        <div class="section-badge">
          <Icon name={isPost ? 'clock' : 'map-pin'} size={14} strokeWidth={2} />
          {isPost ? 'Blog' : 'Atlas Aircon'}
          {isPost && dateLabel && <> • <time datetime={new Date(date).toISOString()}>{dateLabel}</time></>}
        </div>
        <h1 class="page-title">{pageTitle}</h1>
        <p class="hero-intro">
          Professional HVAC and air conditioning services by <strong>Atlas Aircon</strong>. 
          Prompt on-site diagnostics, precision repairs, and genuine OEM spare components backed by certified technicians.
        </p>
        <div class="hero-points">
          <span><Icon name="clock" size={14} /> 24/7 Emergency Dispatch</span>
          <span><Icon name="shield" size={14} /> Warranty on Every Repair</span>
          <span><Icon name="check" size={14} /> Genuine Spare Parts</span>
        </div>
      </div>
      <div class="hero-form">
        <WhatsAppForm />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container wp-wrap">
      <nav aria-label="Breadcrumb" class="crumbs">
        <ol>
          {crumbs.map((c, i) => (
            <li>
              {i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
            </li>
          ))}
        </ol>
      </nav>
      <article class="wp-prose card" set:html={html} />

      {related.length > 0 && (
        <nav class="related card" aria-labelledby="related-heading">
          <h2 id="related-heading">Related Pages</h2>
          <ul>
            {related.map((r) => <li><a href={r.path}>{r.title}</a></li>)}
          </ul>
        </nav>
      )}

      <aside class="wp-cta card">
        <h2>Need AC Service in Vadodara?</h2>
        <p>Talk to an Atlas Aircon engineer. 24/7 emergency dispatch across Gujarat.</p>
        <div class="wp-cta-btns">
          <a class="btn btn-primary" href="tel:+919727257141">Call +91 97272 57141</a>
          <a
            class="btn btn-whatsapp"
            href={`https://wa.me/919727257141?text=${waText}`}
            target="_blank"
            rel="noopener noreferrer">WhatsApp Us</a
          >
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    position: relative;
    padding: var(--space-20) 0 var(--space-12);
    overflow: hidden;
  }
  .header-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(6, 182, 212, 0.1) 0%, transparent 70%), var(--color-navy);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: var(--space-10);
    align-items: center;
  }
  .page-title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
    font-weight: 800;
    color: #f8fafc;
    margin: var(--space-3) 0 0;
    line-height: 1.2;
  }
  .hero-intro {
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.6;
    margin-top: var(--space-4);
    max-width: 580px;
  }
  .hero-intro strong {
    color: #f8fafc;
  }
  .hero-points {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .hero-points span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    background: var(--color-gold-dim);
    border: 1px solid var(--color-gold-border);
    border-radius: var(--radius-full);
  }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: var(--space-8); }
  }
  .wp-wrap {
    max-width: 920px;
    margin: 0 auto;
  }
  .crumbs { margin-bottom: var(--space-4); font-size: var(--text-sm); }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; padding: 0; margin: 0; }
  .crumbs li + li::before { content: '›'; margin-right: var(--space-2); color: var(--color-text-muted); }
  .crumbs a { color: var(--color-gold); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .crumbs [aria-current='page'] { color: var(--color-text-secondary); }
  .related { margin-top: var(--space-8); padding: var(--space-6); }
  .related h2 { font-family: var(--font-heading); color: var(--color-text-primary); font-size: var(--text-xl); margin-bottom: var(--space-3); }
  .related ul { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-2); grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .related a { color: var(--color-gold); text-decoration: none; font-size: var(--text-sm); line-height: 1.5; }
  .related a:hover { color: var(--color-gold-light); text-decoration: underline; }
  .wp-cta {
    margin-top: var(--space-8);
    padding: var(--space-8);
    text-align: center;
  }
  .wp-cta h2 {
    font-family: var(--font-heading);
    color: var(--color-text-primary);
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }
  .wp-cta p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-5);
  }
  .wp-cta-btns {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
  }
</style>

<style is:global>
  /* Typography for migrated WordPress content, using the Astro design tokens */
  .wp-prose {
    padding: var(--space-8);
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.8;
    overflow-wrap: anywhere;
  }
  .wp-prose > :first-child { margin-top: 0; }
  .wp-prose h2, .wp-prose h3, .wp-prose h4, .wp-prose h5, .wp-prose h6 {
    font-family: var(--font-heading);
    color: var(--color-text-primary);
    line-height: 1.3;
    margin: var(--space-8) 0 var(--space-3);
  }
  .wp-prose h2 { font-size: var(--text-3xl); font-weight: 800; }
  .wp-prose h3 { font-size: var(--text-2xl); font-weight: 700; color: var(--color-gold-light); }
  .wp-prose h4 { font-size: var(--text-xl); font-weight: 700; }
  .wp-prose h5, .wp-prose h6 { font-size: var(--text-lg); font-weight: 600; }
  .wp-prose p { margin: 0 0 var(--space-4); }
  .wp-prose strong { color: var(--color-text-primary); font-weight: 700; }
  .wp-prose a { color: var(--color-gold); text-decoration: underline; text-underline-offset: 3px; }
  .wp-prose a:hover { color: var(--color-gold-light); }
  .wp-prose ul, .wp-prose ol { margin: 0 0 var(--space-5); padding-left: var(--space-6); }
  .wp-prose ul { list-style: disc; }
  .wp-prose ol { list-style: decimal; }
  .wp-prose li { margin-bottom: var(--space-2); }
  .wp-prose li::marker { color: var(--color-gold); }
  .wp-prose img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    margin: var(--space-4) 0;
  }
  .wp-prose figure { margin: var(--space-5) 0; }
  .wp-prose figcaption { font-size: var(--text-sm); color: var(--color-text-muted); text-align: center; }
  .wp-prose blockquote {
    margin: var(--space-5) 0;
    padding: var(--space-4) var(--space-5);
    border-left: 4px solid var(--color-gold);
    background: var(--color-gold-dim);
    border-radius: var(--radius-md);
  }
  .wp-prose iframe { width: 100%; min-height: 360px; border: 0; border-radius: var(--radius-lg); }
  .wp-prose hr { border: 0; border-top: 1px solid var(--color-gold-border); margin: var(--space-8) 0; }
  .wp-prose table {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-5) 0;
    font-size: var(--text-sm);
  }
  .wp-prose th, .wp-prose td {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-gold-border);
    text-align: left;
    vertical-align: top;
  }
  .wp-prose th { background: var(--color-gold-dim); color: var(--color-text-primary); font-weight: 700; }
  .wp-prose details { margin: var(--space-3) 0; padding: var(--space-3) var(--space-4); border: 1px solid var(--color-gold-border); border-radius: var(--radius-md); }
  .wp-prose summary { cursor: pointer; color: var(--color-text-primary); font-weight: 600; }
  @media (max-width: 640px) {
    .wp-prose { padding: var(--space-5); }
  }
</style>
