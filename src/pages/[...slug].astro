    landmarks: 'Vadodara, Ahmedabad, Surat, Bharuch, Anand, Ankleshwar, Halol, Dahej & Gandhinagar Commercial Hubs',
    sla: 'Same-Day Commercial Dispatch & Scheduled Night-Shift Servicing',
    technicalSummary:
      'Ceiling-mounted 4-way cassette air conditioners in corporate offices, retail showrooms, banks, clinics, and restaurants require specialized servicing because a clogged condensate lift pump or slime-blocked float switch can stain expensive false-ceiling gypsum boards. Atlas Aircon executes zero-mess commercial cassette maintenance across Gujarat—including night-shift and Sunday slots so your business operations are never disrupted.',
    diagnostics: [
      'Complete disassembly of decorative grille, motorized louver steppers, condensate drain pan, and float switch',
      'Submersible condensate drain lift-pump descaling & 750mm vertical head lift verification',
      '360-degree circular evaporator coil chemical foam-jet cleaning with suspended waterproof catchment funnel',
      'Multi-unit VRV/VRF refnet refrigerant balancing, EEV coil testing, and GST-compliant AMC documentation',
    ],
    faqs: [
      {
        q: 'Why is my ceiling cassette AC dripping water onto the false ceiling or blinking a drain error?',
        a: 'Algae bio-slime inside the internal condensate pan blocks the submersible lift pump or jams the float switch (triggering Daikin A3, Mitsubishi P5, or LG CH04 codes). Disassembling the pan, sanitizing the pump impeller, and flushing the PVC riser permanently resolves ceiling leaks.',
      },
      {
        q: 'Do you offer after-hours commercial cassette AC AMC contracts in Gujarat?',
        a: 'Yes. We provide quarterly and bi-monthly GST-invoiced Annual Maintenance Contracts for banks, hospitals, restaurants, and corporate offices across Vadodara, Bharuch, Anand, Halol, Ahmedabad, and Surat—including evening and weekend servicing.',
      },
    ],
  },
};

const supplement = ENRICHED_SUPPLEMENTS[currentSlug] || null;

// FAQs for restored pages or enriched WP pages
const pageFaqs = restored
  ? [
      {
        q: `How quickly can Atlas Aircon dispatch a technician for ${restored.title.split('|')[0].trim()}?`,
        a: `Our mobile HVAC engineering vans reach all Vadodara residential and commercial zones within 60 to 90 minutes, and regional GIDC corridors (Halol, Savli, Por, Nandesari, Dahej, Ankleshwar, Bharuch, Anand) within 2 to 3 hours.`,
      },
      {
        q: `What is the typical pricing scope for this service?`,
        a: `Standard benchmark pricing: ${restored.priceNote}. Every job begins with an instrument-backed inspection and an upfront written estimate before any component repair or replacement is carried out.`,
      },
      {
        q: `What testing protocol and warranty does Atlas Aircon include?`,
        a: `Depending on equipment scope, our technicians execute 350 PSI dry nitrogen leak testing, dual-stage rotary vacuum dehydration below 500 microns, digital scale refrigerant charging, and clamp-meter load verification—backed by up to a 90-day written service warranty and GST billing.`,
      },
    ]
  : supplement
    ? supplement.faqs
    : [];

// Related pages (internal linking): prev/next + most similar slugs
const self = wpEntries().find((e) => e.slug === currentSlug);
const related = self ? relatedFor(self) : [];

// Breadcrumbs
const ORIGIN = 'https://www.atlasaircons.com';
const canonicalUrl = ORIGIN + Astro.url.pathname;
const crumbs = [
  { name: 'Home', href: '/' },
  ...(isPost ? [{ name: 'Blogs', href: '/blogs/' }] : [{ name: 'Services', href: '/services/' }]),
  { name: pageTitle, href: Astro.url.pathname },
];

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: crumbs.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: ORIGIN + c.href,
      })),
    },
    ...(isPost
      ? [
          {
            '@type': 'Article',
            '@id': `${canonicalUrl}#article`,
            mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
            headline: pageTitle.slice(0, 110),
            datePublished: date ? new Date(date).toISOString() : undefined,
            dateModified: modified ? new Date(modified).toISOString() : undefined,
            author: { '@type': 'Organization', name: 'Atlas Aircon', url: `${ORIGIN}/` },
            publisher: { '@id': `${ORIGIN}/#organization` },
          },
        ]
      : [
          {
            '@type': 'Service',
            '@id': `${canonicalUrl}#service`,
            name: pageTitle,
            description,
            provider: { '@id': `${ORIGIN}/#organization` },
            areaServed: [
              { '@type': 'City', name: 'Vadodara' },
              { '@type': 'State', name: 'Gujarat' },
            ],
          },
        ]),
    ...(pageFaqs.length > 0
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${canonicalUrl}#faq`,
            mainEntity: pageFaqs.map((f) => ({
              '@type': 'Question',
              name: f.q,
              acceptedAnswer: {
                '@type': 'Answer',
                text: f.a,
              },
            })),
          },
        ]
      : []),
  ],
};
---

<BaseLayout title={seoTitle} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />
  </Fragment>
  <section class="page-header">
    <div class="header-bg"></div>
    <div class="container relative z-10 hero-grid">
      <div class="hero-text">
        <div class="section-badge">
          <Icon name={isPost ? 'clock' : 'map-pin'} size={14} strokeWidth={2} />
          {restored ? restored.badge : isPost ? 'Blog' : 'Atlas Aircon'}
          {isPost && dateLabel && <> • <time datetime={new Date(date).toISOString()}>{dateLabel}</time></>}
        </div>
        <h1 class="page-title">{pageTitle}</h1>
        <p class="hero-intro">
          {restored ? (
            <>{restored.intro} Backed by <strong>Atlas Aircon</strong> field engineers across Vadodara and Gujarat industrial corridors.</>
          ) : (
            <>
              Professional HVAC and air conditioning services by <strong>Atlas Aircon</strong>. Prompt on-site diagnostics,
              precision repairs, and genuine OEM spare components backed by certified technicians.
            </>
          )}
        </p>
        <div class="hero-points">
          <span><Icon name="clock" size={14} /> 24/7 Emergency Dispatch</span>
          <span><Icon name="shield" size={14} /> Warranty on Every Repair</span>
          <span><Icon name="check" size={14} /> Genuine Spare Parts</span>
        </div>
      </div>
      <div class="hero-form">
        <WhatsAppForm />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container wp-wrap">
      <nav aria-label="Breadcrumb" class="crumbs">
        <ol>
          {crumbs.map((c, i) => (
            <li>
              {i < crumbs.length - 1 ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
            </li>
          ))}
        </ol>
      </nav>

      {restored ? (
        <article class="wp-prose card">
          <h2>Engineering Scope & Technical Overview</h2>
          <p>
            <strong>{restored.intro}</strong> At Atlas Aircon, our dedicated service division specializes in{' '}
            {restored.focus}. Operating across extreme 44°C–47°C Gujarat summer ambient temperatures and demanding GIDC utility
            grids requires strict adherence to thermodynamic and electrical testing benchmarks rather than guesswork or temporary
            top-ups.
          </p>
          <p>
            Every field call begins with instrument-assisted root-cause verification: incoming phase voltage stability, compressor
            winding insulation resistance, capacitor microfarad tolerance, heat-exchanger airflow Delta-T, and electronic leak
            inspection. Whether servicing a residential apartment in Alkapuri, a retail showroom in Gotri, or a continuous-process
            plant in Makarpura, Savli, Halol, or Dahej GIDC, our technicians restore factory-rated cooling efficiency and lower
            monthly kWh consumption.
          </p>

          <h2>Standard Rate Benchmark & Service Specifications</h2>
          <table>
            <thead>
              <tr>
                <th>Parameter</th>
                <th>Verified Atlas Aircon Standard</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Primary Technical Focus</strong></td>
                <td>{restored.focus}</td>
              </tr>
              <tr>
                <td><strong>Indicative Rate / Pricing Tier</strong></td>
                <td><strong>{restored.priceNote}</strong> (Upfront written quote post-diagnosis)</td>
              </tr>
              <tr>
                <td><strong>Dispatch Turnaround (SLA)</strong></td>
                <td>60–90 Mins (Vadodara City) • 2–3 Hours (Halol, Savli, Por, Nandesari, Dahej, Ankleshwar)</td>
              </tr>
              <tr>
                <td><strong>Testing & Evacuation Protocol</strong></td>
                <td>350 PSI Dry Nitrogen Pressure Hold + &lt;500 Micron Dual-Stage Vacuum + Digital Scale Charge</td>
              </tr>
              <tr>
                <td><strong>Warranty & Documentation</strong></td>
                <td>Up to 90-Day Written Service Warranty • Formal GST Tax Invoice & Field Log Sheet</td>
              </tr>
            </tbody>
          </table>

          <h2>4-Stage Field Execution Protocol (SOP)</h2>
          <ol>
            <li>
              <strong>Calibrated Electrical & Thermal Audit:</strong> Checking supply voltage under load, starting/running amperage,
              NTC sensor resistance curves, and PCB rail voltages (310V DC bus, 15V IPM drive, and 5V logic).
            </li>
            <li>
              <strong>Mechanical & Heat-Exchanger Restoration:</strong> High-pressure 120-bar coil cleaning with waterproof
              catchment jackets, silver-alloy copper brazing under dry nitrogen purge, or precision OEM spare installation.
            </li>
            <li>
              <strong>Moisture Dehydration & Exact Metering:</strong> Deep two-stage vacuum pump evacuation below 500 microns to
              eliminate acid-forming moisture before charging virgin R32, R410A, R134a, or R404A refrigerant by electronic weight.
            </li>
            <li>
              <strong>Load Performance Sign-Off:</strong> Verifying 12°C–16°C evaporator air Delta-T, clear condensate drainage,
              quiet vibration-free operation, and handing over your warranty invoice.
            </li>
          </ol>

          <h2>Coverage Across Vadodara & Gujarat Corridors</h2>
          <p>
            Explore our <a href="/ac-repair-cost-vadodara/">transparent AC repair rate card</a>, browse all{' '}
            <a href="/services/">core residential & industrial HVAC services</a>, check{' '}
            <a href="/service-areas/">330+ Gujarat service areas</a>, or{' '}
            <a href="/book-appointment/">schedule an engineer visit online</a>. We support all leading domestic and commercial
            manufacturers including Daikin, Mitsubishi Electric, O General, Voltas, Blue Star, LG, Carrier, Hitachi, Panasonic,
            Lloyd, Whirlpool, Godrej, Samsung, Haier, and Trane.
          </p>

          <h2>Frequently Asked Questions</h2>
          {pageFaqs.map((f) => (
            <details open>
              <summary>{f.q}</summary>
              <p style="margin-top: 0.6rem;">{f.a}</p>
            </details>
          ))}
        </article>
      ) : (
        <article class="wp-prose card">
          <div set:html={html} />

          {supplement && (
            <div class="supplement-box">
              <hr />
              <h2>Local Engineering Dispatch & Technical Protocol</h2>
              <p>
                <strong>Dispatch Corridor:</strong> {supplement.corridor}<br />
                <strong>Key Coverage Landmarks:</strong> {supplement.landmarks}<br />
                <strong>Verified Arrival SLA:</strong> {supplement.sla}
              </p>
              <p>{supplement.technicalSummary}</p>
              <h3>On-Site Diagnostic Checklist</h3>
              <ul>
                {supplement.diagnostics.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
              <p>
                Compare transparent charges on our <a href="/ac-repair-cost-vadodara/">Vadodara AC service price list</a>, explore{' '}
                <a href="/service-areas/">nearby Gujarat service hubs</a>, or{' '}
                <a href="/book-appointment/">book a priority technician slot</a>.
              </p>
              <h3>Frequently Asked Questions</h3>
              {supplement.faqs.map((f) => (
                <details open>
                  <summary>{f.q}</summary>
                  <p style="margin-top: 0.6rem;">{f.a}</p>
                </details>
              ))}
            </div>
          )}
        </article>
      )}

      {related.length > 0 && (
        <nav class="related card" aria-labelledby="related-heading">
          <h2 id="related-heading">Related Pages</h2>
          <ul>
            {related.map((r) => <li><a href={r.path}>{r.title}</a></li>)}
          </ul>
        </nav>
      )}

      <aside class="wp-cta card">
        <h2>Need Certified HVAC Support in Vadodara or Gujarat?</h2>
        <p>Talk directly to an Atlas Aircon senior engineer. 24/7 emergency dispatch across urban & GIDC zones.</p>
        <div class="wp-cta-btns">
          <a class="btn btn-primary" href="tel:+919727257141">Call +91 97272 57141</a>
          <a
            class="btn btn-whatsapp"
            href={`https://wa.me/919727257141?text=${waText}`}
            target="_blank"
            rel="noopener noreferrer">WhatsApp Us</a
          >
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

