---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import { getCollection } from 'astro:content';
import hvacWorkLogs from '@data/hvac-work-logs.json';

const allProjects = await getCollection('recent-projects');
allProjects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.atlasaircons.com/' },
    { '@type': 'ListItem', position: 2, name: 'Recent Projects', item: 'https://www.atlasaircons.com/recent-projects/' },
  ],
};
---

<BaseLayout
  title="Daily Operations & Engineering Logs | Atlas Aircon"
  description="Live logs of our recent HVAC engineering projects, emergency dispatches, chiller overhauls, and installations across Vadodara & Gujarat."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </Fragment>

  <section class="page-header">
    <div class="header-bg"></div>
    <div class="container relative z-10 text-center">
      <div class="section-badge"><Icon name="zap" size={14} strokeWidth={2} /> Live Dispatches</div>
      <h1 class="page-title">Engineering <span>Logs</span></h1>
      <p class="page-subtitle">Verified on-site work, GIDC plant restorations, and emergency interventions.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="projects-grid">
        {allProjects.map((post) => (
          <a href={`/recent-projects/${post.slug}/`} class="project-card card">
            <div class="project-meta">
              <span class="meta-item"><Icon name="map-pin" size={12} /> {post.data.location}</span>
              <span class="meta-item"><Icon name="calendar" size={12} /> {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            </div>
            <h2 class="project-title">{post.data.title}</h2>
            <div class="project-service">{post.data.serviceType}</div>
          </a>
        ))}

        {hvacWorkLogs.map((log) => (
          <a href={`/hvac-work/${log.slug}/`} class="project-card card">
            <div class="project-meta">
              <span class="meta-item"><Icon name="map-pin" size={12} /> {log.location}</span>
              <span class="meta-item"><Icon name="calendar" size={12} /> {new Date(log.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            </div>
            <h2 class="project-title">{log.title}</h2>
            <p class="project-desc">{log.summary}</p>
            <div class="project-service">{log.serviceType}</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header { position: relative; padding: var(--space-24) 0 var(--space-16); overflow: hidden; }
  .header-bg { position: absolute; inset: 0; background: radial-gradient(ellipse at center, rgba(6,182,212,0.1) 0%, transparent 70%), var(--color-navy); }
  .page-title { font-family: 'Poppins', sans-serif; font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800; color: #F8FAFC; margin: var(--space-4) 0; }
  .page-title span { background: linear-gradient(135deg, #06B6D4, #22D3EE); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .page-subtitle { font-size: var(--text-lg); color: var(--color-text-secondary); }
  .projects-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: var(--space-6); }
  .project-card { display: flex; flex-direction: column; padding: var(--space-6); text-decoration: none; transition: transform var(--transition-base), box-shadow var(--transition-base); }
  .project-card:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0,0,0,0.3), 0 0 0 1px rgba(6,182,212,0.3); }
  .project-meta { display: flex; align-items: center; gap: var(--space-4); margin-bottom: var(--space-3); flex-wrap: wrap; }
  .meta-item { display: flex; align-items: center; gap: 4px; font-size: 0.75rem; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; }
  .project-title { font-family: 'Poppins', sans-serif; font-size: var(--text-lg); font-weight: 700; color: #F8FAFC; margin: 0 0 var(--space-3); line-height: 1.35; }
  .project-desc { color: var(--color-text-secondary); font-size: var(--text-sm); line-height: 1.6; margin: 0 0 var(--space-4); flex-grow: 1; }
  .project-service { display: inline-block; padding: 4px 12px; background: rgba(245,158,11,0.1); color: #F59E0B; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 700; align-self: flex-start; margin-top: auto; }
</style>
