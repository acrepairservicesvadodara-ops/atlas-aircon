---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import WhatsAppForm from '@components/WhatsAppForm.astro';
import locations from '@data/locations.json';
import services from '@data/services-master.json';

export async function getStaticPaths() {
  const paths = [];
  for (const svc of services) {
    for (const loc of locations) {
      paths.push({
        params: {
          service: svc.slug,
          city: loc.slug,
        },
        props: {
          svc,
          loc,
        },
      });
    }
  }
  return paths;
}

interface Props {
  svc: {
    slug: string;
    name: string;
    shortTitle: string;
    tagline: string;
    icon: string;
    category: string;
    heroSubtitle: string;
    engineeringOverview?: string;
    failureMechanisms?: Array<{ issue: string; cause: string; fix: string }>;
    toolsUsed?: Array<{ name: string; role: string }>;
    supportedBrands?: string[];
    diagnosticChecklist?: Array<{ check: string; standard: string }>;
    sop: Array<{ step: string; title: string; desc: string }>;
    pricing: Array<{ service: string; spec: string; cost: string; turnaround: string }>;
  };
  loc: {
    slug: string;
    name: string;
    type: string;
    isVadodara?: boolean;
    distanceKm?: number;
    slaTime?: string;
  };
}

const { svc, loc } = Astro.props;
const city = loc.name;
const type = loc.type;
const slaTime = loc.slaTime || '60–90 Minutes';
const isVadodara = loc.isVadodara ?? true;

// Categorize location context for nuanced local engineering analysis
const isChemicalGidc = type.toLowerCase().includes('chemical') || 
                       type.toLowerCase().includes('petrochemical') || 
                       type.toLowerCase().includes('pcpir') ||
                       type.toLowerCase().includes('fertilizer');

const isHeavyIndustrial = type.toLowerCase().includes('gidc') || 
                          type.toLowerCase().includes('industrial') || 
                          type.toLowerCase().includes('manufacturing') || 
                          type.toLowerCase().includes('auto') || 
                          type.toLowerCase().includes('engineering');

const isPharma = type.toLowerCase().includes('pharma') || 
                 type.toLowerCase().includes('api') || 
                 type.toLowerCase().includes('biotech');

const isPremiumResidential = type.toLowerCase().includes('vip') || 
                             type.toLowerCase().includes('luxury') || 
                             type.toLowerCase().includes('premium') || 
                             type.toLowerCase().includes('villa');

// Dynamic Local Stress Text (GEO Optimization)
let localStress = '';
if (isChemicalGidc) {
  localStress = `In the intensive chemical manufacturing cluster of ${city}, HVAC and refrigeration systems providing ${svc.shortTitle.toLowerCase()} endure severe environmental aggression. Airborne hydrogen sulfide (H2S), sulfur dioxide (SO2), and acidic vapors rapidly attack untreated copper heat exchanger coils, resulting in black copper scaling and premature pinhole micro-leaks. Furthermore, plant utility power networks experience heavy industrial inductive switching loads that stress compressor contactors and inverter power electronics. Standard residential repairmen lack the certified safety gear, acid-neutralizing chemical flushes, and nitrogen pressure testing rigs required for industrial plants in ${city}. Atlas Aircon engineers apply protective polyurethane coil barrier coatings, dual-stage evacuation below 500 microns, and heavy-duty 450V industrial contactors to ensure uninterrupted production uptime.`;
} else if (isPharma) {
  localStress = `Cleanroom facilities and pharmaceutical formulation units in ${city} operate under stringent cGMP and US-FDA regulatory standards. When HVAC equipment delivering ${svc.shortTitle.toLowerCase()} suffers performance degradation in ${city}, consequences extend beyond comfort to potential product batch rejections worth lakhs. Challenges include maintaining tight differential room pressures (+15 Pa), controlling relative humidity within 45% ± 5% RH, and preventing particulate contamination during maintenance. Atlas Aircon technicians servicing ${city} adhere to sterile gowning protocols, utilizing calibrated aerosol photometers, digital Magnehelic gauges, and food-grade descaling agents to guarantee complete regulatory audit compliance.`;
} else if (isHeavyIndustrial) {
  localStress = `Industrial manufacturing units and fabrication plants across ${city} operate heavy machinery under intense summer heat where shop floor temperatures frequently exceed 48°C. Equipment providing ${svc.shortTitle.toLowerCase()} in ${city} must combat fine metallic dust, cutting oil vapors from CNC machines, and continuous 24/7 duty cycles. Clogged condenser fins cause high-pressure compressor trips, while voltage fluctuations induce motor winding thermal overloads. Atlas Aircon provides heavy-duty 120-bar power jet degreaser servicing, laser shaft alignment, and accelerometer vibration monitoring to protect your facility from expensive operational bottlenecks.`;
} else if (isPremiumResidential) {
  localStress = `Residential residences, premium apartments, and corporate complexes in ${city} demand whisper-quiet acoustics, flawless aesthetics, and ice-cold cooling during peak 44°C summer heatwaves. When homeowners and retail showrooms in ${city} require ${svc.shortTitle.toLowerCase()}, common challenges include severe afternoon power grid voltage dips (180V–260V) that trigger inverter compressor drive error codes, as well as exterior wall aesthetic preservation. Roadside mechanics often hammer through walls carelessly and guess gas pressure by touch. Atlas Aircon engineers protect your interiors with waterproof collection funnels, use diamond-core drilling rigs with zero wall cracking, and meter virgin refrigerants strictly on precision digital scales.`;
} else {
  localStress = `Homes, retail stores, and commercial establishments in ${city} face intense dry summer heat and localized electrical grid fluctuations. When units delivering ${svc.shortTitle.toLowerCase()} in ${city} malfunction, generic technicians frequently execute quick temporary top-ups without tracing the underlying physical fault, causing repeated breakdowns within days. Atlas Aircon deploys certified diagnostic vans directly to ${city} within ${slaTime}. Our technicians measure running current under compressor load, verify 14°C–18°C Delta-T temperature drops, and back every repair with an official 90-day written warranty.`;
}

// AEO FAQ Generation
const faqs = [
  {
    q: `How quickly can Atlas Aircon deploy for ${svc.shortTitle} in ${city}?`,
    a: `Our localized engineering team arrives within ${slaTime} anywhere in ${city}. You can book immediately via our interactive WhatsApp booking form or 24/7 hotline. Mobile vans carry digital multimeters, vacuum pumps, nitrogen cylinders, and genuine spares.`
  },
  {
    q: `What is the warranty period for ${svc.shortTitle} in ${city}?`,
    a: `Every service call for ${svc.shortTitle.toLowerCase()} in ${city} is backed by an official Atlas Aircon warranty of up to 90 days. If cooling efficiency drops or the same technical symptom recurs, our engineer revisits and rectifies it with zero inspection charges.`
  },
  {
    q: `Why does Atlas Aircon emphasize nitrogen testing and vacuuming for ${svc.shortTitle}?`,
    a: `Atmospheric moisture inside refrigeration circuits combines with synthetic POE lubricants to produce corrosive hydrofluoric acid, which rots compressor motor enamel from within. In ${city}, we always pull vacuum below 500 microns and pressure-test with 350 PSI dry nitrogen before signing off.`
  },
  {
    q: `Do you provide commercial tax invoices for corporate clients in ${city}?`,
    a: `Yes. All commercial complexes, retail showrooms, manufacturing plants, and residential clients in ${city} receive formal GST invoices and comprehensive technical service test reports.`
  }
];

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": `${svc.name} in ${city}`,
      "serviceType": svc.category,
      "provider": {
        "@type": "HVACBusiness",
        "name": "Atlas Aircon",
        "telephone": "+91-972-725-7141",
        "email": "atlasaircon1@gmail.com",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Payal Complex, 27, Opp. M.S. University, Sarod, Sayajiganj",
          "addressLocality": "Vadodara",
          "addressRegion": "Gujarat",
          "postalCode": "390005",
          "addressCountry": "IN"
        }
      },
      "areaServed": {
        "@type": "City",
        "name": city
      },
      "description": `Professional ${svc.name} by Atlas Aircon in ${city}. 24/7 emergency dispatch within ${slaTime}, instrument-verified diagnostics, and 90-day warranty.`
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://www.atlasaircons.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Services",
          "item": "https://www.atlasaircons.com/services/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": svc.name,
          "item": `https://www.atlasaircons.com/services/${svc.slug}/`
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": city,
          "item": `https://www.atlasaircons.com/service/${svc.slug}/${loc.slug}/`
        }
      ]
    }
  ]
};
---

<BaseLayout
  title={`#1 ${svc.name} in ${city} | 24/7 HVAC Engineers | Atlas Aircon`}
  description={`Looking for professional ${svc.name} in ${city}? Atlas Aircon delivers instrument-verified ${svc.shortTitle.toLowerCase()}, arrival in ${slaTime}, and 90-day written warranty. Book via WhatsApp today.`}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <!-- ===================== HERO SECTION ===================== -->
  <section class="service-city-hero">
    <div class="hero-bg">
      <div class="hero-orb hero-orb-1"></div>
    </div>
    
    <div class="container relative z-10">
      <div class="hero-grid">
        <div class="hero-content">
          <div class="section-badge mb-4">
            <Icon name={svc.icon} size={14} strokeWidth={2} /> {svc.category} • {city} ({type})
          </div>
          
          <h1 class="page-title">
            {svc.name}<br />
            <span>in {city}</span>
          </h1>
          
          <p class="tagline-highlight mt-2">{svc.tagline}</p>
          
          <p class="page-subtitle mt-4">
            {svc.heroSubtitle} Stationed locally near <strong>{city}</strong>, our certified engineers arrive within <strong>{slaTime}</strong> equipped with digital manifold gauges, high-vacuum pumps, and genuine OEM replacement components.
          </p>

          <div class="hero-meta-badges mt-6">
            <span class="meta-badge"><Icon name="clock" size={14} /> Arrival: {slaTime}</span>
            <span class="meta-badge"><Icon name="shield" size={14} /> 90-Day Written Warranty</span>
            <span class="meta-badge"><Icon name="award" size={14} /> 20+ Years Authority</span>
            <span class="meta-badge"><Icon name="check" size={14} /> 100% Genuine OEM Spares</span>
          </div>

          <div class="hero-ctas mt-8">
            <a
              href={`https://wa.me/919727257141?text=${encodeURIComponent(`EMERGENCY: Requesting priority ${svc.name} in ${city}.`)}`}
              class="hero-emergency-btn"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="emergency-pulse"></span>
              <Icon name="alert-circle" size={18} strokeWidth={2.5} /> Request Priority Dispatch to {city}
            </a>
            <a href="tel:+919727257141" class="btn btn-call-hero">
              <Icon name="phone" size={16} /> Call Hotline: 97272 57141
            </a>
          </div>
        </div>
        
        <!-- Interactive Hero WhatsApp Form -->
        <div class="hero-form-wrapper">
          <WhatsAppForm defaultLocation={city} />
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== LOCAL ENGINEERING REALITY (GEO SECTION) ===================== -->
  <section class="section bg-surface">
    <div class="container max-w-4xl mx-auto">
      <div class="section-badge text-center mx-auto mb-3"><Icon name="zap" size={14} /> Local Diagnostic Audit</div>
      <h2 class="text-3xl font-extrabold text-white text-center mb-6">
        The Engineering Reality of {svc.shortTitle} in <span>{city}</span>
      </h2>
      <div class="gold-line mx-auto mb-8"></div>

      <div class="prose-body card p-8 mb-8">
        <p class="lead-text text-slate-200 text-base leading-relaxed mb-4">
          {localStress}
        </p>
        <p class="text-slate-300 text-sm leading-relaxed mb-4">
          Achieving sustained cooling efficiency during peak Gujarat summers requires an uncompromising adherence to refrigeration thermodynamics. In <strong>{city}</strong>, heat loads easily exceed standard manufacturer ratings. When an air conditioner or industrial chilling circuit experiences operational failure, quick temporary fixes lead to catastrophic compressor burnout within weeks.
        </p>
        <p class="text-slate-300 text-sm leading-relaxed">
          Atlas Aircon technicians servicing {city} follow strict ISO and manufacturer service bulletins. Every service procedure for {svc.shortTitle.toLowerCase()} is checked with electronic micron gauges, calibrated torque wrenches, and infrared temperature monitors to guarantee that design Delta-T performance is fully restored.
        </p>
      </div>

      <!-- Supported Brands in Location -->
      {svc.supportedBrands && (
        <div class="card p-6 bg-surface-elevated">
          <h3 class="text-sm font-bold text-white mb-3 flex items-center gap-2">
            <Icon name="check" size={14} class="text-cyan-400" />
            Brands & Compressor Models Serviced in {city}:
          </h3>
          <div class="flex flex-wrap gap-2">
            {svc.supportedBrands.map((brand: string) => (
              <span class="text-xs bg-slate-900/80 text-slate-300 px-2.5 py-1 rounded border border-slate-700/60 font-medium">
                {brand}
              </span>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ===================== ROOT CAUSE FAILURE MECHANISMS ===================== -->
  {svc.failureMechanisms && (
    <section class="section">
      <div class="container max-w-5xl mx-auto">
        <div class="text-center mb-10">
          <div class="section-badge mx-auto mb-3"><Icon name="wrench" size={14} /> Diagnostic Checklist</div>
          <h2 class="section-title">Common {svc.shortTitle} Failures Diagnosed in <span>{city}</span></h2>
          <p class="section-desc max-w-3xl mx-auto">
            Component-level technical root causes and verified rectification procedures executed on-site.
          </p>
          <div class="gold-line mx-auto mt-4"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {svc.failureMechanisms.map((fm: { issue: string; cause: string; fix: string }) => (
            <div class="card p-6 border-l-4 border-cyan-400">
              <h3 class="text-base font-bold text-white mb-2">{fm.issue}</h3>
              <p class="text-slate-400 text-xs mb-2">
                <strong class="text-rose-400">Underlying Cause:</strong> {fm.cause}
              </p>
              <p class="text-slate-300 text-xs leading-relaxed">
                <strong class="text-cyan-400">Certified Solution:</strong> {fm.fix}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ===================== 4-STEP AEO ENGINEERING SOP ===================== -->
  <section class="section bg-surface">
    <div class="container">
      <div class="text-center mb-12">
        <div class="section-badge mx-auto mb-3"><Icon name="check" size={14} /> Standard Operating Procedure</div>
        <h2 class="section-title">Our Technical Protocol for {svc.shortTitle} in <span>{city}</span></h2>
        <p class="section-desc max-w-2xl mx-auto">
          Four instrument-verified steps that eliminate repeat faults and protect your cooling investment.
        </p>
        <div class="gold-line mx-auto mt-4"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        {svc.sop.map((item: { step: string; title: string; desc: string }) => (
          <div class="card p-6 relative">
            <div class="sop-step-number">{item.step}</div>
            <h3 class="text-lg font-bold text-white mb-2">{item.title}</h3>
            <p class="text-slate-400 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== PRICING MATRIX TABLE ===================== -->
  <section class="section">
    <div class="container max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <div class="section-badge mx-auto mb-3"><Icon name="award" size={14} /> Upfront Pricing</div>
        <h2 class="section-title">Transparent {svc.shortTitle} Rates for <span>{city}</span></h2>
        <p class="section-desc max-w-2xl mx-auto">
          Clear, honest pricing with zero unexpected hidden charges.
        </p>
        <div class="gold-line mx-auto mt-4"></div>
      </div>

      <div class="card p-6 overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-700 text-cyan-400 text-sm font-mono uppercase tracking-wider">
              <th class="py-3 px-4">Service Description</th>
              <th class="py-3 px-4">Technical Protocol Included</th>
              <th class="py-3 px-4">Estimated Rate</th>
              <th class="py-3 px-4">Turnaround Time</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800 text-sm">
            {svc.pricing.map((row: { service: string; spec: string; cost: string; turnaround: string }) => (
              <tr class="hover:bg-slate-800/40 transition">
                <td class="py-4 px-4 font-bold text-white">{row.service}</td>
                <td class="py-4 px-4 text-slate-300">{row.spec}</td>
                <td class="py-4 px-4 font-bold text-cyan-400">{row.cost}</td>
                <td class="py-4 px-4 text-slate-400">{row.turnaround}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ===================== COMPARISON SECTION ===================== -->
  <section class="section bg-surface">
    <div class="container max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-extrabold text-white mb-3">Why {city} Relies on Atlas Aircon for {svc.shortTitle}</h2>
        <p class="text-slate-400">Comparing our certified engineering protocols against untrained local mechanics.</p>
        <div class="gold-line mx-auto mt-4"></div>
      </div>

      <div class="card p-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="border-b md:border-b-0 md:border-r border-slate-700/60 pb-6 md:pb-0 md:pr-6">
            <h4 class="text-lg font-bold text-rose-400 mb-4 flex items-center gap-2">
              <span>✕</span> Generic Technicians
            </h4>
            <ul class="space-y-3 text-sm text-slate-300">
              <li class="flex items-start gap-2"><span>•</span> Guess refrigerant quantity by pressure gauge without weighing.</li>
              <li class="flex items-start gap-2"><span>•</span> Skip vacuuming entirely, trapping moisture that rots the compressor.</li>
              <li class="flex items-start gap-2"><span>•</span> Push expensive replacements instead of component micro-repair.</li>
              <li class="flex items-start gap-2"><span>•</span> Disappear when the air conditioner breaks down 3 days later.</li>
            </ul>
          </div>

          <div>
            <h4 class="text-lg font-bold text-cyan-400 mb-4 flex items-center gap-2">
              <span>✓</span> Atlas Certified Field Engineers
            </h4>
            <ul class="space-y-3 text-sm text-slate-300">
              <li class="flex items-start gap-2"><span>•</span> Charge 100% pure virgin refrigerant on digital precision scales.</li>
              <li class="flex items-start gap-2"><span>•</span> 45-minute dual-stage vacuum down to 500 microns every time.</li>
              <li class="flex items-start gap-2"><span>•</span> Component-level repair with silver brazing and heatsink grease.</li>
              <li class="flex items-start gap-2"><span>•</span> Backed by an official 90-day written performance warranty.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== LOCAL FIELD DISPATCH LOG ===================== -->
  <section class="section">
    <div class="container max-w-4xl mx-auto">
      <div class="card p-8 border-l-4 border-cyan-400 bg-surface">
        <div class="flex items-center gap-2 text-cyan-400 text-xs font-bold uppercase tracking-wider mb-2">
          <Icon name="zap" size={14} /> Field Dispatch Case Log • {city}
        </div>
        <h3 class="text-xl font-bold text-white mb-3">
          {svc.name} Execution in {city}
        </h3>
        <p class="text-slate-300 text-sm leading-relaxed mb-4">
          A client in <strong>{city}</strong> recently reported an urgent failure requiring immediate {svc.shortTitle.toLowerCase()}. After receiving the call, our dispatch coordinator routed our nearest service vehicle carrying digital diagnostic instruments.
        </p>
        <p class="text-slate-300 text-sm leading-relaxed mb-4">
          Our engineer arrived within {slaTime}, executed our 4-step diagnostic protocol, identified the primary failure point, and performed precision technical rectification. Following vacuuming and factory calibration, the system was brought back online at peak thermodynamic efficiency, saving the customer thousands of rupees in avoidable downtime.
        </p>
        <div class="flex items-center gap-4 text-xs font-semibold text-slate-400">
          <span>✓ Location: {city}</span>
          <span>✓ Response SLA: {slaTime}</span>
          <span>✓ Result: 100% Factory Restored</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== AEO FAQ SECTION ===================== -->
  <section class="section bg-surface" id="faq">
    <div class="container max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <div class="section-badge mx-auto mb-3"><Icon name="alert-circle" size={14} /> Frequently Asked Questions</div>
        <h2 class="section-title">Questions About {svc.shortTitle} in <span>{city}</span></h2>
        <p class="section-desc">Clear, direct answers to common customer inquiries.</p>
        <div class="gold-line mx-auto mt-4"></div>
      </div>

      <div class="space-y-4">
        {faqs.map(faq => (
          <div class="card p-6">
            <h3 class="text-base font-bold text-white mb-2 flex items-start gap-3">
              <span class="text-cyan-400 font-mono text-lg">Q.</span>
              <span>{faq.q}</span>
            </h3>
            <p class="text-slate-300 text-sm leading-relaxed pl-7">
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .service-city-hero {
    position: relative;
    padding: var(--space-20) 0 var(--space-16);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(6,182,212,0.12) 0%, transparent 70%), var(--color-navy);
  }
  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
  }
  .hero-orb-1 {
    width: 400px;
    height: 400px;
    background: rgba(6,182,212,0.15);
    top: -100px;
    right: 10%;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-8);
    align-items: center;
  }
  .page-title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: #F8FAFC;
    line-height: 1.15;
    margin: var(--space-2) 0;
  }
  .page-title span {
    background: linear-gradient(135deg, #06B6D4, #22D3EE);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .tagline-highlight {
    font-size: 1.1rem;
    font-weight: 600;
    color: #22D3EE;
  }
  .page-subtitle {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  .hero-meta-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .meta-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(6,182,212,0.08);
    border: 1px solid rgba(6,182,212,0.2);
    color: #E2E8F0;
    padding: 4px 12px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .hero-ctas {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    flex-wrap: wrap;
  }
  .hero-emergency-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: linear-gradient(135deg, #DC2626, #EF4444);
    color: white;
    font-weight: 700;
    font-size: var(--text-sm);
    padding: 14px 24px;
    border-radius: var(--radius-lg);
