---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';

const products = [
  {
    name: 'Daikin Original Inverter PCB',
    category: 'Circuit Boards',
    price: 'Call for Price',
    status: 'In Stock',
    icon: 'circuit'
  },
  {
    name: 'R32 Refrigerant Cylinder (10kg)',
    category: 'Chemicals',
    price: 'Call for Price',
    status: 'In Stock',
    icon: 'droplet'
  },
  {
    name: 'O General Universal Remote',
    category: 'Accessories',
    price: '₹850',
    status: 'In Stock',
    icon: 'smartphone'
  },
  {
    name: 'Heavy Duty Vacuum Pump',
    category: 'Tools',
    price: 'Call for Price',
    status: 'Special Order',
    icon: 'zap'
  },
  {
    name: '1.5 Ton Rotary Compressor',
    category: 'Core Components',
    price: 'Call for Price',
    status: 'In Stock',
    icon: 'settings'
  },
  {
    name: 'Copper Piping Roll (15 meters)',
    category: 'Installation',
    price: 'Call for Price',
    status: 'In Stock',
    icon: 'disc'
  }
];
---

<BaseLayout
  title="Atlas Aircon Shop | Genuine Spares"
  description="Purchase genuine OEM AC spare parts, PCBs, remote controls, and accessories directly from Atlas Aircon."
>
  <section class="page-header">
    <div class="header-bg"></div>
    <div class="container relative z-10 text-center">
      <div class="section-badge"><Icon name="shopping-cart" size={14} strokeWidth={2} /> Genuine Spares</div>
      <h1 class="page-title">Parts <span>Shop</span></h1>
      <p class="page-subtitle">OEM components and accessories for all major brands.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="shop-grid">
        {products.map((product) => (
          <div class="product-card card">
            <div class="product-img-placeholder">
              <Icon name={product.icon} size={48} strokeWidth={1} />
            </div>
            <div class="product-info">
              <div class="product-meta">
                <span class="product-category">{product.category}</span>
                <span class={`product-status ${product.status === 'In Stock' ? 'status-green' : 'status-amber'}`}>
                  {product.status}
                </span>
              </div>
              <h3 class="product-name">{product.name}</h3>
              <div class="product-footer">
                <span class="product-price">{product.price}</span>
                <a href="tel:+919727257141" class="btn btn-primary btn-sm">Enquire</a>
              </div>
            </div>
          </div>
        ))}
      </div>
      
      <div class="cta-banner mt-16 text-center p-8 rounded-xl">
        <h2 class="text-xl font-bold text-white mb-2">Need a specific PCB or Compressor?</h2>
        <p class="text-slate-400 mb-6">We source authentic parts directly from Daikin, Voltas, O General, and Blue Star.</p>
        <a href="https://wa.me/919727257141" class="btn btn-whatsapp" target="_blank" rel="noopener">
          <Icon name="whatsapp" size={16} /> WhatsApp Parts Inquiry
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    position: relative;
    padding: var(--space-24) 0 var(--space-16);
    overflow: hidden;
  }
  .header-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(6,182,212,0.1) 0%, transparent 70%), var(--color-navy);
  }
  .page-title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    color: #F8FAFC;
    margin: var(--space-4) 0;
  }
  .page-title span {
    background: linear-gradient(135deg, #06B6D4, #22D3EE);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }
  
  .shop-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-6);
  }
  
  .product-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
  }
  
  .product-img-placeholder {
    height: 200px;
    background: rgba(15,30,53,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(6,182,212,0.3);
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }
  
  .product-info {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  
  .product-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }
  
  .product-category {
    font-size: 0.75rem;
    font-weight: 600;
    color: #94A3B8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .product-status {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }
  
  .status-green {
    background: rgba(34,197,94,0.15);
    color: #4ADE80;
  }
  
  .status-amber {
    background: rgba(245,158,11,0.15);
    color: #FBBF24;
  }
  
  .product-name {
    font-family: 'Poppins', sans-serif;
    font-size: var(--text-lg);
    font-weight: 700;
    color: #F8FAFC;
    margin: 0 0 var(--space-4);
    line-height: 1.3;
  }
  
  .product-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid rgba(255,255,255,0.05);
  }
  
  .product-price {
    font-family: 'Poppins', sans-serif;
    font-weight: 700;
    color: #06B6D4;
    font-size: 1.1rem;
  }
  
  .cta-banner {
    background: rgba(6,182,212,0.05);
    border: 1px solid rgba(6,182,212,0.1);
  }
  
  .mt-16 { margin-top: var(--space-16); }
  .p-8 { padding: var(--space-8); }
  .rounded-xl { border-radius: var(--radius-xl); }
  .text-xl { font-size: var(--text-xl); }
  .font-bold { font-weight: 700; }
  .text-white { color: #F8FAFC; }
  .mb-2 { margin-bottom: var(--space-2); }
  .mb-6 { margin-bottom: var(--space-6); }
  .text-slate-400 { color: #94A3B8; }
</style>
