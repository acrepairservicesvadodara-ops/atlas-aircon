---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
---

<BaseLayout
  title="Contact Us | Atlas Aircon Vadodara"
  description="Contact Atlas Aircon for emergency AC repairs, installations, and industrial HVAC maintenance in Vadodara. Available 24/7."
>
  <!-- Page Header -->
  <section class="page-header">
    <div class="header-bg"></div>
    <div class="container relative z-10 text-center">
      <div class="section-badge"><Icon name="phone" size={14} strokeWidth={2} /> Contact Us</div>
      <h1 class="page-title">We Are <span>Ready to Deploy</span></h1>
      <p class="page-subtitle">24/7 emergency dispatch for Vadodara & surrounding GIDC zones.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        
        <!-- Contact Information -->
        <div class="contact-info">
          <h2>Direct Contact</h2>
          <div class="gold-line mb-8"></div>
          
          <div class="info-card card mb-6">
            <div class="info-icon"><Icon name="map-pin" size={24} /></div>
            <div>
              <h3>Headquarters</h3>
              <p>Payal Complex, 27, Opp. M.S. University,<br/>Sarod, Sayajiganj, Vadodara — 390005</p>
            </div>
          </div>

          <div class="info-card card mb-6">
            <div class="info-icon"><Icon name="phone" size={24} /></div>
            <div>
              <h3>24/7 Emergency Hotline</h3>
              <p><a href="tel:+919727257141" class="text-gold font-bold text-xl">+91 97272 57141</a></p>
            </div>
          </div>

          <div class="info-card card mb-6">
            <div class="info-icon"><Icon name="mail" size={24} /></div>
            <div>
              <h3>Email Inquiries</h3>
              <p><a href="mailto:atlasaircon1@gmail.com" class="hover:text-gold transition">atlasaircon1@gmail.com</a></p>
            </div>
          </div>

          <div class="info-card card">
            <div class="info-icon"><Icon name="clock" size={24} /></div>
            <div>
              <h3>Operating Hours</h3>
              <p>24 Hours / 7 Days a week.<br/>365 Days a Year.</p>
            </div>
          </div>
        </div>

        <!-- Booking Form -->
        <div class="booking-col">
          <div class="booking-form-card">
            <div class="form-header">
              <div class="form-header-icon"><Icon name="zap" size={28} /></div>
              <div>
                <h2 class="form-title">Priority Service Request</h2>
                <p class="form-subtitle">Skip the queue. Book directly via WhatsApp.</p>
              </div>
            </div>

            <form class="booking-form" id="contactBookingForm" novalidate>
              <div class="form-group">
                <label for="name">Your Name <span class="req">*</span></label>
                <input type="text" id="name" name="name" placeholder="Enter your name" required />
              </div>

              <div class="form-group">
                <label for="phone">Phone Number <span class="req">*</span></label>
                <div class="phone-input-wrap">
                  <span class="phone-prefix">+91</span>
                  <input type="tel" id="phone" name="phone" placeholder="10 digit number" maxlength="10" pattern="[6-9][0-9]{9}" required />
                </div>
              </div>

              <div class="form-group">
                <label for="service">Service Required <span class="req">*</span></label>
                <div class="select-wrap">
                  <select id="service" name="service" required>
                    <option value="" disabled selected>Select Service</option>
                    <option>Emergency AC Repair</option>
                    <option>Standard Maintenance</option>
                    <option>New Installation</option>
                    <option>Industrial/VRF System</option>
                  </select>
                  <span class="select-arrow"><Icon name="chevron-down" size={16} /></span>
                </div>
              </div>

              <div class="form-group">
                <label for="address">Full Address <span class="req">*</span></label>
                <textarea id="address" name="address" rows="3" placeholder="Enter your complete address..." required></textarea>
              </div>

              <button type="submit" class="form-submit-btn" id="contactSubmitBtn">
                <Icon name="whatsapp" size={20} /> Request Dispatch
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-header {
    position: relative;
    padding: var(--space-24) 0 var(--space-16);
    overflow: hidden;
  }

  .header-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(6,182,212,0.1) 0%, transparent 70%), var(--color-navy);
  }

  .page-title {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    color: #F8FAFC;
    margin: var(--space-4) 0;
  }

  .page-title span {
    background: linear-gradient(135deg, #06B6D4, #22D3EE);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
  }

  .contact-info h2 {
    font-family: 'Poppins', sans-serif;
    font-size: var(--text-3xl);
    font-weight: 700;
    margin-bottom: var(--space-4);
  }

  .info-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5);
  }

  .info-icon {
    width: 48px;
    height: 48px;
    background: rgba(6,182,212,0.1);
    color: #06B6D4;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .info-card h3 {
    font-size: var(--text-lg);
    color: #F8FAFC;
    margin: 0 0 var(--space-1);
  }

  .info-card p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0;
  }

  .info-card a {
    text-decoration: none;
    color: inherit;
  }

  .text-gold { color: #06B6D4; }
  .font-bold { font-weight: 700; }
  .text-xl { font-size: var(--text-xl); }
  .mb-6 { margin-bottom: var(--space-6); }
  .mb-8 { margin-bottom: var(--space-8); }
  .transition { transition: color var(--transition-fast); }
  .hover\:text-gold:hover { color: #06B6D4; }

  /* Booking Form Card (Copied styles from index.astro for consistency) */
  .booking-form-card {
    width: 100%;
    background: rgba(11, 22, 40, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(6,182,212,0.2);
    border-radius: 20px;
    padding: var(--space-8);
    box-shadow: 0 24px 60px rgba(0,0,0,0.4), 0 0 0 1px rgba(6,182,212,0.08);
  }

  .form-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid rgba(6,182,212,0.15);
  }

  .form-header-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(6,182,212,0.12);
    color: #06B6D4;
    border: 1px solid rgba(6,182,212,0.25);
    border-radius: var(--radius-lg);
    flex-shrink: 0;
  }

  .form-title {
    font-family: 'Poppins', sans-serif;
    font-size: var(--text-lg);
    font-weight: 700;
    color: #F8FAFC;
    margin: 0 0 2px;
  }

  .form-subtitle {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
  }

  .booking-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: #94A3B8;
  }

  .req { color: #EF4444; margin-left: 2px; }

  .form-group input,
  .form-group select,
  .form-group textarea {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--radius-md);
    color: #F8FAFC;
    font-family: 'Poppins', sans-serif;
    font-size: var(--text-sm);
    padding: var(--space-3) var(--space-4);
    transition: all var(--transition-fast);
    width: 100%;
    outline: none;
  }

  .form-group textarea { resize: none; }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: rgba(6,182,212,0.5);
    box-shadow: 0 0 0 3px rgba(6,182,212,0.1);
    background: rgba(6,182,212,0.04);
  }

  .phone-input-wrap {
    display: flex;
    align-items: center;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .phone-input-wrap:focus-within {
    border-color: rgba(6,182,212,0.5);
    box-shadow: 0 0 0 3px rgba(6,182,212,0.1);
  }

  .phone-prefix {
    padding: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: #06B6D4;
    background: rgba(6,182,212,0.08);
    border-right: 1px solid rgba(255,255,255,0.08);
  }

  .phone-input-wrap input {
    border: none;
    background: transparent;
  }

  .phone-input-wrap input:focus { box-shadow: none; }

  .select-wrap { position: relative; }
  .select-arrow {
    position: absolute;
    right: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
    color: #06B6D4;
    pointer-events: none;
  }

  .select-wrap select { padding-right: var(--space-10); appearance: none; }
  .select-wrap select option { background: #0F1E35; color: #F8FAFC; }

  .form-submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background: linear-gradient(135deg, #25D366, #128C7E);
    color: #fff;
    font-family: 'Poppins', sans-serif;
    font-size: var(--text-sm);
    font-weight: 700;
    border: none;
    border-radius: var(--radius-full);
    padding: var(--space-4) var(--space-6);
    cursor: pointer;
    width: 100%;
    transition: all var(--transition-base);
    box-shadow: 0 4px 24px rgba(37,211,102,0.35);
    margin-top: var(--space-2);
  }

  .form-submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(37,211,102,0.5);
  }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; }
    .booking-form-card { padding: var(--space-5); }
  }
</style>

<script>
  const form = document.getElementById('contactBookingForm') as HTMLFormElement | null;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const name = (document.getElementById('name') as HTMLInputElement)?.value.trim();
    const phone = (document.getElementById('phone') as HTMLInputElement)?.value.trim();
    const service = (document.getElementById('service') as HTMLSelectElement)?.value;
    const address = (document.getElementById('address') as HTMLTextAreaElement)?.value.trim();

    if (!name || !phone || !service || !address) {
      alert("Please fill in all fields.");
      return;
    }

    if (!/^[6-9][0-9]{9}$/.test(phone)) {
      alert("Please enter a valid 10-digit Indian mobile number.");
      return;
    }

    const lines = [
      `🚨 *PRIORITY SERVICE REQUEST*`,
      ``,
      `👤 *Name:* ${name}`,
      `📞 *Phone:* +91 ${phone}`,
      `🔧 *Service:* ${service}`,
      `📍 *Address:* ${address}`,
      ``,
      `Please dispatch an engineer ASAP.`
    ];

    const message = encodeURIComponent(lines.join('\n'));
    const waUrl = `https://wa.me/919727257141?text=${message}`;
    window.open(waUrl, '_blank', 'noopener,noreferrer');
  });
</script>
