---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import WhatsAppForm from '@components/WhatsAppForm.astro';
import hvacWorkLogs from '@data/hvac-work-logs.json';

export async function getStaticPaths() {
  return hvacWorkLogs.map((log, idx) => ({
    params: { slug: log.slug },
    props: {
      log,
      related: [
        hvacWorkLogs[(idx + 1) % hvacWorkLogs.length],
        hvacWorkLogs[(idx + 2) % hvacWorkLogs.length],
        hvacWorkLogs[(idx + 3) % hvacWorkLogs.length],
      ],
    },
  }));
}

const { log, related } = Astro.props;
const canonicalUrl = `https://www.atlasaircons.com/hvac-work/${log.slug}/`;

const schemaData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${canonicalUrl}#article`,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
      headline: log.title,
      description: log.summary,
      datePublished: `${log.date}T10:00:00+05:30`,
      dateModified: `${log.date}T10:00:00+05:30`,
      author: { '@type': 'Organization', name: 'Atlas Aircon', url: 'https://www.atlasaircons.com/' },
      publisher: { '@id': 'https://www.atlasaircons.com/#organization' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.atlasaircons.com/' },
        { '@type': 'ListItem', position: 2, name: 'Recent Projects', item: 'https://www.atlasaircons.com/recent-projects/' },
        { '@type': 'ListItem', position: 3, name: log.title, item: canonicalUrl },
      ],
    },
  ],
};
---

<BaseLayout title={`${log.title} | Atlas Aircon Field Log`} description={log.summary}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </Fragment>

  <section class="page-header">
    <div class="header-bg"></div>
    <div class="container relative z-10 hero-grid">
      <div>
        <nav aria-label="Breadcrumb" class="crumbs">
          <a href="/">Home</a> <span>/</span> <a href="/recent-projects/">Recent Projects</a> <span>/</span> <span>{log.location}</span>
        </nav>
        <div class="section-badge"><Icon name="map-pin" size={14} strokeWidth={2} /> {log.location} • {log.serviceType}</div>
        <h1 class="page-title">{log.title}</h1>
        <p class="hero-intro">{log.summary}</p>
      </div>
      <div>
        <WhatsAppForm />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container log-wrap">
      <article class="card log-card">
        <h2>1. On-Site Symptom & Failure Diagnosis</h2>
        <p>{log.problem} Upon arrival in <strong>{log.location}</strong>, our mobile engineering squad recorded baseline electrical amperage, voltage stability, manifold operating pressures, and airflow Delta-T before opening any enclosure or refrigeration joint.</p>

        <h2>2. Engineering Rectification Executed</h2>
        <p>{log.solution}</p>

        <h2>3. Commissioning & Quality Verification Checklist</h2>
        <ul>
          <li><strong>Electrical Load Test:</strong> Verified steady running current within factory nameplate RLA and &lt;2V neutral-to-earth potential.</li>
          <li><strong>Thermodynamic Output:</strong> Confirmed rapid pull-down and 14°C–18°C temperature differential across indoor supply air.</li>
          <li><strong>Leak & Moisture Integrity:</strong> Standing dry nitrogen pressure verification and two-stage micron evacuation where sealed circuits were serviced.</li>
          <li><strong>Warranty Issued:</strong> Official Atlas Aircon service report and 90-day workmanship guarantee handed over to the client in {log.location}.</li>
        </ul>

        <div class="cta-box">
          <h3>Need Similar {log.serviceType} Support in {log.location}?</h3>
          <p>Our 24/7 dispatch vans cover {log.location} and surrounding Vadodara & GIDC zones with genuine spares on board.</p>
          <div class="cta-row">
            <a href="tel:+919727257141" class="btn btn-primary"><Icon name="phone" size={16} /> Call +91 97272 57141</a>
            <a href="/recent-projects/" class="btn btn-outline">View All Engineering Logs</a>
          </div>
        </div>
      </article>

      <aside class="card side-card">
        <h2>More Completed Projects</h2>
        <ul class="rel-list">
          {related.map((r: { slug: string; title: string; location: string }) => (
            <li>
              <a href={`/hvac-work/${r.slug}/`}>
                <span class="rel-loc">{r.location}</span>
                <span>{r.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header { position: relative; padding: var(--space-16) 0 var(--space-12); overflow: hidden; }
  .header-bg { position: absolute; inset: 0; background: radial-gradient(ellipse at top left, rgba(6,182,212,0.14) 0%, transparent 65%), var(--color-navy); }
  .hero-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: var(--space-8); align-items: center; }
  .crumbs { font-size: var(--text-xs); color: var(--color-text-muted); margin-bottom: var(--space-3); display: flex; flex-wrap: wrap; gap: 6px; }
  .crumbs a { color: var(--color-gold); text-decoration: none; }
  .page-title { font-family: 'Poppins', sans-serif; font-size: clamp(1.9rem, 3.6vw, 2.8rem); font-weight: 800; color: #f8fafc; line-height: 1.2; margin: var(--space-3) 0; }
  .hero-intro { color: var(--color-text-secondary); line-height: 1.7; }
  .log-wrap { display: grid; grid-template-columns: 1fr 330px; gap: var(--space-8); align-items: start; }
  .log-card, .side-card { padding: var(--space-8); }
  .log-card h2, .side-card h2 { font-family: var(--font-heading); font-size: var(--text-xl); color: #f8fafc; margin: var(--space-6) 0 var(--space-3); }
  .log-card h2:first-child, .side-card h2:first-child { margin-top: 0; }
  .log-card p, .log-card li { color: var(--color-text-secondary); line-height: 1.8; }
  .log-card ul { padding-left: 1.25rem; display: grid; gap: var(--space-2); }
  .cta-box { margin-top: var(--space-8); padding: var(--space-6); border-radius: 10px; background: rgba(6,182,212,0.08); border: 1px solid rgba(6,182,212,0.25); }
  .cta-box h3 { color: #f8fafc; margin-bottom: var(--space-2); }
  .cta-row { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-4); }
  .rel-list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); }
  .rel-list a { display: flex; flex-direction: column; gap: 4px; padding: var(--space-3); border: 1px solid var(--color-border); border-radius: 8px; color: #f8fafc; text-decoration: none; font-size: var(--text-sm); }
  .rel-list a:hover { border-color: #06b6d4; color: #22d3ee; }
  .rel-loc { font-size: 0.7rem; text-transform: uppercase; color: #f59e0b; font-weight: 700; }
  @media (max-width: 960px) {
    .hero-grid, .log-wrap { grid-template-columns: 1fr; }
    .log-card, .side-card { padding: var(--space-5); }
  }
</style>

