</style>

<script>
  // ============ WhatsApp Booking Form ============
  const form = document.getElementById('bookingForm') as HTMLFormElement | null;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const name    = (document.getElementById('name') as HTMLInputElement)?.value.trim();
    const phone   = (document.getElementById('phone') as HTMLInputElement)?.value.trim();
    const service = (document.getElementById('service') as HTMLSelectElement)?.value;
    const area    = (document.getElementById('area') as HTMLInputElement)?.value.trim();
    const problem = (document.getElementById('problem') as HTMLTextAreaElement)?.value.trim();

    // Basic validation
    if (!name || !phone || !service || !area) {
      // Shake the button
      const btn = document.getElementById('formSubmitBtn');
      btn?.classList.add('shake');
      setTimeout(() => btn?.classList.remove('shake'), 600);

      // Highlight empty fields
      [
        { id: 'name', val: name },
        { id: 'phone', val: phone },
        { id: 'service', val: service },
        { id: 'area', val: area },
      ].forEach(({ id, val }) => {
        const el = document.getElementById(id);
        if (!val) {
          el?.style.setProperty('border-color', 'rgba(239,68,68,0.6)');
          el?.style.setProperty('box-shadow', '0 0 0 3px rgba(239,68,68,0.12)');
          setTimeout(() => {
            el?.style.removeProperty('border-color');
            el?.style.removeProperty('box-shadow');
          }, 2500);
        }
      });
      return;
    }

    // Validate phone
    if (!/^[6-9][0-9]{9}$/.test(phone)) {
      const el = document.getElementById('phone');
      el?.style.setProperty('border-color', 'rgba(239,68,68,0.6)');
      setTimeout(() => el?.style.removeProperty('border-color'), 2500);
      return;
    }

    // Build WhatsApp message
    const lines = [
      `🛠️ *AC SERVICE BOOKING — Atlas Aircon*`,
      ``,
      `👤 *Name:* ${name}`,
      `📞 *Phone:* +91 ${phone}`,
      `🔧 *Service:* ${service}`,
      `📍 *Location:* ${area}`,
    ];

    if (problem) {
      lines.push(`📝 *Problem:* ${problem}`);
    }

    lines.push(``, `Please confirm my booking. Thank you!`);

    const message = encodeURIComponent(lines.join('\n'));
    const waUrl = `https://wa.me/919727257141?text=${message}`;

    // Open WhatsApp
    window.open(waUrl, '_blank', 'noopener,noreferrer');
  });

  // Input focus effects
  document.querySelectorAll('.form-group input, .form-group select, .form-group textarea').forEach(el => {
    el.addEventListener('input', () => {
      (el as HTMLElement).style.removeProperty('border-color');
      (el as HTMLElement).style.removeProperty('box-shadow');
    });
  });
</script>

<style is:global>
  /* Shake animation for form validation */
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    20%       { transform: translateX(-6px); }
    40%       { transform: translateX(6px); }
    60%       { transform: translateX(-4px); }
    80%       { transform: translateX(4px); }
  }
  .shake { animation: shake 0.5s ease; }
</style>

