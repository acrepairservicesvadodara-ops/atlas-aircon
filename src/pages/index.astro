---
// Homepage — Atlas Aircon
// Content sourced from atlasaircons.com
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import WhatsAppForm from '@components/WhatsAppForm.astro';

const services = [
  {
    icon: 'wrench',
    title: 'AC Repair & Power Jet Servicing',
    desc: '120-Bar Power Jet Descaling + non-corrosive alkaline chemicals restore factory-level heat exchange. On-site inverter PCB micro-soldering and IC chip replacement — no unnecessary board replacements.',
    points: ['Inverter PCB Component-Level Repair', 'Vacuum-Assisted Gas Charging by Weight', 'Compressor Seize Recovery & Replacement', 'Copper Coil Brazing & Leak Elimination'],
  },
  {
    icon: 'gear',
    title: 'Precision AC Installation & Shifting',
    desc: 'Diamond-core cutting for zero wall damage. Dry nitrogen pressure testing at 350 PSI on every pipeline before gas charge. Mathematical flaring, torque-wrench sealed joints.',
    points: ['Diamond Core Cutting (Zero Wall Damage)', 'Dry Nitrogen Pressure Testing at 350 PSI', 'Safe Gas Pump-Down & Equipment Shifting', 'Cassette, Tower & Ductable AC Mounting'],
  },
  {
    icon: 'factory',
    title: 'Heavy Industrial & Commercial HVAC',
    desc: 'Rapid-deployment for critical chiller plants and multi-zone VRF systems. Thermal imaging and vibration analysis for predictive maintenance. AMC protocols for GIDC industries.',
    points: ['Water-Cooled & Air-Cooled Chiller Overhaul', 'VRF / VRV System Digital Diagnostics', 'CNC Machine & Control Panel AC Repair', 'Corporate & Industrial AMC Contracts'],
  },
];

const cities = [
  { name: 'Vadodara', label: 'HQ & Operations', href: '/ac-repair-vadodara/' },
  { name: 'Ahmedabad', label: 'AC Repair & Service', href: '/ac-repair-ahmedabad/' },
  { name: 'Surat', label: 'AC Repair & Service', href: '/ac-repair-surat/' },
  { name: 'Anand', label: 'AC Repair & Service', href: '/ac-repair-anand/' },
  { name: 'Rajkot', label: 'AC Repair & Service', href: '/ac-repair-rajkot/' },
  { name: 'Bharuch', label: 'AC Repair & Service', href: '/ac-repair-bharuch/' },
  { name: 'Morbi', label: 'Industrial HVAC', href: '/ac-repair-morbi/' },
  { name: 'Kheda', label: 'AC Repair & Service', href: '/ac-repair-kheda/' },
  { name: 'Godhra', label: 'AC Repair & Service', href: '/ac-repair-godhra/' },
  { name: 'Daman', label: 'AC Repair & Service', href: '/ac-repair-daman/' },
  { name: 'Valsad', label: 'AC Repair & Service', href: '/ac-repair-valsad/' },
];

const faqs = [
  {
    q: 'Why is my AC running but not blowing cold air?',
    a: 'This points to three faults: (1) A blown start capacitor in the outdoor unit preventing the compressor from igniting. (2) A severe refrigerant gas leak — usually a rusted U-bend in the condenser coil. (3) A choked capillary tube or expansion valve. Do NOT keep running the AC as it can permanently seize the compressor.',
  },
  {
    q: 'What is the difference between R32, R410a, and R22 gas?',
    a: 'Refrigerants are not interchangeable. R22 (Freon) is being phased out — very expensive to refill. R410a requires charging in liquid state. R32 is the modern standard — highly efficient, low GWP, but operates at very high pressure and is mildly flammable. Our engineers charge R32 by exact weight per manufacturer spec.',
  },
  {
    q: 'Why does my Inverter AC PCB keep failing?',
    a: 'Inverter AC PCBs use sensitive microprocessors, IPM modules, and communication ICs. Gujarat\'s sudden voltage spikes fry these components. Company service centers force you to buy ₹8,000 replacement boards. Atlas Aircon diagnoses and repairs the burnt components on your existing board at a fraction of the cost.',
  },
  {
    q: 'Why is vacuuming necessary before gas charging?',
    a: 'This is the #1 difference between a professional engineer and a cheap local mechanic. Atmospheric air contains moisture that reacts with synthetic compressor oil to create hydrofluoric acid — literally eating your compressor from the inside. We use dual-stage vacuum pumps for 30–45 minutes to create a pure vacuum before injecting any refrigerant.',
  },
  {
    q: 'How often should a commercial Chiller or VRF system be serviced?',
    a: 'Industrial chillers and VRF systems in GIDC areas should undergo preventative maintenance every 30–45 days. Dust accumulation on heat exchangers exponentially increases compressor load. Water-cooled chillers need chemical descaling of condenser tubes at least twice a year. Our AMC contracts handle all of this automatically.',
  },
];

const stats = [
  { value: '20+', label: 'Years of Engineering' },
  { value: '342+', label: 'Verified Reviews' },
  { value: '4.9/5', label: 'Average Rating' },
  { value: '24/7', label: 'Emergency Support' },
];
---

<BaseLayout
  title="AC Repair, Service & Installation In Vadodara | Atlas Aircon"
  description="Need urgent AC repair, service, or new installation in Vadodara? Atlas Aircon provides 24/7 expert cooling solutions for residential and industrial HVAC."
>

  <!-- ===================== HERO ===================== -->
  <section class="hero" id="hero">
    <!-- Animated Background -->
    <div class="hero-bg">
      <div class="hero-orb hero-orb-1"></div>
      <div class="hero-orb hero-orb-2"></div>
      <div class="hero-grid-overlay"></div>
    </div>

    <div class="container hero-inner">

      <!-- LEFT: Text Content -->
      <div class="hero-content">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          ⚡ Available 24/7 — Emergency Dispatch Ready
        </div>
        <h1 class="hero-title">
          Gujarat's #1<br />
          <span class="hero-title-accent">AC Repair &</span><br />
          Industrial HVAC
        </h1>
        <p class="hero-desc">
          From split AC gas charging in <strong>Alkapuri</strong> to Industrial Chiller
          overhauls in <strong>Makarpura GIDC</strong> — we fix the complex inverter PCB
          faults & commercial VRF systems that standard technicians can't touch.
        </p>

        <!-- Trust Pills -->
        <div class="hero-trust">
          <div class="trust-pill"><Icon name="shield" size={12} strokeWidth={2.5} /> Trusted Since 2005</div>
          <div class="trust-pill"><Icon name="star" size={12} strokeWidth={2.5} /> 4.9/5 · 342+ Reviews</div>
          <div class="trust-pill"><Icon name="clock" size={12} strokeWidth={2.5} /> 24/7 Emergency</div>
          <div class="trust-pill"><Icon name="map-pin" size={12} strokeWidth={2.5} /> All Gujarat</div>
        </div>

        <!-- Emergency CTA -->
        <a
          href="https://wa.me/919727257141?text=EMERGENCY:%20I%20need%20rapid%20AC%20Repair%20in%20Vadodara."
          class="hero-emergency-btn"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="emergency-pulse"></span>
          <Icon name="alert-circle" size={18} strokeWidth={2.5} /> Request Emergency Dispatch
        </a>

        <!-- Stat Row -->
        <div class="hero-stats-row">
          {stats.map(s => (
            <div class="hero-stat-item">
              <span class="hero-stat-val">{s.value}</span>
              <span class="hero-stat-lbl">{s.label}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- CENTER: AC Technician Image -->
      <div class="hero-image-col">
        <div class="hero-img-frame">
          <img
            src="https://atlasaircons.com/wp-content/uploads/2025/07/emergency-ac-repair-in-vadodara.webp"
            alt="Atlas Aircon expert technician performing AC repair in Vadodara"
            width="420"
            height="520"
            loading="eager"
            fetchpriority="high"
          />
          <!-- Overlay badge -->
          <div class="img-badge img-badge-top">
            <span class="img-badge-icon">⭐</span>
            <div>
              <strong>4.9 / 5.0</strong>
              <span>342+ Google Reviews</span>
            </div>
          </div>
          <div class="img-badge img-badge-bottom">
            <span class="img-badge-icon">🔧</span>
            <div>
              <strong>Expert Engineers</strong>
              <span>On-Site in 2 Hours</span>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT: WhatsApp Booking Form -->
      <div class="hero-form-col">
        <div class="booking-form-card">
          <div class="form-header">
            <div class="form-header-icon">📅</div>
            <div>
              <h2 class="form-title">Book AC Service Now</h2>
              <p class="form-subtitle">Get a reply on WhatsApp in minutes</p>
            </div>
          </div>

          <form class="booking-form" id="bookingForm" novalidate>
            <!-- Name -->
            <div class="form-group">
              <label for="name">Your Name <span class="req">*</span></label>
              <input
                type="text"
                id="name"
                name="name"
                placeholder="Enter your name"
                required
                autocomplete="name"
              />
            </div>

            <!-- Phone -->
            <div class="form-group">
              <label for="phone">Phone Number <span class="req">*</span></label>
              <div class="phone-input-wrap">
                <span class="phone-prefix">+91</span>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  placeholder="Enter 10 digit number"
                  maxlength="10"
                  pattern="[6-9][0-9]{9}"
                  required
                  autocomplete="tel"
                />
              </div>
            </div>

            <!-- Service -->
            <div class="form-group">
              <label for="service">Service Required <span class="req">*</span></label>
              <div class="select-wrap">
                <select id="service" name="service" required>
                  <option value="" disabled selected>Select Service</option>
                  <option>AC Repair</option>
                  <option>AC Service / Power Jet Wash</option>
                  <option>AC Installation</option>
                  <option>AC Gas Charging</option>
                  <option>Inverter PCB Repair</option>
                  <option>Cassette AC Service</option>
                  <option>Industrial Chiller Repair</option>
                  <option>VRF / VRV System Service</option>
                  <option>Cold Storage Repair</option>
                  <option>Panel AC Repair</option>
                  <option>AMC Contract</option>
                  <option>AC Shifting / Uninstallation</option>
                </select>
                <span class="select-arrow"><Icon name="chevron-down" size={16} /></span>
              </div>
            </div>

            <!-- Area -->
            <div class="form-group">
              <label for="area">Area / Locality <span class="req">*</span></label>
              <input
                type="text"
                id="area"
                name="area"
                placeholder="e.g., Alkapuri, Vadodara"
                required
              />
            </div>

            <!-- Problem (optional) -->
            <div class="form-group">
              <label for="problem">Problem Description <span class="optional">(Optional)</span></label>
              <textarea
                id="problem"
                name="problem"
                rows="2"
                placeholder="Describe your AC problem..."
              ></textarea>
            </div>

            <!-- Submit -->
            <button type="submit" class="form-submit-btn" id="formSubmitBtn">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
              </svg>
              Book Service Now
            </button>

            <p class="form-note">
              🔒 Your details are sent directly & securely via WhatsApp
            </p>
          </form>
        </div>
      </div>

    </div><!-- /hero-inner -->
  </section>


  <!-- ===================== SERVICES ===================== -->
  <section class="section" id="services">
    <div class="container">
      <div class="text-center" style="margin-bottom: var(--space-12);">
        <div class="section-badge"><Icon name="gear" size={14} strokeWidth={2} /> Our Engineering Capabilities</div>
        <h2 class="section-title">What Sets Us Apart from<br /><span>Standard Mechanics</span></h2>
        <div class="gold-line" style="margin: var(--space-4) auto;"></div>
        <p class="section-desc">
          Atlas Aircon is not a standard aggregator service. We are a dedicated team of HVAC
          engineers specializing in the total lifecycle management of cooling equipment.
        </p>
      </div>

      <div class="services-grid">
        {services.map((svc, i) => (
          <div class="service-card card" style={`animation-delay: ${i * 0.1}s`}>
            <div class="svc-icon"><Icon name={svc.icon} size={32} strokeWidth={2} /></div>
            <h3 class="svc-title">{svc.title}</h3>
            <p class="svc-desc">{svc.desc}</p>
            <ul class="svc-points">
              {svc.points.map(pt => (
                <li>
                  <span class="pt-check"><Icon name="check" size={14} strokeWidth={3} /></span>
                  {pt}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="services-cta">
        <a href="/services/" class="btn btn-outline btn-lg">
          Explore All Services <Icon name="arrow-right" size={16} />
        </a>
        <a href="/ac-repair-cost-vadodara/" class="btn btn-ghost btn-lg">
          View Price List
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== WHY ATLAS ===================== -->
  <section class="section why-atlas" id="why-us">
    <div class="container">
      <div class="why-grid">
        <!-- Left Content -->
        <div>
          <div class="section-badge"><Icon name="award" size={14} strokeWidth={2} /> Engineering Excellence</div>
          <h2 class="section-title">
            We Don't Guess.<br />
            We <span>Diagnose,</span> Isolate<br />
            & Engineer a Fix.
          </h2>
          <div class="gold-line"></div>
          <blockquote class="quote-block">
            <p>
              "For over two decades, Atlas Aircon has protected Vadodara's homes and heavy industries
              from catastrophic thermal failures. The HVAC industry is plagued by untrained mechanics
              who 'top-up' gas without fixing the leak, or bypass essential safety sensors. We operate
              differently. We are an engineering firm."
            </p>
            <footer>— Director & Lead HVAC Architect, Atlas Aircon</footer>
          </blockquote>
          <div class="why-bullets">
            {[
              ['wrench', 'Every technician is strictly vetted and highly trained'],
              ['signal', 'Best digital manifold gauges, vacuum pumps & multimeters in Gujarat'],
              ['circuit', 'Component-level PCB repair — no unnecessary replacements'],
              ['thermometer', 'Dual-stage vacuum pumps for 30–45 min before any gas charge'],
              ['bar-chart', 'Thermal imaging & vibration analysis for predictive maintenance'],
            ].map(([iconName, text]) => (
              <div class="why-bullet">
                <span class="why-bullet-icon"><Icon name={iconName} size={18} strokeWidth={2} /></span>
                <span>{text}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: Service Image -->
        <div class="why-image-wrap">
          <img
            src="https://atlasaircons.com/wp-content/uploads/2025/07/emergency-ac-repair-in-vadodara.webp"
            alt="Atlas Aircon technician performing precision AC repair in Vadodara"
            width="560"
            height="640"
            loading="lazy"
          />
          <div class="why-badge">
            <span class="badge-icon"><Icon name="award" size={24} /></span>
            <div>
              <strong>Gujarat's #1</strong>
              <span>Industrial HVAC Authority</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== SERVICE SECTORS ===================== -->
  <section class="section" id="sectors">
    <div class="container">
      <div class="text-center" style="margin-bottom: var(--space-12);">
        <div class="section-badge"><Icon name="map-pin" size={14} strokeWidth={2} /> Dedicated Service Zones</div>
        <h2 class="section-title">
          Tactical Response Zones<br />
          Across <span>Vadodara</span>
        </h2>
        <div class="gold-line" style="margin: var(--space-4) auto;"></div>
      </div>

      <div class="sectors-grid">
        <!-- Urban Residential -->
        <div class="sector-card card">
          <div class="sector-icon"><Icon name="home" size={28} /></div>
          <h3>Urban Residential Hubs</h3>
          <p>
            <strong>Alkapuri, OP Road, Gotri, Akota:</strong> Stealth installations of Inverter Split ACs,
            false-ceiling Cassette units, and multi-split systems. We use heavy drop-cloths and shoe
            covers to ensure your luxury interiors remain spotless.
          </p>
          <p>
            <strong>Sama-Savli, Fatehgunj, Karelibaug, Waghodia Road:</strong> High-density zones with
            severe voltage fluctuations. We carry fully stocked mobile diagnostic kits to repair
            circuit boards on-site, restoring cooling within hours.
          </p>
        </div>
        <!-- Industrial Belts -->
        <div class="sector-card card">
          <div class="sector-icon"><Icon name="factory" size={28} /></div>
          <h3>Heavy Industrial & GIDC Belts</h3>
          <p>
            <strong>Makarpura GIDC & Por GIDC:</strong> Heavy metallic dust and corrosive chemical fumes
            choke standard condenser coils in weeks. We deploy specialized non-acidic industrial foaming
            agents to dissolve sludge from Panel ACs and Chiller Plants without eating away copper tubing.
          </p>
          <p>
            <strong>Manjusar, Savli & Nandesari:</strong> Massive manufacturing belts requiring constant
            climate control. Our industrial squad handles everything from replacing 3-phase blower motors
            to nitrogen-purged copper brazing on heavy commercial ductable units.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== CITY NETWORK ===================== -->
  <section class="section city-section" id="cities">
    <div class="container">
      <div class="text-center" style="margin-bottom: var(--space-12);">
        <div class="section-badge"><Icon name="map-pin" size={14} strokeWidth={2} /> Gujarat HVAC Network</div>
        <h2 class="section-title">
          Engineering Squads Deployed<br />
          Across <span>All of Gujarat</span>
        </h2>
        <div class="gold-line" style="margin: var(--space-4) auto;"></div>
        <p class="section-desc">
          While our main command center operates in Vadodara, Atlas Aircon deploys specialized
          engineering squads across the entire state. Select your city for immediate local service.
        </p>
      </div>

      <div class="city-grid">
        {cities.map(city => (
          <a href={city.href} class="city-card">
            <div class="city-card-inner">
              <span class="city-dot"></span>
              <div>
                <strong class="city-name">{city.name}</strong>
                <span class="city-label">{city.label}</span>
              </div>
              <span class="city-arrow"><Icon name="arrow-right" size={16} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== LIVE DISPATCH LOG ===================== -->
  <section class="section" id="dispatch">
    <div class="container">
      <div class="text-center" style="margin-bottom: var(--space-12);">
        <div class="section-badge"><Icon name="zap" size={14} strokeWidth={2} /> Live Engineering Logs</div>
        <h2 class="section-title">
          Real Dispatches.<br />
          Verified <span>On-Site Work.</span>
        </h2>
        <div class="gold-line" style="margin: var(--space-4) auto;"></div>
        <p class="section-desc">
          Do not trust aggregators who hide their work. Below are real-time, verified dispatches
          executed by our team right here in Vadodara.
        </p>
      </div>

      <div class="dispatch-grid">
        {[
          {
            title: 'Inverter AC PCB Repair & Gas Charge in Sayajigunj, Vadodara',
            href: '/recent-projects/inverter-ac-pcb-repair-sayajigunj/',
            tag: 'PCB Repair',
          },
          {
            title: 'Commercial Dispatch: 3-Ton Cassette AC Repair & Power Jet Wash in Alkapuri',
            href: '/recent-projects/cassette-ac-repair-alkapuri/',
            tag: 'Commercial',
          },
          {
            title: 'Emergency Dispatch: Inverter AC PCB Circuit Repair in Ajwa Road, Vadodara',
            href: '/recent-projects/inverter-ac-pcb-ajwa-road/',
            tag: 'Emergency',
          },
          {
            title: 'Commercial AC Repair in Fatehgunj, Vadodara | 21-Unit Overhaul',
            href: '/recent-projects/commercial-ac-repair-fatehgunj/',
            tag: 'Multi-Unit',
          },
        ].map(dispatch => (
          <a href={dispatch.href} class="dispatch-card card">
            <div class="dispatch-status">
              <span class="status-dot"></span>
              Service successfully executed and verified by Atlas dispatch.
            </div>
            <h4 class="dispatch-title">{dispatch.title}</h4>
            <div class="dispatch-footer">
              <span class="tag tag-gold">{dispatch.tag}</span>
              <span class="dispatch-link">Read Full Report <Icon name="arrow-right" size={14} /></span>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center" style="margin-top: var(--space-8);">
        <a href="/recent-projects/" class="btn btn-outline btn-lg">
          <Icon name="zap" size={16} /> View All Daily Ops →
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class="section faq-section" id="faq">
    <div class="container">
      <div class="faq-grid">
        <div>
          <div class="section-badge"><Icon name="question" size={14} strokeWidth={2} /> Technical Q&A</div>
          <h2 class="section-title">
            Frequently Asked<br />
            <span>Technical Questions</span>
          </h2>
          <div class="gold-line"></div>
          <p class="section-desc">
            Understanding the mechanics of your cooling system can save you thousands
            in unnecessary repairs and replacements.
          </p>
          <div style="margin-top: var(--space-8);">
            <a href="tel:+919727257141" class="btn btn-primary btn-lg" style="display: inline-flex;">
              <Icon name="phone" size={16} /> Call Our Engineers
            </a>
          </div>
        </div>

        <div class="faq-list">
          {faqs.map((faq, i) => (
            <details class="faq-item" id={`faq-${i}`}>
              <summary class="faq-q">
                <span>{faq.q}</span>
                <span class="faq-icon">+</span>
              </summary>
              <div class="faq-a">
                <p>{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== CTA BANNER ===================== -->
  <section class="cta-banner">
    <div class="cta-banner-bg"></div>
    <div class="container cta-banner-inner">
      <div>
        <h2 class="cta-title">
          Don't Wait for Your AC<br />
          to <span class="text-gold">Completely Fail</span>
        </h2>
        <p>
          Our engineers are on standby 24/7 across Gujarat. Call now for immediate dispatch.
        </p>
      </div>
      <div class="cta-buttons">
        <a href="tel:+919727257141" class="btn btn-primary btn-lg">
          <Icon name="phone" size={18} strokeWidth={2.5} /> 97272 57141 — Call Now
        </a>
        <a
          href="https://wa.me/919727257141?text=EMERGENCY:%20I%20need%20rapid%20AC%20Repair."
          class="btn btn-whatsapp btn-lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="whatsapp" size={18} /> WhatsApp Emergency
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
