---
import Icon from '@components/Icon.astro';

interface Props {
  defaultLocation?: string;
}

const { defaultLocation = '' } = Astro.props;
---

<div class="booking-form-card">
  <div class="form-header">
    <div class="form-header-icon"><Icon name="calendar" size={20} /></div>
    <div>
      <h2 class="form-title">Book AC Service Now</h2>
      <p class="form-subtitle">Get a reply on WhatsApp in minutes</p>
    </div>
  </div>

  <form class="booking-form whatsapp-form" novalidate>
    <!-- Name -->
    <div class="form-group">
      <label>Your Name <span class="req">*</span></label>
      <input
        type="text"
        class="wa-name"
        placeholder="Enter your name"
        required
        autocomplete="name"
      />
    </div>

    <!-- Phone -->
    <div class="form-group">
      <label>Phone Number <span class="req">*</span></label>
      <div class="phone-input-wrap">
        <span class="phone-prefix">+91</span>
        <input
          type="tel"
          class="wa-phone"
          placeholder="Enter 10 digit number"
          maxlength="10"
          pattern="[6-9][0-9]{9}"
          required
          autocomplete="tel"
        />
      </div>
    </div>

    <!-- Service -->
    <div class="form-group">
      <label>Service Required <span class="req">*</span></label>
      <div class="select-wrap">
        <select class="wa-service" required>
          <option value="" disabled selected>Select Service</option>
          <option>AC Repair</option>
          <option>AC Service / Power Jet Wash</option>
          <option>AC Installation</option>
          <option>AC Gas Charging</option>
          <option>Inverter PCB Repair</option>
          <option>Cassette AC Service</option>
          <option>Industrial Chiller Repair</option>
          <option>VRF / VRV System Service</option>
          <option>Cold Storage Repair</option>
          <option>Panel AC Repair</option>
          <option>AMC Contract</option>
          <option>AC Shifting / Uninstallation</option>
        </select>
        <span class="select-arrow"><Icon name="chevron-down" size={16} /></span>
      </div>
    </div>

    <!-- Area -->
    <div class="form-group">
      <label>Area / Locality <span class="req">*</span></label>
      <input
        type="text"
        class="wa-area"
        placeholder="e.g., Alkapuri, Vadodara"
        value={defaultLocation}
        required
      />
    </div>

    <!-- Problem (optional) -->
    <div class="form-group">
      <label>Problem Description <span class="optional">(Optional)</span></label>
      <textarea
        class="wa-problem"
        rows="2"
        placeholder="Describe your AC problem..."
      ></textarea>
    </div>

    <!-- Submit -->
    <button type="submit" class="form-submit-btn">
      <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
      </svg>
      Book Service Now
    </button>

    <p class="form-note">
      <Icon name="lock" size={12} /> Your details are sent directly & securely via WhatsApp
    </p>
  </form>
</div>

<style>
  .booking-form-card {
    width: 100%;
    background: rgba(11, 22, 40, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(6,182,212,0.2);
    border-radius: 20px;
    padding: var(--space-6);
    box-shadow: 0 24px 60px rgba(0,0,0,0.4), 0 0 0 1px rgba(6,182,212,0.08);
  }

  .form-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid rgba(6,182,212,0.15);
  }

  .form-header-icon {
    line-height: 1;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(6,182,212,0.12);
    color: #06B6D4;
    border: 1px solid rgba(6,182,212,0.25);
    border-radius: var(--radius-lg);
    flex-shrink: 0;
  }

  .form-title {
    font-family: 'Poppins', sans-serif;
    font-size: var(--text-lg);
    font-weight: 700;
    color: #F8FAFC;
    margin: 0 0 2px;
    line-height: 1.3;
  }

  .form-subtitle {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1;
  }

  .booking-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: left;
  }

  .form-group label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: #94A3B8;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .req { color: #EF4444; margin-left: 2px; }
  .optional { color: var(--color-text-muted); font-weight: 400; text-transform: none; letter-spacing: normal; }

  .form-group input,
  .form-group select,
  .form-group textarea {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--radius-md);
    color: #F8FAFC;
    font-family: 'Poppins', sans-serif;
    font-size: var(--text-sm);
    padding: var(--space-3) var(--space-4);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    width: 100%;
    outline: none;
    appearance: none;
    -webkit-appearance: none;
  }

  .form-group textarea {
    resize: none;
    line-height: 1.6;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: #475569;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: rgba(6,182,212,0.5);
    box-shadow: 0 0 0 3px rgba(6,182,212,0.1);
    background: rgba(6,182,212,0.04);
  }

  /* Phone Input */
  .phone-input-wrap {
    display: flex;
    align-items: center;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .phone-input-wrap:focus-within {
    border-color: rgba(6,182,212,0.5);
    box-shadow: 0 0 0 3px rgba(6,182,212,0.1);
  }

  .phone-prefix {
    padding: var(--space-3) var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
    color: #06B6D4;
    background: rgba(6,182,212,0.08);
    border-right: 1px solid rgba(255,255,255,0.08);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .phone-input-wrap input {
    background: transparent;
    border: none;
    border-radius: 0;
    box-shadow: none;
    flex: 1;
    min-width: 0;
  }

  .phone-input-wrap input:focus {
    border: none;
    box-shadow: none;
    background: transparent;
  }

  /* Select */
  .select-wrap {
    position: relative;
  }

  .select-arrow {
    position: absolute;
    right: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
    color: #06B6D4;
    pointer-events: none;
    font-size: var(--text-sm);
  }

  .select-wrap select {
    padding-right: var(--space-10);
    cursor: pointer;
  }

  .select-wrap select option {
    background: #0F1E35;
    color: #F8FAFC;
  }

  /* Submit Button */
  .form-submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    background: linear-gradient(135deg, #25D366, #128C7E);
    color: #fff;
    font-family: 'Poppins', sans-serif;
    font-size: var(--text-sm);
    font-weight: 700;
    border: none;
    border-radius: var(--radius-full);
    padding: var(--space-4) var(--space-6);
    cursor: pointer;
    width: 100%;
    transition: all var(--transition-base);
    box-shadow: 0 4px 24px rgba(37,211,102,0.35);
    letter-spacing: 0.02em;
    margin-top: var(--space-1);
  }

  .form-submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(37,211,102,0.5);
  }

  .form-note {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-align: center;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }
</style>

<script>
  // Handle WhatsApp form submission safely for multiple instances
  document.querySelectorAll('.whatsapp-form').forEach(form => {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const name = this.querySelector('.wa-name').value;
      const phone = this.querySelector('.wa-phone').value;
      const service = this.querySelector('.wa-service').value;
      const area = this.querySelector('.wa-area').value;
      const problem = this.querySelector('.wa-problem').value;
      
      const lines = [
        `🛠️ *AC SERVICE BOOKING — Atlas Aircon*`,
        ``,
        `👤 *Name:* ${name}`,
        `📞 *Phone:* +91 ${phone}`,
        `🔧 *Service:* ${service}`,
        `📍 *Location:* ${area}`,
      ];
      
      if (problem) {
        lines.push(``);
        lines.push(`📝 *Problem:* ${problem}`);
      }
      
      const message = encodeURIComponent(lines.join('\n'));
      window.open(`https://wa.me/919727257141?text=${message}`, '_blank');
    });
  });
</script>
