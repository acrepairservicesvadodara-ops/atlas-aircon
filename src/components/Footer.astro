---
// Footer Component — Atlas Aircon
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <!-- Top Pattern Bar -->
  <div class="footer-top-bar"></div>

  <div class="footer-body">
    <div class="container">
      <div class="footer-grid">

        <!-- Column 1: Brand -->
        <div class="footer-col footer-brand">
          <a href="/" class="footer-logo">
            <img
              src="/images/logo.webp"
              alt="Atlas Aircon"
              width="160"
              height="60"
              loading="lazy"
            />
          </a>
          <p class="footer-tagline">
            Gujarat's #1 authority for Industrial HVAC, Chiller Repair, and GIDC Maintenance Projects.
            <strong>24/7 Emergency Support.</strong> Trusted since 2005.
          </p>
          <!-- Rating -->
          <div class="footer-rating">
            <div class="stars">
              {[1,2,3,4,5].map(() => <Icon name="star" size={14} class="star-icon" />)}
            </div>
            <span>4.9/5 — 342+ Verified Reviews</span>
          </div>
          <!-- Social Links -->
          <div class="footer-social">
            <a href="https://www.facebook.com/atlasaircon/" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
            <a href="https://www.instagram.com/atlasaircon/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
            </a>
            <a href="https://www.linkedin.com/company/atlas-aircon" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
          </div>
        </div>

        <!-- Column 2: Company -->
        <div class="footer-col">
          <h4 class="footer-col-title">Company</h4>
          <ul class="footer-links">
            <li><a href="/about-us/">About Us</a></li>
            <li><a href="/contact-us/">Contact Support</a></li>
            <li><a href="/shop/">Spare Parts Store</a></li>
            <li><a href="/blogs/">Blog & Articles</a></li>
            <li><a href="/ac-repair-cost-vadodara/">Price List</a></li>
            <li><a href="/franchise/">Franchise</a></li>
            <li><a href="/ac-technician-jobs/">Jobs / Careers</a></li>
            <li><a href="/privacy-policy/">Privacy Policy</a></li>
            <li><a href="/recent-projects/">Daily Ops Log</a></li>
          </ul>
        </div>

        <!-- Column 3: Core Services -->
        <div class="footer-col">
          <h4 class="footer-col-title">Core Services</h4>
          <ul class="footer-links">
            <li><a href="/services/industrial-chiller/">Industrial Chillers</a></li>
            <li><a href="/services/vrf-vrv-system/">VRF / VRV Systems</a></li>
            <li><a href="/services/cold-storage/">Cold Storage Rooms</a></li>
            <li><a href="/services/panel-ac/">Panel AC Repair</a></li>
            <li><a href="/services/ac-installation/">Commercial Installation</a></li>
            <li><a href="/ac-repair-vadodara/">AC Repair Vadodara</a></li>
            <li><a href="/fault-codes/">Fault Code Decoder</a></li>
            <li><a href="/wiki/">Atlas Wiki</a></li>
          </ul>
        </div>

        <!-- Column 4: Contact & Locations -->
        <div class="footer-col">
          <h4 class="footer-col-title">Contact Us</h4>
          <ul class="footer-contact">
            <li>
              <span class="contact-icon"><Icon name="map-pin" size={16} strokeWidth={2} /></span>
              <span>Payal Complex, 27, Opp. M.S. University, Sarod, Sayajiganj, Vadodara — 390005</span>
            </li>
            <li>
              <span class="contact-icon"><Icon name="phone" size={16} strokeWidth={2} /></span>
              <a href="tel:+919727257141">+91 97272 57141</a>
            </li>
            <li>
              <span class="contact-icon"><Icon name="mail" size={16} strokeWidth={2} /></span>
              <a href="mailto:atlasaircon1@gmail.com">atlasaircon1@gmail.com</a>
            </li>
            <li>
              <span class="contact-icon"><Icon name="clock" size={16} strokeWidth={2} /></span>
              <span>Open 24/7 — All Days</span>
            </li>
          </ul>

          <div class="footer-ctas">
            <a href="tel:+919727257141" class="btn btn-primary btn-sm">
              <Icon name="phone" size={14} strokeWidth={2.5} /> Call Engineer
            </a>
            <a
              href="https://wa.me/919727257141?text=Hi%2C+I+need+AC+service+in+Vadodara"
              class="btn btn-whatsapp btn-sm"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="whatsapp" size={14} /> WhatsApp
            </a>
          </div>
        </div>
      </div>

      <!-- Service City Grid -->
      <div class="footer-cities">
        <div class="divider" style="margin-bottom: var(--space-6);"></div>
        <p class="footer-cities-label"><Icon name="map-pin" size={14} strokeWidth={2} /> Service Across Gujarat</p>
        <div class="city-links">
          {[
            ['Vadodara', '/ac-repair-vadodara/'],
            ['Ahmedabad', '/ac-repair-ahmedabad/'],
            ['Surat', '/ac-repair-surat/'],
            ['Anand', '/ac-repair-anand/'],
            ['Rajkot', '/ac-repair-rajkot/'],
            ['Bharuch', '/ac-repair-bharuch/'],
            ['Morbi', '/ac-repair-morbi/'],
            ['Kheda', '/ac-repair-kheda/'],
            ['Godhra', '/ac-repair-godhra/'],
            ['Daman', '/ac-repair-daman/'],
            ['Valsad', '/ac-repair-valsad/'],
            ['Ankleshwar', '/ac-repair-ankleshwar/'],
          ].map(([city, href]) => (
            <a href={href} class="city-link">{city}</a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="footer-bottom">
    <div class="container">
      <div class="footer-bottom-inner">
        <p>&copy; {year} Atlas Aircon. All rights reserved. Vadodara's #1 HVAC Engineers.</p>
        <p>Designed for performance. Built for Gujarat's industry.</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy-light);
    border-top: 1px solid var(--color-gold-border);
    margin-top: 0;
  }

  /* Gold gradient top bar */
  .footer-top-bar {
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--color-gold), var(--color-gold-light), var(--color-gold), transparent);
  }

  /* Footer Body */
  .footer-body {
    padding: var(--space-16) 0 var(--space-12);
  }

  /* Grid */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: var(--space-10);
    margin-bottom: var(--space-10);
  }

  /* Brand Column */
  .footer-logo {
    display: inline-block;
    margin-bottom: var(--space-4);
  }

  .footer-logo img {
    height: 52px;
    width: auto;
    filter: brightness(1.05);
  }

  .footer-tagline {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .footer-tagline strong { color: var(--color-text-secondary); }

  /* Rating */
  .footer-rating {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
  }

  .stars {
    display: flex;
    gap: 2px;
    color: var(--color-gold);
  }
  .star-icon {
    fill: var(--color-gold);
  }

  .footer-rating span {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-weight: 600;
  }

  /* Social */
  .footer-social {
    display: flex;
    gap: var(--space-3);
  }

  .footer-social a {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: rgba(212,175,55,0.08);
    border: 1px solid var(--color-gold-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    transition: all var(--transition-fast);
  }

  .footer-social a:hover {
    background: var(--color-gold-dim);
    color: var(--color-gold);
    border-color: var(--color-gold);
    transform: translateY(-2px);
  }

  /* Column Titles */
  .footer-col-title {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-gold-border);
  }

  /* Footer Links */
  .footer-links { display: flex; flex-direction: column; gap: var(--space-2); }

  .footer-links a {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .footer-links a::before {
    content: '›';
    color: var(--color-gold);
    font-size: var(--text-base);
    line-height: 1;
    opacity: 0;
    transform: translateX(-4px);
    transition: all var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--color-gold);
  }

  .footer-links a:hover::before {
    opacity: 1;
    transform: translateX(0);
  }

  /* Contact */
  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .footer-contact li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .contact-icon { font-size: var(--text-base); flex-shrink: 0; margin-top: 1px; }

  .footer-contact a {
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .footer-contact a:hover { color: var(--color-gold); }

  .footer-ctas {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  /* Cities */
  .footer-cities { margin-top: var(--space-4); }

  .footer-cities-label {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .city-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .city-link {
    font-size: var(--text-xs);
    font-family: var(--font-heading);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    text-decoration: none;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
  }

  .city-link:hover {
    color: var(--color-gold);
    background: var(--color-gold-dim);
    border-color: var(--color-gold-border);
  }

  /* Bottom Bar */
  .footer-bottom {
    background: rgba(0,0,0,0.3);
    border-top: 1px solid rgba(212,175,55,0.08);
    padding: var(--space-5) 0;
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .footer-bottom p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
    font-family: var(--font-heading);
    letter-spacing: 0.03em;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: var(--space-8); }
    .footer-brand { grid-column: 1 / -1; }
  }

  @media (max-width: 640px) {
    .footer-grid { grid-template-columns: 1fr; }
    .footer-brand { grid-column: auto; }
    .footer-bottom-inner { flex-direction: column; text-align: center; }
  }
</style>
