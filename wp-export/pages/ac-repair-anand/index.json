x-5 py-5 border-b border-gray-100 text-sm font-bold\">₹2500</td>\n                            <td class=\"px-5 py-5 border-b border-gray-100 text-sm\"><a href=\"/ac-repair-service-price-list-air-conditioner-repair-service-cost-in-vadodara-gujarat\" class=\"text-orange-600 underline font-bold\">Full Price List</a></td>\n                        </tr>\n                        <tr class=\"price-row\">\n                            <td class=\"px-5 py-5 border-b border-gray-100 text-sm\"><b>PCB Troubleshooting</b></td>\n                            <td class=\"px-5 py-5 border-b border-gray-100 text-sm font-bold\">₹1200</td>\n                            <td class=\"px-5 py-5 border-b border-gray-100 text-sm\"><a href=\"/ac-repair-service-price-list-air-conditioner-repair-service-cost-in-vadodara-gujarat\" class=\"text-orange-600 underline font-bold\">Full Price List</a></td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n            <div class=\"mt-8 grid grid-cols-2 md:grid-cols-4 gap-4\">\n                <a href=\"/remote/\" class=\"p-3 bg-white border-2 border-orange-500 rounded text-center font-bold hover:bg-orange-500 hover:text-white transition shadow-sm\">AC Remote</a>\n                <a href=\"/capacitor\" class=\"p-3 bg-white border-2 border-orange-500 rounded text-center font-bold hover:bg-orange-500 hover:text-white transition shadow-sm\">Capacitor</a>\n                <a href=\"/compressor\" class=\"p-3 bg-white border-2 border-orange-500 rounded text-center font-bold hover:bg-orange-500 hover:text-white transition shadow-sm\">Compressor Fix</a>\n                <a href=\"/indoor-motor\" class=\"p-3 bg-white border-2 border-orange-500 rounded text-center font-bold hover:bg-orange-500 hover:text-white transition shadow-sm\">Indoor Motor</a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Anand Local Areas -->\n    <section class=\"py-16 bg-blue-900 text-white\">\n        <div class=\"container mx-auto px-6\">\n            <h2 class=\"text-3xl font-bold text-center mb-12\">Anand Areas We Serve</h2>\n            <div class=\"mb-12\">\n                <h3 class=\"text-2xl font-bold mb-6 border-b border-blue-700 pb-2\">Residential Areas</h3>\n                <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4 text-sm text-blue-200\">\n                    <span>Vallabh Vidyanagar</span> <span>Karamsad</span> <span>Bakrol</span> <span>Mogar</span> <span>Lambhvel</span> <span>Borsad</span>\n                    <span>Sojitra</span> <span>Khambhat</span> <span>Tarapur</span> <span>Petlad</span> <span>Vansol</span> <span>Bhadran</span>\n                    <span>Vidyanagar Road</span> <span>Anand Town</span> <span>Amul Dairy Road</span> <span>Bakrol Road</span> <span>Town Hall Area</span> <span>Ganesh Colony</span>\n                </div>\n            </div>\n            <div>\n                <h3 class=\"text-2xl font-bold mb-6 border-b border-blue-700 pb-2\">Industrial Areas</h3>\n                <div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 text-sm text-blue-200\">\n                    <span>Vithal Udyognagar GIDC</span> <span>Khambhat GIDC</span> <span>Borsad Industrial Estate</span> <span>Sojitra Industrial Area</span>\n                    <span>Anand Industrial GIDC</span> <span>Tarapur GIDC</span> <span>Mogar Highway Units</span> <span>Petlad Industrial Area</span>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Anand FAQs -->\n    <section class=\"py-16 bg-yellow-50\">\n        <div class=\"container mx-auto px-6 max-w-4xl\">\n            <h2 class=\"text-3xl font-bold text-center mb-12 uppercase text-blue-900\">Anand Service FAQs</h2>\n            <div class=\"space-y-6\">\n                <div class=\"bg-white p-6 rounded-lg shadow-sm border-l-4 border-yellow-500\">\n                    <h5 class=\"font-bold text-lg mb-2 text-orange-700\">What is the cost of AC service in Anand?</h5>\n                    <p class=\"text-gray-600\">A professional <b>ac jet service</b> in Anand starts from ₹599. Prices vary based on the level of cleaning and unit capacity.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-lg shadow-sm border-l-4 border-yellow-500\">\n                    <h5 class=\"font-bold text-lg mb-2 text-orange-700\">Do you provide AC repair in Vallabh Vidyanagar?</h5>\n                    <p class=\"text-gray-600\">Yes, we provide <b>fast ac repair</b> and maintenance services across Vallabh Vidyanagar for students and residents.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-lg shadow-sm border-l-4 border-yellow-500\">\n                    <h5 class=\"font-bold text-lg mb-2 text-orange-700\">Can you fix central AC for industries in Vithal Udyognagar?</h5>\n                    <p class=\"text-gray-600\">Yes, <b>Atlas Aircon</b> provides specialized <b>hvac repair services</b> for industrial plants in Vithal Udyognagar GIDC.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-lg shadow-sm border-l-4 border-yellow-500\">\n                    <h5 class=\"font-bold text-lg mb-2 text-orange-700\">What brands do you service in Anand?</h5>\n                    <p class=\"text-gray-600\">We offer <b>multi-brand ac repair</b> for Daikin, Samsung, LG, Voltas, Blue Star, Carrier, and many others.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-lg shadow-sm border-l-4 border-yellow-500\">\n                    <h5 class=\"font-bold text-lg mb-2 text-orange-700\">Is gas charging available for all AC types?</h5>\n                    <p class=\"text-gray-600\">Yes, we provide <b>ac gas charging</b> for split, window, cassette, and ductable systems using R22, R32, or R410 gas.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-lg shadow-sm border-l-4 border-yellow-500\">\n                    <h5 class=\"font-bold text-lg mb-2 text-orange-700\">Do you offer a warranty on PCB repairs?</h5>\n                    <p class=\"text-gray-600\">We provide a <b>service warranty</b> on labor and a standard duration warranty on repaired <b>ac pcb circuits</b>.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-lg shadow-sm border-l-4 border-yellow-500\">\n                    <h5 class=\"font-bold text-lg mb-2 text-orange-700\">How long does a master service take?</h5>\n                    <p class=\"text-gray-600\">A thorough <b>ac master service</b> takes approximately 60 to 90 minutes to ensure peak performance.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-lg shadow-sm border-l-4 border-yellow-500\">\n                    <h5 class=\"font-bold text-lg mb-2 text-orange-700\">Do you supply genuine copper pipes in Anand?</h5>\n                    <p class=\"text-gray-600\">Yes, we strictly use high-grade <b>copper pipe for ac</b> to prevent premature gas leakage and rust issues.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-lg shadow-sm border-l-4 border-yellow-500\">\n                    <h5 class=\"font-bold text-lg mb-2 text-orange-700\">Can you repair cold rooms in Anand?</h5>\n                    <p class=\"text-gray-600\">Yes, we provide expert <b>cold room repair services</b> for dairy and pharmaceutical sectors in Anand.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-lg shadow-sm border-l-4 border-yellow-500\">\n                    <h5 class=\"font-bold text-lg mb-2 text-orange-700\">How do I book an AC technician in Anand?</h5>\n                    <p class=\"text-gray-600\">Click the <b>WhatsApp button</b> or call our Anand service desk at <b>+91 97272 57141</b>.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"bg-blue-900 text-white py-12 border-t-4 border-yellow-400\"