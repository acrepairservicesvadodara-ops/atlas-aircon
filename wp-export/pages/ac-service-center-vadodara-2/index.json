Industrial Area\", \"Bapod Industrial Area\", \"Yamuna Mill Industrial Area (Dabhoi Road)\", \"Chhani Industrial Area\", \"Petrochemical Complex (IPCL/PCC) Area\", \"Koyali Refinery Area\", \"Kotambi Industrial Park\", \"Jarod Industrial Area\", \"Samlaya Industrial Area\", \"Tundav Industrial Area\", \"Lamdapura Industrial Area\", \"Muval Industrial Area\", \"Desar Industrial Area\", \"Sanvadodara GIDC\", \"Dabhoi GIDC\", \"Pavi-Jetpur GIDC\", \"Bodeli Industrial Area\", \"Padra Industrial Area\", \"Ekalbara Industrial Area\", \"Jambusar Road Industrial Zone\", \"Atladra Industrial Area\", \"Sokhada Industrial Area\", \"Dashrath Industrial Estate\", \"Bajwa Industrial Area\", \"Karjan Industrial Area\", \"Miyagam Karjan GIDC\", \"Vadsar Industrial Area\", \"Maneja Industrial Area\", \"Maretha Industrial Zone\", \"Nexus Industrial Park (Kotambi)\", \"Shah Industrial Park (Kotambi/Manjusar)\", \"Brushellz Industrial Park (Chhani)\", \"Avani Industrial Park\", \"Krishna Industrial Park (Halol Highway)\", \"Gokul Industrial Estate\", \"Fortune Industrial Park (Savli)\", \"Halol GIDC\", \"Kalol GIDC\", \"Baska Industrial Area\", \"Tajpura Industrial Area\"];\n        \n        const allAreas = [...residential, ...industrial];\n\n        function renderAreas(list) {\n            const grid = document.getElementById('areaGrid');\n            grid.innerHTML = '';\n            list.forEach(area => {\n                const div = document.createElement('div');\n                div.className = \"bg-slate-800 p-2 rounded border border-slate-700 hover:bg-slate-700 transition cursor-default text-center text-slate-400\";\n                div.textContent = area;\n                grid.appendChild(div);\n            });\n        }\n\n        function filterAreas() {\n            const query = document.getElementById('areaSearch').value.toLowerCase();\n            const filtered = allAreas.filter(a => a.toLowerCase().includes(query));\n            renderAreas(filtered);\n        }\n\n        function solveError() {\n            const code = document.getElementById('errorSelect').value;\n            const hub = document.getElementById('solutionResult');\n            const issue = document.getElementById('issueText');\n            const solution = document.getElementById('solutionText');\n\n            const errors = {\n                \"E1\": [\"Room Temp Sensor Failure\", \"Resistance check of thermistor and card calibration required.\"],\n                \"E4\": [\"Indoor Fan Motor Malfunction\", \"Inspection of winding continuity and starting capacitor replacement.\"],\n                \"F1\": [\"Inverter Board Phase Error\", \"Diagnosis of power module (IPM) and voltage regulation check.\"],\n                \"C6\": [\"Inter-unit Communication Error\", \"Verification of L-N-S wiring and signal card test.\"],\n                \"P4\": [\"IPM Overheat Protection\", \"Full cleaning of outdoor condenser fins and heat sink paste reapplication.\"],\n                \"EC\": [\"Refrigerant Leakage Alarm\", \"Nitrogen pressure testing, brazing leak points, and gas refill.\"]\n            };\n\n            if (errors[code]) {\n                hub.classList.remove('hidden');\n                issue.textContent = errors[code][0];\n                solution.textContent = errors[code][1];\n            } else {\n                hub.classList.add('hidden');\n            }\n        }\n\n        function initChart() {\n            const ctx = document.getElementById('priceChart').getContext('2d');\n            new Chart(ctx, {\n                type: 'bar',\n                data: {\n                    labels: ['Service', 'Gas Charge', 'PCB Repair', 'Capacitor', 'Compressor'],\n                    datasets: [{\n                        label: 'Average Charge (₹)',\n                        data: [750, 3500, 2500, 650, 8500],\n                        backgroundColor: '#2563eb',\n                        borderRadius: 12\n                    }]\n                },\n   