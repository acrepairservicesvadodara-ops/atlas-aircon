m border border-slate-100 lg:col-span-2\">\n                    <h3 class=\"text-xs font-black text-blue-600 uppercase tracking-widest mb-6\">Expert Brand Servicing (Out-of-Warranty)</h3>\n                    <div class=\"grid grid-cols-2 gap-x-4 gap-y-3 text-xs text-slate-500\">\n                        <a href=\"#\" class=\"hover:text-blue-600\"><strong>Blue Star AC Service Center Vadodara</strong></a>\n                        <a href=\"#\" class=\"hover:text-blue-600\"><strong>Carrier AC Service Center Vadodara</strong></a>\n                        <a href=\"#\" class=\"hover:text-blue-600\">Electrolux Service</a>\n                        <a href=\"#\" class=\"hover:text-blue-600\"><strong>Haier AC Service Center Vadodara</strong></a>\n                        <a href=\"#\" class=\"hover:text-blue-600\"><strong>Hitachi AC Service Center Vadodara</strong></a>\n                        <a href=\"#\" class=\"hover:text-blue-600\">Kelvinator Service</a>\n                        <a href=\"#\" class=\"hover:text-blue-600\"><strong>LG AC Service Center Vadodara</strong></a>\n                        <a href=\"#\" class=\"hover:text-blue-600\">Mitsubishi Service</a>\n                        <a href=\"#\" class=\"hover:text-blue-600\">O General Service</a>\n                        <a href=\"#\" class=\"hover:text-blue-600\">Onida Service</a>\n                        <a href=\"#\" class=\"hover:text-blue-600\">Panasonic Service</a>\n                        <a href=\"#\" class=\"hover:text-blue-600\"><strong>Daikin AC Service Center Vadodara</strong></a>\n                        <a href=\"#\" class=\"hover:text-blue-600\"><strong>Samsung AC Service Center Vadodara</strong></a>\n                        <a href=\"#\" class=\"hover:text-blue-600\"><strong>Voltas AC Service Center Vadodara</strong></a>\n                        <a href=\"#\" class=\"hover:text-blue-600\">York Service</a>\n                    </div>\n                </div>\n                <!-- Group 3: Spares -->\n                <div class=\"bg-white p-6 rounded-3xl shadow-sm border border-slate-100\">\n                    <h3 class=\"text-xs font-black text-blue-600 uppercase tracking-widest mb-6\">Technical Parts</h3>\n                    <div class=\"flex flex-wrap gap-2\">\n                        <a href=\"#\" class=\"px-2 py-1 bg-slate-50 rounded text-[10px] font-bold text-slate-500 hover:bg-blue-50 transition\"><strong>AC Remote Repair Vadodara</strong></a>\n                        <a href=\"#\" class=\"px-2 py-1 bg-slate-50 rounded text-[10px] font-bold text-slate-500 hover:bg-blue-50 transition\"><strong>AC Copper Pipe Vadodara</strong></a>\n                        <a href=\"#\" class=\"px-2 py-1 bg-slate-50 rounded text-[10px] font-bold text-slate-500 hover:bg-blue-50 transition\"><strong>AC Gas Charging Vadodara</strong></a>\n                        <a href=\"#\" class=\"px-2 py-1 bg-slate-50 rounded text-[10px] font-bold text-slate-500 hover:bg-blue-50 transition\"><strong>AC PCB Repair Vadodara</strong></a>\n                        <a href=\"#\" class=\"px-2 py-1 bg-slate-50 rounded text-[10px] font-bold text-slate-500 hover:bg-blue-50 transition\"><strong>AC Compressor Replacement Vadodara</strong></a>\n                        <a href=\"#\" class=\"px-2 py-1 bg-slate-50 rounded text-[10px] font-bold text-slate-500 hover:bg-blue-50 transition\"><strong>AC Capacitor Vadodara</strong></a>\n                        <a href=\"#\" class=\"px-2 py-1 bg-slate-50 rounded text-[10px] font-bold text-slate-500 hover:bg-blue-50 transition\"><strong>AC Spare Parts Vadodara</strong></a>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Unit Types Image Section -->\n            <div class=\"mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n                <a href=\"#\" class=\"group relative rounded-2xl overflow-hidden aspect-video shadow-md\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/Window-ac-repair-service.webp\" class=\"w-full h-full object-cover group-hover:scale-110 transition duration-500\" alt=\"Window AC Service\" title=\"\">\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex items-end p-4\">\n                        <span class=\"text-white text-xs font-bold uppercase\"><strong>Window AC Service Center Vadodara</strong></span>\n                    </div>\n                </a>\n                <a href=\"#\" class=\"group relative rounded-2xl overflow-hidden aspect-video shadow-md\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/chiller-service-in-vadodara.webp\" class=\"w-full h-full object-cover group-hover:scale-110 transition duration-500\" alt=\"Split AC Service\" title=\"\">\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex items-end p-4\">\n                        <span class=\"text-white text-xs font-bold uppercase\"><strong>Split AC Service Center Vadodara</strong></span>\n                    </div>\n                </a>\n                <a href=\"#\" class=\"group relative rounded-2xl overflow-hidden aspect-video shadow-md\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/advance-panel-ac-repair-service.webp\" class=\"w-full h-full object-cover group-hover:scale-110 transition duration-500\" alt=\"Panel AC Repair\" title=\"\">\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex items-end p-4\">\n                        <span class=\"text-white text-xs font-bold uppercase\"><strong>Industrial AC Service Center Vadodara</strong></span>\n                    </div>\n                </a>\n                <a href=\"#\" class=\"group relative rounded-2xl overflow-hidden aspect-video shadow-md\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/04/Air-cooler-repair-service-vadodara.webp\" class=\"w-full h-full object-cover group-hover:scale-110 transition duration-500\" alt=\"Air Cooler Repair\" title=\"\">\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex items-end p-4\">\n                        <span class=\"text-white text-xs font-bold uppercase\">Air Coolers</span>\n                    </div>\n                </a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Diagnostic Hub -->\n    <section id=\"diagnose\" class=\"py-24 bg-white\">\n        <div class=\"max-w-4xl mx-auto px-4\">\n            <div class=\"text-center mb-16\">\n                <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/02/Emergency-AC-Breakdown-Atlas-Aircon.webp\" class=\"w-full h-64 object-cover rounded-3xl shadow-xl mb-12\" alt=\"Emergency Breakdown\" title=\"\">\n                <h2 class=\"text-4xl font-black text-slate-900 mb-4\"><strong>AC Troubleshooting Vadodara</strong></h2>\n                <p class=\"text-slate-500\">Expert diagnosis for <strong>AC Not Cooling Repair Vadodara</strong>, <strong>AC Water Leakage Repair Vadodara</strong>, and <strong>AC Fan Motor Repair Vadodara</strong>.</p>\n            </div>\n\n            <div class=\"bg-slate-50 rounded-[40px] p-8 lg:p-12 border border-slate-100 shadow-inner\">\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-10\">\n                    <div>\n                        <label class=\"block text-[10px] font-black text-blue-600 uppercase tracking-widest mb-4\">Select Error Code</label>\n                        <select id=\"errorSelect\" onchange=\"solveError()\" class=\"w-full p-4 rounded-2xl border-2 border-white bg-white shadow-sm focus:border-blue-500 outline-none transition font-bold text-slate-800\">\n                            <option value=\"\">&#8212; Choose Display Code &#8212;</option>\n                            <option value=\"E1\">E1 / E2 &#8211; Temp Sensor (Thermostat)</option>\n                            <option value=\"E4\">E4 &#8211; Fan Motor Issue</option>\n                            <option value=\"F1\">F1 / F2 &#8211; Board Phase Error</option>\n                            <option value=\"C6\">C6 &#8211; Comm. Error</option>\n                            <option value=\"P4\">P4 &#8211; Inverter Heat</option>\n                            <option value=\"EC\">EC &#8211; Leak Warning (Gas)</option>\n                        </select>\n                        <div id=\"solutionResult\" class=\"mt-8 hidden fade-in\">\n                            <h4 class=\"text-sm font-black text-slate-900 uppercase mb-2\">Technical Analysis:</h4>\n                            <p id=\"issueText\" class=\"text-slate-600 mb-4 italic\"></p>\n                            <div class=\"p-4 bg-white rounded-2xl border border-slate-200\">\n                                <p class=\"text-xs font-bold text-blue-600 mb-1 uppercase\">Center Solution:</p>\n                                <p id=\"solutionText\" class=\"text-sm text-slate-800 font-semibold\"></p>\n                                <p class=\"text-xs text-slate-400 mt-2\">Services: <strong>AC Thermostat Sensor Repair Vadodara</strong>, <strong>AC Swing Motor Repair Vadodara</strong></p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex flex-col justify-center\">\n                        <div class=\"p-6 bg-blue-600 rounded-3xl text-white shadow-xl shadow-blue-200\">\n                            <i class=\"fas fa-info-circle text-2xl mb-4 text-blue-200\"></i>\n                            <p class=\"text-sm leading-relaxed mb-6 font-medium\">As a <strong>Trusted AC Service Center Vadodara</strong>, we maintain a vast library of diagnostic tools. We handle <strong>AC Gas Leak Repair Vadodara</strong> and component-level fixes.</p>\n                            <a href=\"https://wa.me/919727257141\" class=\"block w-full text-center py-3 bg-white text-blue-600 rounded-xl font-bold uppercase text-[11px] tracking-wider hover:bg-blue-50 transition\" target=\"_blank\" rel=\"noopener\">Request Center Visit</a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Pricing Section -->\n    <section id=\"pricing\" class=\"py-24 bg-slate-50\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\">\n                <div>\n                    <h2 class=\"text-4xl font-black text-slate-900 mb-6\">Price Comparison &#038; Estimator</h2>\n                    <p class=\"text-slate-500 mb-8 leading-relaxed\">\n                        At Atlas Aircon, we prioritize transparency. Our <strong>Affordable AC Service Vadodara</strong> rates are competitive. Check our <strong>AC Service Charges Vadodara</strong> below.\n                    </p>\n                    \n                    <div class=\"space-y-4 mb-8\">\n                        <div class=\"p-4 bg-white rounded-2xl border border-slate-100 flex justify-between items-center shadow-sm\">\n                            <span class=\"text-xs font-bold text-slate-600\"><strong>AC Jet Service Vadodara</strong> (Cleaning)</span>\n                            <span class=\"text-xs font-black text-blue-600\">₹599 &#8211; ₹899</span>\n                        </div>\n                        <div class=\"p-4 bg-white rounded-2xl border border-slate-100 flex justify-between items-center shadow-sm\">\n                            <span class=\"text-xs font-bold text-slate-600\"><strong>AC Gas Filling Center Vadodara</strong> (Full)</span>\n                            <span class=\"text-xs font-black text-blue-600\">₹2500 &#8211; ₹4500</span>\n                        </div>\n                        <div class=\"p-4 bg-white rounded-2xl border border-slate-100 flex justify-between items-center shadow-sm\">\n                            <span class=\"text-xs font-bold text-slate-600\"><strong>AC Installation Service Vadodara</strong></span>\n                            <span class=\"text-xs font-black text-blue-600\">₹1200 &#8211; ₹1500</span>\n                        </div>\n                        <div class=\"p-4 bg-white rounded-2xl border border-slate-100 flex justify-between items-center shadow-sm\">\n                            <span class=\"text-xs font-bold text-slate-600\"><strong>AC Uninstallation Service Vadodara</strong></span>\n                            <span class=\"text-xs font-black text-blue-600\">₹600 &#8211; ₹800</span>\n                        </div>\n                    </div>\n\n                    <a href=\"#\" class=\"text-xs font-black text-blue-600 uppercase tracking-widest flex items-center gap-2 hover:gap-3 transition-all\">\n                        View <strong>AC Installation Charges Vadodara</strong> &#038; List <i class=\"fas fa-arrow-right\"></i>\n                    </a>\n                </div>\n\n                <div class=\"bg-white p-8 rounded-[40px] shadow-2xl shadow-slate-200 border border-slate-100\">\n                    <h3 class=\"text-center text-[10px] font-black text-slate-400 uppercase tracking-widest mb-6\">Repair Cost Distribution</h3>\n                    <div class=\"chart-container\">\n                        <canvas id=\"priceChart\"></canvas>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Detailed Keyword Integration Section (SEO Content Block) -->\n    <section class=\"py-20 bg-white border-t border-slate-100\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <h2 class=\"text-2xl font-black text-slate-900 mb-8\">Service Capabilities &#038; Coverage</h2>\n            \n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 text-sm text-slate-600\">\n                <!-- Column 1: Service Types -->\n                <div class=\"space-y-4\">\n                    <h3 class=\"font-bold text-blue-600 uppercase text-xs tracking-widest\">Maintenance &#038; Plans</h3>\n                    <p class=\"leading-relaxed\">\n                        We offer comprehensive <strong>AC Maintenance Service Vadodara</strong> and <strong>AC AMC Vadodara</strong> (Annual Maintenance Contract). Whether you need a <strong>AC Check Up Vadodara</strong> or deep cleaning services like <strong>AC Chemical Wash Service Vadodara</strong> and <strong>AC Deep Cleaning Service Vadodara</strong>, we have you covered.\n                    </p>\n                    <p class=\"leading-relaxed\">\n                        Our technicians perform <strong>AC General Service Vadodara</strong>, <strong>AC Indoor Unit Cleaning Vadodara</strong>, <strong>AC Outdoor Unit Cleaning Vadodara</strong>, and <strong>AC Vent Cleaning Vadodara</strong>.\n                    </p>\n                </div>\n\n                <!-- Column 2: Service Nature -->\n                <div class=\"space-y-4\">\n                    <h3 class=\"font-bold text-blue-600 uppercase text-xs tracking-widest\">Convenience &#038; Type</h3>\n                    <p class=\"leading-relaxed\">\n                        We are a <strong>Walk In AC Service Center Vadodara</strong> also offering <strong>AC Service Center With Pickup And Drop Vadodara</strong>. We are the premier <strong>Commercial AC Service Center Vadodara</strong> and <strong>AC Service Center For Office Vadodara</strong>.\n                    </p>\n                    <p class=\"leading-relaxed\">\n                        Need service on weekends? We are an <strong>AC Service Center Sunday Open Vadodara</strong> and <strong>AC Service Center Open Now Vadodara</strong>. We serve homes, shops and hospitals (<strong>AC Service Center For Home Vadodara</strong>, <strong>AC Service Center For Shop Vadodara</strong>, <strong>AC Service Center For Hospital Vadodara</strong>).\n                    </p>\n                    <p>\n                        We also specialize in <strong>AC Gas Top Up Vadodara</strong>.\n                    </p>\n                </div>\n\n                <!-- Column 3: Locations List -->\n                <div class=\"space-y-4\">\n                    <h3 class=\"font-bold text-blue-600 uppercase text-xs tracking-widest\">Key Locations</h3>\n                    <div class=\"flex flex-wrap gap-2 text-[11px] font-semibold text-slate-500\">\n                        <span><strong>AC Service Center Alkapuri Vadodara</strong>,</span>\n                        <span><strong>AC Service Center Gotri Vadodara</strong>,</span>\n                        <span><strong>AC Service Center Manjalpur Vadodara</strong>,</span>\n                        <span><strong>AC Service Center Waghodia Road Vadodara</strong>,</span>\n                        <span><strong>AC Service Center Fatehganj Vadodara</strong>,</span>\n                        <span><strong>AC Service Center Akota Vadodara</strong>,</span>\n                        <span><strong>AC Service Center Nizampura Vadodara</strong>,</span>\n                        <span><strong>AC Service Center Karelibaug Vadodara</strong>,</span>\n                        <span><strong>AC Service Center Subhanpura Vadodara</strong>,</span>\n                        <span><strong>AC Service Center Tandalja Vadodara</strong>,</span>\n                        <span><strong>AC Service Center Harni Vadodara</strong>,</span>\n                        <span><strong>AC Service Center Makarpura Vadodara</strong>,</span>\n                        <span><strong>AC Service Center Gorwa Vadodara</strong>,</span>\n                        <span><strong>AC Service Center Vasna Road Vadodara</strong>,</span>\n                        <span><strong>AC Service Center Chhani Vadodara</strong>,</span>\n                        <span><strong>AC Service Cente