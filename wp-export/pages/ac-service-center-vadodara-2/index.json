 hover:bg-slate-700 transition cursor-default text-center text-slate-400\";\n                div.textContent = area;\n                grid.appendChild(div);\n            });\n        }\n\n        function filterAreas() {\n            const query = document.getElementById('areaSearch').value.toLowerCase();\n            const filtered = allAreas.filter(a => a.toLowerCase().includes(query));\n            renderAreas(filtered);\n        }\n\n        function solveError() {\n            const code = document.getElementById('errorSelect').value;\n            const hub = document.getElementById('solutionResult');\n            const issue = document.getElementById('issueText');\n            const solution = document.getElementById('solutionText');\n\n            const errors = {\n                \"E1\": [\"Room Temp Sensor Failure\", \"Resistance check of thermistor and card calibration required.\"],\n                \"E4\": [\"Indoor Fan Motor Malfunction\", \"Inspection of winding continuity and starting capacitor replacement.\"],\n                \"F1\": [\"Inverter Board Phase Error\", \"Diagnosis of power module (IPM) and voltage regulation check.\"],\n                \"C6\": [\"Inter-unit Communication Error\", \"Verification of L-N-S wiring and signal card test.\"],\n                \"P4\": [\"IPM Overheat Protection\", \"Full cleaning of outdoor condenser fins and heat sink paste reapplication.\"],\n                \"EC\": [\"Refrigerant Leakage Alarm\", \"Nitrogen pressure testing, brazing leak points, and gas refill.\"]\n            };\n\n            if (errors[code]) {\n                hub.classList.remove('hidden');\n                issue.textContent = errors[code][0];\n                solution.textContent = errors[code][1];\n            } else {\n                hub.classList.add('hidden');\n            }\n        }\n\n        function initChart() {\n            const ctx = document.getElementById('priceChart').getContext('2d');\n            new Chart(ctx, {\n                type: 'bar',\n                data: {\n                    labels: ['Service', 'Gas Charge', 'PCB Repair', 'Capacitor', 'Compressor'],\n                    datasets: [{\n                        label: 'Average Charge (₹)',\n                        data: [750, 3500, 2500, 650, 8500],\n                        backgroundColor: '#2563eb',\n                        borderRadius: 12\n                    }]\n                },\n                options: {\n                    responsive: true,\n                    maintainAspectRatio: false,\n                    scales: {\n                        y: { beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { font: { size: 9 } } },\n                        x: { grid: { display: false }, ticks: { font: { size: 9 } } }\n                    },\n                    plugins: { legend: { display: false } }\n                }\n            });\n        }\n\n        window.onload = () => {\n            renderAreas(allAreas);\n            initChart();\n        };\n    </script>\n\n\n    <!-- Navigation -->\n    <nav class=\"bg-white/90 backdrop-blur-md shadow-sm sticky top-0 z-50 border-b border-slate-100\">\n        <div class=\"max-w-7xl mx-auto px-4 h-16 flex justify-between items-center\">\n            <div class=\"flex items-center gap-2\">\n                <div class=\"w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center text-white shadow-lg\">\n                    <i class=\"fas fa-snowflake animate-pulse\"></i>\n                </div>\n                <div class=\"flex flex-col\">\n                    <span class=\"font-extrabold text-lg leading-tight tracking-tight uppercase\">Atlas Aircon</span>\n                    <span class=\"text-[9px] text-blue-600 font-black uppercase tracking-[0.2em]\">Service Center Vadodara</span>\n                </div>\n            </div>\n            <div class=\"hidden lg:flex space-x-6 text-[11px] font-bold uppercase tracking-wider text-slate-500\">\n                <a