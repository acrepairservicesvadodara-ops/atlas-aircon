y-16 bg-white\">\n            <div class=\"container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl\">\n                <div class=\"text-center mb-12\">\n                    <h2 class=\"font-['Poppins',sans-serif] font-extrabold text-[#1A202C] m-0 text-3xl md:text-5xl mb-6\">Common AC Questions Answered</h2>\n                    <p class=\"text-xl text-gray-600 mt-4\">Everything you need to know before booking an engineer visit.</p>\n                </div>\n                \n                <div class=\"space-y-4 text-left\">\n                    <details class=\"group border border-gray-200 rounded-xl bg-gray-50 hover:border-[#D4AF37] hover:shadow-md transition-all cursor-pointer\">\n                        <summary class=\"flex justify-between items-center font-medium list-none p-6 text-lg text-[#1A202C] outline-none [&#038;::-webkit-details-marker]:hidden\">\n                            <span class=\"font-bold\">How quickly can you fix AC water leakage inside the room?</span>\n                            <span class=\"text-[#D4AF37]\">\n                                <i class=\"fas fa-chevron-down transition-transform duration-300 group-open:rotate-180\"></i>\n                            </span>\n                        </summary>\n                        <div class=\"text-gray-600 px-6 pb-6 text-base\">\n                            <div>\n                                Water leakage usually indicates a blocked drain pipe. Our team uses high-pressure jet pumps to clear the buildup. It&#8217;s a standard <strong>Himalaya AC water leakage repair Vadodara</strong> fix that typically takes 30 to 45 minutes to resolve permanently.\n                            </div>\n                        </div>\n                    </details>\n\n                    <details class=\"group border border-gray-200 rounded-xl bg-gray-50 hover:border-[#D4AF37] hover:shadow-md transition-all cursor-pointer\">\n                        <summary class=\"flex justify-between items-center font-medium list-none p-6 text-lg text-[#1A202C] outline-none [&#038;::-webkit-details-marker]:hidden\">\n                            <span class=\"font-bold\">Are you an official brand-authorized service center?</span>\n                            <span class=\"text-[#D4AF37]\">\n                                <i class=\"fas fa-chevron-down transition-transform duration-300 group-open:rotate-180\"></i>\n                            </span>\n                        </summary>\n                        <div class=\"text-gray-600 px-6 pb-6 text-base\">\n                            <div>\n                                No, we are an <strong>independent repair specialist</strong>. This independence allows us to be much faster than authorized centers, offer more flexible scheduling, and maintain lower overhead costs. We provide our own independent warranty on all work.\n                            </div>\n                        </div>\n                    </details>\n                </div>\n            </div>\n        </section>\n\n    </div>\n\n    <footer class=\"bg-[#1A202C] text-gray-400 py-12 rounded-3xl mt-12 border-t-4 border-[#D4AF37]\">\n        <div class=\"container mx-auto px-4 text-center\">\n            <h3 class=\"text-white font-black text-2xl m-0 tracking-tight\">ATLAS<span class=\"text-[#D4AF37]\">AIRCON</span></h3>\n            <p class=\"text-sm mt-4 max-w-xl mx-auto\">The authority in independent Himalaya air conditioning repairs across Vadodara. Engineering excellence, transparent pricing, and 24/7 reliability.</p>\n            <div class=\"flex justify-center space-x-6 mt-8\">\n                <a href=\"tel:+919727257141\" class=\"text-[#D4AF37] hover:text-white transition-colors text-lg font-bold no-underline flex items-center\">\n                    <i class=\"fas fa-phone-alt mr-2\"></i> +91 97272 57141\n                </a>\n            </div>\n            <p class=\"text-xs mt-8\">&copy; 2026 Atlas Aircon Engineering. All Rights Reserved. Independent 