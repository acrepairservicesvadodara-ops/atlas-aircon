  "content": {
    "rendered": "<div class=\"atlas-purified-matrix\"><style>\n        body { font-family: 'Inter', sans-serif; }\n        .chart-container {\n            position: relative;\n            width: 100%;\n            max-width: 600px;\n            margin-left: auto;\n            margin-right: auto;\n            height: 300px;\n            max-height: 400px;\n        }\n        @media (min-width: 768px) { .chart-container { height: 350px; } }\n        .custom-scroll::-webkit-scrollbar { width: 4px; }\n        .custom-scroll::-webkit-scrollbar-thumb { background: #059669; border-radius: 10px; }\n        .fade-in { animation: fadeIn 0.6s ease-out; }\n        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }\n        .tab-active { border-bottom: 3px solid #059669; color: #059669; }\n    </style>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n<script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"LocalBusiness\",\n      \"name\": \"Atlas Aircon Kheda\",\n      \"image\": \"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\",\n      \"@id\": \"https://atlasaircons.com/kheda\",\n      \"url\": \"https://atlasaircons.com/kheda\",\n      \"telephone\": \"+91 97272 57141\",\n      \"email\": \"atlasaircon1@gmail.com\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"addressLocality\": \"Kheda\",\n        \"addressRegion\": \"Gujarat\",\n        \"postalCode\": \"387001\",\n        \"addressCountry\": \"IN\"\n      },\n      \"geo\": {\n        \"@type\": \"GeoCoordinates\",\n        \"latitude\": 22.7533,\n        \"longitude\": 72.6841\n      },\n      \"openingHoursSpecification\": {\n        \"@type\": \"OpeningHoursSpecification\",\n        \"dayOfWeek\": [\n          \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\", \"Sunday\"\n        ],\n        \"opens\": \"00:00\",\n        \"closes\": \"23:59\"\n      }\n    }\n    </script>\n<script>\n        const residential = [\n            \"Nadiad City\", \"Kheda City\", \"Dakor\", \"Mehmedabad\", \"Matar\", \"Thasra\", \"Mahudha\", \"Kapadvanj\", \"Vaso\", \n            \"Galteshwar\", \"Vallabh Vidyanagar Boundary\", \"Karamsad Boundary\", \"Mogar Boundary\", \"Sanskarsar\", \n            \"Civil Hospital Area\", \"Station Road Nadiad\", \"College Road\", \"Dabhan\", \"Pij Road\", \"Uttarsanda\", \n            \"Chaklasi\", \"Alina\", \"Limbasi\", \"Salun\", \"Vina\", \"Tundel\", \"Palana\", \"Narsanda\"\n        ];\n        \n        const industrial = [\n            \"Nadiad GIDC\", \"Kheda Industrial Estate\", \"Mehmedabad Industrial Zone\", \"Kapadvanj Industrial Area\", \n            \"Thasra GIDC\", \"Matar Industrial Belt\", \"Bareja Boundary Estates\", \"Dabhan Industrial Units\",\n            \"Pij Industrial Clusters\", \"Highway Roadside Industrial Zone\"\n        ];\n        \n        const allAreas = [...residential, ...industrial];\n\n        function renderAreas(list) {\n            const grid = document.getElementById('areaGrid');\n            grid.innerHTML = '';\n            list.forEach(area => {\n                const div = document.createElement('div');\n                div.className = \"bg-slate-800 p-2 rounded border border-slate-700 hover:bg-slate-700 transition cursor-default text-center text-slate-400\";\n                div.textContent = area;\n                grid.appendChild(div);\n            });\n        }\n\n        function filterAreas() {\n            const query = document.getElementById('areaSearch').value.toLowerCase();\n            const filtered = allAreas.filter(a => a.toLowerCase().includes(query));\n            renderAreas(filtered);\n        }\n\n        function switchTab(tab) {\n            // Hide all\n            document.getElementById('content-brands').classList.add('hidden');\n            document.getElementById('content-units').classList.add('hidden');\n            document.getElementById('content-spares').classList.add('hidden');\n            \n            // Unset active class\n            document.getElementById('tab-brands').classList.remove('tab-active');\n            document.getElementById('tab-units').classList.remove('tab-active');\n            document.getElementById('tab-spares').classList.remove('tab-active');\n            document.getElementById('tab-brands').classList.add('text-slate-400');\n            document.getElementById('tab-units').classList.add('text-slate-400');\n            document.getElementById('tab-spares').classList.add('text-slate-400');\n\n            // Show selected\n            document.getElementById('content-' + tab).classList.remove('hidden');\n            document.getElementById('tab-' + tab).classList.add('tab-active');\n            document.getElementById('tab-' + tab).classList.remove('text-slate-400');\n        }\n\n        function solveError() {\n            const code = document.getElementById('errorSelect').value;\n            const hub = document.getElementById('solutionResult');\n            const issue = document.getElementById('issueText');\n            const solution = document.getElementById('solutionText');\n\n            const errors = {\n                \"E1\": [\"Room Temp Sensor Failure\", \"Pollen/Dust obstruction related sensor fail; resistance check and PCB calibration needed.\"],\n                \"E4\": [\"Indoor Fan Motor Malfunction\", \"Motor winding check and starting capacitor replacement for inland high-heat units.\"],\n                \"F1\": [\"Inverter Board Phase Error\", \"Diagnosis of IPM module and local voltage stabilizer check for Kheda grid.\"],\n                \"C6\": [\"Inter-unit Communication Error\", \"Verification of L-N-S signal wiring and card test for environmentally stressed units.\"],\n                \"P4\": [\"IPM Overheat Protection\", \"Full cleaning of outdoor condenser fins and heat sink paste reapplication.\"],\n                \"EC\": [\"Refrigerant Leakage Alarm\", \"Nitrogen pressure testing, brazing leak points, and gas refill.\"]\n            };\n\n            if (errors[code]) {\n                hub.classList.remove('hidden');\n                issue.textContent = errors[code][0];\n                solution.textContent = errors[code][1];\n            } else {\n                hub.classList.add('hidden');\n            }\n        }\n\n        function initChart() {\n            const ctx = document.getElementById('priceChart').getContext('2d');\n            new Chart(ctx, {\n                type: 'bar',\n                data: {\n                    labels: ['Service', 'Gas Fill', 'PCB Fix', 'Capacitor', 'Compressor'],\n                    datasets: [{\n                        label: 'Avg Kheda Charge (₹)',\n                        data: [800, 3500, 2800, 650, 9500],\n                        backgroundColor: '#059669',\n                        borderRadius: 12\n                    }]\n                },\n                options: {\n                    responsive: true,\n                    maintainAspectRatio: false,\n                    scales: {\n                        y: { beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { font: { size: 9 } } },\n                        x: { grid: { display: false }, ticks: { font: { size: 9 } } }\n                    },\n                    plugins: { legend: { display: false } }\n                }\n            });\n        }\n\n        window.onload = () => {\n            renderAreas(allAreas);\n            initChart();\n        };\n    </script>\n\n\n    <!-- Navigation -->\n    <nav class=\"bg-white/95 backdrop-blur-md shadow-sm sticky top-0 z-50 border-b border-emerald-100\">\n        <div class=\"max-w-7xl mx-auto px-4 h-16 flex justify-between items-center\">\n            <div class=\"flex items-center gap-2\">\n                <div class=\"w-10 h-10 bg-emerald-600 rounded-xl flex items-center justify-center text-white shadow-lg shadow-emerald-100\">\n                    <i class=\"fas fa-snowflake animate-pulse\"></i>\n                </div>\n                <div class=\"flex flex-col\">\n                    <span class=\"font-extrabold text-lg leading-tight tracking-tight uppercase\">Atlas Aircon</span>\n                    <span class=\"text-[9px] text-emerald-600 font-black uppercase tracking-[0.2em]\">Service Center Kheda</span>\n                </div>\n            </div>\n            <div class=\"hidden lg:flex space-x-6 text-[11px] font-bold uppercase tracking-wider text-slate-500\">\n                <a href=\"#directory\" class=\"hover:text-emerald-600 transition\">Tabbed Directory</a>\n                <a href=\"#diagnose\" class=\"hover:text-emerald-600 transition\">Diagnostics</a>\n                <a href=\"#pricing\" class=\"hover:text-emerald-600 transition\">Estimates</a>\n                <a href=\"#areas\" class=\"hover:text-emerald-600 transition\">Kheda Coverage</a>\n            </div>\n            <a href=\"https://wa.me/919727257141\" target=\"_blank\" class=\"bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-full text-xs font-black shadow-md transition flex items-center gap-2\" rel=\"noopener\">\n                <i class=\"fab fa-whatsapp\"></i> +91 97272 57141\n            </a>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <header class=\"relative bg-white border-b border-slate-100 overflow-hidden\">\n        <div class=\"max-w-7xl mx-auto px-4 py-16 lg:py-28\">\n            <div class=\"lg:flex lg:items-center lg:gap-20\">\n                <div class=\"lg:w-1/2 text-center lg:text-left fade-in\">\n                    <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-600 text-[10px] font-bold uppercase tracking-widest mb-6\">\n                        <i class=\"fas fa-leaf\"></i> Charotar Regional Excellence\n                    </div>\n                    <h1 class=\"text-5xl lg:text-7xl font-black text-slate-900 leading-[1.05] mb-6 tracking-tighter\">\n                        Premier <span class=\"text-emerald-600\">AC Service Center Kheda</span>\n                    </h1>\n                    <p class=\"text-lg text-slate-500 mb-4 leading-relaxed max-w-xl mx-auto lg:mx-0\">\n                        Independent cooling specialists serving Kheda, Nadiad, and Dakor with rapid doorstep repairs and multi-brand expertise.\n                    </p>\n                    <p class=\"text-sm font-bold text-red-600 mb-8 uppercase tracking-wide\">\n                        *Independent Specialist: We repair all major brands (Out-of-Warranty).\n                    </p>\n                    <div class=\"flex flex-wrap justify-center lg:justify-start gap-4\">\n                        <a href=\"#directory\" class=\"px-8 py-4 bg-slate-900 text-white rounded-2xl font-bold shadow-xl hover:bg-slate-800 transition\">Browse Hub</a>\n                        <a href=\"https://wa.me/919727257141\" class=\"px-8 py-4 bg-emerald-50 text-emerald-700 rounded-2xl font-bold hover:bg-emerald-100 transition\" target=\"_blank\" rel=\"noopener\">Emergency Visit</a>\n                    </div>\n                </div>\n                <div class=\"lg:w-1/2 mt-12 lg:mt-0 relative\">\n                    <img decoding=\"async\" class=\"rounded-[40px] shadow-2xl border-8 border-slate-50 transform hover:-rotate-1 transition duration-500\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/Atlas-aircon-vehicle.webp\" alt=\"AC Service Center Kheda Mobile Van\" title=\"\">\n                    <div class=\"absolute -top-6 -right-6 bg-emerald-600 text-white p-6 rounded-3xl shadow-xl\">\n                        <p class=\"text-xs font-bold uppercase opacity-80\">District Hub</p>\n                        <p class=\"text-2xl font-black\">Nadiad Center</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- Knowledge Section: District Specific -->\n    <section class=\"py-16 bg-slate-50\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n                <div class=\"lg:col-span-2 bg-white p-8 lg:p-12 rounded-[40px] shadow-sm border border-slate-100\">\n                    <h2 class=\"text-3xl font-black text-slate-900 mb-6 tracking-tight\">Charotar Cooling Solutions</h2>\n                    <p class=\"text-slate-600 leading-relaxed mb-6\">\n                        The Kheda district, known for its lush agriculture and the bustling industrial growth of Nadiad, presents a unique environment for AC units. High levels of pollen and dust from Charotar’s fields often clog outdoor units, leading to high electricity bills and poor cooling performance in areas like <strong>Mehmedabad</strong> and <strong>Matar</strong>.\n                    </p>\n                    <p class=\"text-slate-600 leading-relaxed\">\n                        As an independent <strong>AC service center in Kheda</strong>, Atlas Aircon provides specialized jet-washing techniques that deep-clean evaporator coils, ensuring peak efficiency even in peak summer. We are experts in repairing out-of-warranty units from brands like LG, Samsung, and Voltas, focusing on component-level PCB fixes that save you from expensive motherboard replacements.\n                    </p>\n                </div>\n                <div class=\"bg-emerald-600 rounded-[40px] p-8 text-white flex flex-col justify-center\">\n                    <h3 class=\"text-xl font-bold mb-4\">Why Atlas in Kheda?</h3>\n                    <ul class=\"space-y-4 text-sm font-medium text-emerald-50\">\n                        <li class=\"flex items-center gap-3\"><i class=\"fas fa-check-circle\"></i> Rapid service in Nadiad GIDC</li>\n                        <li class=\"flex items-center gap-3\"><i class=\"fas fa-check-circle\"></i> specialized pollen filters</li>\n                        <li class=\"flex items-center gap-3\"><i class=\"fas fa-check-circle\"></i> independent brand specialists</li>\n                        <li class=\"flex items-center gap-3\"><i class=\"fas fa-check-circle\"></i> fixed pricing for the district</li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- DIFFERENT: Tabbed Interactive Directory Hub -->\n    <section id=\"directory\" class=\"py-20 bg-white\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"text-center mb-12\">\n                <h2 class=\"text-4xl font-black text-slate-900 tracking-tight mb-4\">Kheda Service Hub Directory</h2>\n                <p class=\"text-slate-500 max-w-2xl mx-auto\">Explore specific portals for brands, unit types, and technical spare parts available at our center.</p>\n            </div>\n\n            <!-- Tab Navigation -->\n            <div class=\"flex justify-center border-b border-slate-100 mb-12\">\n                <button onclick=\"switchTab('brands')\" id=\"tab-brands\" class=\"px-6 py-3 text-xs font-black uppercase tracking-widest tab-active transition-all\">Brand Centers</button>\n                <button onclick=\"switchTab('units')\" id=\"tab-units\" class=\"px-6 py-3 text-xs font-black uppercase tracking-widest text-slate-400 hover:text-emerald-600 transition-all\">Unit Types</button>\n                <button onclick=\"switchTab('spares')\" id=\"tab-spares\" class=\"px-6 py-3 text-xs font-black uppercase tracking-widest text-slate-400 hover:text-emerald-600 transition-all\">Tech &#038; Spares</button>\n            </div>\n\n            <!-- Tab Content -->\n            <div id=\"content-brands\" class=\"fade-in\">\n                <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4\">\n                    <a href=\"/blue-star-ac-service-center-kheda\" class=\"p-4 bg-slate-50 rounded-2xl text-center text-xs font-bold text-slate-600 hover:bg-emerald-50 hover:text-emerald-600 transition\">Blue Star</a>\n                    <a href=\"/carrier-ac-service-center-kheda\" class=\"p-4 bg-slate-50 rounded-2xl text-center text-xs font-bold text-slate-600 hover:bg-emerald-50 hover:text-emerald-600 transition\">Carrier</a>\n                    <a href=\"/daikin-ac-service-center-kheda\" class=\"p-4 bg-slate-50 rounded-2xl text-center text-xs font-bold text-slate-600 hover:bg-emerald-50 hover:text-emerald-600 transition\">Daikin</a>\n                    <a href=\"/lg-ac-service-center-kheda\" class=\"p-4 bg-slate-50 rounded-2xl text-center text-xs font-bold text-slate-600 hover:bg-emerald-50 hover:text-emerald-600 transition\">LG</a>\n                    <a href=\"/samsung-ac-service-center-kheda\" class=\"p-4 bg-slate-50 rounded-2xl text-center text-xs font-bold text-slate-600 hover:bg-emerald-50 hover:text-emerald-600 transition\">Samsung</a>\n                    <a href=\"/voltas-ac-service-center-kheda\" class=\"p-4 bg-slate-50 rounded-2xl text-center text-xs font-bold text-slate-600 hover:bg-emerald-50 hover:text-emerald-600 transition\">Voltas</a>\n                    <a href=\"/hitachi-ac-service-center-kheda\" class=\"p-4 bg-slate-50 rounded-2xl text-center text-xs font-bold text-slate-600 hover:bg-emerald-50 hover:text-emerald-600 transition\">Hitachi</a>\n                    <a href=\"/mitsubishi-ac-service-center-kheda\" class=\"p-4 bg-slate-50 rounded-2xl text-center text-xs font-bold text-slate-600 hover:bg-emerald-50 hover:text-emerald-600 transition\">Mitsubishi</a>\n                    <a href=\"/panasonic-ac-service-center-kheda\" class=\"p-4 bg-slate-50 rounded-2xl text-center text-xs font-bold text-slate-600 hover:bg-emerald-50 hover:text-emerald-600 transition\">Panasonic</a>\n                    <a href=\"/o-general-ac-service-center-kheda\" class=\"p-4 bg-slate-50 rounded-2xl text-center text-xs font-bold text-slate-600 hover:bg-emerald-50 hover:text-emerald-600 transition\">O General</a>\n                </div>\n            </div>\n\n            <div id=\"content-units\" class=\"hidden fade-in\">\n                <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n                    <a href=\"/split-ac-service-kheda\" class=\"group block bg-slate-900 rounded-3xl overflow-hidden aspect-video relative\">\n                        <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/Window-ac-repair-service.webp\" class=\"w-full h-full object-cover opacity-60 group-hover:scale-110 transition duration-500\" alt=\"ac service center kheda - Field Operations\" title=\"\">\n                        <span class=\"absolute bottom-4 left-4 text-white text-xs font-black uppercase tracking-widest\">Split &#038; Window Portals</span>\n                    </a>\n                    <a href=\"/cassette-ac-service-kheda\" class=\"group block bg-slate-900 rounded-3xl overflow-hidden aspect-video relative\">\n                        <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/advance-panel-ac-repair-service.webp\" class=\"w-full h-full object-cover opacity-60 group-hover:scale-110 transition duration-500\" alt=\"ac service center kheda - Field Operations\" title=\"\">\n                        <span class=\"absolute bottom-4 left-4 text-white text-xs font-black uppercase tracking-widest\">Cassette &#038; Ductable</span>\n                    </a>\n                    <a href=\"/industrial-chiller-kheda\" class=\"group block bg-slate-900 rounded-3xl overflow-hidden aspect-video relative\">\n                        <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/chiller-service-in-vadodara.webp\" class=\"w-full h-full object-cover opacity-60 group-hover:scale-110 transition duration-500\" alt=\"ac service center kheda - Field Operations\" title=\"\">\n                        <span class=\"absolute bottom-4 left-4 text-white text-xs font-black uppercase tracking-widest\">Chillers &#038; Industrial</span>\n                    </a>\n                    <a href=\"/air-cooler-service-kheda\" class=\"group block bg-slate-900 rounded-3xl overflow-hidden aspect-video relative\">\n                        <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/04/Air-cooler-repair-service-vadodara.webp\" class=\"w-full h-full object-cover opacity-60 group-hover:scale-110 transition duration-500\" alt=\"ac service center kheda - Field Operations\" title=\"\">\n                        <span class=\"absolute bottom-4 left-4 text-white text-xs font-black uppercase tracking-widest\">Air Coolers Hub</span>\n                    </a>\n                </div>\n            </div>\n\n            <div id=\"content-spares\" class=\"hidden fade-in\">\n                <div class=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n                    <a href=\"/remote-kheda/\" class=\"p-6 bg-slate-50 border-2 border-dashed border-slate-200 rounded-3xl text-center group hover:border-emerald-500 transition\">\n                        <i class=\"fas fa-wifi text-emerald-600 mb-2\"></i>\n                        <p class=\"text-sm font-black text-slate-900 uppercase\">Remote Control</p>\n                    </a>\n                    <a href=\"/pcb-repair-kheda\" class=\"p-6 bg-slate-50 border-2 border-dashed border-slate-200 rounded-3xl text-center group hover:border-emerald-500 transition\">\n                        <i class=\"fas fa-microchip text-emerald-600 mb-2\"></i>\n                        <p class=\"text-sm font-black text-slate-900 uppercase\">PCB Circuit Fix</p>\n                    </a>\n                    <a href=\"/gas-charging-kheda/\" class=\"p-6 bg-slate-50 border-2 border-dashed border-slate-200 rounded-3xl text-center group hover:border-emerald-500 transition\">\n                        <i class=\"fas fa-gas-pump text-emerald-600 mb-2\"></i>\n                        <p class=\"text-sm font-black text-slate-900 uppercase\">Gas Refilling</p>\n                    </a>\n                    <a href=\"/compressor-kheda\" class=\"p-6 bg-slate-50 border-2 border-dashed border-slate-200 rounded-3xl text-center group hover:border-emerald-500 transition\">\n                        <i class=\"fas fa-cogs text-emerald-600 mb-2\"></i>\n                        <p class=\"text-sm font-black text-slate-900 uppercase\">OEM Compressor</p>\n                    </a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Diagnostic Hub: Interaction Focus -->\n    <section id=\"diagnose\" class=\"py-24 bg-slate-50\">\n        <div class=\"max-w-5xl mx-auto px-4\">\n            <div class=\"lg:flex lg:items-center lg:gap-16\">\n                <div class=\"lg:w-1/2 mb-12 lg:mb-0\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/02/Emergency-AC-Breakdown-Atlas-Aircon.webp\" class=\"rounded-[40px] shadow-2xl mb-8\" alt=\"Emergency Breakdown Kheda\" title=\"\">\n                    <h2 class=\"text-4xl font-black text-slate-900 mb-6\">Charotar Diagnostic Hub</h2>\n                    <p class=\"text-slate-500 leading-relaxed mb-6\">\n                        Before scheduling an appointment at our <strong>AC Service Center Kheda</strong> hub, use this interactive troubleshooter. We identify fault codes for residential units and high-capacity industrial units common across Charotar factories.\n                    </p>\n                    <div class=\"p-6 bg-emerald-600 rounded-3xl text-white shadow-xl shadow-emerald-100\">\n                        <p class=\"text-sm font-medium mb-4 italic\">&#8220;We provide component-level PCB repairs in Nadiad, ensuring units are optimized for Kheda&#8217;s environmental agricultural dust stresses.&#8221;</p>\n                        <a href=\"https://wa.me/919727257141\" class=\"inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-widest\" target=\"_blank\" rel=\"noopener\">Connect with Kheda Center <i class=\"fas fa-arrow-right\"></i></a>\n                    </div>\n                </div>\n                <div class=\"lg:w-1/2\">\n                    <div class=\"bg-white rounded-[50px] p-10 shadow-2xl border border-emerald-50\">\n                        <label class=\"block text-[10px] font-black text-emerald-600 uppercase tracking-[0.2em] mb-4\">Select Error Code</label>\n                        <select id=\"errorSelect\" onchange=\"solveError()\" class=\"w-full p-5 rounded-2xl border-2 border-slate-100 focus:border-emerald-500 outline-none transition font-bold text-slate-800 mb-8\">\n                            <option value=\"\">&#8212; Choose Code &#8212;</option>\n                            <option value=\"E1\">E1 / E2 &#8211; Temp Sensor</option>\n                            <option value=\"E4\">E4 &#8211; Fan Motor Issue</option>\n                            <option value=\"F1\">F1 / F2 &#8211; Phase Error</option>\n                            <option value=\"C6\">C6 &#8211; Comm. Error</option>\n                            <option value=\"P4\">P4 &#8211; Inverter Heat</option>\n                            <option value=\"EC\">EC &#8211; Leak Warning</option>\n                        </select>\n                        <div id=\"solutionResult\" class=\"hidden fade-in space-y-4\">\n                            <div class=\"p-5 bg-slate-50 rounded-2xl border border-slate-100\">\n                                <h4 class=\"text-xs font-black text-slate-400 uppercase mb-1\">Issue Identified</h4>\n                                <p id=\"issueText\" class=\"text-slate-900 font-bold\"></p>\n                            </div>\n                            <div class=\"p-5 bg-emerald-50 rounded-2xl border border-emerald-100\">\n                                <h4 class=\"text-xs font-black text-emerald-600 uppercase mb-1\">Recommended Solution</h4>\n                                <p id=\"solutionText\" class=\"text-sm text-slate-800 font-semibold\"></p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Pricing Analysis: Data Visualization -->\n    <section id=\"pricing\" class=\"py-24 bg-white\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"text-center mb-16\">\n                <h2 class=\"text-4xl font-black text-slate-900 mb-4 tracking-tight\">Kheda Service Price Statistics</h2>\n                <p class=\"text-slate-500\">Transparent maintenance pricing for the entire Kheda district market.</p>\n            </div>\n\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\">\n                <div class=\"bg-slate-50 p-8 rounded-[40px] border border-slate-100\">\n                    <h3 class=\"text-center text-[10px] font-black text-slate-400 uppercase tracking-widest mb-8\">Estimated Repair Costs (Kheda Averages)</h3>\n                    <div class=\"chart-container\">\n                        <canvas id=\"priceChart\"></canvas>\n                    </div>\n                </div>\n                <div>\n                    <h3 class=\"text-2xl font-black text-slate-900 mb-6\">District Market Transparency</h3>\n                    <p class=\"text-slate-500 mb-8 leading-relaxed\">\n                        Inland environments require more frequent deep-cleaning to prevent compressor burnout. We offer competitive statewide rates specifically for the Kheda-Nadiad corridor.\n                    </p>\n                    <div class=\"space-y-4\">\n                        <div class=\"flex justify-between items-center p-4 bg-white rounded-2xl shadow-sm border border-slate-100 hover:border-emerald-200 transition\">\n                            <span class=\"text-sm font-bold text-slate-600\">Split AC Deep Cleaning</span>\n                            <span class=\"text-sm font-black text-emerald-600\">₹650 &#8211; ₹950</span>\n                        </div>\n                        <div class=\"flex justify-between items-center p-4 bg-white rounded-2xl shadow-sm border border-slate-100 hover:border-emerald-200 transition\">\n                            <span class=\"text-sm font-bold text-slate-600\">Gas Refilling (Full)</span>\n                            <span class=\"text-sm font-black text-emerald-600\">₹2500 &#8211; ₹4500</span>\n                        </div>\n                        <div class=\"flex justify-between items-center p-4 bg-white rounded-2xl shadow-sm border border-slate-100 hover:border-emerald-200 transition\">\n                            <span class=\"text-sm font-bold text-slate-600\">PCB Repair Fix</span>\n                            <span class=\"text-sm font-black text-emerald-600\">₹1500 &#8211; ₹5000</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Coverage Locator (Integrated Footer Replacement) -->\n    <section id=\"areas\" class=\"py-24 bg-slate-900 text-white rounded-t-[60px]\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"text-center mb-16\">\n                <h2 class=\"text-4xl font-black mb-6 tracking-tight\">Kheda Service Coverage Locator</h2>\n                <p class=\"text-slate-400 max-w-xl mx-auto\">Providing 2-hour doorstep response times across the Nadiad residential heart and the industrial GIDC corridors of Kheda.</p>\n            </div>\n\n            <div class=\"relative max-w-xl mx-auto mb-16\">\n                <input type=\"text\" id=\"areaSearch\" onkeyup=\"filterAreas()\" placeholder=\"Enter area (e.g. Nadiad, Dakor, Matar)...\" class=\"w-full px-8 py-5 rounded-3xl bg-slate-800 border border-slate-700 text-white placeholder-slate-500 focus:ring-2 focus:ring-emerald-500 outline-none transition\">\n                <div class=\"absolute inset-y-0 right-8 flex items-center\">\n                    <i class=\"fas fa-search text-slate-600\"></i>\n                </div>\n            </div>\n\n            <!-- Dynamic Search Results -->\n            <div id=\"areaGrid\" class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 text-[10px] font-bold tracking-tight h-[400px] overflow-y-auto custom-scroll pr-4 pb-12\">\n                <!-- Areas injected by JS -->\n            </div>\n\n            <!-- Integrated Contact/Business Block -->\n            <div class=\"mt-20 pt-20 border-t border-slate-800 lg:flex lg:justify-between lg:items-start\">\n                <div class=\"max-w-xs mb-12 lg:mb-0\">\n                    <div class=\"flex items-center gap-2 mb-6\">\n                        <div class=\"w-10 h-10 bg-emerald-600 rounded-xl flex items-center justify-center text-white font-black text-xl shadow-lg\">A</div>\n                        <span class=\"text-2xl font-black tracking-tighter uppercase\">Atlas Aircon</span>\n                    </div>\n                    <p class=\"text-xs text-slate-400 leading-relaxed mb-8\">Official <strong>AC Service Center Kheda</strong> portal. Specialized independent repairs for the residential, commercial, and industrial heart of Charotar.</p>\n                    <p class=\"text-[10px] text-slate-600 uppercase font-black tracking-[0.2em]\">© 2026 Professional AC Maintenance Hub</p>\n                </div>\n\n                <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-16\">\n                    <div>\n                        <h4 class=\"text-[10px] font-black text-emerald-500 uppercase tracking-widest mb-6\">Kheda District Contact</h4>\n                        <ul class=\"space-y-4 text-sm font-semibold\">\n                            <li class=\"flex items-center gap-3\"><i class=\"fas fa-phone text-emerald-500\"></i> +91 97272 57141</li>\n                            <li class=\"flex items-center gap-3\"><i class=\"fas fa-envelope text-emerald-500\"></i> atlasaircon1@gmail.com</li>\n                            <li class=\"flex items-center gap-3\"><i class=\"fas fa-map-marker-alt text-emerald-500\"></i> Kheda / Nadiad, Gujarat</li>\n                        </ul>\n                    </div>\n                    <div>\n                        <h4 class=\"text-[10px] font-black text-emerald-500 uppercase tracking-widest mb-6\">Center Information</h4>\n                        <p class=\"text-[11px] text-slate-500 font-medium leading-relaxed mb-4\">We are an independent service provider specializing in out-of-warranty repairs. We are not an authorized center for any specific manufacturer.</p>\n                        <div class=\"flex gap-4\">\n                            <i class=\"fab fa-facebook text-slate-700 hover:text-emerald-500 transition\"></i>\n                            <i class=\"fab fa-instagram text-slate-700 hover:text-emerald-500 transition\"></i>\n                            <i class=\"fab fa-linkedin text-slate-700 hover:text-emerald-500 transition\"></i>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Schema Data: Kheda Focused -->\n    <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"LocalBusiness\",\n      \"name\": \"Atlas Aircon Kheda\",\n      \"image\": \"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\",\n      \"@id\": \"https://atlasaircons.com/kheda\",\n      \"url\": \"https://atlasaircons.com/kheda\",\n      \"telephone\": \"+91 97272 57141\",\n      \"email\": \"atlasaircon1@gmail.com\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"addressLocality\": \"Kheda\",\n        \"addressRegion\": \"Gujarat\",\n        \"postalCode\": \"387001\",\n        \"addressCountry\": \"IN\"\n      },\n      \"geo\": {\n        \"@type\": \"GeoCoordinates\",\n        \"latitude\": 22.7533,\n        \"longitude\": 72.6841\n      },\n      \"openingHoursSpecification\": {\n        \"@type\": \"OpeningHoursSpecification\",\n        \"dayOfWeek\": [\n          \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\", \"Sunday\"\n        ],\n        \"opens\": \"00:00\",\n        \"closes\": \"23:59\"\n      }\n    }\n    </script>\n\n    <!-- Application Logic -->\n    <script>\n        const residential = [\n            \"Nadiad City\", \"Kheda City\", \"Dakor\", \"Mehmedabad\", \"Matar\", \"Thasra\", \"Mahudha\", \"Kapadvanj\", \"Vaso\", \n            \"Galteshwar\", \"Vallabh Vidyanagar Boundary\", \"Karamsad Boundary\", \"Mogar Boundary\", \"Sanskarsar\", \n            \"Civil Hospital Area\", \"Station Road Nadiad\", \"College Road\", \"Dabhan\", \"Pij Road\", \"Uttarsanda\", \n            \"Chaklasi\", \"Alina\", \"Limbasi\", \"Salun\", \"Vina\", \"Tundel\", \"Palana\", \"Narsanda\"\n        ];\n        \n        const industrial = [\n            \"Nadiad GIDC\", \"Kheda Industrial Estate\", \"Mehmedabad Industrial Zone\", \"Kapadvanj Industrial Area\", \n            \"Thasra GIDC\", \"Matar Industrial Belt\", \"Bareja Boundary Estates\", \"Dabhan Industrial Units\",\n            \"Pij Industrial Clusters\", \"Highway Roadside Industrial Zone\"\n        ];\n        \n        const allAreas = [...residential, ...industrial];\n\n        function renderAreas(list) {\n            const grid = document.getElementById('areaGrid');\n            grid.innerHTML = '';\n            list.forEach(area => {\n                const div = document.createElement('div');\n                div.className = \"bg-slate-800 p-2 rounded border border-slate-700 hover:bg-slate-700 transition cursor-default text-center text-slate-400\";\n                div.textContent = area;\n                grid.appendChild(div);\n            });\n        }\n\n        function filterAreas() {\n            const query = document.getElementById('areaSearch').value.toLowerCase();\n            const filtered = allAreas.filter(a => a.toLowerCase().includes(query));\n            renderAreas(filtered);\n        }\n\n        function switchTab(tab) {\n            // Hide all\n            document.getElementById('content-brands').classList.add('hidden');\n            document.getElementById('content-units').classList.add('hidden');\n            document.getElementById('content-spares').classList.add('hidden');\n            \n            // Unset active class\n            document.getElementById('tab-brands').classList.remove('tab-active');\n            document.getElementById('tab-units').classList.remove('tab-active');\n            document.getElementById('tab-spares').classList.remove('tab-active');\n            document.getElementById('tab-brands').classList.add('text-slate-400');\n            document.getElementById('tab-units').classList.add('text-slate-400');\n            document.getElementById('tab-spares').classList.add('text-slate-400');\n\n            // Show selected\n            document.getElementById('content-' + tab).classList.remove('hidden');\n            document.getElementById('tab-' + tab).classList.add('tab-active');\n            document.getElementById('tab-' + tab).classList.remove('text-slate-400');\n        }\n\n        function solveError() {\n            const code = document.getElementById('errorSelect').value;\n            const hub = document.getElementById('solutionResult');\n            const issue = document.getElementById('issueText');\n            const solution = document.getElementById('solutionText');\n\n            const errors = {\n                \"E1\": [\"Room Temp Sensor Failure\", \"Pollen/Dust obstruction related sensor fail; resistance check and PCB calibration needed.\"],\n                \"E4\": [\"Indoor Fan Motor Malfunction\", \"Motor winding check and starting capacitor replacement for inland high-heat units.\"],\n                \"F1\": [\"Inverter Board Phase Error\", \"Diagnosis of IPM module and local voltage stabilizer check for Kheda grid.\"],\n                \"C6\": [\"Inter-unit Communication Error\", \"Verification of L-N-S signal wiring and card test for environmentally stressed units.\"],\n                \"P4\": [\"IPM Overheat Protection\", \"Full cleaning of outdoor condenser fins and heat sink paste reapplication.\"],\n                \"EC\": [\"Refrigerant Leakage Alarm\", \"Nitrogen pressure testing, brazing leak points, and gas refill.\"]\n            };\n\n            if (errors[code]) {\n                hub.classList.remove('hidden');\n                issue.textContent = errors[code][0];\n                solution.textContent = errors[code][1];\n            } else {\n                hub.classList.add('hidden');\n            }\n        }\n\n        function initChart() {\n            const ctx = document.getElementById('priceChart').getContext('2d');\n            new Chart(ctx, {\n                type: 'bar',\n                data: {\n                    labels: ['Service', 'Gas Fill', 'PCB Fix', 'Capacitor', 'Compressor'],\n                    datasets: [{\n                        label: 'Avg Kheda Charge (₹)',\n                        data: [800, 3500, 2800, 650, 9500],\n                        backgroundColor: '#059669',\n                        borderRadius: 12\n                    }]\n                },\n                options: {\n                    responsive: true,\n                    maintainAspectRatio: false,\n                    scales: {\n                        y: { beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { font: { size: 9 } } },\n                        x: { grid: { display: false }, ticks: { font: { size: 9 } } }\n                    },\n                    plugins: { legend: { display: false } }\n                }\n            });\n        }\n\n        window.onload = () => {\n            renderAreas(allAreas);\n            initChart();\n        };\n    </script>\n</div>",
