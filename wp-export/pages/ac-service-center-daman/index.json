  "content": {
    "rendered": "<div class=\"atlas-purified-matrix\"><style>\n        body { font-family: 'Inter', sans-serif; }\n        .chart-container {\n            position: relative;\n            width: 100%;\n            max-width: 600px;\n            margin-left: auto;\n            margin-right: auto;\n            height: 300px;\n            max-height: 400px;\n        }\n        @media (min-width: 768px) { .chart-container { height: 350px; } }\n        .custom-scroll::-webkit-scrollbar { width: 4px; }\n        .custom-scroll::-webkit-scrollbar-thumb { background: #2563eb; border-radius: 10px; }\n        .fade-in { animation: fadeIn 0.6s ease-out; }\n        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }\n    </style>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n<script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"LocalBusiness\",\n      \"name\": \"Atlas Aircon Daman\",\n      \"image\": \"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\",\n      \"@id\": \"https://atlasaircons.com/daman\",\n      \"url\": \"https://atlasaircons.com/daman\",\n      \"telephone\": \"+91 97272 57141\",\n      \"email\": \"atlasaircon1@gmail.com\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"addressLocality\": \"Daman\",\n        \"addressRegion\": \"Daman & Diu\",\n        \"postalCode\": \"396210\",\n        \"addressCountry\": \"IN\"\n      },\n      \"geo\": {\n        \"@type\": \"GeoCoordinates\",\n        \"latitude\": 20.4147,\n        \"longitude\": 72.8324\n      },\n      \"openingHoursSpecification\": {\n        \"@type\": \"OpeningHoursSpecification\",\n        \"dayOfWeek\": [\n          \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\", \"Sunday\"\n        ],\n        \"opens\": \"00:00\",\n        \"closes\": \"23:59\"\n      }\n    }\n    </script>\n<script>\n        const residential = [\n            \"Nani Daman\", \"Moti Daman\", \"Devka Beach Road\", \"Jampore\", \"Marwad\", \"Kadaiya\", \"Dunetha\", \"Varkund\", \n            \"Magarwada\", \"Pariyari\", \"Kachigam\", \"Bhimpore\", \"Dholar\", \"Patlara\", \"Kathiria\", \"Tin Batti Area\", \n            \"Dilip Nagar\", \"Masat Area\", \"Khariwad\", \"Zari\", \"Damanwada\", \"Airport Road\"\n        ];\n        \n        const industrial = [\n            \"Dabhel GIDC\", \"Ringanwada Industrial Area\", \"Somnath Industrial Estate\", \"Dunetha GIDC\", \n            \"Bhimpore Industrial Belt\", \"Kachigam GIDC\", \"Kadaiya Industrial Zone\", \"Daman Industrial Estate\",\n            \"Bimpore Industrial\", \"Varkund Industrial Estate\", \"Cooper Industrial Estate\"\n        ];\n        \n        const allAreas = [...residential, ...industrial];\n\n        function renderAreas(list) {\n            const grid = document.getElementById('areaGrid');\n            grid.innerHTML = '';\n            list.forEach(area => {\n                const div = document.createElement('div');\n                div.className = \"bg-slate-800 p-2 rounded border border-slate-700 hover:bg-slate-700 transition cursor-default text-center text-slate-400\";\n                div.textContent = area;\n                grid.appendChild(div);\n            });\n        }\n\n        function filterAreas() {\n            const query = document.getElementById('areaSearch').value.toLowerCase();\n            const filtered = allAreas.filter(a => a.toLowerCase().includes(query));\n            renderAreas(filtered);\n        }\n\n        function solveError() {\n            const code = document.getElementById('errorSelect').value;\n            const hub = document.getElementById('solutionResult');\n            const issue = document.getElementById('issueText');\n            const solution = document.getElementById('solutionText');\n\n            const errors = {\n                \"E1\": [\"Room Temp Sensor Failure\", \"Coastal humidity check for sensor resistance and PCB cleaning required.\"],\n                \"E4\": [\"Indoor Fan Motor Malfunction\", \"Inspection of winding continuity and capacitor replacement for sea-air exposed units.\"],\n                \"F1\": [\"Inverter Board Phase Error\", \"Diagnosis of power module (IPM) and anti-corrosion sealing check.\"],\n                \"C6\": [\"Inter-unit Communication Error\", \"Verification of L-N-S wiring and signal card test for salt-corroded connectors.\"],\n                \"P4\": [\"IPM Overheat Protection\", \"Full cleaning of outdoor condenser fins and heat sink paste reapplication.\"],\n                \"EC\": [\"Refrigerant Leakage Alarm\", \"Nitrogen pressure testing for coastal pinhole leaks, brazing, and refill.\"]\n            };\n\n            if (errors[code]) {\n                hub.classList.remove('hidden');\n                issue.textContent = errors[code][0];\n                solution.textContent = errors[code][1];\n            } else {\n                hub.classList.add('hidden');\n            }\n        }\n\n        function initChart() {\n            const ctx = document.getElementById('priceChart').getContext('2d');\n            new Chart(ctx, {\n                type: 'bar',\n                data: {\n                    labels: ['Coastal Service', 'Gas Fill', 'PCB Fix', 'Capacitor', 'Compressor'],\n                    datasets: [{\n                        label: 'Average Daman Cost (₹)',\n                        data: [850, 3500, 2900, 700, 9500],\n                        backgroundColor: '#2563eb',\n                        borderRadius: 12\n                    }]\n                },\n                options: {\n                    responsive: true,\n                    maintainAspectRatio: false,\n                    scales: {\n                        y: { beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { font: { size: 9 } } },\n                        x: { grid: { display: false }, ticks: { font: { size: 9 } } }\n                    },\n                    plugins: { legend: { display: false } }\n                }\n            });\n        }\n\n        window.onload = () => {\n            renderAreas(allAreas);\n            initChart();\n        };\n    </script>\n\n\n    <!-- Navigation -->\n    <nav class=\"bg-white/90 backdrop-blur-md shadow-sm sticky top-0 z-50 border-b border-slate-100\">\n        <div class=\"max-w-7xl mx-auto px-4 h-16 flex justify-between items-center\">\n            <div class=\"flex items-center gap-2\">\n                <div class=\"w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center text-white shadow-lg\">\n                    <i class=\"fas fa-snowflake animate-pulse\"></i>\n                </div>\n                <div class=\"flex flex-col\">\n                    <span class=\"font-extrabold text-lg leading-tight tracking-tight uppercase\">Atlas Aircon</span>\n                    <span class=\"text-[9px] text-blue-600 font-black uppercase tracking-[0.2em]\">Service Center Daman</span>\n                </div>\n            </div>\n            <div class=\"hidden lg:flex space-x-6 text-[11px] font-bold uppercase tracking-wider text-slate-500\">\n                <a href=\"#links\" class=\"hover:text-blue-600 transition\">Service Directory</a>\n                <a href=\"#diagnose\" class=\"hover:text-blue-600 transition\">Diagnostics</a>\n                <a href=\"#pricing\" class=\"hover:text-blue-600 transition\">Price Stats</a>\n                <a href=\"#areas\" class=\"hover:text-blue-600 transition\">Daman Coverage</a>\n            </div>\n            <a href=\"https://wa.me/919727257141\" target=\"_blank\" class=\"bg-green-500 hover:bg-green-600 text-white px-5 py-2.5 rounded-full text-xs font-black shadow-md transition flex items-center gap-2\" rel=\"noopener\">\n                <i class=\"fab fa-whatsapp\"></i> +91 97272 57141\n            </a>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <header class=\"relative bg-white border-b border-slate-100 overflow-hidden\">\n        <div class=\"max-w-7xl mx-auto px-4 py-16 lg:py-24\">\n            <div class=\"lg:flex lg:items-center lg:gap-16\">\n                <div class=\"lg:w-1/2 text-center lg:text-left fade-in\">\n                    <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-[10px] font-bold uppercase tracking-widest mb-6\">\n                        <i class=\"fas fa-umbrella-beach\"></i> Coastal Cooling Specialist\n                    </div>\n                    <h1 class=\"text-5xl lg:text-7xl font-black text-slate-900 leading-[1.05] mb-6 tracking-tighter\">\n                        Premier <span class=\"text-blue-600\">AC Service Center Daman</span>\n                    </h1>\n                    <p class=\"text-lg text-slate-500 mb-4 leading-relaxed max-w-xl mx-auto lg:mx-0\">\n                        The Union Territory&#8217;s leading independent hub for specialized anti-corrosive AC maintenance and industrial HVAC repairs.\n                    </p>\n                    <p class=\"text-sm font-bold text-red-600 mb-8 uppercase tracking-wide\">\n                        *Independent Specialist: Expert repairs for all brands out-of-warranty.\n                    </p>\n                    <div class=\"flex flex-wrap justify-center lg:justify-start gap-4\">\n                        <a href=\"#links\" class=\"px-8 py-4 bg-slate-900 text-white rounded-2xl font-bold shadow-xl hover:bg-slate-800 transition\">Service Portals</a>\n                        <a href=\"https://wa.me/919727257141\" class=\"px-8 py-4 bg-blue-50 text-blue-700 rounded-2xl font-bold hover:bg-blue-100 transition\" target=\"_blank\" rel=\"noopener\">Emergency Breakdown</a>\n                    </div>\n                </div>\n                <div class=\"lg:w-1/2 mt-12 lg:mt-0 relative\">\n                    <img decoding=\"async\" class=\"rounded-3xl shadow-2xl border-4 border-white transform hover:rotate-1 transition duration-500\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/Atlas-aircon-vehicle.webp\" alt=\"AC Service Center Daman Mobile Unit\" title=\"\">\n                    <div class=\"absolute -bottom-6 -left-6 bg-white p-4 rounded-2xl shadow-xl border border-slate-100\">\n                        <p class=\"text-[10px] font-black text-blue-600 uppercase mb-1\">Serving Daman</p>\n                        <p class=\"text-xl font-black text-slate-900 italic\">Residential &#038; Industrial</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- Information Synthesis: Daman Specifics -->\n    <section class=\"py-12 bg-slate-50\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"bg-white rounded-[40px] p-8 lg:p-12 shadow-sm border border-slate-100\">\n                <div class=\"max-w-3xl\">\n                    <h2 class=\"text-3xl font-black text-slate-900 mb-6 tracking-tight\">Managing Cooling in a Coastal-Industrial Climate</h2>\n                    <p class=\"text-slate-600 leading-relaxed mb-6\">\n                        Daman presents unique challenges for air conditioning systems. As the leading <strong>AC service center in Daman</strong>, we have developed specialized protocols to combat the high salinity levels from the Arabian Sea that typically corrode AC coils in <strong>Devka</strong> and <strong>Jampore</strong> within months. Simultaneously, we provide heavy-duty HVAC maintenance for the industrial powerhouses in <strong>Dabhel</strong> and <strong>Ringanwada GIDC</strong>. \n                    </p>\n                    <p class=\"text-slate-600 leading-relaxed\">\n                        Our independent repair center specializes in component-level fixes for global brands like Blue Star, Carrier, and Daikin. By focusing on repair over replacement, we help Daman&#8217;s residents and factory owners save on maintenance while ensuring their systems are protected with anti-corrosive coatings.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Master Directory Hub (Including all Links) -->\n    <section id=\"links\" class=\"py-20 bg-white\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"text-center mb-16\">\n                <h2 class=\"text-4xl font-black text-slate-900 tracking-tight mb-4\">Service Directory for Daman</h2>\n                <p class=\"text-slate-500 max-w-2xl mx-auto\">Access specific portals for every unit type, brand center, and technical component at our <strong>Daman AC Service Hub</strong>.</p>\n            </div>\n\n            <div id=\"linksContainer\" class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8\">\n                <!-- Group 1: Core Portals -->\n                <div class=\"bg-slate-50 p-6 rounded-3xl shadow-sm border border-slate-100\">\n                    <h3 class=\"text-[10px] font-black text-blue-600 uppercase tracking-widest mb-6\">Daman Main Portals</h3>\n                    <ul class=\"space-y-3\">\n                        <li><a href=\"/ac-repair-daman\" class=\"text-sm font-bold text-slate-600 hover:text-blue-600 transition flex items-center gap-2\"><i class=\"fas fa-chevron-right text-[10px] opacity-20\"></i> AC Repair Daman</a></li>\n                        <li><a href=\"/ac-service-center-daman\" class=\"text-sm font-bold text-slate-600 hover:text-blue-600 transition flex items-center gap-2\"><i class=\"fas fa-chevron-right text-[10px] opacity-20\"></i> Service Center Daman</a></li>\n                        <li><a href=\"/ac-price-list-daman\" class=\"text-sm font-bold text-slate-600 hover:text-blue-600 transition flex items-center gap-2\"><i class=\"fas fa-chevron-right text-[10px] opacity-20\"></i> Daman Price List</a></li>\n                        <li><a href=\"/ac-service-daman\" class=\"text-sm font-bold text-slate-600 hover:text-blue-600 transition flex items-center gap-2\"><i class=\"fas fa-chevron-right text-[10px] opacity-20\"></i> Coastal Maintenance</a></li>\n                    </ul>\n                </div>\n                <!-- Group 2: Industrial Specialist Links -->\n                <div class=\"bg-slate-50 p-6 rounded-3xl shadow-sm border border-slate-100 lg:col-span-2\">\n                    <h3 class=\"text-[10px] font-black text-blue-600 uppercase tracking-widest mb-6\">Expert Brand Maintenance (Out-of-Warranty)</h3>\n                    <div class=\"grid grid-cols-2 md:grid-cols-3 gap-x-4 gap-y-3\">\n                        <a href=\"/blue-star-ac-service-center-daman\" class=\"text-xs font-bold text-slate-500 hover:text-blue-600\">Blue Star</a>\n                        <a href=\"/carrier-ac-service-center-daman\" class=\"text-xs font-bold text-slate-500 hover:text-blue-600\">Carrier</a>\n                        <a href=\"/daikin-ac-service-center-daman\" class=\"text-xs font-bold text-slate-500 hover:text-blue-600\">Daikin</a>\n                        <a href=\"/lg-ac-service-center-daman\" class=\"text-xs font-bold text-slate-500 hover:text-blue-600\">LG</a>\n                        <a href=\"/samsung-ac-service-center-daman\" class=\"text-xs font-bold text-slate-500 hover:text-blue-600\">Samsung</a>\n                        <a href=\"/voltas-ac-service-center-daman\" class=\"text-xs font-bold text-slate-500 hover:text-blue-600\">Voltas</a>\n                        <a href=\"/hitachi-ac-service-center-daman\" class=\"text-xs font-bold text-slate-500 hover:text-blue-600\">Hitachi</a>\n                        <a href=\"/mitsubishi-ac-service-center-daman\" class=\"text-xs font-bold text-slate-500 hover:text-blue-600\">Mitsubishi</a>\n                        <a href=\"/panasonic-ac-service-center-daman\" class=\"text-xs font-bold text-slate-500 hover:text-blue-600\">Panasonic</a>\n                        <a href=\"/o-general-ac-service-center-daman\" class=\"text-xs font-bold text-slate-500 hover:text-blue-600\">O General</a>\n                        <a href=\"/haier-ac-service-center-daman\" class=\"text-xs font-bold text-slate-500 hover:text-blue-600\">Haier</a>\n                        <a href=\"/york-ac-service-center-daman\" class=\"text-xs font-bold text-slate-500 hover:text-blue-600\">York</a>\n                    </div>\n                </div>\n                <!-- Group 3: Components -->\n                <div class=\"bg-slate-50 p-6 rounded-3xl shadow-sm border border-slate-100\">\n                    <h3 class=\"text-[10px] font-black text-blue-600 uppercase tracking-widest mb-6\">Daman Spare Hub</h3>\n                    <div class=\"flex flex-wrap gap-2\">\n                        <a href=\"/remote-daman/\" class=\"px-2 py-1 bg-white rounded text-[10px] font-bold text-slate-500 hover:shadow-sm transition\">Remote</a>\n                        <a href=\"/copper-pipe-daman/\" class=\"px-2 py-1 bg-white rounded text-[10px] font-bold text-slate-500 hover:shadow-sm transition\">Copper Pipe</a>\n                        <a href=\"/gas-charging-service-daman/\" class=\"px-2 py-1 bg-white rounded text-[10px] font-bold text-slate-500 hover:shadow-sm transition\">Gas Refill</a>\n                        <a href=\"/pcb-repair-daman\" class=\"px-2 py-1 bg-white rounded text-[10px] font-bold text-slate-500 hover:shadow-sm transition\">PCB Fix</a>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Visual Unit Categories -->\n            <div class=\"mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n                <a href=\"/window-ac-repair-daman\" class=\"group relative rounded-2xl overflow-hidden aspect-video shadow-lg\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/Window-ac-repair-service.webp\" class=\"w-full h-full object-cover group-hover:scale-110 transition duration-500\" alt=\"Window AC Service Daman\" title=\"\">\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-4\">\n                        <span class=\"text-white text-[10px] font-black uppercase tracking-widest\">Window AC Portals</span>\n                    </div>\n                </a>\n                <a href=\"/industrial-chiller-repair-daman\" class=\"group relative rounded-2xl overflow-hidden aspect-video shadow-lg\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/chiller-service-in-vadodara.webp\" class=\"w-full h-full object-cover group-hover:scale-110 transition duration-500\" alt=\"Industrial Chiller Service Daman\" title=\"\">\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-4\">\n                        <span class=\"text-white text-[10px] font-black uppercase tracking-widest\">Industrial Chillers</span>\n                    </div>\n                </a>\n                <a href=\"/panel-ac-repair-daman\" class=\"group relative rounded-2xl overflow-hidden aspect-video shadow-lg\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/advance-panel-ac-repair-service.webp\" class=\"w-full h-full object-cover group-hover:scale-110 transition duration-500\" alt=\"Panel AC Repair Daman\" title=\"\">\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-4\">\n                        <span class=\"text-white text-[10px] font-black uppercase tracking-widest\">Panel AC Specialized</span>\n                    </div>\n                </a>\n                <a href=\"/air-cooler-service-daman\" class=\"group relative rounded-2xl overflow-hidden aspect-video shadow-lg\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/04/Air-cooler-repair-service-vadodara.webp\" class=\"w-full h-full object-cover group-hover:scale-110 transition duration-500\" alt=\"Air Cooler Service Daman\" title=\"\">\n                    <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-4\">\n                        <span class=\"text-white text-[10px] font-black uppercase tracking-widest\">Air Cooler Hub</span>\n                    </div>\n                </a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Diagnostic Hub: Interaction Focus -->\n    <section id=\"diagnose\" class=\"py-24 bg-slate-50\">\n        <div class=\"max-w-5xl mx-auto px-4\">\n            <div class=\"lg:flex lg:items-center lg:gap-16\">\n                <div class=\"lg:w-1/2 mb-12 lg:mb-0\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/02/Emergency-AC-Breakdown-Atlas-Aircon.webp\" class=\"rounded-3xl shadow-2xl mb-8\" alt=\"Emergency Breakdown Daman\" title=\"\">\n                    <h2 class=\"text-4xl font-black text-slate-900 mb-6\">Integrated Diagnostic Hub</h2>\n                    <p class=\"text-slate-500 leading-relaxed mb-6\">\n                        Before scheduling an emergency coastal visit from our <strong>AC Service Center Daman</strong>, use our interactive troubleshooter. We identify display codes for residential and high-capacity industrial HVAC systems.\n                    </p>\n                    <div class=\"p-6 bg-blue-600 rounded-3xl text-white shadow-xl\">\n                        <p class=\"text-sm font-medium mb-4 italic\">&#8220;We provide component-level PCB repairs for coastal Daman, ensuring electronics are cleaned and sealed against humidity.&#8221;</p>\n                        <a href=\"https://wa.me/919727257141\" class=\"inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest\" target=\"_blank\" rel=\"noopener\">Connect with Daman Center <i class=\"fas fa-arrow-right\"></i></a>\n                    </div>\n                </div>\n                <div class=\"lg:w-1/2\">\n                    <div class=\"bg-white rounded-[40px] p-8 shadow-2xl border border-slate-100\">\n                        <label class=\"block text-[10px] font-black text-blue-600 uppercase tracking-[0.2em] mb-4\">Select Error Code</label>\n                        <select id=\"errorSelect\" onchange=\"solveError()\" class=\"w-full p-4 rounded-2xl border-2 border-slate-100 focus:border-blue-500 outline-none transition font-bold text-slate-800 mb-8\">\n                            <option value=\"\">&#8212; Choose Code &#8212;</option>\n                            <option value=\"E1\">E1 / E2 &#8211; Temp Sensor</option>\n                            <option value=\"E4\">E4 &#8211; Fan Motor Issue</option>\n                            <option value=\"F1\">F1 / F2 &#8211; Phase Error</option>\n                            <option value=\"C6\">C6 &#8211; Comm. Error</option>\n                            <option value=\"P4\">P4 &#8211; Inverter Heat</option>\n                            <option value=\"EC\">EC &#8211; Leak Warning</option>\n                        </select>\n                        <div id=\"solutionResult\" class=\"hidden fade-in space-y-4\">\n                            <div class=\"p-4 bg-slate-50 rounded-2xl border border-slate-100\">\n                                <h4 class=\"text-xs font-black text-slate-400 uppercase mb-1\">Diagnosis</h4>\n                                <p id=\"issueText\" class=\"text-slate-900 font-bold\"></p>\n                            </div>\n                            <div class=\"p-4 bg-blue-50 rounded-2xl border border-blue-100\">\n                                <h4 class=\"text-xs font-black text-blue-600 uppercase mb-1\">Recommended Action</h4>\n                                <p id=\"solutionText\" class=\"text-sm text-slate-800 font-semibold\"></p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Pricing Analysis: Data Visualization -->\n    <section id=\"pricing\" class=\"py-24 bg-white\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"text-center mb-16\">\n                <h2 class=\"text-4xl font-black text-slate-900 mb-4 tracking-tight\">Daman UT Service Price Stats</h2>\n                <p class=\"text-slate-500\">Transparent maintenance pricing from your trusted independent <strong>AC Service Center Daman</strong>.</p>\n            </div>\n\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\">\n                <div class=\"bg-slate-50 p-8 rounded-[40px] border border-slate-100\">\n                    <h3 class=\"text-center text-[10px] font-black text-slate-400 uppercase tracking-widest mb-8\">Estimated Repair Costs (Daman Market)</h3>\n                    <div class=\"chart-container\">\n                        <canvas id=\"priceChart\"></canvas>\n                    </div>\n                </div>\n                <div>\n                    <h3 class=\"text-2xl font-black text-slate-900 mb-6\">Coastal Market Transparency</h3>\n                    <p class=\"text-slate-500 mb-8 leading-relaxed\">\n                        Due to the coastal environment, standard servicing in Daman often includes coil washing. We offer fixed rates for residential homes and customized contracts for industrial GIDC units.\n                    </p>\n                    <div class=\"space-y-4\">\n                        <div class=\"flex justify-between items-center p-4 bg-white rounded-2xl shadow-sm border border-slate-100\">\n                            <span class=\"text-sm font-bold text-slate-600\">Split AC Anti-Salt Service</span>\n                            <span class=\"text-sm font-black text-blue-600\">₹799 &#8211; ₹1099</span>\n                        </div>\n                        <div class=\"flex justify-between items-center p-4 bg-white rounded-2xl shadow-sm border border-slate-100\">\n                            <span class=\"text-sm font-bold text-slate-600\">Gas Refilling (Full)</span>\n                            <span class=\"text-sm font-black text-blue-600\">₹2500 &#8211; ₹4500</span>\n                        </div>\n                        <div class=\"flex justify-between items-center p-4 bg-white rounded-2xl shadow-sm border border-slate-100\">\n                            <span class=\"text-sm font-bold text-slate-600\">PCB Repair Fix</span>\n                            <span class=\"text-sm font-black text-blue-600\">₹1500 &#8211; ₹5000</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Coverage Locator (Integrated Footer Replacement) -->\n    <section id=\"areas\" class=\"py-24 bg-slate-900 text-white rounded-t-[60px]\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"text-center mb-16\">\n                <h2 class=\"text-4xl font-black mb-6 tracking-tight\">Daman Service Coverage Locator</h2>\n                <p class=\"text-slate-400 max-w-xl mx-auto\">Providing 2-hour response times across the Nani Daman, Moti Daman residential hubs, and the industrial Dabhel belts.</p>\n            </div>\n\n            <div class=\"relative max-w-xl mx-auto mb-16\">\n                <input type=\"text\" id=\"areaSearch\" onkeyup=\"filterAreas()\" placeholder=\"Enter your area (e.g. Dabhel, Devka)...\" class=\"w-full px-8 py-5 rounded-3xl bg-slate-800 border border-slate-700 text-white placeholder-slate-500 focus:ring-2 focus:ring-blue-500 outline-none transition\">\n                <div class=\"absolute inset-y-0 right-8 flex items-center\">\n                    <i class=\"fas fa-search text-slate-600\"></i>\n                </div>\n            </div>\n\n            <!-- Dynamic Search Results -->\n            <div id=\"areaGrid\" class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 text-[10px] font-bold tracking-tight h-[400px] overflow-y-auto custom-scroll pr-4 pb-12\">\n                <!-- Areas injected by JS -->\n            </div>\n\n            <!-- Integrated Contact/Business Block -->\n            <div class=\"mt-20 pt-20 border-t border-slate-800 lg:flex lg:justify-between lg:items-start\">\n                <div class=\"max-w-xs mb-12 lg:mb-0\">\n                    <div class=\"flex items-center gap-2 mb-6\">\n                        <div class=\"w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center text-white font-black text-xl shadow-lg\">A</div>\n                        <span class=\"text-2xl font-black tracking-tighter uppercase\">Atlas Aircon</span>\n                    </div>\n                    <p class=\"text-xs text-slate-400 leading-relaxed mb-8\">Official <strong>AC Service Center Daman</strong> portal. Specialized independent repairs for residential hubs and the industrial GIDC estates of the Union Territory.</p>\n                    <p class=\"text-[10px] text-slate-600 uppercase font-black tracking-[0.2em]\">© 2026 Professional AC Maintenance Hub</p>\n                </div>\n\n                <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-16\">\n                    <div>\n                        <h4 class=\"text-[10px] font-black text-blue-500 uppercase tracking-widest mb-6\">Daman Contact</h4>\n                        <ul class=\"space-y-4 text-sm font-semibold\">\n                            <li class=\"flex items-center gap-3\"><i class=\"fas fa-phone text-blue-500\"></i> +91 97272 57141</li>\n                            <li class=\"flex items-center gap-3\"><i class=\"fas fa-envelope text-blue-500\"></i> atlasaircon1@gmail.com</li>\n                            <li class=\"flex items-center gap-3\"><i class=\"fas fa-map-marker-alt text-blue-500\"></i> Daman, UT, India</li>\n                        </ul>\n                    </div>\n                    <div>\n                        <h4 class=\"text-[10px] font-black text-blue-500 uppercase tracking-widest mb-6\">Independent Service</h4>\n                        <p class=\"text-[11px] text-slate-500 font-medium leading-relaxed mb-4\">We are an independent service provider specializing in out-of-warranty repairs. We are not an authorized center for any specific manufacturer.</p>\n                        <div class=\"flex gap-4\">\n                            <i class=\"fab fa-facebook text-slate-700 hover:text-blue-500 transition\"></i>\n                            <i class=\"fab fa-instagram text-slate-700 hover:text-blue-500 transition\"></i>\n                            <i class=\"fab fa-linkedin text-slate-700 hover:text-blue-500 transition\"></i>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Schema Data: Daman Focused -->\n    <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"LocalBusiness\",\n      \"name\": \"Atlas Aircon Daman\",\n      \"image\": \"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\",\n      \"@id\": \"https://atlasaircons.com/daman\",\n      \"url\": \"https://atlasaircons.com/daman\",\n      \"telephone\": \"+91 97272 57141\",\n      \"email\": \"atlasaircon1@gmail.com\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"addressLocality\": \"Daman\",\n        \"addressRegion\": \"Daman & Diu\",\n        \"postalCode\": \"396210\",\n        \"addressCountry\": \"IN\"\n      },\n      \"geo\": {\n        \"@type\": \"GeoCoordinates\",\n        \"latitude\": 20.4147,\n        \"longitude\": 72.8324\n      },\n      \"openingHoursSpecification\": {\n        \"@type\": \"OpeningHoursSpecification\",\n        \"dayOfWeek\": [\n          \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\", \"Sunday\"\n        ],\n        \"opens\": \"00:00\",\n        \"closes\": \"23:59\"\n      }\n    }\n    </script>\n\n    <!-- Application Logic -->\n    <script>\n        const residential = [\n            \"Nani Daman\", \"Moti Daman\", \"Devka Beach Road\", \"Jampore\", \"Marwad\", \"Kadaiya\", \"Dunetha\", \"Varkund\", \n            \"Magarwada\", \"Pariyari\", \"Kachigam\", \"Bhimpore\", \"Dholar\", \"Patlara\", \"Kathiria\", \"Tin Batti Area\", \n            \"Dilip Nagar\", \"Masat Area\", \"Khariwad\", \"Zari\", \"Damanwada\", \"Airport Road\"\n        ];\n        \n        const industrial = [\n            \"Dabhel GIDC\", \"Ringanwada Industrial Area\", \"Somnath Industrial Estate\", \"Dunetha GIDC\", \n            \"Bhimpore Industrial Belt\", \"Kachigam GIDC\", \"Kadaiya Industrial Zone\", \"Daman Industrial Estate\",\n            \"Bimpore Industrial\", \"Varkund Industrial Estate\", \"Cooper Industrial Estate\"\n        ];\n        \n        const allAreas = [...residential, ...industrial];\n\n        function renderAreas(list) {\n            const grid = document.getElementById('areaGrid');\n            grid.innerHTML = '';\n            list.forEach(area => {\n                const div = document.createElement('div');\n                div.className = \"bg-slate-800 p-2 rounded border border-slate-700 hover:bg-slate-700 transition cursor-default text-center text-slate-400\";\n                div.textContent = area;\n                grid.appendChild(div);\n            });\n        }\n\n        function filterAreas() {\n            const query = document.getElementById('areaSearch').value.toLowerCase();\n            const filtered = allAreas.filter(a => a.toLowerCase().includes(query));\n            renderAreas(filtered);\n        }\n\n        function solveError() {\n            const code = document.getElementById('errorSelect').value;\n            const hub = document.getElementById('solutionResult');\n            const issue = document.getElementById('issueText');\n            const solution = document.getElementById('solutionText');\n\n            const errors = {\n                \"E1\": [\"Room Temp Sensor Failure\", \"Coastal humidity check for sensor resistance and PCB cleaning required.\"],\n                \"E4\": [\"Indoor Fan Motor Malfunction\", \"Inspection of winding continuity and capacitor replacement for sea-air exposed units.\"],\n                \"F1\": [\"Inverter Board Phase Error\", \"Diagnosis of power module (IPM) and anti-corrosion sealing check.\"],\n                \"C6\": [\"Inter-unit Communication Error\", \"Verification of L-N-S wiring and signal card test for salt-corroded connectors.\"],\n                \"P4\": [\"IPM Overheat Protection\", \"Full cleaning of outdoor condenser fins and heat sink paste reapplication.\"],\n                \"EC\": [\"Refrigerant Leakage Alarm\", \"Nitrogen pressure testing for coastal pinhole leaks, brazing, and refill.\"]\n            };\n\n            if (errors[code]) {\n                hub.classList.remove('hidden');\n                issue.textContent = errors[code][0];\n                solution.textContent = errors[code][1];\n            } else {\n                hub.classList.add('hidden');\n            }\n        }\n\n        function initChart() {\n            const ctx = document.getElementById('priceChart').getContext('2d');\n            new Chart(ctx, {\n                type: 'bar',\n                data: {\n                    labels: ['Coastal Service', 'Gas Fill', 'PCB Fix', 'Capacitor', 'Compressor'],\n                    datasets: [{\n                        label: 'Average Daman Cost (₹)',\n                        data: [850, 3500, 2900, 700, 9500],\n                        backgroundColor: '#2563eb',\n                        borderRadius: 12\n                    }]\n                },\n                options: {\n                    responsive: true,\n                    maintainAspectRatio: false,\n                    scales: {\n                        y: { beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { font: { size: 9 } } },\n                        x: { grid: { display: false }, ticks: { font: { size: 9 } } }\n                    },\n                    plugins: { legend: { display: false } }\n                }\n            });\n        }\n\n        window.onload = () => {\n            renderAreas(allAreas);\n            initChart();\n        };\n    </script>\n</div>",
