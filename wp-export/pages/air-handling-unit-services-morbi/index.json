  "content": {
    "rendered": "<div class=\"atlas-purified-matrix\"><style>\n        :root {\n            --primary-blue: #0056b3;\n            --secondary-green: #28a745;\n            --accent-yellow: #ffc107;\n            --dark-black: #1a1a1a;\n        }\n        .hero-gradient {\n            background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('https://atlasaircons.com/wp-content/uploads/2025/09/air-handling-units.webp');\n            background-size: cover;\n            background-position: center;\n        }\n        .whatsapp-float {\n            position: fixed;\n            bottom: 20px;\n            right: 20px;\n            background-color: #25d366;\n            color: white;\n            padding: 15px;\n            border-radius: 50px;\n            z-index: 1000;\n            display: flex;\n            align-items: center;\n            box-shadow: 0 4px 10px rgba(0,0,0,0.3);\n        }\n        .section-padding { padding: 80px 0; }\n        .text-justify { text-align: justify; }\n        .bg-custom-green { background-color: var(--secondary-green); }\n        .bg-custom-blue { background-color: var(--primary-blue); }\n        .bg-custom-yellow { background-color: var(--accent-yellow); }\n    </style>\n<script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"Service\",\n      \"serviceType\": \"Air Handling Unit Services\",\n      \"provider\": {\n        \"@type\": \"LocalBusiness\",\n        \"name\": \"Atlas Aircon Morbi\",\n        \"image\": \"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\",\n        \"address\": {\n          \"@type\": \"PostalAddress\",\n          \"streetAddress\": \"Shanala Road\",\n          \"addressLocality\": \"Morbi\",\n          \"addressRegion\": \"Gujarat\",\n          \"postalCode\": \"363641\",\n          \"addressCountry\": \"IN\"\n        },\n        \"telephone\": \"+919727257141\",\n        \"priceRange\": \"₹₹\",\n        \"email\": \"atlasaircon1@gmail.com\"\n      },\n      \"areaServed\": {\n        \"@type\": \"AdministrativeArea\",\n        \"name\": \"Morbi District\"\n      },\n      \"aggregateRating\": {\n        \"@type\": \"AggregateRating\",\n        \"ratingValue\": \"4.9\",\n        \"reviewCount\": \"1580\"\n      },\n      \"hasOfferCatalog\": {\n        \"@type\": \"OfferCatalog\",\n        \"name\": \"Morbi Industrial HVAC Services\",\n        \"itemListElement\": [\n          {\n            \"@type\": \"Offer\",\n            \"itemOffered\": {\n              \"@type\": \"Service\",\n              \"name\": \"Industrial AHU Repair\"\n            }\n          },\n          {\n            \"@type\": \"Offer\",\n            \"itemOffered\": {\n              \"@type\": \"Service\",\n              \"name\": \"Ceramic Plant AHU AMC\"\n            }\n          }\n        ]\n      }\n    }\n    </script>\n\n\n    <!-- HEADER MENU -->\n    <header class=\"bg-white shadow-md sticky top-0 z-50\">\n        <nav class=\"container mx-auto px-4 py-3 flex justify-between items-center\">\n            <a href=\"/home\">\n                <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\" alt=\"Atlas Aircon Logo\" class=\"h-12\" title=\"\">\n            </a>\n            <div class=\"hidden lg:flex space-x-4 text-[10px] font-bold uppercase overflow-x-auto\">\n                <a href=\"/home\" class=\"hover:text-blue-600\">Home</a>\n                <a href=\"/shop\" class=\"hover:text-blue-600\">Shop</a>\n                <a href=\"/ac-service-vadodara\" class=\"hover:text-blue-600\">AC Service</a>\n                <a href=\"/chiller-repair-services-vadodara\" class=\"hover:text-blue-600\">Chiller</a>\n                <a href=\"/hvac-repair-services-vadodara\" class=\"hover:text-blue-600\">HVAC</a>\n                <a href=\"/air-handling-unit-services-vadodara\" class=\"hover:text-blue-600\">AHU</a>\n                <a href=\"/locations\" class=\"hover:text-blue-600\">Locations</a>\n                <a href=\"/contact-us\" class=\"hover:text-blue-600\">Contact</a>\n            </div>\n            <button class=\"lg:hidden text-2xl\"><i class=\"fas fa-bars\"></i></button>\n        </nav>\n    </header>\n\n    <!-- HERO BANNER -->\n    <section class=\"hero-gradient h-[600px] flex items-center text-white relative\">\n        <div class=\"container mx-auto px-4\">\n            <h1 class=\"text-4xl md:text-6xl font-extrabold mb-4 leading-tight\">\n                Premium <span class=\"text-yellow-400\">Air Handling Unit services Morbi</span>\n            </h1>\n            <p class=\"text-xl md:text-2xl mb-8 max-w-2xl\">\n                Atlas Aircon provides heavy-duty <b>AHU repair, maintenance, and AMC services</b> for Morbi&#8217;s world-class ceramic and vitrified tile industries. Expert cooling solutions for industrial excellence.\n            </p>\n            <div class=\"flex flex-wrap gap-4\">\n                <a href=\"https://wa.me/919727257141\" class=\"bg-[#25d366] hover:bg-green-600 text-white px-8 py-4 rounded-full font-bold flex items-center transition\" target=\"_blank\" rel=\"noopener\">\n                    <i class=\"fab fa-whatsapp mr-2 text-2xl\"></i> Chat on WhatsApp\n                </a>\n                <a href=\"tel:+919727257141\" class=\"bg-blue-600 hover:bg-blue-700 text-white px-8 py-4 rounded-full font-bold transition\">\n                    Call: +91 97272 57141\n                </a>\n            </div>\n        </div>\n    </section>\n\n    <!-- INTRODUCTION SECTION -->\n    <section class=\"section-padding bg-gray-50\">\n        <div class=\"container mx-auto px-4\">\n            <div class=\"grid md:grid-cols-2 gap-12 items-center\">\n                <div class=\"text-justify\">\n                    <h2 class=\"text-3xl font-bold mb-6\">Expert <span class=\"text-blue-700\">Air Handling Unit services Morbi</span> for the Ceramic Capital</h2>\n                    <p class=\"mb-4 text-lg leading-relaxed\">\n                        In the heart of India&#8217;s ceramic hub, maintaining precise air quality and temperature is not just a luxury—it is an industrial necessity. Atlas Aircon offers specialized <b>Air Handling Unit services Morbi</b> specifically designed for the high-dust and high-temperature environments of vitrified tile plants and sanitaryware units. We understand that in Morbi, any HVAC failure can lead to production delays and compromised product quality.\n                    </p>\n                    <p class=\"mb-6\">\n                        An Air Handling Unit (AHU) in a Morbi ceramic plant operates under extreme conditions. Dust particles from raw materials can quickly clog filtration systems, leading to motor strain and cooling inefficiency. Our <b>Air Handling Unit services Morbi</b> provide a deep-cleaning approach that goes beyond surface maintenance. We handle everything from <b>Double Skin AHUs</b> for executive office blocks to massive <b>Process AHUs</b> for factory floors. Our technicians are experts in <b>cooling coil restoration</b>, <b>VFD programming</b>, and <b>dynamic fan balancing</b> to ensure your system runs silently and efficiently.\n                    </p>\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/09/ahu-manufacturers-in-vadodara.webp\" alt=\"Air Handling Unit services Morbi\" class=\"rounded-lg shadow-xl mb-6 w-full\" title=\"\">\n                </div>\n                <div class=\"bg-white p-8 rounded-2xl shadow-lg border-t-4 border-blue-600\">\n                    <h3 class=\"text-2xl font-bold mb-4\">Why Morbi Industries Trust Atlas Aircon?</h3>\n                    <ul class=\"space-y-4\">\n                        <li class=\"flex items-start\">\n                            <i class=\"fas fa-check-circle text-green-500 mt-1 mr-3\"></i>\n                            <span><b>Dust-Proof Solutions:</b> We use specialized multi-stage filtration to protect AHUs in Morbi&#8217;s ceramic zones.</span>\n                        </li>\n                        <li class=\"flex items-start\">\n                            <i class=\"fas fa-check-circle text-green-500 mt-1 mr-3\"></i>\n                            <span><b>Rapid GIDC Response:</b> On-site technicians available for <b>Morbi GIDC</b>, <b>Wankaner</b>, and <b>Lakhdhirpur Road</b>.</span>\n                        </li>\n                        <li class=\"flex items-start\">\n                            <i class=\"fas fa-check-circle text-green-500 mt-1 mr-3\"></i>\n                            <span><b>High-Tonnage Expertise:</b> Capability to handle large-scale AHUs (10,000 to 40,000+ CFM).</span>\n                        </li>\n                        <li class=\"flex items-start\">\n                            <i class=\"fas fa-check-circle text-green-500 mt-1 mr-3\"></i>\n                            <span><b>Genuine Spare Inventory:</b> Ready stock of fan belts, pulleys, and motors for major brands.</span>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- BRANDS WE REPAIR -->\n    <section class=\"section-padding bg-white\">\n        <div class=\"container mx-auto px-4 text-center\">\n            <h2 class=\"text-3xl font-bold mb-4\">Which Brands We Repair &#038; Service</h2>\n            <p class=\"mb-10 text-gray-600\">We provide expert technical repair and maintenance for all leading industrial AHU brands found in Morbi.</p>\n            <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-8 items-center opacity-80\">\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Blue Star</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Daikin</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Carrier</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>York</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Zeco</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Edgetech</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Citizen</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Trane</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Voltas</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Hitachi</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Mitsubishi</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>LG</b></div>\n            </div>\n        </div>\n    </section>\n\n    <!-- TYPES WE REPAIR -->\n    <section class=\"section-padding bg-gray-900 text-white\">\n        <div class=\"container mx-auto px-4\">\n            <h2 class=\"text-3xl font-bold mb-12 text-center\">Types of AHU We Service in Morbi</h2>\n            <div class=\"grid md:grid-cols-3 gap-8\">\n                <div class=\"bg-gray-800 p-6 rounded-xl border-l-4 border-yellow-500\">\n                    <h3 class=\"text-xl font-bold mb-3\">Double Skin Industrial AHUs</h3>\n                    <p class=\"text-gray-400 mb-4\">Essential for office blocks and labs in ceramic plants. We focus on insulation integrity and air-tight seals.</p>\n                    <a href=\"/central-ac-repair-services-vadodara\" class=\"text-yellow-500 font-bold\">Industrial AC &rarr;</a>\n                </div>\n                <div class=\"bg-gray-800 p-6 rounded-xl border-l-4 border-green-500\">\n                    <h3 class=\"text-xl font-bold mb-3\">Single Skin Process AHUs</h3>\n                    <p class=\"text-gray-400 mb-4\">High-CFM units for factory floor ventilation. We handle bearing changes and motor efficiency audits.</p>\n                    <a href=\"/hvac-repair-services-vadodara\" class=\"text-green-500 font-bold\">HVAC Solutions &rarr;</a>\n                </div>\n                <div class=\"bg-gray-800 p-6 rounded-xl border-l-4 border-blue-500\">\n                    <h3 class=\"text-xl font-bold mb-3\">Rooftop Packages / AHUs</h3>\n                    <p class=\"text-gray-400 mb-4\">Exposed to harsh sun and dust on factory roofs. Specialized in weather-proof casing repair and coil cleaning.</p>\n                    <a href=\"/ac-service-vadodara\" class=\"text-blue-500 font-bold\">Rooftop Service &rarr;</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- INDUSTRIAL FOCUS SECTION (Morbi Specific) -->\n    <section class=\"section-padding bg-yellow-50\">\n        <div class=\"container mx-auto px-4\">\n            <h2 class=\"text-3xl font-bold mb-8 text-center text-gray-900\">Dedicated Service for Morbi GIDC &#038; Ceramic Clusters</h2>\n            <div class=\"bg-white p-8 rounded-3xl shadow-lg\">\n                <p class=\"mb-6 text-lg text-justify\">\n                    Morbi is a global leader in tile production. Atlas Aircon offers specialized <b>Air Handling Unit services Morbi</b> that cater to the demanding maintenance cycles of these 24/7 manufacturing plants. We provide customized maintenance schedules to ensure your HVAC systems never become a bottleneck for your production line.\n                </p>\n                <div class=\"grid md:grid-cols-2 gap-8\">\n                    <div>\n                        <h4 class=\"font-bold text-xl mb-4 text-blue-800\"><i class=\"fas fa-industry mr-2\"></i> Major Ceramic Hubs</h4>\n                        <div class=\"flex flex-wrap gap-2\">\n                            <span class=\"bg-gray-100 px-3 py-1 rounded-full text-sm\">Morbi GIDC-1 &#038; 2</span>\n                            <span class=\"bg-gray-100 px-3 py-1 rounded-full text-sm\">Lakhdhirpur Road</span>\n                            <span class=\"bg-gray-100 px-3 py-1 rounded-full text-sm\">Wankaner GIDC</span>\n                            <span class=\"bg-gray-100 px-3 py-1 rounded-full text-sm\">Halvad Industrial Zone</span>\n                            <span class=\"bg-gray-100 px-3 py-1 rounded-full text-sm\">Jetpar Road Clusters</span>\n                            <span class=\"bg-gray-100 px-3 py-1 rounded-full text-sm\">Old Ghuntu Road</span>\n                            <span class=\"bg-gray-100 px-3 py-1 rounded-full text-sm\">Morbi-Navlakhi Highway</span>\n                        </div>\n                    </div>\n                    <div>\n                        <h4 class=\"font-bold text-xl mb-4 text-green-800\"><i class=\"fas fa-map-marker-alt mr-2\"></i> Residential Areas Covered</h4>\n                        <ul class=\"grid grid-cols-2 gap-2 text-sm\">\n                            <li>Ravapar Road</li>\n                            <li>Shakti Nagar</li>\n                            <li>Mahendranagar</li>\n                            <li>Trajpar</li>\n                            <li>Sama Kanthe</li>\n                            <li>Shanala Road</li>\n                            <li>Morbi City</li>\n                            <li>Navlakhi Road</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- PRICE TABLE -->\n    <section class=\"section-padding bg-white\">\n        <div class=\"container mx-auto px-4\">\n            <h2 class=\"text-3xl font-bold mb-8 text-center\">AHU Spare Parts &#038; Service Price List (Morbi District)</h2>\n            <div class=\"overflow-x-auto\">\n                <table class=\"w-full text-left border-collapse\">\n                    <thead>\n                        <tr class=\"bg-blue-600 text-white uppercase text-sm\">\n                            <th class=\"p-4 border\">AHU Maintenance Item / Service</th>\n                            <th class=\"p-4 border\">Approximate Cost</th>\n                            <th class=\"p-4 border\">Action</th>\n                        </tr>\n                    </thead>\n                    <tbody class=\"text-gray-700\">\n                        <tr class=\"hover:bg-gray-50\">\n                            <td class=\"p-4 border\"><b>Annual Maintenance Contract (AMC)</b></td>\n                            <td class=\"p-4 border\">₹ 8,500 &#8211; 25,000+</td>\n                            <td class=\"p-4 border\"><a href=\"tel:+919727257141\" class=\"text-blue-600 font-bold underline\">Get Quote</a></td>\n                        </tr>\n                        <tr class=\"hover:bg-gray-50 bg-gray-50\">\n                            <td class=\"p-4 border\"><b>Industrial Filter Set</b> (Primary + Secondary)</td>\n                            <td class=\"p-4 border\">₹ 1,200 &#8211; 4,500</td>\n                            <td class=\"p-4 border\"><a href=\"/shop\" class=\"text-blue-600 font-bold underline\">Shop Now</a></td>\n                        </tr>\n                        <tr class=\"hover:bg-gray-50\">\n                            <td class=\"p-4 border\"><b>Cooling Coil Deep Cleaning</b> (Chemical)</td>\n                            <td class=\"p-4 border\">₹ 2,500 &#8211; 9,000</td>\n                            <td class=\"p-4 border\"><a href=\"tel:+919727257141\" class=\"text-blue-600 font-bold underline\">Book Service</a></td>\n                        </tr>\n                        <tr class=\"hover:bg-gray-50 bg-gray-50\">\n                            <td class=\"p-4 border\"><b>V-Belt Set Replacement</b> (Heavy Duty)</td>\n                            <td class=\"p-4 border\">₹ 1,000 &#8211; 3,500</td>\n                            <td class=\"p-4 border\"><a href=\"/fan-belts\" class=\"text-blue-600 font-bold underline\">Order Spares</a></td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n            <p class=\"text-xs text-gray-400 mt-4 italic text-center\">* Pricing depends on AHU capacity (CFM) and distance from Morbi main center.</p>\n        </div>\n    </section>\n\n    <!-- PROS AND CONS -->\n    <section class=\"section-padding bg-gray-50\">\n        <div class=\"container mx-auto px-4\">\n            <h2 class=\"text-3xl font-bold mb-10 text-center\">Pros and Cons of Regular AHU Maintenance</h2>\n            <div class=\"grid md:grid-cols-2 gap-10\">\n                <div class=\"bg-green-50 p-8 rounded-2xl shadow-sm border-l-8 border-green-500\">\n                    <h3 class=\"text-2xl font-bold mb-4 text-green-800\">Advantages (Pros)</h3>\n                    <ul class=\"space-y-3\">\n                        <li><i class=\"fas fa-plus-circle text-green-500 mr-2\"></i> <b>Production Uptime:</b> Prevents unplanned shutdowns of tile production lines.</li>\n                        <li><i class=\"fas fa-plus-circle text-green-500 mr-2\"></i> <b>Dust Mitigation:</b> Keeps factory dust away from sensitive control rooms and labs.</li>\n                        <li><i class=\"fas fa-plus-circle text-green-500 mr-2\"></i> <b>Electricity Savings:</b> Clean coils can reduce HVAC power load by up to 20-30%.</li>\n                        <li><i class=\"fas fa-plus-circle text-green-500 mr-2\"></i> <b>Improved Motor Life:</b> Regular greasing prevents expensive blower motor burnouts.</li>\n                        <li><i class=\"fas fa-plus-circle text-green-500 mr-2\"></i> <b>Worker Efficiency:</b> Comfortable indoor temperatures improve workforce productivity.</li>\n                        <li><i class=\"fas fa-plus-circle text-green-500 mr-2\"></i> <b>Consistent Humidity:</b> Critical for ensuring precise chemical mixtures in labs.</li>\n                        <li><i class=\"fas fa-plus-circle text-green-500 mr-2\"></i> <b>Fire Safety:</b> Cleaning accumulated dust in ducts reduces fire risks.</li>\n                    </ul>\n                </div>\n                <div class=\"bg-red-50 p-8 rounded-2xl shadow-sm border-l-8 border-red-500\">\n                    <h3 class=\"text-2xl font-bold mb-4 text-red-800\">Risks of Neglect (Cons)</h3>\n                    <ul class=\"space-y-3\">\n                        <li><i class=\"fas fa-minus-circle text-red-500 mr-2\"></i> <b>Mechanical Failure:</b> Ceramic dust acts as an abrasive, destroying unmaintained bearings.</li>\n                        <li><i class=\"fas fa-minus-circle text-red-500 mr-2\"></i> <b>High Repair Costs:</b> Neglected AHUs often need complete coil or blower replacements.</li>\n                        <li><i class=\"fas fa-minus-circle text-red-500 mr-2\"></i> <b>Poor Air Quality:</b> Re-circulating dusty air affects staff health and morale.</li>\n                        <li><i class=\"fas fa-minus-circle text-red-500 mr-2\"></i> <b>Inefficient Cooling:</b> Clogged filters cause &#8220;short-cycling&#8221; of the chiller system.</li>\n                        <li><i class=\"fas fa-minus-circle text-red-500 mr-2\"></i> <b>Odor Problems:</b> Stagnant water in drain pans breeds mold in humid Morbi weather.</li>\n                        <li><i class=\"fas fa-minus-circle text-red-500 mr-2\"></i> <b>Warranty Issues:</b> Manufacturers may deny claims if service records are missing.</li>\n                        <li><i class=\"fas fa-minus-circle text-red-500 mr-2\"></i> <b>Energy Wastage:</b> Forcing air through blocked filters skyrockets your kVA consumption.</li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- ERROR CODES -->\n    <section class=\"section-padding bg-white\">\n        <div class=\"container mx-auto px-4\">\n            <h2 class=\"text-3xl font-bold mb-8 text-center\">Common AHU Error Codes &#038; Solutions</h2>\n            <div class=\"grid md:grid-cols-2 lg:grid-cols-4 gap-4\">\n                <div class=\"p-6 border rounded hover:border-blue-500 transition shadow-sm\">\n                    <h4 class=\"font-bold text-red-600 mb-2\">E1: Dirty Filter Alert</h4>\n                    <p class=\"text-xs\"><b>Solution:</b> Replace primary filters immediately. Clean the mesh filter if washable.</p>\n                </div>\n                <div class=\"p-6 border rounded hover:border-blue-500 transition shadow-sm\">\n                    <h4 class=\"font-bold text-red-600 mb-2\">E5: Motor Overcurrent</h4>\n                    <p class=\"text-xs\"><b>Solution:</b> Check for bearing friction. Verify supply voltage from the plant grid.</p>\n                </div>\n                <div class=\"p-6 border rounded hover:border-blue-500 transition shadow-sm\">\n                    <h4 class=\"font-bold text-red-600 mb-2\">E7: Water Level Alarm</h4>\n                    <p class=\"text-xs\"><b>Solution:</b> Clear blockages in the condensate drain line. Inspect the &#8220;P&#8221; trap.</p>\n                </div>\n                <div class=\"p-6 border rounded hover:border-blue-500 transition shadow-sm\">\n                    <h4 class=\"font-bold text-red-600 mb-2\">L4: Belt Slip / Break</h4>\n                    <p class=\"text-xs\"><b>Solution:</b> Inspect V-belts for wear. Tension or replace the belt set as needed.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- FAQS -->\n    <section class=\"section-padding bg-gray-50\">\n        <div class=\"container mx-auto px-4 max-w-4xl\">\n            <h2 class=\"text-3xl font-bold mb-10 text-center\">Morbi AHU Service FAQs</h2>\n            <div class=\"space-y-6\">\n                <div class=\"bg-white p-6 rounded-xl shadow-sm\">\n                    <h4 class=\"font-bold text-lg mb-2\">1. Why are Air Handling Unit services Morbi different?</h4>\n                    <p class=\"text-gray-600\">Morbi has a high concentration of ceramic dust. Our service includes heavy-duty filtration cleaning and anti-abrasive bearing lubrication specifically for this environment.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl shadow-sm\">\n                    <h4 class=\"font-bold text-lg mb-2\">2. Do you provide AHU AMC for ceramic factories?</h4>\n                    <p class=\"text-gray-600\">Yes, we specialize in industrial AMCs that include monthly deep inspections to prevent any breakdown in your production-critical HVAC systems.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl shadow-sm\">\n                    <h4 class=\"font-bold text-lg mb-2\">3. How quickly can you reach Wankaner GIDC?</h4>\n                    <p class=\"text-gray-600\">We have a mobile service team in Morbi that can reach Wankaner and Lakhdhirpur within 2-4 hours for emergency repairs.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl shadow-sm\">\n                    <h4 class=\"font-bold text-lg mb-2\">4. Can you handle AHU motor repairs?</h4>\n                    <p class=\"text-gray-600\">Yes, we offer on-site bearing replacement and off-site precision motor rewinding for all industrial motors up to 50 HP.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl shadow-sm\">\n                    <h4 class=\"font-bold text-lg mb-2\">5. Do you supply AHU filters in Morbi?</h4>\n                    <p class=\"text-gray-600\">We maintain a large stock of synthetic pre-filters and fine filters in standard sizes for immediate delivery in Morbi.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl shadow-sm\">\n                    <h4 class=\"font-bold text-lg mb-2\">6. Why is my AHU making a loud vibration?</h4>\n                    <p class=\"text-gray-600\">Vibration is often caused by an imbalanced blower wheel due to dust accumulation or worn-out isolators. We provide dynamic balancing services.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl shadow-sm\">\n                    <h4 class=\"font-bold text-lg mb-2\">7. Are your technicians trained for industrial safety?</h4>\n                    <p class=\"text-gray-600\">Yes, all Atlas Aircon technicians follow strict safety protocols, including LOTO (Lock Out Tag Out) during AHU servicing in factory premises.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl shadow-sm\">\n                    <h4 class=\"font-bold text-lg mb-2\">8. Can AHU service help reduce factory electricity bills?</h4>\n                    <p class=\"text-gray-600\">Absolutely. A well-maintained AHU runs with lower resistance, reducing the amperage drawn by the fan motor significantly.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl shadow-sm\">\n                    <h4 class=\"font-bold text-lg mb-2\">9. Do you service AHUs for offices and showrooms?</h4>\n                    <p class=\"text-gray-600\">Yes, we provide premium AHU services for commercial showrooms on Shanala Road and office blocks throughout Morbi.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl shadow-sm\">\n                    <h4 class=\"font-bold text-lg mb-2\">10. How can I book a service today?</h4>\n                    <p class=\"text-gray-600\">Call +91 97272 57141 or chat with us on WhatsApp. Our industrial audit team will visit your site for a free initial assessment.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- AREAS SERVED LIST -->\n    <section class=\"section-padding bg-white border-t\">\n        <div class=\"container mx-auto px-4\">\n            <h2 class=\"text-2xl font-bold mb-6\">Service Presence Across Morbi District</h2>\n            <div class=\"text-sm text-gray-500 leading-relaxed overflow-y-auto max-h-40 p-4 bg-gray-50 rounded\">\n                Morbi City | Ravapar | Shakti Nagar | Mahendranagar | Trajpar | Sama Kanthe | Shanala Road | Navlakhi Road | Lakhdhirpur Road | Morbi GIDC-1 | Morbi GIDC-2 | Wankaner | Wankaner GIDC | Halvad | Halvad Industrial Zone | Tankara | Maliya Miyana | Jetpar Road | Ghuntu Road | Pipali-Jetpar Road.\n            </div>\n        </div>\n    </section>\n\n    <!-- FOOTER -->\n    <footer class=\"bg-gray-900 text-white section-padding\">\n        <div class=\"container mx-auto px-4 grid md:grid-cols-4 gap-12\">\n            <div>\n                <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\" alt=\"Atlas Aircon\" class=\"h-10 mb-6 brightness-0 invert\" title=\"\">\n                <p class=\"text-gray-400 text-sm\">Providing expert industrial HVAC and <b>Air Handling Unit services Morbi</b> for the ceramic world. Reliability is our core strength.</p>\n            </div>\n            <div>\n                <h4 class=\"font-bold mb-4\">Core Services</h4>\n                <ul class=\"text-gray-400 text-sm space-y-2\">\n                    <li><a href=\"/chiller-repair-services-vadodara\" class=\"hover:text-white underline\">Chiller Repair</a></li>\n                    <li><a href=\"/hvac-repair-services-vadodara\" class=\"hover:text-white underline\">HVAC Solutions</a></li>\n                    <li><a href=\"/ac-service-vadodara\" class=\"hover:text-white underline\">Industrial AC Service</a></li>\n                    <li><a href=\"/panel-ac-service-vadodara\" class=\"hover:text-white underline\">Panel AC Repair</a></li>\n                </ul>\n            </div>\n            <div>\n                <h4 class=\"font-bold mb-4\">Industrial Hubs</h4>\n                <ul class=\"text-gray-400 text-sm space-y-2\">\n                    <li><a href=\"/locations\" class=\"hover:text-white underline\">Morbi GIDC</a></li>\n                    <li><a href=\"/locations\" class=\"hover:text-white underline\">Wankaner GIDC</a></li>\n                    <li><a href=\"/locations\" class=\"hover:text-white underline\">Halvad Zone</a></li>\n                    <li><a href=\"/locations\" class=\"hover:text-white underline\">Jetpar Road</a></li>\n                </ul>\n            </div>\n            <div>\n                <h4 class=\"font-bold mb-4\">Contact Morbi Support</h4>\n                <p class=\"text-gray-400 text-sm mb-2\"><b>Phone:</b> +91 97272 57141</p>\n                <p class=\"text-gray-400 text-sm mb-2\"><b>Email:</b> atlasaircon1@gmail.com</p>\n                <p class=\"text-gray-400 text-sm\"><b>Service Area:</b> Morbi District, Gujarat 363641</p>\n            </div>\n        </div>\n    </footer>\n\n    <!-- WHATSAPP FLOAT -->\n    <a href=\"https://wa.me/919727257141\" class=\"whatsapp-float\" target=\"_blank\" rel=\"noopener\">\n        <i class=\"fab fa-whatsapp mr-2\"></i> Morbi Support\n    </a>\n\n    <!-- JSON-LD SCHEMA -->\n    <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"Service\",\n      \"serviceType\": \"Air Handling Unit Services\",\n      \"provider\": {\n        \"@type\": \"LocalBusiness\",\n        \"name\": \"Atlas Aircon Morbi\",\n        \"image\": \"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\",\n        \"address\": {\n          \"@type\": \"PostalAddress\",\n          \"streetAddress\": \"Shanala Road\",\n          \"addressLocality\": \"Morbi\",\n          \"addressRegion\": \"Gujarat\",\n          \"postalCode\": \"363641\",\n          \"addressCountry\": \"IN\"\n        },\n        \"telephone\": \"+919727257141\",\n        \"priceRange\": \"₹₹\",\n        \"email\": \"atlasaircon1@gmail.com\"\n      },\n      \"areaServed\": {\n        \"@type\": \"AdministrativeArea\",\n        \"name\": \"Morbi District\"\n      },\n      \"aggregateRating\": {\n        \"@type\": \"AggregateRating\",\n        \"ratingValue\": \"4.9\",\n        \"reviewCount\": \"1580\"\n      },\n      \"hasOfferCatalog\": {\n        \"@type\": \"O