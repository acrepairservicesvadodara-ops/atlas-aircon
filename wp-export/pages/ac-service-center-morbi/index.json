  "content": {
    "rendered": "<div class=\"atlas-purified-matrix\"><style>\n        body { font-family: 'Inter', sans-serif; }\n        .chart-container {\n            position: relative;\n            width: 100%;\n            max-width: 600px;\n            margin-left: auto;\n            margin-right: auto;\n            height: 300px;\n            max-height: 400px;\n        }\n        @media (min-width: 768px) { .chart-container { height: 350px; } }\n        .custom-scroll::-webkit-scrollbar { width: 4px; }\n        .custom-scroll::-webkit-scrollbar-track { background: #f3f4f6; }\n        .custom-scroll::-webkit-scrollbar-thumb { background: #b45309; border-radius: 10px; }\n        .fade-in { animation: fadeIn 0.6s ease-out; }\n        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }\n        .persona-card-active { border-color: #b45309; background-color: #fffbeb; box-shadow: 0 10px 15px -3px rgba(180, 83, 9, 0.1); }\n    </style>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n<script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"LocalBusiness\",\n      \"name\": \"Atlas Aircon Morbi\",\n      \"image\": \"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\",\n      \"@id\": \"https://atlasaircons.com/morbi\",\n      \"url\": \"https://atlasaircons.com/morbi\",\n      \"telephone\": \"+91 97272 57141\",\n      \"email\": \"atlasaircon1@gmail.com\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"addressLocality\": \"Morbi\",\n        \"addressRegion\": \"Gujarat\",\n        \"postalCode\": \"363641\",\n        \"addressCountry\": \"IN\"\n      },\n      \"geo\": {\n        \"@type\": \"GeoCoordinates\",\n        \"latitude\": 22.8120,\n        \"longitude\": 70.8236\n      },\n      \"openingHoursSpecification\": {\n        \"@type\": \"OpeningHoursSpecification\",\n        \"dayOfWeek\": [\n          \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\", \"Sunday\"\n        ],\n        \"opens\": \"00:00\",\n        \"closes\": \"23:59\"\n      }\n    }\n    </script>\n<script>\n        const residential = [\n            \"Morbi City\", \"Ravapar Road\", \"Shakti Plot\", \"Sardar Nagar\", \"Sanala Road\", \"Mahendranagar\", \"GIDC Residential\", \n            \"Nazarbaug Area\", \"Station Road\", \"Civil Hospital Area\", \"Lati Plot\", \"Bapa Sitaram Chowk\", \"Ramco Bungalow\", \n            \"Gokul Nagar\", \"Avni Road\", \"Vasant Plot\", \"Nanakwada\", \"Kuber Cinema Area\", \"Gayatri Nagar\", \"Panchasar Road\",\n            \"Wankaner City Boundary\", \"Halvad Boundary\", \"Tankara City Area\"\n        ];\n        \n        const industrial = [\n            \"Morbi GIDC-1\", \"Morbi GIDC-2\", \"Ceramic Zone - Jetpar Road\", \"Lakhdhirpur Road Industrial Estate\", \n            \"Navlakhi Road Industrial Area\", \"Ghuntu Industrial Cluster\", \"Rafaleshwar Industrial Hub\", \n            \"Wankaner GIDC\", \"Tankara Industrial Belt\", \"Morbi 2nd Industrial Zone\", \"Ceramic City Estates\",\n            \"Tiles Manufacturing Belt\", \"Vaghasiya Industrial Units\", \"Maliya Highway Industrial Area\"\n        ];\n        \n        const allAreas = [...residential, ...industrial];\n\n        function renderAreas(list) {\n            const grid = document.getElementById('areaGrid');\n            grid.innerHTML = '';\n            list.forEach(area => {\n                const div = document.createElement('div');\n                div.className = \"bg-indigo-900/50 p-3 rounded-xl border border-indigo-800 hover:bg-indigo-800 transition cursor-default text-center text-indigo-300\";\n                div.textContent = area;\n                grid.appendChild(div);\n            });\n        }\n\n        function filterAreas() {\n            const query = document.getElementById('areaSearch').value.toLowerCase();\n            const filtered = allAreas.filter(a => a.toLowerCase().includes(query));\n            renderAreas(filtered);\n        }\n\n        function switchPersona(persona) {\n            // Content Toggle\n            document.getElementById('content-home').classList.toggle('hidden', persona !== 'home');\n            document.getElementById('content-factory').classList.toggle('hidden', persona !== 'factory');\n            \n            // Button Style Toggle\n            document.getElementById('btn-home').classList.toggle('persona-card-active', persona === 'home');\n            document.getElementById('btn-factory').classList.toggle('persona-card-active', persona === 'factory');\n        }\n\n        function solveError() {\n            const code = document.getElementById('errorSelect').value;\n            const hub = document.getElementById('solutionResult');\n            const issue = document.getElementById('issueText');\n            const solution = document.getElementById('solutionText');\n\n            const errors = {\n                \"E1\": [\"Sensor Fault (Morbi Dust)\", \"Ceramic dust penetration in thermistor; cleaning and sensor recalibration required.\"],\n                \"E4\": [\"Fan Motor Fail (High Friction)\", \"Fine dust causing motor bearing jam; lubricating or capacitor swap needed.\"],\n                \"F1\": [\"Inverter Board Phase Fail\", \"Industrial power surge related IPM failure; module repair and voltage check.\"],\n                \"C6\": [\"Communication Loss\", \"Signal wiring corrosion or ceramic dust interference on connector terminals.\"],\n                \"P4\": [\"IPM Overheat (Heat Sink Block)\", \"Condensed dust layer on heat sink paste; cleaning and reapplication required.\"],\n                \"EC\": [\"Gas Leakage Detected\", \"Pressure test required for industrial-grade fatigue leaks; brazing and gas refill.\"]\n            };\n\n            if (errors[code]) {\n                hub.classList.remove('hidden');\n                issue.textContent = errors[code][0];\n                solution.textContent = errors[code][1];\n            } else {\n                hub.classList.add('hidden');\n            }\n        }\n\n        function initChart() {\n            const ctx = document.getElementById('priceChart').getContext('2d');\n            new Chart(ctx, {\n                type: 'bar',\n                data: {\n                    labels: ['Ceramic Shield Service', 'Industrial Gas Fill', 'PCB Repair', 'Capacitor', 'Compressor'],\n                    datasets: [{\n                        label: 'Average Morbi District Charge (₹)',\n                        data: [950, 4000, 3200, 750, 9800],\n                        backgroundColor: '#B45309',\n                        borderRadius: 16\n                    }]\n                },\n                options: {\n                    indexAxis: 'y', // Horizontal Bar Chart\n                    responsive: true,\n                    maintainAspectRatio: false,\n                    scales: {\n                        x: { beginAtZero: true, grid: { color: '#e5e7eb' }, ticks: { font: { size: 9 } } },\n                        y: { grid: { display: false }, ticks: { font: { size: 9, weight: 'bold' } } }\n                    },\n                    plugins: { legend: { display: false } }\n                }\n            });\n        }\n\n        window.onload = () => {\n            renderAreas(allAreas);\n            initChart();\n        };\n    </script>\n\n\n    <!-- Navigation -->\n    <nav class=\"bg-white/95 backdrop-blur-md shadow-sm sticky top-0 z-50 border-b border-amber-100\">\n        <div class=\"max-w-7xl mx-auto px-4 h-16 flex justify-between items-center\">\n            <div class=\"flex items-center gap-2\">\n                <div class=\"w-10 h-10 bg-amber-700 rounded-xl flex items-center justify-center text-white shadow-lg shadow-amber-200\">\n                    <i class=\"fas fa-snowflake animate-pulse\"></i>\n                </div>\n                <div class=\"flex flex-col\">\n                    <span class=\"font-extrabold text-lg leading-tight tracking-tight uppercase\">Atlas Aircon</span>\n                    <span class=\"text-[9px] text-amber-700 font-black uppercase tracking-[0.2em]\">Service Center Morbi</span>\n                </div>\n            </div>\n            <div class=\"hidden lg:flex space-x-6 text-[11px] font-bold uppercase tracking-wider text-slate-500\">\n                <a href=\"#directory\" class=\"hover:text-amber-700 transition\">Persona Directory</a>\n                <a href=\"#diagnose\" class=\"hover:text-amber-700 transition\">Diagnostics</a>\n                <a href=\"#pricing\" class=\"hover:text-amber-700 transition\">Price Stats</a>\n                <a href=\"#areas\" class=\"hover:text-amber-700 transition\">Morbi Coverage</a>\n            </div>\n            <a href=\"https://wa.me/919727257141\" target=\"_blank\" class=\"bg-amber-700 hover:bg-amber-800 text-white px-5 py-2.5 rounded-full text-xs font-black shadow-md transition flex items-center gap-2\" rel=\"noopener\">\n                <i class=\"fab fa-whatsapp\"></i> +91 97272 57141\n            </a>\n        </div>\n    </nav>\n\n    <!-- Hero Section -->\n    <header class=\"relative bg-white border-b border-amber-50 overflow-hidden\">\n        <div class=\"max-w-7xl mx-auto px-4 py-16 lg:py-32\">\n            <div class=\"lg:flex lg:items-center lg:gap-24\">\n                <div class=\"lg:w-1/2 text-center lg:text-left fade-in\">\n                    <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 text-amber-700 text-[10px] font-bold uppercase tracking-widest mb-6 border border-amber-100\">\n                        <i class=\"fas fa-industry\"></i> Ceramic Capital HVAC Specialists\n                    </div>\n                    <h1 class=\"text-6xl lg:text-8xl font-black text-gray-900 leading-[1.0] mb-6 tracking-tighter\">\n                        Premier <span class=\"text-amber-700\">AC Service Center Morbi</span>\n                    </h1>\n                    <p class=\"text-lg text-gray-500 mb-4 leading-relaxed max-w-xl mx-auto lg:mx-0\">\n                        Specialized cooling solutions for Morbi&#8217;s unique high-dust industrial zones and residential pockets. Rapid doorstep response.\n                    </p>\n                    <p class=\"text-sm font-bold text-red-600 mb-10 uppercase tracking-wide\">\n                        *Independent Specialist: multi-brand expert for out-of-warranty units.\n                    </p>\n                    <div class=\"flex flex-wrap justify-center lg:justify-start gap-4\">\n                        <a href=\"#directory\" class=\"px-8 py-4 bg-gray-900 text-white rounded-2xl font-bold shadow-xl hover:bg-gray-800 transition text-sm\">Select Your Persona</a>\n                        <a href=\"https://wa.me/919727257141\" class=\"px-8 py-4 bg-amber-50 text-amber-800 rounded-2xl font-bold hover:bg-amber-100 transition text-sm\" target=\"_blank\" rel=\"noopener\">Book Technician</a>\n                    </div>\n                </div>\n                <div class=\"lg:w-1/2 mt-12 lg:mt-0 relative\">\n                    <img decoding=\"async\" class=\"rounded-[50px] shadow-2xl border-4 border-white transform hover:scale-[1.02] transition duration-500\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/Atlas-aircon-vehicle.webp\" alt=\"AC Service Center Morbi Van\" title=\"\">\n                    <div class=\"absolute -bottom-10 right-10 bg-indigo-900 text-white p-8 rounded-3xl shadow-2xl border-t-4 border-amber-500\">\n                        <p class=\"text-xs font-bold uppercase opacity-60 tracking-widest\">Industry focus</p>\n                        <p class=\"text-2xl font-black italic\">Ceramic GIDC Hub</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- Knowledge Section: Industrial Context -->\n    <section class=\"py-20 bg-[#FDFBFA]\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"bg-white rounded-[60px] p-10 lg:p-16 shadow-sm border border-amber-50\">\n                <div class=\"lg:flex lg:gap-16 items-center\">\n                    <div class=\"lg:w-1/2\">\n                        <h2 class=\"text-4xl font-black text-gray-900 mb-8 tracking-tight\">Battling Morbi&#8217;s Ceramic Dust</h2>\n                        <p class=\"text-gray-600 leading-relaxed mb-6 text-lg\">\n                            Morbi is India&#8217;s ceramic hub, but the fine dust particles from tile manufacturing are the silent killers of air conditioners. In areas like <strong>Rafaleshwar</strong> and the <strong>Jetpar Road GIDC</strong>, standard AC filters fail within weeks.\n                        </p>\n                        <p class=\"text-gray-600 leading-relaxed mb-8\">\n                            As the leading <strong>AC service center in Morbi</strong>, we provide &#8220;Ceramic Shield&#8221; deep cleaning using high-pressure chemical jets that dissolve hardened dust layers from the condenser. We specialize in industrial chiller maintenance and heavy-duty ductable systems that power Morbi&#8217;s massive manufacturing floors.\n                        </p>\n                    </div>\n                    <div class=\"lg:w-1/2 grid grid-cols-2 gap-4\">\n                        <div class=\"p-6 bg-amber-50 rounded-3xl border border-amber-100\">\n                            <i class=\"fas fa-microchip text-amber-700 mb-4 text-2xl\"></i>\n                            <h4 class=\"font-bold text-gray-900\">PCB Sealing</h4>\n                            <p class=\"text-xs text-gray-500 mt-2\">Specialized coating to protect boards from fine industrial dust.</p>\n                        </div>\n                        <div class=\"p-6 bg-indigo-50 rounded-3xl border border-indigo-100\">\n                            <i class=\"fas fa-wind text-indigo-900 mb-4 text-2xl\"></i>\n                            <h4 class=\"font-bold text-gray-900\">High-Flow AHU</h4>\n                            <p class=\"text-xs text-gray-500 mt-2\">Ducting solutions for ceramic factory office blocks.</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- DIFFERENT: Persona-Based Directory System -->\n    <section id=\"directory\" class=\"py-24 bg-white border-y border-amber-50\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"text-center mb-16\">\n                <h2 class=\"text-4xl font-black text-gray-900 mb-4\">Choose Your Cooling Persona</h2>\n                <p class=\"text-gray-500\">We&#8217;ve organized our 40+ specialized service portals based on your specific environment.</p>\n            </div>\n\n            <div class=\"flex flex-col lg:flex-row gap-6 mb-16\">\n                <!-- Residential Persona -->\n                <button onclick=\"switchPersona('home')\" id=\"btn-home\" class=\"flex-1 p-8 rounded-[40px] border-2 border-gray-100 text-left transition-all hover:border-amber-400 persona-card-active\">\n                    <div class=\"w-12 h-12 bg-amber-100 rounded-2xl flex items-center justify-center text-amber-700 mb-6\">\n                        <i class=\"fas fa-home text-xl\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-black text-gray-900 uppercase tracking-tighter\">Home &#038; Office</h3>\n                    <p class=\"text-sm text-gray-500 mt-2\">Split, Window, and VRF systems for residential Morbi and administrative blocks.</p>\n                </button>\n                <!-- Industrial Persona -->\n                <button onclick=\"switchPersona('factory')\" id=\"btn-factory\" class=\"flex-1 p-8 rounded-[40px] border-2 border-gray-100 text-left transition-all hover:border-amber-400\">\n                    <div class=\"w-12 h-12 bg-indigo-100 rounded-2xl flex items-center justify-center text-indigo-900 mb-6\">\n                        <i class=\"fas fa-industry text-xl\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-black text-gray-900 uppercase tracking-tighter\">Ceramic Industry</h3>\n                    <h3 class=\"text-sm text-indigo-900 font-bold\">Industrial &#038; GIDC</h3>\n                    <p class=\"text-sm text-gray-500 mt-2\">Chillers, Panel ACs, and centralized HVAC for manufacturing plants.</p>\n                </button>\n            </div>\n\n            <!-- Dynamic Content Area -->\n            <div id=\"persona-content\" class=\"fade-in\">\n                <!-- Residential Content -->\n                <div id=\"content-home\" class=\"space-y-12\">\n                    <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3\">\n                        <a href=\"/blue-star-ac-service-center-morbi\" class=\"p-3 bg-gray-50 rounded-xl text-[10px] font-black uppercase text-center hover:bg-amber-700 hover:text-white transition\">Blue Star</a>\n                        <a href=\"/lg-ac-service-center-morbi\" class=\"p-3 bg-gray-50 rounded-xl text-[10px] font-black uppercase text-center hover:bg-amber-700 hover:text-white transition\">LG Service</a>\n                        <a href=\"/samsung-ac-service-center-morbi\" class=\"p-3 bg-gray-50 rounded-xl text-[10px] font-black uppercase text-center hover:bg-amber-700 hover:text-white transition\">Samsung</a>\n                        <a href=\"/voltas-ac-service-center-morbi\" class=\"p-3 bg-gray-50 rounded-xl text-[10px] font-black uppercase text-center hover:bg-amber-700 hover:text-white transition\">Voltas</a>\n                        <a href=\"/daikin-ac-service-center-morbi\" class=\"p-3 bg-gray-50 rounded-xl text-[10px] font-black uppercase text-center hover:bg-amber-700 hover:text-white transition\">Daikin</a>\n                        <a href=\"/mitsubishi-ac-service-center-morbi\" class=\"p-3 bg-gray-50 rounded-xl text-[10px] font-black uppercase text-center hover:bg-amber-700 hover:text-white transition\">Mitsubishi</a>\n                    </div>\n                    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n                        <a href=\"/split-ac-service-morbi\" class=\"group relative rounded-3xl overflow-hidden aspect-video bg-gray-900\">\n                            <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/Window-ac-repair-service.webp\" class=\"w-full h-full object-cover opacity-50 group-hover:scale-110 transition duration-700\" alt=\"ac service center morbi - Field Operations\" title=\"\">\n                            <span class=\"absolute bottom-6 left-6 text-white font-black uppercase tracking-widest text-sm\">Split AC Portals</span>\n                        </a>\n                        <a href=\"/refrigerator-repair-morbi\" class=\"group relative rounded-3xl overflow-hidden aspect-video bg-gray-900\">\n                            <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/advance-panel-ac-repair-service.webp\" class=\"w-full h-full object-cover opacity-50 group-hover:scale-110 transition duration-700\" alt=\"ac service center morbi - Field Operations\" title=\"\">\n                            <span class=\"absolute bottom-6 left-6 text-white font-black uppercase tracking-widest text-sm\">Home Appliances</span>\n                        </a>\n                        <div class=\"p-8 bg-amber-700 rounded-[40px] text-white flex flex-col justify-center\">\n                            <h4 class=\"font-black text-xl mb-4\">Residential AMC</h4>\n                            <p class=\"text-xs text-amber-100 mb-6\">Fixed yearly maintenance for Morbi&#8217;s housing colonies.</p>\n                            <a href=\"/ac-repair-service-price-list-morbi\" class=\"text-[10px] font-black uppercase tracking-widest bg-white text-amber-700 px-6 py-3 rounded-full w-fit\">View Rates</a>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Industrial Content (Hidden by default) -->\n                <div id=\"content-factory\" class=\"hidden space-y-12\">\n                    <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6\">\n                        <a href=\"/chiller-repair-morbi\" class=\"p-8 bg-indigo-900 text-white rounded-[40px] flex flex-col justify-between hover:bg-indigo-800 transition h-64\">\n                            <i class=\"fas fa-snowflake text-3xl\"></i>\n                            <div>\n                                <h4 class=\"text-xl font-black uppercase tracking-tighter\">Industrial Chillers</h4>\n                                <p class=\"text-xs text-indigo-300 mt-2\">Specialized for ceramic kilns and machinery cooling.</p>\n                            </div>\n                        </a>\n                        <a href=\"/panel-ac-service-morbi\" class=\"p-8 bg-white border-2 border-indigo-100 rounded-[40px] flex flex-col justify-between hover:border-amber-400 transition h-64\">\n                            <i class=\"fas fa-server text-3xl text-indigo-900\"></i>\n                            <div>\n                                <h4 class=\"text-xl font-black text-gray-900 uppercase tracking-tighter\">Panel AC Repair</h4>\n                                <p class=\"text-xs text-gray-500 mt-2\">Protecting tile manufacturing control panels.</p>\n                            </div>\n                        </a>\n                        <a href=\"/air-handling-unit-morbi\" class=\"p-8 bg-white border-2 border-indigo-100 rounded-[40px] flex flex-col justify-between hover:border-amber-400 transition h-64\">\n                            <i class=\"fas fa-fan text-3xl text-indigo-900\"></i>\n                            <div>\n                                <h4 class=\"text-xl font-black text-gray-900 uppercase tracking-tighter\">AHU Maintenance</h4>\n                                <p class=\"text-xs text-gray-500 mt-2\">Filtration systems for high-dust zones.</p>\n                            </div>\n                        </a>\n                        <a href=\"/ducting-repair-morbi\" class=\"p-8 bg-indigo-50 rounded-[40px] flex flex-col justify-between border-2 border-transparent h-64\">\n                            <i class=\"fas fa-project-diagram text-3xl text-indigo-900\"></i>\n                            <div>\n                                <h4 class=\"text-xl font-black text-gray-900 uppercase tracking-tighter\">HVAC Ducting</h4>\n                                <p class=\"text-xs text-gray-500 mt-2\">Design and repair for large Morbi factories.</p>\n                            </div>\n                        </a>\n                    </div>\n                    <div class=\"flex flex-wrap gap-4 justify-center\">\n                        <a href=\"/copper-pipe-morbi/\" class=\"px-6 py-2 bg-gray-50 rounded-full text-xs font-bold border border-gray-100\">Copper Pipe</a>\n                        <a href=\"/gas-charging-morbi/\" class=\"px-6 py-2 bg-gray-50 rounded-full text-xs font-bold border border-gray-100\">Gas Refill</a>\n                        <a href=\"/pcb-repair-morbi\" class=\"px-6 py-2 bg-gray-50 rounded-full text-xs font-bold border border-gray-100\">Industrial PCB</a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Diagnostic Hub: Ceramic Specific -->\n    <section id=\"diagnose\" class=\"py-24 bg-[#FDFBFA]\">\n        <div class=\"max-w-6xl mx-auto px-4\">\n            <div class=\"lg:flex lg:items-center lg:gap-16\">\n                <div class=\"lg:w-1/2 mb-12 lg:mb-0\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/02/Emergency-AC-Breakdown-Atlas-Aircon.webp\" class=\"rounded-[50px] shadow-2xl mb-10\" alt=\"Emergency Breakdown Morbi\" title=\"\">\n                    <h2 class=\"text-5xl font-black text-gray-900 mb-6 tracking-tighter\">Morbi Diagnostic Hub</h2>\n                    <p class=\"text-gray-500 leading-relaxed mb-8\">\n                        Is your unit struggling against the Morbi dust? Check your error code here. Our <strong>AC Service Center Morbi</strong> team uses these technical definitions to provide immediate on-site fixes.\n                    </p>\n                    <div class=\"bg-white p-8 rounded-[40px] shadow-sm border border-amber-100 relative overflow-hidden\">\n                        <div class=\"absolute top-0 right-0 p-4 opacity-10\">\n                            <i class=\"fas fa-shield-alt text-6xl text-amber-700\"></i>\n                        </div>\n                        <h4 class=\"font-black text-amber-700 uppercase text-xs mb-2\">Technical Warning</h4>\n                        <p class=\"text-sm font-bold text-gray-800 italic leading-relaxed\">&#8220;Dust-clogged condensers in Morbi Ceramic GIDC are responsible for 70% of compressor failures. Don&#8217;t wait for Error code EC.&#8221;</p>\n                    </div>\n                </div>\n                <div class=\"lg:w-1/2\">\n                    <div class=\"bg-gray-900 rounded-[60px] p-10 lg:p-14 text-white shadow-2xl\">\n                        <label class=\"block text-[10px] font-black text-amber-500 uppercase tracking-[0.3em] mb-4\">Select Display Code</label>\n                        <select id=\"errorSelect\" onchange=\"solveError()\" class=\"w-full p-5 rounded-2xl bg-gray-800 border-2 border-gray-700 focus:border-amber-500 outline-none transition font-bold text-white mb-10\">\n                            <option value=\"\">&#8212; Choose Code &#8212;</option>\n                            <option value=\"E1\">E1 / E2 &#8211; Temp Sensor</option>\n                            <option value=\"E4\">E4 &#8211; Fan Motor Issue</option>\n                            <option value=\"F1\">F1 / F2 &#8211; Phase Error</option>\n                            <option value=\"C6\">C6 &#8211; Comm. Error</option>\n                            <option value=\"P4\">P4 &#8211; Inverter Heat</option>\n                            <option value=\"EC\">EC &#8211; Leak Warning</option>\n                        </select>\n                        <div id=\"solutionResult\" class=\"hidden fade-in space-y-6\">\n                            <div class=\"pb-6 border-b border-gray-800\">\n                                <h4 class=\"text-[10px] font-black text-gray-500 uppercase mb-2\">Failure Point</h4>\n                                <p id=\"issueText\" class=\"text-xl font-black\"></p>\n                            </div>\n                            <div>\n                                <h4 class=\"text-[10px] font-black text-amber-500 uppercase mb-2\">Atlas Solution</h4>\n                                <p id=\"solutionText\" class=\"text-sm text-gray-400 font-medium leading-relaxed\"></p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Pricing Analysis: Horizontal Bar Chart -->\n    <section id=\"pricing\" class=\"py-24 bg-white\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"text-center mb-16\">\n                <h2 class=\"text-4xl font-black text-gray-900 mb-4 tracking-tight\">Morbi District Service Price Index</h2>\n                <p class=\"text-gray-500\">Transparent maintenance pricing for residential households and ceramic industrial estates.</p>\n            </div>\n\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\">\n                <div>\n                    <h3 class=\"text-2xl font-black text-gray-900 mb-6 italic\">Why Morbi Pricing Differs?</h3>\n                    <p class=\"text-gray-500 mb-8 leading-relaxed\">\n                        Industrial-grade units in Morbi require heavy-duty detergents and specialized nitrogen pressure testing to combat industrial-grade leakages. We offer competitive district rates while ensuring no compromise on service quality.\n                    </p>\n                    <div class=\"space-y-4\">\n                        <div class=\"flex justify-between items-center p-5 bg-gray-50 rounded-3xl border border-gray-100 hover:border-amber-300 transition\">\n                            <span class=\"text-sm font-bold text-gray-600\">Industrial Jet Service</span>\n                            <span class=\"text-sm font-black text-amber-700\">₹850 &#8211; ₹1200</span>\n                        </div>\n                        <div class=\"flex justify-between items-center p-5 bg-gray-50 rounded-3xl border border-gray-100 hover:border-amber-300 transition\">\n                            <span class=\"text-sm font-bold text-gray-600\">Gas Refilling (Industrial)</span>\n                            <span class=\"text-sm font-black text-amber-700\">₹3000 &#8211; ₹5000</span>\n                        </div>\n                        <div class=\"flex justify-between items-center p-5 bg-gray-50 rounded-3xl border border-gray-100 hover:border-amber-300 transition\">\n                            <span class=\"text-sm font-bold text-gray-600\">Specialized PCB Sealing</span>\n                            <span class=\"text-sm font-black text-amber-700\">₹1800 &#8211; ₹5500</span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"bg-gray-50 p-10 rounded-[50px] border border-amber-50 shadow-inner\">\n                    <h3 class=\"text-center text-[10px] font-black text-gray-400 uppercase tracking-widest mb-10\">Estimated Market Costs (Horizontal View)</h3>\n                    <div class=\"chart-container\">\n                        <canvas id=\"priceChart\"></canvas>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Coverage Locator (Integrated Footer Replacement) -->\n    <section id=\"areas\" class=\"py-24 bg-indigo-950 text-white rounded-t-[80px]\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"text-center mb-20\">\n                <h2 class=\"text-5xl font-black mb-6 tracking-tight\">Morbi Service Coverage Hub</h2>\n                <p class=\"text-indigo-300 max-w-xl mx-auto\">2-hour doorstep response across Morbi City, Ravapar, and the massive Ceramic GIDC corridors.</p>\n            </div>\n\n            <div class=\"relative max-w-xl mx-auto mb-16\">\n                <input type=\"text\" id=\"areaSearch\" onkeyup=\"filterAreas()\" placeholder=\"Search area (e.g. Ravapar, Morbi GIDC, Jetpar)...\" class=\"w-full px-8 py-6 rounded-full bg-indigo-900 border border-indigo-800 text-white placeholder-indigo-400 focus:ring-2 focus:ring-amber-500 outline-none transition shadow-2xl\">\n                <div class=\"absolute inset-y-0 right-8 flex items-center\">\n                    <i class=\"fas fa-search text-indigo-500\"></i>\n                </div>\n            </div>\n\n            <!-- Dynamic Search Results -->\n            <div id=\"areaGrid\" class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 text-[10px] font-bold tracking-tight h-[450px] overflow-y-auto custom-scroll pr-6 pb-12\">\n                <!-- Areas injected by JS -->\n            </div>\n\n            <!-- Integrated Contact/Business Block -->\n            <div class=\"mt-20 pt-20 border-t border-indigo-900 lg:flex lg:justify-between lg:items-start\">\n                <div class=\"max-w-xs mb-16 lg:mb-0\">\n                    <div class=\"flex items-center gap-2 mb-8\">\n                        <div class=\"w-10 h-10 bg-amber-600 rounded-xl flex items-center justify-center text-white font-black text-xl shadow-lg\">A</div>\n                        <span class=\"text-2xl font-black tracking-tighter uppercase\">Atlas Aircon</span>\n                    </div>\n                    <p class=\"text-xs text-indigo-400 leading-relaxed mb-8 italic\">Official <strong>AC Service Center Morbi</strong> portal. Specialized independent repairs for the ceramic and industrial heart of Saurashtra.</p>\n                    <p class=\"text-[10px] text-indigo-700 uppercase font-black tracking-[0.3em]\">© 2026 Saurashtra AC Network</p>\n                </div>\n\n                <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-20\">\n                    <div>\n                        <h4 class=\"text-[10px] font-black text-amber-500 uppercase tracking-widest mb-6\">Morbi District Contact</h4>\n                        <ul class=\"space-y-6 text-sm font-semibold\">\n                            <li class=\"flex items-center gap-4\"><i class=\"fas fa-phone text-amber-500 text-lg\"></i> +91 97272 57141</li>\n                            <li class=\"flex items-center gap-4\"><i class=\"fas fa-envelope text-amber-500 text-lg\"></i> atlasaircon1@gmail.com</li>\n                            <li class=\"flex items-center gap-4\"><i class=\"fas fa-map-marker-alt text-amber-500 text-lg\"></i> Morbi / Saurashtra, Gujarat</li>\n                        </ul>\n                    </div>\n                    <div>\n                        <h4 class=\"text-[10px] font-black text-amber-500 uppercase tracking-widest mb-6\">Service Integrity</h4>\n                        <p class=\"text-[11px] text-indigo-400 font-medium leading-relaxed mb-6\">We are an independent, out-of-warranty specialist. We focus on fixing technical components rather than replacing entire modules.</p>\n                        <div class=\"flex gap-6\">\n                            <i class=\"fab fa-facebook text-indigo-700 hover:text-amber-500 transition text-xl\"></i>\n                            <i class=\"fab fa-instagram text-indigo-700 hover:text-amber-500 transition text-xl\"></i>\n                            <i class=\"fab fa-linkedin text-indigo-700 hover:text-amber-500 transition text-xl\"></i>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Schema Data: Morbi Focused -->\n    <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"LocalBusiness\",\n      \"name\": \"Atlas Aircon Morbi\",\n      \"image\": \"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\",\n      \"@id\": \"https://atlasaircons.com/morbi\",\n      \"url\": \"https://atlasaircons.com/morbi\",\n      \"telephone\": \"+91 97272 57141\",\n      \"email\": \"atlasaircon1@gmail.com\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"addressLocality\": \"Morbi\",\n        \"addressRegion\": \"Gujarat\",\n        \"postalCode\": \"363641\",\n        \"addressCountry\": \"IN\"\n      },\n      \"geo\": {\n        \"@type\": \"GeoCoordinates\",\n        \"latitude\": 22.8120,\n        \"longitude\": 70.8236\n      },\n      \"openingHoursSpecification\": {\n        \"@type\": \"OpeningHoursSpecification\",\n        \"dayOfWeek\": [\n          \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\", \"Sunday\"\n        ],\n        \"opens\": \"00:00\",\n        \"closes\": \"23:59\"\n      }\n    }\n    </script>\n\n    <!-- Application Logic -->\n    <script>\n        const residential = [\n            \"Morbi City\", \"Ravapar Road\", \"Shakti Plot\", \"Sardar Nagar\", \"Sanala Road\", \"Mahendranagar\", \"GIDC Residential\", \n            \"Nazarbaug Area\", \"Station Road\", \"Civil Hospital Area\", \"Lati Plot\", \"Bapa Sitaram Chowk\", \"Ramco Bungalow\", \n            \"Gokul Nagar\", \"Avni Road\", \"Vasant Plot\", \"Nanakwada\", \"Kuber Cinema Area\", \"Gayatri Nagar\", \"Panchasar Road\",\n            \"Wankaner City Boundary\", \"Halvad Boundary\", \"Tankara City Area\"\n        ];\n        \n        const industrial = [\n            \"Morbi GIDC-1\", \"Morbi GIDC-2\", \"Ceramic Zone - Jetpar Road\", \"Lakhdhirpur Road Industrial Estate\", \n            \"Navlakhi Road Industrial Area\", \"Ghuntu Industrial Cluster\", \"Rafaleshwar Industrial Hub\", \n            \"Wankaner GIDC\", \"Tankara Industrial Belt\", \"Morbi 2nd Industrial Zone\", \"Ceramic City Estates\",\n            \"Tiles Manufacturing Belt\", \"Vaghasiya Industrial Units\", \"Maliya Highway Industrial Area\"\n        ];\n        \n        const allAreas = [...residential, ...industrial];\n\n        function renderAreas(list) {\n            const grid = document.getElementById('areaGrid');\n            grid.innerHTML = '';\n            list.forEach(area => {\n                const div = document.createElement('div');\n                div.className = \"bg-indigo-900/50 p-3 rounded-xl border border-indigo-800 hover:bg-indigo-800 transition cursor-default text-center text-indigo-300\";\n                div.textContent = area;\n                grid.appendChild(div);\n            });\n        }\n\n        function filterAreas() {\n            const query = document.getElementById('areaSearch').value.toLowerCase();\n            const filtered = allAreas.filter(a => a.toLowerCase().includes(query));\n            renderAreas(filtered);\n        }\n\n        function switchPersona(persona) {\n            // Content Toggle\n            document.getElementById('content-home').classList.toggle('hidden', persona !== 'home');\n            document.getElementById('content-factory').classList.toggle('hidden', persona !== 'factory');\n            \n            // Button Style Toggle\n            document.getElementById('btn-home').classList.toggle('persona-card-active', persona === 'home');\n            document.getElementById('btn-factory').classList.toggle('persona-card-active', persona === 'factory');\n        }\n\n        function solveError() {\n            const code = document.getElementById('errorSelect').value;\n            const hub = document.getElementById('solutionResult');\n            const issue = document.getElementById('issueText');\n            const solution = document.getElementById('solutionText');\n\n            const errors = {\n                \"E1\": [\"Sensor Fault (Morbi Dust)\", \"Ceramic dust penetration in thermistor; cleaning and sensor recalibration required.\"],\n                \"E4\": [\"Fan Motor Fail (High Friction)\", \"Fine dust causing motor bearing jam; lubricating or capacitor swap needed.\"],\n                \"F1\": [\"Inverter Board Phase Fail\", \"Industrial power surge related IPM failure; module repair and voltage check.\"],\n                \"C6\": [\"Communication Loss\", \"Signal wiring corrosion or ceramic dust interference on connector terminals.\"],\n                \"P4\": [\"IPM Overheat (Heat Sink Block)\", \"Condensed dust layer on heat sink paste; cleaning and reapplication required.\"],\n                \"EC\": [\"Gas Leakage Detected\", \"Pressure test required for industrial-grade fatigue leaks; brazing and gas refill.\"]\n            };\n\n            if (errors[code]) {\n                hub.classList.remove('hidden');\n                issue.textContent = errors[code][0];\n                solution.textContent = errors[code][1];\n            } else {\n                hub.classList.add('hidden');\n            }\n        }\n\n        function initChart() {\n            const ctx = document.getElementById('priceChart').getContext('2d');\n            new Chart(ctx, {\n                type: 'bar',\n                data: {\n                    labels: ['Ceramic Shield Service', 'Industrial Gas Fill', 'PCB Repair', 'Capacitor', 'Compressor'],\n                    datasets: [{\n                        label: 'Average Morbi District Charge (₹)',\n                        data: [950, 4000, 3200, 750, 9800],\n                        backgroundColor: '#B45309',\n                        borderRadius: 16\n                    }]\n                },\n                options: {\n                    indexAxis: 'y', // Horizontal Bar Chart\n                    responsive: true,\n                    maintainAspectRatio: false,\n                    scales: {\n                        x: { beginAtZero: true, grid: { color: '#e5e7eb' }, ticks: { font: { size: 9 } } },\n                        y: { grid: { display: false }, ticks: { font: { size: 9, weight: 'bold' } } }\n                    },\n                    plugins: { legend: { display: false } }\n                }\n            });\n        }\n\n        window.onload = () => {\n            renderAreas(allAreas);\n            initChart();\n        };\n    </script>\n</div>",
