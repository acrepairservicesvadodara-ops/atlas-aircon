            </div>\n            <div>\n                <h4 class=\"font-bold mb-4\">Industrial Hubs</h4>\n                <ul class=\"text-gray-400 text-sm space-y-2\">\n                    <li><a href=\"/locations\" class=\"hover:text-white underline\">Sachin GIDC Support</a></li>\n                    <li><a href=\"/locations\" class=\"hover:text-white underline\">Hazira Plant Service</a></li>\n                    <li><a href=\"/locations\" class=\"hover:text-white underline\">Pandesara GIDC Repair</a></li>\n                    <li><a href=\"/locations\" class=\"hover:text-white underline\">Ichhapore GIDC Unit</a></li>\n                </ul>\n            </div>\n            <div>\n                <h4 class=\"font-bold mb-4\">Contact Surat Support</h4>\n                <p class=\"text-gray-400 text-sm mb-2\"><b>Phone:</b> +91 97272 57141</p>\n                <p class=\"text-gray-400 text-sm mb-2\"><b>Email:</b> atlasaircon1@gmail.com</p>\n                <p class=\"text-gray-400 text-sm\"><b>Service Area:</b> Surat City, Hazira, Sachin, Gujarat 395001</p>\n            </div>\n        </div>\n    </footer>\n\n    <!-- WHATSAPP FLOAT -->\n    <a href=\"https://wa.me/919727257141\" class=\"whatsapp-float\" target=\"_blank\" rel=\"noopener\">\n        <i class=\"fab fa-whatsapp mr-2\"></i> Surat Service\n    </a>\n\n    <!-- JSON-LD SCHEMA -->\n    <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"Service\",\n      \"serviceType\": \"Air Handling Unit Services\",\n      \"provider\": {\n        \"@type\": \"LocalBusiness\",\n        \"name\": \"Atlas Aircon Surat\",\n        \"image\": \"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\",\n        \"address\": {\n          \"@type\": \"PostalAddress\",\n          \"streetAddress\": \"Surat Industrial Area\",\n          \"addressLocality\": \"Surat\",\n          \"addressRegion\": \"Gujarat\",\n          \"postalCode\": \"395001\"