  "content": {
    "rendered": "<div class=\"atlas-purified-matrix\"><style>\n        body { font-family: 'Inter', sans-serif; }\n        .chart-container {\n            position: relative;\n            width: 100%;\n            max-width: 500px;\n            margin: auto;\n            height: 400px;\n        }\n        .custom-scroll::-webkit-scrollbar { width: 4px; }\n        .custom-scroll::-webkit-scrollbar-thumb { background: #15803D; border-radius: 10px; }\n        .fade-in { animation: fadeIn 0.6s ease-out; }\n        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }\n        .matrix-btn-active { background-color: #15803D; color: white; box-shadow: 0 10px 15px -3px rgba(21, 128, 61, 0.3); }\n        .glass-panel { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(10px); }\n    </style>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n<script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"LocalBusiness\",\n      \"name\": \"Atlas Aircon Rajpipla\",\n      \"image\": \"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\",\n      \"@id\": \"https://atlasaircons.com/rajpipla\",\n      \"url\": \"https://atlasaircons.com/rajpipla\",\n      \"telephone\": \"+91 97272 57141\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"addressLocality\": \"Rajpipla\",\n        \"addressRegion\": \"Gujarat\",\n        \"postalCode\": \"393145\",\n        \"addressCountry\": \"IN\"\n      }\n    }\n    </script>\n<script>\n        const residential = [\n            \"Rajpipla City\", \"Station Road\", \"Vadiya Palace Area\", \"Darbar Road\", \"Kevadia Colony\", \"Ekta Nagar\", \"Garudeshwar\", \n            \"Tilakwada\", \"Nandod\", \"Sarangpur Area\", \"Kalyanpura\", \"Vadia Road\", \"Panchvati Society\", \"Rajvant Palace Road\", \n            \"College Road Area\", \"Gopalpura\", \"Juna Rajpipla\", \"Gita Nagar\", \"Civil Hospital Area\", \"New Town\"\n        ];\n        \n        const industrial = [\n            \"Rajpipla GIDC\", \"Kevadia Tourism Hub\", \"Statue of Unity Tent City Belt\", \"Narmada Dam Project Area\", \n            \"Garudeshwar Industrial Pocket\", \"Kevadia Railway Station Zone\", \"Vikas Bhavan Area\", \"Narmada Riverfront Zones\",\n            \"Ekta Nagar Commercial Cluster\", \"Rajpipla Warehouse Zone\"\n        ];\n        \n        const allAreas = [...residential, ...industrial];\n\n        const matrixData = {\n            tourism: `\n                <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                    <a href=\"/tent-city-ac-service-rajpipla\" class=\"p-6 bg-green-800 text-white rounded-3xl h-48 flex flex-col justify-between\">\n                        <i class=\"fas fa-campground text-2xl\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">Tent City Systems</span>\n                    </a>\n                    <a href=\"/hotel-hvac-rajpipla\" class=\"p-6 bg-white border-2 border-green-100 rounded-3xl h-48 flex flex-col justify-between\">\n                        <i class=\"fas fa-hotel text-2xl text-amber-600\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">Hotel HVAC AMC</span>\n                    </a>\n                    <a href=\"/eco-ac-cleaning-rajpipla\" class=\"p-6 bg-amber-600 text-white rounded-3xl h-48 flex flex-col justify-between\">\n                        <i class=\"fas fa-seedling text-2xl\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">Eco-Friendly Cleaning</span>\n                    </a>\n                </div>\n            `,\n            brands: `\n                <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3\">\n                    <a href=\"/blue-star-ac-service-rajpipla\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-green-700 hover:text-white transition shadow-sm border border-slate-100\">Blue Star</a>\n                    <a href=\"/daikin-ac-service-rajpipla\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-green-700 hover:text-white transition shadow-sm border border-slate-100\">Daikin</a>\n                    <a href=\"/samsung-ac-service-rajpipla\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-green-700 hover:text-white transition shadow-sm border border-slate-100\">Samsung</a>\n                    <a href=\"/lg-ac-service-rajpipla\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-green-700 hover:text-white transition shadow-sm border border-slate-100\">LG Service</a>\n                    <a href=\"/voltas-ac-service-rajpipla\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-green-700 hover:text-white transition shadow-sm border border-slate-100\">Voltas</a>\n                    <a href=\"/mitsubishi-ac-service-rajpipla\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-green-700 hover:text-white transition shadow-sm border border-slate-100\">Mitsubishi</a>\n                </div>\n            `,\n            industrial: `\n                <div class=\"flex flex-wrap gap-4 justify-center\">\n                    <a href=\"/copper-pipe-rajpipla\" class=\"px-8 py-3 bg-white rounded-full text-xs font-bold border border-slate-200 hover:border-green-600 transition\">High-Grade Copper Pipes</a>\n                    <a href=\"/pcb-repair-rajpipla\" class=\"px-8 py-3 bg-white rounded-full text-xs font-bold border border-slate-200 hover:border-green-600 transition\">PCB Inverter Repair</a>\n                    <a href=\"/remote-rajpipla\" class=\"px-8 py-3 bg-white rounded-full text-xs font-bold border border-slate-200 hover:border-green-600 transition\">Universal Remotes</a>\n                </div>\n            `\n        };\n\n        function updateMatrix(key) {\n            document.getElementById('matrix-content').innerHTML = matrixData[key];\n            document.querySelectorAll('#matrix button').forEach(btn => btn.classList.remove('matrix-btn-active'));\n            document.getElementById('m-' + key).classList.add('matrix-btn-active');\n        }\n\n        function renderAreas(list) {\n            const grid = document.getElementById('areaGrid');\n            grid.innerHTML = '';\n            list.forEach(area => {\n                const div = document.createElement('div');\n                div.className = \"bg-green-800/40 p-3 rounded-xl border border-green-700 hover:bg-amber-600/20 transition cursor-default text-center text-green-50\";\n                div.textContent = area;\n                grid.appendChild(div);\n            });\n        }\n\n        function filterAreas() {\n            const query = document.getElementById('areaSearch').value.toLowerCase();\n            const filtered = allAreas.filter(a => a.toLowerCase().includes(query));\n            renderAreas(filtered);\n        }\n\n        function solveError() {\n            const code = document.getElementById('errorSelect').value;\n            const hub = document.getElementById('solutionResult');\n            const issue = document.getElementById('issueText');\n            const solution = document.getElementById('solutionText');\n\n            const errors = {\n                \"E1\": [\"Sensor Fault (Humidity)\", \"High Narmada humidity causing sensor impedance shift; PCB cleaning and sensor recalibration required.\"],\n                \"E4\": [\"Motor Fail (Resin Block)\", \"Forest resin/pollen jam in blower fan; motor winding test and high-pressure chemical jet wash needed.\"],\n                \"F1\": [\"Phase Error (Grid Spike)\", \"Power fluctuation at Rajpipla grid damaged IPM module; component repair at our central facility.\"],\n                \"C6\": [\"Comm Loss (Cable Corrosion)\", \"Moisture-induced corrosion in inter-unit wiring; cable replacement with weather-shielded wiring.\"],\n                \"P4\": [\"IPM Overheat (Dust Block)\", \"Coil block due to fine forest dust; full descaling and thermal paste reapplication.\"],\n                \"EC\": [\"Gas Leak (Joint Oxidation)\", \"Humidity causing copper oxidation at joints; pressure test and silver-brazing required.\"]\n            };\n\n            if (errors[code]) {\n                hub.classList.remove('hidden');\n                issue.textContent = errors[code][0];\n                solution.textContent = errors[code][1];\n            } else {\n                hub.classList.add('hidden');\n            }\n        }\n\n        function initChart() {\n            const ctx = document.getElementById('priceChart').getContext('2d');\n            new Chart(ctx, {\n                type: 'polarArea',\n                data: {\n                    labels: ['Repair', 'Gas Fill', 'Eco-Service', 'Spares', 'PCB Sealing'],\n                    datasets: [{\n                        data: [80, 85, 95, 70, 90],\n                        backgroundColor: [\n                            'rgba(21, 128, 61, 0.6)',\n                            'rgba(146, 64, 14, 0.6)',\n                            'rgba(180, 83, 9, 0.6)',\n                            'rgba(5, 46, 22, 0.6)',\n                            'rgba(251, 191, 36, 0.6)'\n                        ]\n                    }]\n                },\n                options: {\n                    responsive: true,\n                    maintainAspectRatio: false,\n                    scales: {\n                        r: { grid: { color: '#e2e8f0' }, ticks: { display: false } }\n                    },\n                    plugins: { legend: { position: 'bottom', labels: { font: { size: 10 } } } }\n                }\n            });\n        }\n\n        window.onload = () => {\n            renderAreas(allAreas);\n            updateMatrix('tourism');\n            initChart();\n        };\n    </script>\n\n\n    <!-- Navigation -->\n    <nav class=\"bg-white/90 backdrop-blur-md shadow-sm sticky top-0 z-50 border-b border-green-100\">\n        <div class=\"max-w-7xl mx-auto px-4 h-16 flex justify-between items-center\">\n            <div class=\"flex items-center gap-2\">\n                <div class=\"w-10 h-10 bg-green-700 rounded-xl flex items-center justify-center text-white shadow-lg\">\n                    <i class=\"fas fa-leaf animate-pulse\"></i>\n                </div>\n                <div class=\"flex flex-col\">\n                    <span class=\"font-extrabold text-lg leading-tight tracking-tight uppercase\">Atlas Aircon</span>\n                    <span class=\"text-[9px] text-green-700 font-black uppercase tracking-[0.2em]\">Service Center Rajpipla</span>\n                </div>\n            </div>\n            <div class=\"hidden lg:flex space-x-6 text-[11px] font-bold uppercase tracking-wider text-slate-500\">\n                <a href=\"#matrix\" class=\"hover:text-green-700 transition\">Heritage Matrix</a>\n                <a href=\"#diagnose\" class=\"hover:text-green-700 transition\">Diagnostics</a>\n                <a href=\"#pricing\" class=\"hover:text-green-700 transition\">Price Radar</a>\n                <a href=\"#areas\" class=\"hover:text-green-700 transition\">Narmada Zones</a>\n            </div>\n            <a href=\"https://wa.me/919727257141\" target=\"_blank\" class=\"bg-green-800 hover:bg-amber-800 text-white px-5 py-2.5 rounded-full text-xs font-black shadow-md transition flex items-center gap-2\" rel=\"noopener\">\n                <i class=\"fab fa-whatsapp\"></i> +91 97272 57141\n            </a>\n        </div>\n    </nav>\n\n    <!-- Hero Section: Nature-Focus Split -->\n    <header class=\"relative bg-white overflow-hidden border-b border-slate-100\">\n        <div class=\"max-w-7xl mx-auto flex flex-col lg:flex-row min-h-[70vh]\">\n            <div class=\"lg:w-1/2 px-6 py-16 lg:py-32 flex flex-col justify-center fade-in\">\n                <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-green-50 text-green-800 text-[10px] font-bold uppercase tracking-widest mb-8 w-fit border border-green-100\">\n                    <i class=\"fas fa-mountain\"></i> Statue of Unity Gateway Specialists\n                </div>\n                <h1 class=\"text-5xl lg:text-7xl font-black text-slate-900 leading-[1.05] mb-8 tracking-tighter\">\n                    Premier <span class=\"text-green-700\">AC Service Center Rajpipla</span>\n                </h1>\n                <p class=\"text-lg text-slate-500 mb-6 leading-relaxed max-w-lg\">\n                    Specialized cooling for heritage palaces, forest resorts, and Ekta Nagar&#8217;s world-class tourism infrastructure.\n                </p>\n                <div class=\"p-4 bg-amber-50 rounded-2xl border-l-4 border-amber-600 mb-10\">\n                    <p class=\"text-xs font-bold text-amber-900 uppercase italic\">*Independent Specialist: Multi-brand component-level repairs for out-of-warranty units.</p>\n                </div>\n                <div class=\"flex flex-wrap gap-4\">\n                    <a href=\"#matrix\" class=\"px-8 py-4 bg-green-700 text-white rounded-2xl font-bold shadow-xl hover:bg-green-800 transition text-sm\">Explore Service Matrix</a>\n                    <a href=\"https://wa.me/919727257141\" class=\"px-8 py-4 bg-amber-100 text-amber-900 rounded-2xl font-bold hover:bg-amber-200 transition text-sm\" target=\"_blank\" rel=\"noopener\">Statue of Unity Emergency</a>\n                </div>\n            </div>\n            <div class=\"lg:w-1/2 relative bg-green-900 flex items-center justify-center p-4\">\n                <img decoding=\"async\" class=\"relative z-10 rounded-[40px] shadow-2xl border-8 border-green-800 transform hover:scale-[1.02] transition duration-700\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/Atlas-aircon-vehicle.webp\" alt=\"AC Service Center Rajpipla\" title=\"\">\n                <div class=\"absolute bottom-10 left-10 p-6 bg-white rounded-3xl text-green-900 shadow-2xl\">\n                    <p class=\"text-xs font-bold uppercase tracking-widest\">Active In</p>\n                    <p class=\"text-2xl font-black\">Ekta Nagar &#038; Kevadia</p>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- Context: Eco-Tourism Focus -->\n    <section class=\"py-20 bg-[#F0F4F2]\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n                <div class=\"lg:col-span-2 bg-white p-10 lg:p-16 rounded-[50px] shadow-sm border border-green-50\">\n                    <h2 class=\"text-3xl font-black mb-8 tracking-tight text-slate-800\">Cooling Management for Narmada&#8217;s Humid Forest Belt</h2>\n                    <p class=\"text-slate-600 leading-relaxed mb-6 text-lg\">\n                        Rajpipla&#8217;s proximity to the Narmada dam and Vindhya forests creates a unique microclimate. High humidity and organic forest dust often lead to evaporator coil freezing and sensor malfunctions.\n                    </p>\n                    <p class=\"text-slate-600 leading-relaxed\">\n                        As the leading <strong>AC service center in Rajpipla</strong>, we offer specialized &#8220;Eco-Cleaning&#8221; that uses non-toxic chemicals, perfect for the sensitive ecological zones surrounding the <strong>Statue of Unity</strong>. We specialize in high-capacity VRV/VRF systems used in luxury tent cities and resorts.\n                    </p>\n                </div>\n                <div class=\"bg-green-800 rounded-[50px] p-10 text-white flex flex-col justify-center relative overflow-hidden\">\n                    <div class=\"absolute top-0 right-0 p-4 opacity-10\"><i class=\"fas fa-hotel text-8xl\"></i></div>\n                    <h3 class=\"text-xl font-bold mb-4\">Resort AMC Experts</h3>\n                    <p class=\"text-sm text-green-100 mb-8 leading-relaxed\">We manage Annual Maintenance Contracts for 20+ luxury resorts in the Narmada district, ensuring 100% guest comfort.</p>\n                    <div class=\"flex items-center gap-4\">\n                        <div class=\"w-12 h-12 bg-amber-500 rounded-full flex items-center justify-center font-bold\">24/7</div>\n                        <span class=\"text-xs font-bold uppercase tracking-widest\">Tourism Support Link</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Interactive Service Matrix: Tourism Focus -->\n    <section id=\"matrix\" class=\"py-24 bg-white\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"text-center mb-16\">\n                <h2 class=\"text-4xl font-black text-slate-900 mb-4\">The Narmada Service Matrix</h2>\n                <p class=\"text-slate-500 italic\">&#8220;Tailored solutions for residential heritage homes and modern tourism infrastructure.&#8221;</p>\n            </div>\n\n            <div class=\"flex flex-wrap justify-center gap-3 mb-12\">\n                <button onclick=\"updateMatrix('tourism')\" id=\"m-tourism\" class=\"px-6 py-3 rounded-2xl font-bold text-xs uppercase tracking-widest transition-all border-2 border-slate-100 matrix-btn-active\">Tourism &#038; Resorts</button>\n                <button onclick=\"updateMatrix('brands')\" id=\"m-brands\" class=\"px-6 py-3 rounded-2xl font-bold text-xs uppercase tracking-widest transition-all border-2 border-slate-100\">Multi-Brand Hub</button>\n                <button onclick=\"updateMatrix('industrial')\" id=\"m-industrial\" class=\"px-6 py-3 rounded-2xl font-bold text-xs uppercase tracking-widest transition-all border-2 border-slate-100\">GIDC &#038; Govt.</button>\n            </div>\n\n            <div id=\"matrix-content\" class=\"fade-in bg-slate-50 p-8 lg:p-12 rounded-[40px] border border-green-50 shadow-inner\">\n                <!-- Content injected via JS -->\n            </div>\n        </div>\n    </section>\n\n    <!-- Diagnostic Hub: Forest & Humidity Specific -->\n    <section id=\"diagnose\" class=\"py-24 bg-green-950 text-white\">\n        <div class=\"max-w-6xl mx-auto px-4\">\n            <div class=\"lg:flex lg:items-center lg:gap-20\">\n                <div class=\"lg:w-1/2\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/02/Emergency-AC-Breakdown-Atlas-Aircon.webp\" class=\"rounded-[40px] shadow-2xl mb-12 border-4 border-green-900\" alt=\"AC Repair Rajpipla\" title=\"\">\n                    <h2 class=\"text-4xl font-black mb-6\">Narmada Technical Resolver</h2>\n                    <p class=\"text-green-200 leading-relaxed mb-8\">\n                        Humidity levels in Rajpipla can exceed 80%. Use our troubleshooter to see if your AC issue is due to humidity-related sensor trips or mechanical fatigue.\n                    </p>\n                    <div class=\"p-6 bg-amber-600 rounded-3xl shadow-xl\">\n                        <h4 class=\"font-black uppercase text-xs mb-2\">Technician Insight</h4>\n                        <p class=\"text-sm font-bold\">&#8220;90% of failures in Kevadia are due to high humidity affecting PCB circuits. We offer specialized moisture-proof sealing at our Rajpipla center.&#8221;</p>\n                    </div>\n                </div>\n                <div class=\"lg:w-1/2 mt-16 lg:mt-0\">\n                    <div class=\"bg-white rounded-[50px] p-10 lg:p-14 text-slate-900 shadow-2xl\">\n                        <label class=\"block text-[10px] font-black text-green-700 uppercase tracking-[0.3em] mb-6\">Select Error Code</label>\n                        <select id=\"errorSelect\" onchange=\"solveError()\" class=\"w-full p-5 rounded-2xl bg-slate-50 border-2 border-green-50 focus:border-green-600 outline-none transition font-bold text-slate-900 mb-10\">\n                            <option value=\"\">&#8212; Choose Code &#8212;</option>\n                            <option value=\"E1\">E1 / E2 &#8211; Temp Sensor</option>\n                            <option value=\"E4\">E4 &#8211; Fan Motor Issue</option>\n                            <option value=\"F1\">F1 / F2 &#8211; Phase Error</option>\n                            <option value=\"C6\">C6 &#8211; Comm. Error</option>\n                            <option value=\"P4\">P4 &#8211; Inverter Heat</option>\n                            <option value=\"EC\">EC &#8211; Leak Warning</option>\n                        </select>\n                        <div id=\"solutionResult\" class=\"hidden fade-in space-y-6\">\n                            <div class=\"pb-6 border-b border-slate-100\">\n                                <h4 class=\"text-[10px] font-black text-slate-400 uppercase mb-2\">Diagnosis</h4>\n                                <p id=\"issueText\" class=\"text-xl font-black text-green-800\"></p>\n                            </div>\n                            <div>\n                                <h4 class=\"text-[10px] font-black text-amber-600 uppercase mb-2\">Rajpipla Center Fix</h4>\n                                <p id=\"solutionText\" class=\"text-sm text-slate-600 font-medium leading-relaxed\"></p>\n                            </div>\n                            <a href=\"https://wa.me/919727257141\" class=\"block w-full text-center py-4 bg-green-800 text-white rounded-2xl font-bold uppercase text-[11px] tracking-widest hover:bg-green-700 transition\" target=\"_blank\" rel=\"noopener\">Statue of Unity Express Service</a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- DIFFERENT: Pricing Polar Area Chart -->\n    <section id=\"pricing\" class=\"py-24 bg-white\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"text-center mb-20\">\n                <h2 class=\"text-4xl font-black text-slate-900 mb-4 tracking-tight\">Rajpipla Service Cost Radar</h2>\n                <p class=\"text-slate-500\">Comparing standard residential vs specialized resort-grade maintenance costs.</p>\n            </div>\n\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-20 items-center\">\n                <div class=\"bg-slate-50 p-8 rounded-[60px] border border-green-50 shadow-inner\">\n                    <h3 class=\"text-center text-[10px] font-black text-slate-400 uppercase tracking-widest mb-10\">Relative Cost Distribution</h3>\n                    <div class=\"chart-container\">\n                        <canvas id=\"priceChart\"></canvas>\n                    </div>\n                </div>\n                <div>\n                    <h3 class=\"text-3xl font-black text-green-900 mb-8 italic\">Fair Pricing, No Tourism Surcharge</h3>\n                    <p class=\"text-slate-500 mb-10 leading-relaxed text-lg\">\n                        Even though we serve high-profile areas like **Ekta Nagar**, we maintain our transparent, fixed Rajpipla pricing for all.\n                    </p>\n                    <div class=\"space-y-4\">\n                        <div class=\"flex justify-between items-center p-5 bg-green-50 rounded-3xl border border-green-100\">\n                            <span class=\"text-sm font-bold text-green-800\">Split Jet Cleaning (Anti-Fungal)</span>\n                            <span class=\"text-lg font-black text-slate-900\">₹650 &#8211; ₹950</span>\n                        </div>\n                        <div class=\"flex justify-between items-center p-5 bg-white rounded-3xl border border-slate-100 shadow-sm\">\n                            <span class=\"text-sm font-bold text-slate-600\">Gas Refilling (Full R32/R410)</span>\n                            <span class=\"text-lg font-black text-slate-900\">₹2500 &#8211; ₹4500</span>\n                        </div>\n                        <div class=\"flex justify-between items-center p-5 bg-white rounded-3xl border border-slate-100 shadow-sm\">\n                            <span class=\"text-sm font-bold text-slate-600\">Inverter PCB Moisture Sealing</span>\n                            <span class=\"text-lg font-black text-slate-900\">₹1500 &#8211; ₹5000</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Coverage Locator (Integrated End Section) -->\n    <section id=\"areas\" class=\"py-24 bg-white\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"bg-green-900 rounded-[80px] p-10 lg:p-20 text-white relative overflow-hidden\">\n                <div class=\"absolute bottom-0 right-0 p-10 opacity-5\"><i class=\"fas fa-map-marked-alt text-[200px]\"></i></div>\n                \n                <div class=\"text-center mb-16 relative z-10\">\n                    <h2 class=\"text-5xl font-black mb-6 tracking-tight\">Narmada District Network</h2>\n                    <p class=\"text-green-200 max-w-xl mx-auto text-lg\">Covering the heart of Rajpipla city and the rapid expansion of Ekta Nagar.</p>\n                </div>\n\n                <div class=\"relative max-w-xl mx-auto mb-16 z-10\">\n                    <input type=\"text\" id=\"areaSearch\" onkeyup=\"filterAreas()\" placeholder=\"Search (e.g. Kevadia, Station Road, Garudeshwar)...\" class=\"w-full px-8 py-6 rounded-full bg-green-800 border border-green-700 text-white placeholder-green-400 focus:ring-2 focus:ring-amber-500 outline-none transition shadow-2xl font-bold\">\n                </div>\n\n                <div id=\"areaGrid\" class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 text-[10px] font-bold tracking-tight h-[300px] overflow-y-auto custom-scroll pr-6 pb-12 relative z-10\">\n                    <!-- Areas injected by JS -->\n                </div>\n\n                <!-- Business Identity -->\n                <div class=\"mt-20 pt-20 border-t border-green-800 lg:flex lg:justify-between lg:items-start relative z-10\">\n                    <div class=\"max-w-xs mb-16 lg:mb-0\">\n                        <div class=\"flex items-center gap-2 mb-8\">\n                            <div class=\"w-10 h-10 bg-amber-600 rounded-xl flex items-center justify-center text-white font-black text-xl\">A</div>\n                            <span class=\"text-2xl font-black tracking-tighter uppercase\">Atlas Aircon</span>\n                        </div>\n                        <p class=\"text-xs text-green-300 leading-relaxed mb-8\">The official <strong>AC Service Center Rajpipla</strong> interactive portal. Independent specialists supporting Gujarat&#8217;s tourism boom.</p>\n                        <p class=\"text-[10px] text-green-600 uppercase font-black tracking-[0.2em]\">© 2026 Narmada Cooling Network</p>\n                    </div>\n\n                    <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-20\">\n                        <div>\n                            <h4 class=\"text-[10px] font-black text-amber-500 uppercase tracking-widest mb-6\">Rajpipla Contact</h4>\n                            <ul class=\"space-y-6 text-sm font-semibold text-green-50\">\n                                <li class=\"flex items-center gap-4\"><i class=\"fas fa-phone text-amber-500 text-lg\"></i> +91 97272 57141</li>\n                                <li class=\"flex items-center gap-4\"><i class=\"fas fa-envelope text-amber-500 text-lg\"></i> atlasaircon1@gmail.com</li>\n                                <li class=\"flex items-center gap-4\"><i class=\"fas fa-map-marker-alt text-amber-500 text-lg\"></i> Rajpipla, Narmada, Gujarat</li>\n                            </ul>\n                        </div>\n                        <div>\n                            <h4 class=\"text-[10px] font-black text-amber-500 uppercase tracking-widest mb-6\">Center Note</h4>\n                            <p class=\"text-[11px] text-green-300 font-medium leading-relaxed mb-6\">Independent maintenance hub. We specialize in high-ambient and humid condition repairs for all major global brands like Daikin, LG, and Samsung.</p>\n                            <div class=\"flex gap-6\">\n                                <i class=\"fab fa-facebook text-green-700 hover:text-amber-500 transition text-xl\"></i>\n                                <i class=\"fab fa-instagram text-green-700 hover:text-amber-500 transition text-xl\"></i>\n                                <i class=\"fab fa-linkedin text-green-700 hover:text-amber-500 transition text-xl\"></i>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Schema Data -->\n    <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"LocalBusiness\",\n      \"name\": \"Atlas Aircon Rajpipla\",\n      \"image\": \"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\",\n      \"@id\": \"https://atlasaircons.com/rajpipla\",\n      \"url\": \"https://atlasaircons.com/rajpipla\",\n      \"telephone\": \"+91 97272 57141\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"addressLocality\": \"Rajpipla\",\n        \"addressRegion\": \"Gujarat\",\n        \"postalCode\": \"393145\",\n        \"addressCountry\": \"IN\"\n      }\n    }\n    </script>\n\n    <script>\n        const residential = [\n            \"Rajpipla City\", \"Station Road\", \"Vadiya Palace Area\", \"Darbar Road\", \"Kevadia Colony\", \"Ekta Nagar\", \"Garudeshwar\", \n            \"Tilakwada\", \"Nandod\", \"Sarangpur Area\", \"Kalyanpura\", \"Vadia Road\", \"Panchvati Society\", \"Rajvant Palace Road\", \n            \"College Road Area\", \"Gopalpura\", \"Juna Rajpipla\", \"Gita Nagar\", \"Civil Hospital Area\", \"New Town\"\n        ];\n        \n        const industrial = [\n            \"Rajpipla GIDC\", \"Kevadia Tourism Hub\", \"Statue of Unity Tent City Belt\", \"Narmada Dam Project Area\", \n            \"Garudeshwar Industrial Pocket\", \"Kevadia Railway Station Zone\", \"Vikas Bhavan Area\", \"Narmada Riverfront Zones\",\n            \"Ekta Nagar Commercial Cluster\", \"Rajpipla Warehouse Zone\"\n        ];\n        \n        const allAreas = [...residential, ...industrial];\n\n        const matrixData = {\n            tourism: `\n                <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                    <a href=\"/tent-city-ac-service-rajpipla\" class=\"p-6 bg-green-800 text-white rounded-3xl h-48 flex flex-col justify-between\">\n                        <i class=\"fas fa-campground text-2xl\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">Tent City Systems</span>\n                    </a>\n                    <a href=\"/hotel-hvac-rajpipla\" class=\"p-6 bg-white border-2 border-green-100 rounded-3xl h-48 flex flex-col justify-between\">\n                        <i class=\"fas fa-hotel text-2xl text-amber-600\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">Hotel HVAC AMC</span>\n                    </a>\n                    <a href=\"/eco-ac-cleaning-rajpipla\" class=\"p-6 bg-amber-600 text-white rounded-3xl h-48 flex flex-col justify-between\">\n                        <i class=\"fas fa-seedling text-2xl\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">Eco-Friendly Cleaning</span>\n                    </a>\n                </div>\n            `,\n            brands: `\n                <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3\">\n                    <a href=\"/blue-star-ac-service-rajpipla\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-green-700 hover:text-white transition shadow-sm border border-slate-100\">Blue Star</a>\n                    <a href=\"/daikin-ac-service-rajpipla\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-green-700 hover:text-white transition shadow-sm border border-slate-100\">Daikin</a>\n                    <a href=\"/samsung-ac-service-rajpipla\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-green-700 hover:text-white transition shadow-sm border border-slate-100\">Samsung</a>\n                    <a href=\"/lg-ac-service-rajpipla\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-green-700 hover:text-white transition shadow-sm border border-slate-100\">LG Service</a>\n                    <a href=\"/voltas-ac-service-rajpipla\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-green-700 hover:text-white transition shadow-sm border border-slate-100\">Voltas</a>\n                    <a href=\"/mitsubishi-ac-service-rajpipla\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-green-700 hover:text-white transition shadow-sm border border-slate-100\">Mitsubishi</a>\n                </div>\n            `,\n            industrial: `\n                <div class=\"flex flex-wrap gap-4 justify-center\">\n                    <a href=\"/copper-pipe-rajpipla\" class=\"px-8 py-3 bg-white rounded-full text-xs font-bold border border-slate-200 hover:border-green-600 transition\">High-Grade Copper Pipes</a>\n                    <a href=\"/pcb-repair-rajpipla\" class=\"px-8 py-3 bg-white rounded-full text-xs font-bold border border-slate-200 hover:border-green-600 transition\">PCB Inverter Repair</a>\n                    <a href=\"/remote-rajpipla\" class=\"px-8 py-3 bg-white rounded-full text-xs font-bold border border-slate-200 hover:border-green-600 transition\">Universal Remotes</a>\n                </div>\n            `\n        };\n\n        function updateMatrix(key) {\n            document.getElementById('matrix-content').innerHTML = matrixData[key];\n            document.querySelectorAll('#matrix button').forEach(btn => btn.classList.remove('matrix-btn-active'));\n            document.getElementById('m-' + key).classList.add('matrix-btn-active');\n        }\n\n        function renderAreas(list) {\n            const grid = document.getElementById('areaGrid');\n            grid.innerHTML = '';\n            list.forEach(area => {\n                const div = document.createElement('div');\n                div.className = \"bg-green-800/40 p-3 rounded-xl border border-green-700 hover:bg-amber-600/20 transition cursor-default text-center text-green-50\";\n                div.textContent = area;\n                grid.appendChild(div);\n            });\n        }\n\n        function filterAreas() {\n            const query = document.getElementById('areaSearch').value.toLowerCase();\n            const filtered = allAreas.filter(a => a.toLowerCase().includes(query));\n            renderAreas(filtered);\n        }\n\n        function solveError() {\n            const code = document.getElementById('errorSelect').value;\n            const hub = document.getElementById('solutionResult');\n            const issue = document.getElementById('issueText');\n            const solution = document.getElementById('solutionText');\n\n            const errors = {\n                \"E1\": [\"Sensor Fault (Humidity)\", \"High Narmada humidity causing sensor impedance shift; PCB cleaning and sensor recalibration required.\"],\n                \"E4\": [\"Motor Fail (Resin Block)\", \"Forest resin/pollen jam in blower fan; motor winding test and high-pressure chemical jet wash needed.\"],\n                \"F1\": [\"Phase Error (Grid Spike)\", \"Power fluctuation at Rajpipla grid damaged IPM module; component repair at our central facility.\"],\n                \"C6\": [\"Comm Loss (Cable Corrosion)\", \"Moisture-induced corrosion in inter-unit wiring; cable replacement with weather-shielded wiring.\"],\n                \"P4\": [\"IPM Overheat (Dust Block)\", \"Coil block due to fine forest dust; full descaling and thermal paste reapplication.\"],\n                \"EC\": [\"Gas Leak (Joint Oxidation)\", \"Humidity causing copper oxidation at joints; pressure test and silver-brazing required.\"]\n            };\n\n            if (errors[code]) {\n                hub.classList.remove('hidden');\n                issue.textContent = errors[code][0];\n                solution.textContent = errors[code][1];\n            } else {\n                hub.classList.add('hidden');\n            }\n        }\n\n        function initChart() {\n            const ctx = document.getElementById('priceChart').getContext('2d');\n            new Chart(ctx, {\n                type: 'polarArea',\n                data: {\n                    labels: ['Repair', 'Gas Fill', 'Eco-Service', 'Spares', 'PCB Sealing'],\n                    datasets: [{\n                        data: [80, 85, 95, 70, 90],\n                        backgroundColor: [\n                            'rgba(21, 128, 61, 0.6)',\n                            'rgba(146, 64, 14, 0.6)',\n                            'rgba(180, 83, 9, 0.6)',\n                            'rgba(5, 46, 22, 0.6)',\n                            'rgba(251, 191, 36, 0.6)'\n                        ]\n                    }]\n                },\n                options: {\n                    responsive: true,\n                    maintainAspectRatio: false,\n                    scales: {\n                        r: { grid: { color: '#e2e8f0' }, ticks: { display: false } }\n                    },\n                    plugins: { legend: { position: 'bottom', labels: { font: { size: 10 } } } }\n                }\n            });\n        }\n\n        window.onload = () => {\n            renderAreas(allAreas);\n            updateMatrix('tourism');\n            initChart();\n        };\n    </script>\n</div>",
