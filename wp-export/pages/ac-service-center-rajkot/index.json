  "content": {
    "rendered": "<div class=\"atlas-purified-matrix\"><style>\n        body { font-family: 'Inter', sans-serif; }\n        .chart-container {\n            position: relative;\n            width: 100%;\n            max-width: 500px;\n            margin: auto;\n            height: 400px;\n        }\n        .custom-scroll::-webkit-scrollbar { width: 4px; }\n        .custom-scroll::-webkit-scrollbar-thumb { background: #EA580C; border-radius: 10px; }\n        .fade-in { animation: fadeIn 0.6s ease-out; }\n        @keyframes fadeIn { from { opacity: 0; transform: scale(0.98); } to { opacity: 1; transform: scale(1); } }\n        .matrix-btn-active { background-color: #EA580C; color: white; box-shadow: 0 10px 15px -3px rgba(234, 88, 12, 0.3); }\n    </style>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n<script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"LocalBusiness\",\n      \"name\": \"Atlas Aircon Rajkot\",\n      \"image\": \"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\",\n      \"@id\": \"https://atlasaircons.com/rajkot\",\n      \"url\": \"https://atlasaircons.com/rajkot\",\n      \"telephone\": \"+91 97272 57141\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"addressLocality\": \"Rajkot\",\n        \"addressRegion\": \"Gujarat\",\n        \"postalCode\": \"360001\",\n        \"addressCountry\": \"IN\"\n      }\n    }\n    </script>\n<script>\n        const residential = [\n            \"Kalavad Road\", \"Yagnik Road\", \"Nana Mava Road\", \"Mavdi Area\", \"Raiya Road\", \"Sadhu Vaswani Road\", \"Junction Plot\", \n            \"Amin Marg\", \"University Road\", \"Kotecha Chowk\", \"Phulchhab Chowk\", \"Indira Gandhi Road\", \"150 Feet Ring Road\", \n            \"Raiya Circle\", \"Hanuman Madhi Area\", \"Saurashtra University Campus\", \"Kishanpara\", \"Ramakrishna Ashram Area\", \n            \"Munjka\", \"Ghanteshwar\", \"Madhapar\", \"Gondal Road Residential\"\n        ];\n        \n        const industrial = [\n            \"Metoda GIDC\", \"Lodhika GIDC\", \"Aji Industrial Estate\", \"Shapar-Veraval GIDC\", \"Kotharia Industrial Area\", \n            \"Atika Industrial Zone\", \"Bhakti Nagar Industrial Estate\", \"Maliya Highway Belt\", \"Gondal GIDC\", \n            \"Hadamtala GIDC\", \"Veraval Shapar GIDC-2\", \"Rajkot 2nd Industrial Cluster\", \"Foundry Zone - Aji\",\n            \"Machine Tool Belt - Metoda\"\n        ];\n        \n        const allAreas = [...residential, ...industrial];\n\n        const matrixData = {\n            brands: `\n                <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3\">\n                    <a href=\"/blue-star-ac-service-center-rajkot\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-orange-600 hover:text-white transition shadow-sm border border-slate-100\">Blue Star</a>\n                    <a href=\"/lg-ac-service-center-rajkot\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-orange-600 hover:text-white transition shadow-sm border border-slate-100\">LG Service</a>\n                    <a href=\"/daikin-ac-service-center-rajkot\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-orange-600 hover:text-white transition shadow-sm border border-slate-100\">Daikin</a>\n                    <a href=\"/samsung-ac-service-center-rajkot\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-orange-600 hover:text-white transition shadow-sm border border-slate-100\">Samsung</a>\n                    <a href=\"/voltas-ac-service-center-rajkot\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-orange-600 hover:text-white transition shadow-sm border border-slate-100\">Voltas</a>\n                    <a href=\"/mitsubishi-ac-service-center-rajkot\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-orange-600 hover:text-white transition shadow-sm border border-slate-100\">Mitsubishi</a>\n                </div>\n            `,\n            industrial: `\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n                    <a href=\"/chiller-repair-rajkot\" class=\"p-6 bg-indigo-950 text-white rounded-3xl h-48 flex flex-col justify-between\">\n                        <i class=\"fas fa-snowflake text-2xl\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">Industrial Chillers</span>\n                    </a>\n                    <a href=\"/panel-ac-service-rajkot\" class=\"p-6 bg-white border-2 border-slate-200 rounded-3xl h-48 flex flex-col justify-between\">\n                        <i class=\"fas fa-server text-2xl text-orange-600\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">CNC Panel AC</span>\n                    </a>\n                    <a href=\"/ductable-ac-rajkot\" class=\"p-6 bg-orange-600 text-white rounded-3xl h-48 flex flex-col justify-between\">\n                        <i class=\"fas fa-wind text-2xl\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">Ductable Systems</span>\n                    </a>\n                </div>\n            `,\n            parts: `\n                <div class=\"flex flex-wrap gap-4 justify-center\">\n                    <a href=\"/remote-rajkot/\" class=\"px-8 py-3 bg-white rounded-full text-xs font-bold border border-slate-200 hover:border-orange-500 transition\">Universal Remotes</a>\n                    <a href=\"/pcb-repair-rajkot\" class=\"px-8 py-3 bg-white rounded-full text-xs font-bold border border-slate-200 hover:border-orange-500 transition\">PCB Inverter Cards</a>\n                    <a href=\"/compressor-rajkot\" class=\"px-8 py-3 bg-white rounded-full text-xs font-bold border border-slate-200 hover:border-orange-500 transition\">OEM Compressors</a>\n                </div>\n            `\n        };\n\n        function updateMatrix(key) {\n            document.getElementById('matrix-content').innerHTML = matrixData[key];\n            document.querySelectorAll('#matrix button').forEach(btn => btn.classList.remove('matrix-btn-active'));\n            document.getElementById('m-' + key).classList.add('matrix-btn-active');\n        }\n\n        function renderAreas(list) {\n            const grid = document.getElementById('areaGrid');\n            grid.innerHTML = '';\n            list.forEach(area => {\n                const div = document.createElement('div');\n                div.className = \"bg-indigo-900/40 p-3 rounded-xl border border-indigo-800 hover:bg-orange-600/20 transition cursor-default text-center text-indigo-100\";\n                div.textContent = area;\n                grid.appendChild(div);\n            });\n        }\n\n        function filterAreas() {\n            const query = document.getElementById('areaSearch').value.toLowerCase();\n            const filtered = allAreas.filter(a => a.toLowerCase().includes(query));\n            renderAreas(filtered);\n        }\n\n        function solveError() {\n            const code = document.getElementById('errorSelect').value;\n            const hub = document.getElementById('solutionResult');\n            const issue = document.getElementById('issueText');\n            const solution = document.getElementById('solutionText');\n\n            const errors = {\n                \"E1\": [\"Sensor Fault (Power Surge)\", \"Rajkot grid voltage spike damaged thermistor; resistance check and calibration required.\"],\n                \"E4\": [\"Indoor Motor Fail (Dust Jam)\", \"Machinery dust causing bearing friction; motor winding test and start-capacitor replacement.\"],\n                \"F1\": [\"Board Phase Error (Engineering Load)\", \"High voltage related IPM module failure; card level diagnosis at Rajkot workshop.\"],\n                \"C6\": [\"Comm Loss (CNC Interference)\", \"Signal wiring shield failure or EMI interference; verification of L-N-S wiring.\"],\n                \"P4\": [\"IPM Overheat (Industrial Heat)\", \"Outdoor unit heat sink block; full chemical wash and paste reapplication required.\"],\n                \"EC\": [\"Gas Leak Alarm (Vibration Leak)\", \"Industrial vibration causing flare-nut stress leak; nitrogen test and brazing required.\"]\n            };\n\n            if (errors[code]) {\n                hub.classList.remove('hidden');\n                issue.textContent = errors[code][0];\n                solution.textContent = errors[code][1];\n            } else {\n                hub.classList.add('hidden');\n            }\n        }\n\n        function initChart() {\n            const ctx = document.getElementById('priceChart').getContext('2d');\n            new Chart(ctx, {\n                type: 'radar',\n                data: {\n                    labels: ['Repair Tech', 'Gas Refill', 'Board Fix', 'Spares', 'Maintenance'],\n                    datasets: [{\n                        label: 'Rajkot Market Intensity',\n                        data: [90, 85, 95, 70, 80],\n                        backgroundColor: 'rgba(234, 88, 12, 0.2)',\n                        borderColor: '#EA580C',\n                        pointBackgroundColor: '#1E1B4B',\n                        borderWidth: 3\n                    }]\n                },\n                options: {\n                    responsive: true,\n                    maintainAspectRatio: false,\n                    scales: {\n                        r: {\n                            angleLines: { color: '#e2e8f0' },\n                            grid: { color: '#f1f5f9' },\n                            pointLabels: { font: { size: 10, weight: 'bold' }, color: '#1E1B4B' },\n                            ticks: { display: false, count: 5 }\n                        }\n                    },\n                    plugins: { legend: { display: false } }\n                }\n            });\n        }\n\n        window.onload = () => {\n            renderAreas(allAreas);\n            updateMatrix('brands');\n            initChart();\n        };\n    </script>\n\n\n    <!-- Navigation -->\n    <nav class=\"bg-white/90 backdrop-blur-md shadow-sm sticky top-0 z-50 border-b border-orange-100\">\n        <div class=\"max-w-7xl mx-auto px-4 h-16 flex justify-between items-center\">\n            <div class=\"flex items-center gap-2\">\n                <div class=\"w-10 h-10 bg-orange-600 rounded-xl flex items-center justify-center text-white shadow-lg\">\n                    <i class=\"fas fa-tools animate-bounce\"></i>\n                </div>\n                <div class=\"flex flex-col\">\n                    <span class=\"font-extrabold text-lg leading-tight tracking-tight uppercase\">Atlas Aircon</span>\n                    <span class=\"text-[9px] text-orange-600 font-black uppercase tracking-[0.2em]\">Service Center Rajkot</span>\n                </div>\n            </div>\n            <div class=\"hidden lg:flex space-x-6 text-[11px] font-bold uppercase tracking-wider text-slate-500\">\n                <a href=\"#matrix\" class=\"hover:text-orange-600 transition\">Service Matrix</a>\n                <a href=\"#diagnose\" class=\"hover:text-orange-600 transition\">Diagnostics</a>\n                <a href=\"#pricing\" class=\"hover:text-orange-600 transition\">Market Radar</a>\n                <a href=\"#areas\" class=\"hover:text-orange-600 transition\">Rajkot Zones</a>\n            </div>\n            <a href=\"https://wa.me/919727257141\" target=\"_blank\" class=\"bg-indigo-950 hover:bg-orange-600 text-white px-5 py-2.5 rounded-full text-xs font-black shadow-md transition flex items-center gap-2\" rel=\"noopener\">\n                <i class=\"fab fa-whatsapp\"></i> +91 97272 57141\n            </a>\n        </div>\n    </nav>\n\n    <!-- Hero Section: Split Layout -->\n    <header class=\"relative bg-white overflow-hidden border-b border-slate-100\">\n        <div class=\"max-w-7xl mx-auto flex flex-col lg:flex-row min-h-[80vh]\">\n            <div class=\"lg:w-1/2 px-4 py-16 lg:py-32 flex flex-col justify-center fade-in\">\n                <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-50 text-orange-700 text-[10px] font-bold uppercase tracking-widest mb-8 w-fit border border-orange-100\">\n                    <i class=\"fas fa-cogs\"></i> Engineering Hub Specialists\n                </div>\n                <h1 class=\"text-5xl lg:text-8xl font-black text-indigo-950 leading-[1.0] mb-8 tracking-tighter\">\n                    Premier <span class=\"text-orange-600\">AC Service Center Rajkot</span>\n                </h1>\n                <p class=\"text-lg text-slate-500 mb-6 leading-relaxed max-w-lg\">\n                    Providing precision cooling for Rajkot&#8217;s high-tech machine tool industries and premium residential estates. Expert multi-brand support.\n                </p>\n                <div class=\"p-4 bg-slate-50 rounded-2xl border-l-4 border-orange-600 mb-10\">\n                    <p class=\"text-xs font-bold text-red-600 uppercase italic\">*Independent Service Specialist: We focus on component-level PCB repairs for out-of-warranty units.</p>\n                </div>\n                <div class=\"flex flex-wrap gap-4\">\n                    <a href=\"#matrix\" class=\"px-8 py-4 bg-orange-600 text-white rounded-2xl font-bold shadow-xl hover:bg-orange-700 transition text-sm\">View Service Matrix</a>\n                    <a href=\"https://wa.me/919727257141\" class=\"px-8 py-4 bg-indigo-50 text-indigo-950 rounded-2xl font-bold hover:bg-indigo-100 transition text-sm\" target=\"_blank\" rel=\"noopener\">Request Emergency Visit</a>\n                </div>\n            </div>\n            <div class=\"lg:w-1/2 relative bg-indigo-950 flex items-center justify-center p-8\">\n                <div class=\"absolute inset-0 opacity-20\" style=\"background-image: radial-gradient(#EA580C 1px, transparent 1px); background-size: 30px 30px;\"></div>\n                <img decoding=\"async\" class=\"relative z-10 rounded-[40px] shadow-2xl border-8 border-indigo-900 transform hover:-rotate-1 transition duration-700\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/Atlas-aircon-vehicle.webp\" alt=\"AC Service Center Rajkot\" title=\"\">\n                <div class=\"absolute top-10 right-10 p-6 bg-orange-600 rounded-3xl text-white shadow-2xl animate-pulse\">\n                    <p class=\"text-xs font-bold uppercase tracking-widest\">Active In</p>\n                    <p class=\"text-2xl font-black\">Metoda &#038; Lodhika</p>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- Context: Engineering Hub Focus -->\n    <section class=\"py-20 bg-slate-50\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n                <div class=\"lg:col-span-2 bg-white p-10 lg:p-16 rounded-[50px] shadow-sm border border-slate-100\">\n                    <h2 class=\"text-3xl font-black mb-8 tracking-tight\">Solving Cooling Challenges in the Hub of Machine Tools</h2>\n                    <p class=\"text-slate-600 leading-relaxed mb-6 text-lg\">\n                        Rajkot isn&#8217;t just a city; it&#8217;s an engineering powerhouse. From the massive CNC manufacturing units in <strong>Aji Industrial Estate</strong> to the bustling retail corridors of <strong>Yagnik Road</strong>, air conditioners here face unique stressors: massive voltage surges and extreme industrial heat.\n                    </p>\n                    <p class=\"text-slate-600 leading-relaxed\">\n                        As the leading <strong>AC service center in Rajkot</strong>, we don&#8217;t just &#8220;clean&#8221; units. We provide technical auditing. We specialize in repairing inverter PCB cards damaged by grid fluctuations and maintenance of heavy-tonnage chillers for Rajkot&#8217;s foundry and forging sectors.\n                    </p>\n                </div>\n                <div class=\"bg-indigo-950 rounded-[50px] p-10 text-white flex flex-col justify-center relative overflow-hidden\">\n                    <div class=\"absolute top-0 right-0 p-4 opacity-10\"><i class=\"fas fa-bolt text-8xl\"></i></div>\n                    <h3 class=\"text-xl font-bold mb-4\">State-of-the-art Testing</h3>\n                    <p class=\"text-sm text-indigo-200 mb-8 leading-relaxed\">Our Rajkot center features specialized diagnostic rigs to test PCB communication for brands like Daikin, Samsung, and Voltas before on-site installation.</p>\n                    <div class=\"flex items-center gap-4\">\n                        <div class=\"w-12 h-12 bg-orange-600 rounded-full flex items-center justify-center font-bold\">100%</div>\n                        <span class=\"text-xs font-bold uppercase tracking-widest\">Load Testing Guaranteed</span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- DIFFERENT: Interactive Service Matrix -->\n    <section id=\"matrix\" class=\"py-24 bg-white border-y border-slate-100\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"text-center mb-16\">\n                <h2 class=\"text-4xl font-black text-indigo-950 mb-4\">Rajkot Service Matrix</h2>\n                <p class=\"text-slate-500\">Click a category below to explore our specialized Rajkot service portals.</p>\n            </div>\n\n            <div class=\"flex flex-wrap justify-center gap-3 mb-12\">\n                <button onclick=\"updateMatrix('brands')\" id=\"m-brands\" class=\"px-6 py-3 rounded-2xl font-bold text-xs uppercase tracking-widest transition-all border-2 border-slate-100 matrix-btn-active\">Multi-Brand Centers</button>\n                <button onclick=\"updateMatrix('industrial')\" id=\"m-industrial\" class=\"px-6 py-3 rounded-2xl font-bold text-xs uppercase tracking-widest transition-all border-2 border-slate-100\">Industrial &#038; GIDC</button>\n                <button onclick=\"updateMatrix('parts')\" id=\"m-parts\" class=\"px-6 py-3 rounded-2xl font-bold text-xs uppercase tracking-widest transition-all border-2 border-slate-100\">Spare Part Hub</button>\n            </div>\n\n            <div id=\"matrix-content\" class=\"fade-in bg-slate-50 p-8 lg:p-12 rounded-[40px] border border-slate-100\">\n                <!-- Content injected via JS -->\n            </div>\n        </div>\n    </section>\n\n    <!-- Diagnostic Hub: Rajkot Specific -->\n    <section id=\"diagnose\" class=\"py-24 bg-indigo-950 text-white\">\n        <div class=\"max-w-6xl mx-auto px-4\">\n            <div class=\"lg:flex lg:items-center lg:gap-20\">\n                <div class=\"lg:w-1/2\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/02/Emergency-AC-Breakdown-Atlas-Aircon.webp\" class=\"rounded-[40px] shadow-2xl mb-12 border-4 border-indigo-900\" alt=\"Emergency AC Repair Rajkot\" title=\"\">\n                    <h2 class=\"text-4xl font-black mb-6\">Rajkot Technical Resolver</h2>\n                    <p class=\"text-indigo-300 leading-relaxed mb-8\">\n                        Rajkot&#8217;s power grid often experiences spikes. Use our diagnostic tool below to identify if your unit has suffered a communication error or a mechanical failure.\n                    </p>\n                    <div class=\"p-6 bg-orange-600 rounded-3xl shadow-xl\">\n                        <h4 class=\"font-black uppercase text-xs mb-2\">Service Note</h4>\n                        <p class=\"text-sm font-bold italic\">&#8220;We repair 90% of faulty PCBs at our Rajkot facility, saving clients from the high cost of new board replacements at authorized centers.&#8221;</p>\n                    </div>\n                </div>\n                <div class=\"lg:w-1/2 mt-16 lg:mt-0\">\n                    <div class=\"bg-white rounded-[50px] p-10 lg:p-14 text-indigo-950 shadow-2xl\">\n                        <label class=\"block text-[10px] font-black text-orange-600 uppercase tracking-[0.3em] mb-6\">Select Display Code</label>\n                        <select id=\"errorSelect\" onchange=\"solveError()\" class=\"w-full p-5 rounded-2xl bg-slate-50 border-2 border-slate-100 focus:border-orange-500 outline-none transition font-bold text-indigo-950 mb-10\">\n                            <option value=\"\">&#8212; Choose Code &#8212;</option>\n                            <option value=\"E1\">E1 / E2 &#8211; Temp Sensor</option>\n                            <option value=\"E4\">E4 &#8211; Fan Motor Issue</option>\n                            <option value=\"F1\">F1 / F2 &#8211; Phase Error</option>\n                            <option value=\"C6\">C6 &#8211; Comm. Error</option>\n                            <option value=\"P4\">P4 &#8211; Inverter Heat</option>\n                            <option value=\"EC\">EC &#8211; Leak Warning</option>\n                        </select>\n                        <div id=\"solutionResult\" class=\"hidden fade-in space-y-6\">\n                            <div class=\"pb-6 border-b border-slate-100\">\n                                <h4 class=\"text-[10px] font-black text-slate-400 uppercase mb-2\">Failure Point</h4>\n                                <p id=\"issueText\" class=\"text-xl font-black text-indigo-950\"></p>\n                            </div>\n                            <div>\n                                <h4 class=\"text-[10px] font-black text-orange-600 uppercase mb-2\">Technician Protocol</h4>\n                                <p id=\"solutionText\" class=\"text-sm text-slate-600 font-medium leading-relaxed\"></p>\n                            </div>\n                            <a href=\"https://wa.me/919727257141\" class=\"block w-full text-center py-4 bg-indigo-950 text-white rounded-2xl font-bold uppercase text-[11px] tracking-widest hover:bg-orange-600 transition\" target=\"_blank\" rel=\"noopener\">Request Inspection</a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- DIFFERENT: Pricing Radar Chart -->\n    <section id=\"pricing\" class=\"py-24 bg-white\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"text-center mb-20\">\n                <h2 class=\"text-4xl font-black text-indigo-950 mb-4 tracking-tight\">Market Cost Radar: Rajkot District</h2>\n                <p class=\"text-slate-500\">Visualizing service intensity and cost distribution in the Rajkot market.</p>\n            </div>\n\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-20 items-center\">\n                <div class=\"bg-slate-50 p-8 rounded-[60px] border border-slate-100 shadow-inner\">\n                    <h3 class=\"text-center text-[10px] font-black text-slate-400 uppercase tracking-widest mb-10\">Service Value Radar</h3>\n                    <div class=\"chart-container\">\n                        <canvas id=\"priceChart\"></canvas>\n                    </div>\n                </div>\n                <div>\n                    <h3 class=\"text-3xl font-black text-indigo-950 mb-8 italic\">Fair Pricing in the Industrial Heart</h3>\n                    <p class=\"text-slate-500 mb-10 leading-relaxed text-lg\">\n                        As an independent <strong>AC service center Rajkot</strong>, we prioritize component restoration. This &#8220;Radar&#8221; shows how we allocate resources—high on technical expertise (PCB/Compressor) while keeping standard maintenance costs accessible.\n                    </p>\n                    <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                        <div class=\"p-6 bg-orange-50 rounded-3xl border border-orange-100\">\n                            <span class=\"block text-[10px] font-black text-orange-600 uppercase mb-2\">Split Jet Service</span>\n                            <span class=\"text-xl font-black text-indigo-950\">₹599 &#8211; ₹850</span>\n                        </div>\n                        <div class=\"p-6 bg-slate-50 rounded-3xl border border-slate-200\">\n                            <span class=\"block text-[10px] font-black text-slate-400 uppercase mb-2\">Gas Charging</span>\n                            <span class=\"text-xl font-black text-indigo-950\">₹2500 &#8211; ₹4500</span>\n                        </div>\n                        <div class=\"p-6 bg-slate-50 rounded-3xl border border-slate-200\">\n                            <span class=\"block text-[10px] font-black text-slate-400 uppercase mb-2\">PCB Repair</span>\n                            <span class=\"text-xl font-black text-indigo-950\">₹1500 &#8211; ₹5000</span>\n                        </div>\n                        <div class=\"p-6 bg-indigo-950 rounded-3xl text-white\">\n                            <span class=\"block text-[10px] font-black text-orange-400 uppercase mb-2\">Industrial Chiller</span>\n                            <span class=\"text-xl font-black\">Quote Only</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Coverage Locator (Integrated End Section) -->\n    <section id=\"areas\" class=\"py-24 bg-white\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"bg-indigo-950 rounded-[80px] p-10 lg:p-20 text-white relative overflow-hidden\">\n                <div class=\"absolute bottom-0 right-0 p-10 opacity-5\"><i class=\"fas fa-map-marked-alt text-[200px]\"></i></div>\n                \n                <div class=\"text-center mb-16 relative z-10\">\n                    <h2 class=\"text-5xl font-black mb-6 tracking-tight\">Rajkot Doorstep Hub</h2>\n                    <p class=\"text-indigo-300 max-w-xl mx-auto text-lg\">Rapid response for Kalavad Road residences and GIDC industrial estates.</p>\n                </div>\n\n                <div class=\"relative max-w-xl mx-auto mb-16 z-10\">\n                    <input type=\"text\" id=\"areaSearch\" onkeyup=\"filterAreas()\" placeholder=\"Search your area (e.g. Metoda, Kalavad Road, Mavdi)...\" class=\"w-full px-8 py-6 rounded-full bg-indigo-900 border border-indigo-800 text-white placeholder-indigo-400 focus:ring-2 focus:ring-orange-500 outline-none transition shadow-2xl font-bold\">\n                </div>\n\n                <div id=\"areaGrid\" class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 text-[10px] font-bold tracking-tight h-[400px] overflow-y-auto custom-scroll pr-6 pb-12 relative z-10\">\n                    <!-- Areas injected by JS -->\n                </div>\n\n                <!-- Business Identity Block -->\n                <div class=\"mt-20 pt-20 border-t border-indigo-900 lg:flex lg:justify-between lg:items-start relative z-10\">\n                    <div class=\"max-w-xs mb-16 lg:mb-0\">\n                        <div class=\"flex items-center gap-2 mb-8\">\n                            <div class=\"w-10 h-10 bg-orange-600 rounded-xl flex items-center justify-center text-white font-black text-xl\">A</div>\n                            <span class=\"text-2xl font-black tracking-tighter uppercase\">Atlas Aircon</span>\n                        </div>\n                        <p class=\"text-xs text-indigo-400 leading-relaxed mb-8\">The official <strong>AC Service Center Rajkot</strong> interactive portal. Independent specialists providing engineering-grade cooling management.</p>\n                        <p class=\"text-[10px] text-indigo-700 uppercase font-black tracking-[0.2em]\">© 2026 Engineering AC Network</p>\n                    </div>\n\n                    <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-20\">\n                        <div>\n                            <h4 class=\"text-[10px] font-black text-orange-500 uppercase tracking-widest mb-6\">Rajkot Contact</h4>\n                            <ul class=\"space-y-6 text-sm font-semibold\">\n                                <li class=\"flex items-center gap-4\"><i class=\"fas fa-phone text-orange-500 text-lg\"></i> +91 97272 57141</li>\n                                <li class=\"flex items-center gap-4\"><i class=\"fas fa-envelope text-orange-500 text-lg\"></i> atlasaircon1@gmail.com</li>\n                                <li class=\"flex items-center gap-4\"><i class=\"fas fa-map-marker-alt text-orange-500 text-lg\"></i> Rajkot / Shapar, Gujarat</li>\n                            </ul>\n                        </div>\n                        <div>\n                            <h4 class=\"text-[10px] font-black text-orange-500 uppercase tracking-widest mb-6\">Service Disclaimer</h4>\n                            <p class=\"text-[11px] text-indigo-400 font-medium leading-relaxed mb-6\">We are a private, independent maintenance hub. We specialize in out-of-warranty technical repairs for all major global air conditioner brands.</p>\n                            <div class=\"flex gap-6\">\n                                <i class=\"fab fa-facebook text-indigo-700 hover:text-orange-500 transition text-xl\"></i>\n                                <i class=\"fab fa-instagram text-indigo-700 hover:text-orange-500 transition text-xl\"></i>\n                                <i class=\"fab fa-linkedin text-indigo-700 hover:text-orange-500 transition text-xl\"></i>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Schema Data -->\n    <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"LocalBusiness\",\n      \"name\": \"Atlas Aircon Rajkot\",\n      \"image\": \"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\",\n      \"@id\": \"https://atlasaircons.com/rajkot\",\n      \"url\": \"https://atlasaircons.com/rajkot\",\n      \"telephone\": \"+91 97272 57141\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"addressLocality\": \"Rajkot\",\n        \"addressRegion\": \"Gujarat\",\n        \"postalCode\": \"360001\",\n        \"addressCountry\": \"IN\"\n      }\n    }\n    </script>\n\n    <!-- Application Logic -->\n    <script>\n        const residential = [\n            \"Kalavad Road\", \"Yagnik Road\", \"Nana Mava Road\", \"Mavdi Area\", \"Raiya Road\", \"Sadhu Vaswani Road\", \"Junction Plot\", \n            \"Amin Marg\", \"University Road\", \"Kotecha Chowk\", \"Phulchhab Chowk\", \"Indira Gandhi Road\", \"150 Feet Ring Road\", \n            \"Raiya Circle\", \"Hanuman Madhi Area\", \"Saurashtra University Campus\", \"Kishanpara\", \"Ramakrishna Ashram Area\", \n            \"Munjka\", \"Ghanteshwar\", \"Madhapar\", \"Gondal Road Residential\"\n        ];\n        \n        const industrial = [\n            \"Metoda GIDC\", \"Lodhika GIDC\", \"Aji Industrial Estate\", \"Shapar-Veraval GIDC\", \"Kotharia Industrial Area\", \n            \"Atika Industrial Zone\", \"Bhakti Nagar Industrial Estate\", \"Maliya Highway Belt\", \"Gondal GIDC\", \n            \"Hadamtala GIDC\", \"Veraval Shapar GIDC-2\", \"Rajkot 2nd Industrial Cluster\", \"Foundry Zone - Aji\",\n            \"Machine Tool Belt - Metoda\"\n        ];\n        \n        const allAreas = [...residential, ...industrial];\n\n        const matrixData = {\n            brands: `\n                <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3\">\n                    <a href=\"/blue-star-ac-service-center-rajkot\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-orange-600 hover:text-white transition shadow-sm border border-slate-100\">Blue Star</a>\n                    <a href=\"/lg-ac-service-center-rajkot\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-orange-600 hover:text-white transition shadow-sm border border-slate-100\">LG Service</a>\n                    <a href=\"/daikin-ac-service-center-rajkot\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-orange-600 hover:text-white transition shadow-sm border border-slate-100\">Daikin</a>\n                    <a href=\"/samsung-ac-service-center-rajkot\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-orange-600 hover:text-white transition shadow-sm border border-slate-100\">Samsung</a>\n                    <a href=\"/voltas-ac-service-center-rajkot\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-orange-600 hover:text-white transition shadow-sm border border-slate-100\">Voltas</a>\n                    <a href=\"/mitsubishi-ac-service-center-rajkot\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-orange-600 hover:text-white transition shadow-sm border border-slate-100\">Mitsubishi</a>\n                </div>\n            `,\n            industrial: `\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n                    <a href=\"/chiller-repair-rajkot\" class=\"p-6 bg-indigo-950 text-white rounded-3xl h-48 flex flex-col justify-between\">\n                        <i class=\"fas fa-snowflake text-2xl\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">Industrial Chillers</span>\n                    </a>\n                    <a href=\"/panel-ac-service-rajkot\" class=\"p-6 bg-white border-2 border-slate-200 rounded-3xl h-48 flex flex-col justify-between\">\n                        <i class=\"fas fa-server text-2xl text-orange-600\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">CNC Panel AC</span>\n                    </a>\n                    <a href=\"/ductable-ac-rajkot\" class=\"p-6 bg-orange-600 text-white rounded-3xl h-48 flex flex-col justify-between\">\n                        <i class=\"fas fa-wind text-2xl\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">Ductable Systems</span>\n                    </a>\n                </div>\n            `,\n            parts: `\n                <div class=\"flex flex-wrap gap-4 justify-center\">\n                    <a href=\"/remote-rajkot/\" class=\"px-8 py-3 bg-white rounded-full text-xs font-bold border border-slate-200 hover:border-orange-500 transition\">Universal Remotes</a>\n                    <a href=\"/pcb-repair-rajkot\" class=\"px-8 py-3 bg-white rounded-full text-xs font-bold border border-slate-200 hover:border-orange-500 transition\">PCB Inverter Cards</a>\n                    <a href=\"/compressor-rajkot\" class=\"px-8 py-3 bg-white rounded-full text-xs font-bold border border-slate-200 hover:border-orange-500 transition\">OEM Compressors</a>\n                </div>\n            `\n        };\n\n        function updateMatrix(key) {\n            document.getElementById('matrix-content').innerHTML = matrixData[key];\n            document.querySelectorAll('#matrix button').forEach(btn => btn.classList.remove('matrix-btn-active'));\n            document.getElementById('m-' + key).classList.add('matrix-btn-active');\n        }\n\n        function renderAreas(list) {\n            const grid = document.getElementById('areaGrid');\n            grid.innerHTML = '';\n            list.forEach(area => {\n                const div = document.createElement('div');\n                div.className = \"bg-indigo-900/40 p-3 rounded-xl border border-indigo-800 hover:bg-orange-600/20 transition cursor-default text-center text-indigo-100\";\n                div.textContent = area;\n                grid.appendChild(div);\n            });\n        }\n\n        function filterAreas() {\n            const query = document.getElementById('areaSearch').value.toLowerCase();\n            const filtered = allAreas.filter(a => a.toLowerCase().includes(query));\n            renderAreas(filtered);\n        }\n\n        function solveError() {\n            const code = document.getElementById('errorSelect').value;\n            const hub = document.getElementById('solutionResult');\n            const issue = document.getElementById('issueText');\n            const solution = document.getElementById('solutionText');\n\n            const errors = {\n                \"E1\": [\"Sensor Fault (Power Surge)\", \"Rajkot grid voltage spike damaged thermistor; resistance check and calibration required.\"],\n                \"E4\": [\"Indoor Motor Fail (Dust Jam)\", \"Machinery dust causing bearing friction; motor winding test and start-capacitor replacement.\"],\n                \"F1\": [\"Board Phase Error (Engineering Load)\", \"High voltage related IPM module failure; card level diagnosis at Rajkot workshop.\"],\n                \"C6\": [\"Comm Loss (CNC Interference)\", \"Signal wiring shield failure or EMI interference; verification of L-N-S wiring.\"],\n                \"P4\": [\"IPM Overheat (Industrial Heat)\", \"Outdoor unit heat sink block; full chemical wash and paste reapplication required.\"],\n                \"EC\": [\"Gas Leak Alarm (Vibration Leak)\", \"Industrial vibration causing flare-nut stress leak; nitrogen test and brazing required.\"]\n            };\n\n            if (errors[code]) {\n                hub.classList.remove('hidden');\n                issue.textContent = errors[code][0];\n                solution.textContent = errors[code][1];\n            } else {\n                hub.classList.add('hidden');\n            }\n        }\n\n        function initChart() {\n            const ctx = document.getElementById('priceChart').getContext('2d');\n            new Chart(ctx, {\n                type: 'radar',\n                data: {\n                    labels: ['Repair Tech', 'Gas Refill', 'Board Fix', 'Spares', 'Maintenance'],\n                    datasets: [{\n                        label: 'Rajkot Market Intensity',\n                        data: [90, 85, 95, 70, 80],\n                        backgroundColor: 'rgba(234, 88, 12, 0.2)',\n                        borderColor: '#EA580C',\n                        pointBackgroundColor: '#1E1B4B',\n                        borderWidth: 3\n                    }]\n                },\n                options: {\n                    responsive: true,\n                    maintainAspectRatio: false,\n                    scales: {\n                        r: {\n                            angleLines: { color: '#e2e8f0' },\n                            grid: { color: '#f1f5f9' },\n                            pointLabels: { font: { size: 10, weight: 'bold' }, color: '#1E1B4B' },\n                            ticks: { display: false, count: 5 }\n                        }\n                    },\n                    plugins: { legend: { display: false } }\n                }\n            });\n        }\n\n        window.onload = () => {\n            renderAreas(allAreas);\n            updateMatrix('brands');\n            initChart();\n        };\n    </script>\n</div>",
