  "content": {
    "rendered": "\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"Service\",\n      \"name\": \"Blue Star AC Repair & Maintenance Vadodara\",\n      \"provider\": {\n        \"@type\": \"LocalBusiness\",\n        \"name\": \"Atlas Aircon\",\n        \"image\": \"https://atlasaircons.com/wp-content/uploads/2025/07/Atlas-Aircon-Vehicle-2.webp\",\n        \"telephone\": \"+91-9727257141\",\n        \"address\": {\n          \"@type\": \"PostalAddress\",\n          \"streetAddress\": \"Sayajigunj\",\n          \"addressLocality\": \"Vadodara\",\n          \"postalCode\": \"390005\",\n          \"addressCountry\": \"IN\"\n        }\n      },\n      \"areaServed\": { \"@type\": \"City\", \"name\": \"Vadodara\" },\n      \"description\": \"Expert technical support for Blue Star Split, Window, and Inverter AC units in Vadodara. Same-day emergency repair and genuine spares.\"\n    },\n    {\n      \"@type\": \"FAQPage\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Why is my Blue Star AC leaking water inside?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Indoor leakage in Blue Star units is usually due to a blocked drain tray or pipe caused by dust buildup. Our high-pressure jet wash clears these obstructions permanently.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Can Blue Star Inverter PCBs be repaired?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Yes, Atlas Aircon specializes in component-level PCB repair for Blue Star inverter models, saving you from expensive full-board replacements.\"\n          }\n        }\n      ]\n    }\n  ]\n}\n</script>\n\n<style>\n    .bluestar-v2-wrapper { font-family: 'Inter', sans-serif; color: #333; }\n    .bluestar-v2-wrapper .hero-bg { \n        background: linear-gradient(135deg, #ffffff 0%, rgba(253, 184, 19, 0.1) 50%, rgba(212, 175, 55, 0.2) 100%); \n    }\n    .bluestar-v2-wrapper .gold-btn {\n        background-color: #D4AF37 !important;\n        color: white !important;\n        transition: 0.3s ease;\n        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);\n    }\n    .bluestar-v2-wrapper .gold-btn:hover { background-color: #FDB813 !important; transform: translateY(-2px); }\n    .bluestar-v2-wrapper .gold-text { color: #D4AF37; }\n    .bluestar-v2-wrapper .faq-v2-ans {\n        max-height: 0;\n        overflow: hidden;\n        transition: max-height 0.4s ease;\n    }\n    .bluestar-v2-wrapper details[open] .faq-v2-ans { max-height: 500px; padding-top: 1rem; }\n    .bluestar-v2-wrapper summary { list-style: none; cursor: pointer; outline: none; }\n    .bluestar-v2-wrapper summary::-webkit-details-marker { display: none; }\n    \n    #bs-popup-overlay {\n        position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n        background: rgba(0,0,0,0.6); z-index: 100000; display: none;\n        align-items: center; justify-content: center; backdrop-filter: blur(4px);\n    }\n    #bs-popup-overlay.active { display: flex; }\n</style>\n\n<div class=\"bluestar-v2-wrapper bg-white leading-relaxed\">\n\n    <section class=\"hero-bg py-16 md:py-28 px-6 border-b border-gray-100\">\n        <div class=\"max-w-7xl mx-auto grid md:grid-cols-2 gap-12 items-center\">\n            <div>\n                <span class=\"bg-slate-800 text-white text-xs font-bold px-4 py-1 rounded-full uppercase tracking-tighter mb-4 inline-block\">Independent Technical Squad</span>\n                <h1 class=\"text-4xl md:text-6xl font-black text-slate-900 leading-tight mb-6\">\n                    Master <span class=\"gold-text\">Blue Star AC</span> Repair in Vadodara\n                </h1>\n                <p class=\"text-lg md:text-xl text-slate-600 mb-10 max-w-xl\">\n                    Don&#8217;t let a &#8220;general mechanic&#8221; experiment on your expensive <strong>Blue Star AC</strong>. We provide component-level diagnostics, 120-bar power jet washing, and authentic gas recharging across Vadodara.\n                </p>\n                <div class=\"flex flex-col sm:flex-row gap-4\">\n                    <a href=\"tel:+919727257141\" class=\"gold-btn px-10 py-4 rounded-full font-black text-lg text-center flex items-center justify-center\">\n                        <i class=\"fas fa-phone-alt mr-2\"></i> Call Dispatch Now\n                    </a>\n                    <a href=\"https://wa.me/919727257141\" class=\"bg-slate-800 text-white px-10 py-4 rounded-full font-bold text-lg text-center flex items-center justify-center hover:bg-slate-700 transition\" target=\"_blank\" rel=\"noopener\">\n                        <i class=\"fab fa-whatsapp mr-2 text-green-400\"></i> WhatsApp Us\n                    </a>\n                </div>\n            </div>\n            <div class=\"relative\">\n                <img decoding=\"async\" class=\"rounded-3xl shadow-2xl w-full border-8 border-white\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/Atlas-Aircon-Vehicle-2.webp\" alt=\"Blue Star AC Technician Vadodara\" title=\"\">\n            </div>\n        </div>\n    </section>\n\n    <section class=\"py-20 px-6 bg-white\">\n        <div class=\"max-w-4xl mx-auto text-center\">\n            <h2 class=\"text-3xl md:text-5xl font-black text-slate-900 mb-8\">Decoding The <span class=\"gold-text\">Blue Star Hardware</span></h2>\n            <p class=\"text-lg text-slate-600 mb-6 text-justify\">\n                Blue Star machines are engineered for heavy-duty performance, but they are notorious for sensitive <strong>Thermistor sensors</strong> and <strong>Inverter Motherboards</strong>. In the high-humidity and dusty climate of Vadodara, these components often trigger error codes like <span class=\"font-bold text-red-600\">E1 or E6</span>.\n            </p>\n            <p class=\"text-lg text-slate-600 text-justify\">\n                While authorized centers might suggest replacing the entire PCB (costing upwards of ₹8,000), our <strong>Atlas Aircon</strong> engineers isolate the specific capacitor or relay that has failed. We fix the board, save your money, and restore your comfort the same day.\n            </p>\n        </div>\n    </section>\n\n    <section class=\"py-16 px-6 bg-gray-50\">\n        <div class=\"max-w-7xl mx-auto grid md:grid-cols-3 gap-8\">\n            <div class=\"bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl transition-all\">\n                <div class=\"text-4xl mb-4 gold-text\"><i class=\"fas fa-microchip\"></i></div>\n                <h3 class=\"text-xl font-bold mb-2\">Inverter PCB Fix</h3>\n                <p class=\"text-slate-500 text-sm\">We repair 85% of Blue Star inverter boards that others claim are &#8220;unfixable.&#8221;</p>\n                <span class=\"mt-4 block font-bold gold-text\">Starts @ ₹1500</span>\n            </div>\n            <div class=\"bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl transition-all\">\n                <div class=\"text-4xl mb-4 gold-text\"><i class=\"fas fa-shower\"></i></div>\n                <h3 class=\"text-xl font-bold mb-2\">120-Bar Jet Service</h3>\n                <p class=\"text-slate-500 text-sm\">Our hydraulic pumps blast out calcified grime from deep inside the coils.</p>\n                <span class=\"mt-4 block font-bold gold-text\">Starts @ ₹999</span>\n            </div>\n            <div class=\"bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl transition-all\">\n                <div class=\"text-4xl mb-4 gold-text\"><i class=\"fas fa-gas-pump\"></i></div>\n                <h3 class=\"text-xl font-bold mb-2\">Nitrogen Leak Test</h3>\n                <p class=\"text-slate-500 text-sm\">We find the leak using high-pressure nitrogen before refilling the gas.</p>\n                <span class=\"mt-4 block font-bold gold-text\">Reliable Cooling</span>\n            </div>\n        </div>\n    </section>\n\n    <section class=\"py-16 bg-white px-6\">\n        <div class=\"max-w-4xl mx-auto\">\n            <h2 class=\"text-3xl font-black text-center mb-10\">Realistic <span class=\"gold-text\">Service Tariff</span></h2>\n            <div class=\"bg-slate-900 rounded-3xl overflow-hidden shadow-2xl border border-slate-800\">\n                <div class=\"p-6 border-b border-slate-800 flex justify-between text-white hover:bg-slate-800 transition\">\n                    <span class=\"font-bold\">Split AC Installation</span> <span class=\"gold-text font-black\">₹1500+</span>\n                </div>\n                <div class=\"p-6 border-b border-slate-800 flex justify-between text-white hover:bg-slate-800 transition\">\n                    <span class=\"font-bold\">Window AC Installation</span> <span class=\"gold-text font-black\">₹700+</span>\n                </div>\n                <div class=\"p-6 border-b border-slate-800 flex justify-between text-white hover:bg-slate-800 transition\">\n                    <span class=\"font-bold\">Gas Charging (R32 / R410A)</span> <span class=\"gold-text font-black\">₹2500+</span>\n                </div>\n                <div class=\"p-6 flex justify-between text-white hover:bg-slate-800 transition\">\n                    <span class=\"font-bold\">Visiting &#038; Inspection</span> <span class=\"gold-text font-black\">₹299</span>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <section class=\"py-20 px-6 bg-gray-50 border-t border-gray-200\">\n        <div class=\"max-w-7xl mx-auto text-center\">\n            <h2 class=\"text-3xl font-black text-slate-900 mb-12\">Dispatch Units Ready In:</h2>\n            <div class=\"flex flex-wrap justify-center gap-3\">\n                <span class=\"px-6 py-2 bg-white rounded-full text-xs font-black uppercase text-slate-600 border border-gray-200\">Alkapuri</span>\n                <span class=\"px-6 py-2 bg-white rounded-full text-xs font-black uppercase text-slate-600 border border-gray-200\">Sayajigunj</span>\n                <span class=\"px-6 py-2 bg-white rounded-full text-xs font-black uppercase text-slate-600 border border-gray-200\">Gotri</span>\n                <span class=\"px-6 py-2 bg-white rounded-full text-xs font-black uppercase text-slate-600 border border-gray-200\">Karelibaug</span>\n                <span class=\"px-6 py-2 bg-white rounded-full text-xs font-black uppercase text-slate-600 border border-gray-200\">Makarpura</span>\n                <span class=\"px-6 py-2 bg-white rounded-full text-xs font-black uppercase text-slate-600 border border-gray-200\">Waghodia Road</span>\n            </div>\n        </div>\n    </section>\n\n    <section class=\"py-12 bg-yellow-50 px-6 border-t border-yellow-100\">\n        <div class=\"max-w-4xl mx-auto text-center text-sm text-slate-500\">\n            <strong>Disclaimer:</strong> Atlas Aircon is an independent third-party repair specialist. We are not officially affiliated with Blue Star Ltd. All brand names are property of their respective owners.\n        </div>\n    </section>\n\n</div>\n\n<div id=\"bs-popup-overlay\">\n    <div class=\"bg-white p-8 rounded-3xl shadow-2xl relative max-w-sm w-full mx-6\">\n        <button id=\"bs-popup-close\" class=\"absolute top-4 right-5 text-3xl text-gray-300 hover:text-gray-500\">&times;</button>\n        <div class=\"text-center\">\n            <h3 class=\"text-2xl font-black text-slate-900 mb-2\">Fix Your <span class=\"gold-text\">Blue Star AC</span> Today</h3>\n            <p class=\"text-gray-500 text-sm mb-8\">Our engineers are available in Vadodara right now.</p>\n            <a href=\"https://wa.me/919727257141\" class=\"bg-green-500 text-white font-black py-4 px-6 rounded-2xl block w-full shadow-lg hover:bg-green-600 transition mb-4 uppercase tracking-tighter\" target=\"_blank\" rel=\"noopener\">\n                Request WhatsApp Quote\n            </a>\n            <a href=\"tel:+919727257141\" class=\"text-blue-600 font-bold text-sm hover:underline\">Or Call +91 97272 57141</a>\n        </div>\n    </div>\n</div>\n\n<div id=\"bs-min-btn\" class=\"fixed bottom-6 right-6 w-14 h-14 bg-yellow-600 text-white rounded-full flex items-center justify-center shadow-2xl cursor-pointer z-[99999] hover:scale-110 transition transform\">\n    <i class=\"fas fa-comment-dots text-2xl\"></i>\n</div>\n\n<script>\n    // FAQ Toggle Logic\n    document.querySelectorAll('.bluestar-v2-wrapper details').forEach((el) => {\n        el.addEventListener('toggle', function() {\n            const content = this.querySelector('.faq-v2-ans');\n            if (this.open) {\n                content.style.maxHeight = content.scrollHeight + \"px\";\n            } else {\n                content.style.maxHeight = \"0px\";\n            }\n        });\n    });\n\n    // Popup Logic\n    const overlay = document.getElementById('bs-popup-overlay');\n    const minBtn = document.getElementById('bs-min-btn');\n    const closeBtn = document.getElementById('bs-popup-close');\n\n    const openPopup = () => { overlay.classList.add('active'); minBtn.style.display = 'none'; };\n    const closePopup = () => { overlay.classList.remove('active'); minBtn.style.display = 'flex'; };\n\n    minBtn.addEventListener('click', openPopup);\n    closeBtn.addEventListener('click', closePopup);\n\n    // Auto-show popup after 45s\n    setTimeout(() => { if(!sessionStorage.getItem('bs-p')) { openPopup(); sessionStorage.setItem('bs-p', '1'); } }, 45000);\n</script>\n\n\n",
