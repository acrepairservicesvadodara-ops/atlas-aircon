or: #334155; }<br />\r\n    .hero-gradient { background: linear-gradient(135deg, #004aad 0%, #002d6b 100%); }<br />\r\n    .glass-effect { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); }<br />\r\n    .product-card:hover { transform: translateY(-5px); transition: all 0.3s ease; box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1); }<br />\r\n</style>\r\n\r\n<!-- BREADCRUMB -->\r\n\r\n<nav class=\"bg-gray-100 py-3 px-4 border-b\">\r\n<div class=\"max-w-7xl mx-auto text-xs md:text-sm flex items-center gap-2 text-gray-500\"><a class=\"hover:text-blue-600\" href=\"/\">Home</a> <i class=\"fas fa-chevron-right text-[10px]\"></i>\r\n<a class=\"hover:text-blue-600\" href=\"/ac-services\">AC Services</a> <i class=\"fas fa-chevron-right text-[10px]\"></i>\r\n<span class=\"text-gray-900 font-semibold\">AC Installation Kheda</span></div>\r\n</nav><!-- HERO SECTION -->\r\n\r\n<header class=\"hero-gradient text-white py-24 px-4 relative overflow-hidden\">\r\n<div class=\"absolute top-0 right-0 w-64 h-64 bg-blue-400 opacity-10 rounded-full -mr-32 -mt-32\"></div>\r\n<div class=\"max-w-6xl mx-auto text-center relative z-10\"><span class=\"bg-blue-500/30 text-blue-100 px-6 py-1 rounded-full text-sm font-bold tracking-widest uppercase mb-4 inline-block italic\">Kheda&#8217;s #1 HVAC Engineering Specialist</span>\r\n<h1 class=\"text-4xl md:text-7xl font-black mb-6 leading-tight\">Professional and Standard AC Installation in Kheda</h1>\r\n<p class=\"text-xl md:text-2xl text-blue-100 mb-10 max-w-3xl mx-auto font-light leading-relaxed\">Ensure 100% cooling efficiency with our technical 7-step installation process. From Nadiad high-rises to Mehmedabad factories.</p>\r\n\r\n<div class=\"flex flex-wrap justify-center gap-4\"><a class=\"bg-green-500 hover:bg-green-600 text-white px-8 py-4 rounded-xl font-bold text-lg shadow-xl transition-all flex items-center gap-3\" href=\"https://wa.me/919727257141\" target=\"_blank\" rel=\"noopener\">\r\n<i class=\"fab fa-whatsapp text-2xl\"></i> Chat for Quote\r\n</a>\r\n<a class=\"bg-white/10 hover:bg-white/20 text-white border border-white/30 px-8 py-4 rounded-xl font-bold text-lg transition-all\" href=\"#technical\">Technical Workflow</a></div>\r\n</div>\r\n</header><!-- THE ATLAS DIFFERENCE -->\r\n\r\n<section id=\"technical\" class=\"py-20 px-4 bg-white\">\r\n<div class=\"max-w-7xl mx-auto\">\r\n<div class=\"grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\">\r\n<div class=\"space-y-6\">\r\n<h2 class=\"text-3xl md:text-4xl font-extrabold text-gray-900\">Advanced AC Commissioning for Kheda&#8217;s Climate</h2>\r\n<p class=\"text-lg text-gray-600 leading-relaxed\">In the Kheda district, the combination of high dust and extreme heat requires more than just mounting. For long-term reliability, most residents opt for professional <a class=\"text-blue-600 font-semibold underline\" href=\"/ac-repair-kheda\">AC Repair in Kheda</a>. At Atlas Aircon, we follow a <strong>7-Step Precision Protocol</strong> to ensure your system survives the Narmada belt&#8217;s harsh environment.</p>\r\n\r\n<ul class=\"space-y-4\">\r\n \t<li class=\"flex items-start bg-blue-50 p-4 rounded-lg\"><i class=\"fas fa-microchip mt-1 text-blue-600 mr-3\"></i>\r\n<div><strong>Nitrogen Testing:</strong> Joints tested at 400 PSI to guarantee a leak-proof <a class=\"text-blue-700 font-medium hover:underline\" href=\"/gas-charging-service/\">Gas Charging Service</a>.</div></li>\r\n \t<li class=\"flex items-start bg-blue-50 p-4 rounded-lg\"><i class=\"fas fa-wind mt-1 text-blue-600 mr-3\"></i>\r\n<div><strong>Industrial Vacuuming:</strong> 500-micron dehydration to protect the compressor.</div></li>\r\n \t<li class=\"flex items-start bg-blue-50 p-4 rounded-lg\"><i class=\"fas fa-bolt mt-1 text-blue-600 mr-3\"></i>\r\n<div><strong>Wiring Audit:</strong> Ensuring high-grade <a class=\"text-blue-700 font-medium hover:underline\" href=\"/copper-wire/\">multi-strand copper wiring</a> for safety.</div></li>\r\n</ul>\r\n</div>\r\n<div class=\"grid grid-cols-2 gap-4\"><img decoding=\"async\" class=\"rounded-2xl shadow-lg w-full h-64 object-cover\" src=\"https://atlasaircons.com/wp-content/uploads/2023/04/Split-Ac-Installation-and-Repair-Service-1.webp\" alt=\"Professional AC Installation and Mounting Services in Kheda\" title=\"\">\r\n<img decoding=\"async\" class=\"rounded-2xl shadow-lg w-full h-64 object-cover mt-8\" src=\"https://atlasaircons.com/wp-content/uploads/2023/02/Professional-AC-Maintenance-Services-2.webp\" alt=\"Technician performing AC vacuuming and leak testing in Nadiad\" title=\"\"></div>\r\n</div>\r\n</div>\r\n</section><!-- WOOCOMMERCE STYLE PRODUCTS SECTION -->\r\n\r\n<section class=\"py-20 px-4 bg-white overflow-hidden\">\r\n<div class=\"max-w-7xl mx-auto\">\r\n<div class=\"text-center mb-16\">\r\n<h2 class=\"text-3xl md:text-5xl font-black text-gray-900 mb-4\">Essential Installation Spares &amp; Services</h2>\r\n<p class=\"text-gray-600\">High-quality components for long-lasting cooling performance.</p>\r\n\r\n</div>\r\n<div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6\"><!-- Product 1 -->\r\n<div class=\"w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mb-4 text-blue-600 text-2xl\"></div>\r\n<h4 class=\"font-bold text-gray-800 text-sm mb-2\">Smart AC Remote</h4>\r\n<span class=\"text-blue-600 font-bold text-xs uppercase tracking-wider\">Buy Remote</span>\r\n\r\n<!-- Product 2 -->\r\n<div class=\"w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mb-4 text-blue-600 text-2xl\"></div>\r\n<h4 class=\"font-bold text-gray-800 text-sm mb-2\">Indoor Unit Stand</h4>\r\n<span class=\"text-blue-600 font-bold text-xs uppercase tracking-wider\">Secure Mounting</span>\r\n\r\n<!-- Product 3 -->\r\n<div class=\"w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mb-4 text-blue-600 text-2xl\"></div>\r\n<h4 class=\"font-bold text-gray-800 text-sm mb-2\">Outdoor MS Stand</h4>\r\n<span class=\"text-blue-600 font-bold text-xs uppercas