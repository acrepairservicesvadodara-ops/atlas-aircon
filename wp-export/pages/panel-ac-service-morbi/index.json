tems-center shadow-lg text-lg\" target=\"_blank\" rel=\"noopener\">\n                        <svg class=\"w-8 h-8 mr-3 fill-current\" viewBox=\"0 0 24 24\"><path d=\"M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.588-5.946 0-6.556 5.332-11.888 11.888-11.888 3.176 0 6.161 1.237 8.404 3.48s3.481 5.229 3.481 8.404c0 6.556-5.331 11.888-11.888 11.888-2.003 0-3.963-.505-5.7-1.467l-6.305 1.692zm6.39-4.321c1.556.924 3.167 1.411 4.841 1.411 5.097 0 9.245-4.148 9.245-9.245 0-2.468-.962-4.789-2.709-6.537-1.747-1.747-4.068-2.708-6.536-2.708-5.097 0-9.245 4.148-9.245 9.245 0 1.785.513 3.52 1.484 5.016l-.979 3.575 3.655-.957zm10.334-3.52c-.27-.135-1.598-.788-1.846-.878-.248-.09-.428-.135-.608.135-.18.27-.698.878-.855 1.058-.158.18-.315.203-.585.068-.27-.135-1.14-.421-2.172-1.341-.803-.715-1.346-1.598-1.503-1.868-.158-.27-.017-.417.118-.552.122-.122.27-.315.405-.473.135-.158.18-.27.27-.45.09-.18.045-.338-.023-.473-.068-.135-.608-1.463-.833-2.003-.22-.529-.44-.457-.608-.466-.157-.008-.337-.009-.517-.009-.18 0-.473.068-.72.338-.248.27-.945.923-.945 2.25 0 1.328.968 2.61 1.103 2.79.135.18 1.905 2.909 4.614 4.082.645.278 1.148.445 1.541.569.648.206 1.237.177 1.704.107.52-.078 1.598-.653 1.823-1.283.225-.63.225-1.17.157-1.283-.068-.113-.248-.18-.517-.315z\"/></svg>\n                        Instant Morbi B2B Support\n                    </a>\n                </div>\n            </div>\n            <div class=\"relative\">\n                <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/09/Atlas-Aircon-Panel-Ac-2.png\" alt=\"Panel AC service Morbi industrial unit\" class=\"rounded-3xl shadow-2xl border-4 border-white transform lg:scale-105\" title=\"\">\n            </div>\n        </div>\n    </section>\n\n    <!-- Main Content -->\n    <main class=\"container mx-auto px-4 py-16\">\n        \n        <!-- Technical Introduction -->\n        <section class=\"mb-20\">\n            <h2 class=\"text-3xl font-bold section-title\">Battle-Hardened <b>Panel AC service Morbi</b> for High-Dust Zones</h2>\n            <div class=\"grid lg:grid-cols-2 gap-12 items-center\">\n                <div class=\"prose max-w-none text-gray-700 space-y-6\">\n                    <p>\n                        Morbi is the beating heart of India&#8217;s ceramic industry, home to thousands of tile, sanitaryware, and wall clock manufacturers. However, the industrial environment in <b>Lakhdhirpur Road</b> and <b>Rafaleshwar</b> is notoriously harsh. Fine ceramic dust permeates everything, clogging standard AC filters in hours, while massive kilns radiate intense heat. Finding a <b>Panel AC service Morbi</b> provider who understands these extreme conditions is non-negotiable.\n                    </p>\n                    <p>\n                        Our specialized <b>industrial panel AC repair</b> services are designed specifically for the ceramic cluster. We know that a stopped digital printing machine or a kiln control panel trip can cost lakhs in wasted production. Our technicians are experts in servicing <b>Rittal</b> and <b>Advance Cooling</b> units used in high-dust environments. We employ high-pressure cleaning techniques and specialized filtration solutions to keep your electrical enclosures breathing freely.\n                    </p>\n                    <p>\n                        At <a href=\"/\"><b>Atlas Aircon</b></a>, we provide comprehensive <b>Panel AC service Morbi</b> solutions. From repairing units on digital printing presses to maintaining cooling for packaging plants in <b>Wankaner</b>, we ensure your automation stays cool, even when the ambient temperature crosses 45°C.\n                    </p>\n                </div>\n                <div>\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2026/01/panel-ac-repair-service.webp\" alt=\"Industrial Panel AC service Morbi technical diagnostics\" class=\"rounded-2xl shadow-2xl w-full border-2 border-gray-100\" title=\"\">\n                </div>\n            </div>\n        </section>\n\n        <!-- Specialized Application Section -->\n        <section class=\"mb-20 bg-white p-10 rounded-3xl shadow-lg border-l-8 border-primary\">\n            <h2 class=\"text-3xl font-bold mb-8\">Morbi Industrial Expertise</h2>\n            <div class=\"grid md:grid-cols-3 gap-8 text-center\">\n                <div class=\"space-y-4\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/09/Atlas-Aircon-Panel-Ac-3.png\" alt=\"Ceramic Industry Panel AC service Morbi\" class=\"w-full h-40 object-cover rounded-xl mb-4\" title=\"\">\n                    <h3 class=\"text-xl font-bold text-primary\">Ceramics &#038; Tiles</h3>\n                    <p class=\"text-sm text-gray-600\">Cooling for Digital Printing Machines and Kiln PLCs in Lakhdhirpur. We tackle ceramic dust clogging head-on.</p>\n                </div>\n                <div class=\"space-y-4\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2024/03/Walkin-Freezer-Repair-Service.webp\" alt=\"Clock Industry Panel AC service Morbi\" class=\"w-full h-40 object-cover rounded-xl mb-4\" title=\"\">\n                    <h3 class=\"text-xl font-bold text-primary\">Wall Clock &#038; Electronics</h3>\n                    <p class=\"text-sm text-gray-600\">Precision cooling for injection molding and assembly lines in the Ajanta/Oreva belt.</p>\n                </div>\n                <div class=\"space-y-4\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/rittal-panel-ac-service.webp\" alt=\"Paper Mill Panel AC service Morbi\" class=\"w-full h-40 object-cover rounded-xl mb-4\" title=\"\">\n                    <h3 class=\"text-xl font-bold text-primary\">Paper &#038; Packaging</h3>\n                    <p class=\"text-sm text-gray-600\">Maintaining panel ACs in high-humidity paper mills and corrugation units on Pipli Road.</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- Pros and Cons -->\n        <section class=\"mb-20\">\n            <h2 class=\"text-3xl font-bold section-title\">7 Major Pros and Cons of Industrial Service</h2>\n            <div class=\"grid md:grid-cols-2 gap-8\">\n                <div class=\"p-8 bg-green-50 rounded-2xl border border-green-200\">\n                    <h3 class=\"text-2xl font-bold mb-6 text-green-700\">Advantages (Pros)</h3>\n                    <ul class=\"space-y-4 text-sm\">\n                        <li><b>Dust Defense:</b> Specialized cleaning prevents ceramic dust from choking condenser coils.</li>\n                        <li><b>Digital Printing Uptime:</b> Ensures sensitive printing heads don&#8217;t overheat and clog.</li>\n                        <li><b>Kiln Safety:</b> Keeps PLC panels cool despite the intense ambient heat of the kilns.</li>\n                        <li><b>Energy Savings:</b> Clean units consume far less power, critical for high-energy ceramic plants.</li>\n                        <li><b>Component Life:</b> Doubles the life of VFDs and power supplies in dusty environments.</li>\n                        <li><b>Vibration Check:</b> We secure components against the heavy vibrations of ball mills and presses.</li>\n                        <li><b>Emergency Speed:</b> Rapid response to prevent batch wastage in continuous firing kilns.</li>\n                    </ul>\n                </div>\n                <div class=\"p-8 bg-red-50 rounded-2xl border border-red-200\">\n                    <h3 class=\"text-2xl font-bold mb-6 text-red-700\">Neglect Risks (Cons)</h3>\n                    <ul class=\"space-y-4 text-sm\">\n                        <li><b>Batch Loss:</b> A kiln panel trip can ruin an entire batch of tiles in the firing zone.</li>\n                        <li><b>Print Head Damage:</b> Overheating in digital printers causes expensive head failures.</li>\n                        <li><b>Compressor Seizure:</b> Ceramic dust turns into concrete-like layers on coils, killing compressors.</li>\n                        <li><b>Short Circuits:</b> Conductive dust buildup inside panels causes catastrophic shorts.</li>\n                        <li><b>High Power Bills:</b> Choked filters make ACs run continuously, spiking electricity costs.</li>\n                        <li><b>Voided Warranty:</b> Machinery OEMs often void warranties if cooling is neglected.</li>\n                        <li><b>Fire Risk:</b> Overheated cables and drives in dust-laden panels are a fire hazard.</li>\n                    </ul>\n                </div>\n            </div>\n        </section>\n\n        <!-- Brands We Service -->\n        <section class=\"mb-20\">\n            <h2 class=\"text-3xl font-bold section-title\">Leading Industrial Brands Supported</h2>\n            <p class=\"mb-10 text-gray-600\">We specialize in a massive array of global and Indian brands. We use only high-grade spares and do not claim to be authorized service providers, allowing us to provide faster, more cost-effective solutions for the Morbi industrial belt.</p>\n            <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4\">\n                <div class=\"p-4 border border-blue-200 rounded-lg text-center font-bold hover:shadow-md transition\">Rittal</div>\n                <div class=\"p-4 border border-blue-200 rounded-lg text-center font-bold hover:shadow-md transition\">Adhunik</div>\n                <div class=\"p-4 border border-blue-200 rounded-lg text-center font-bold hover:shadow-md transition\">Advance Cooling</div>\n                <div class=\"p-4 border border-blue-200 rounded-lg text-center font-bold hover:shadow-md transition\">Hoffman</div>\n                <div class=\"p-4 border border-blue-200 rounded-lg text-center font-bold hover:shadow-md transition\">Schneider</div>\n                <div class=\"p-4 border border-blue-200 rounded-lg text-center font-bold hover:shadow-md transition\">Pfannenberg</div>\n                <div class=\"p-4 border border-blue-200 rounded-lg text-center font-bold hover:shadow-md transition\">Cosmotec</div>\n                <div class=\"p-4 border border-blue-200 rounded-lg text-center font-bold hover:shadow-md transition\">Daikin</div>\n                <div class=\"p-4 border border-blue-200 rounded-lg text-center font-bold hover:shadow-md transition\">Mitsubishi</div>\n                <div class=\"p-4 border border-blue-200 rounded-lg text-center font-bold hover:shadow-md transition\">Blue Star</div>\n                <div class=\"p-4 border border-blue-200 rounded-lg text-center font-bold hover:shadow-md transition\">Seifert</div>\n                <div class=\"p-4 border border-blue-200 rounded-lg text-center font-bold hover:shadow-md transition\">Voltas</div>\n            </div>\n        </section>\n\n        <!-- Pricing Table -->\n        <section class=\"mb-20 bg-white p-8 rounded-2xl shadow-lg border-t-8 border-secondary\">\n            <h2 class=\"text-3xl font-bold mb-8 text-center\">Morbi Service &#038; Spares Price List (2026)</h2>\n            <div class=\"table-responsive\">\n                <table class=\"w-full text-left border-collapse\">\n                    <thead>\n                        <tr class=\"bg-gray-100\">\n                            <th class=\"p-4 border\">Item Description</th>\n                            <th class=\"p-4 border\">Estimated Price (INR)</th>\n                            <th class=\"p-4 border\">Grade</th>\n                            <th class=\"p-4 border\">Action</th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        <tr>\n                            <td class=\"p-4 border\"><b>General Service (Ceramic/Dusty)</b></td>\n                            <td class=\"p-4 border\">₹1,800</td>\n                            <td class=\"p-4 border\">High-Pressure Wash</td>\n                            <td class=\"p-4 border\"><a href=\"/shop\" class=\"price-link\">Book Now</a></td>\n                        </tr>\n                        <tr>\n                            <td class=\"p-4 border\"><b>Refrigerant Gas Charging</b></td>\n                            <td class=\"p-4 border\">₹3,500+</td>\n                            <td class=\"p-4 border\">High Purity</td>\n                            <td class=\"p-4 border\"><a href=\"/shop\" class=\"price-link\">Book Now</a></td>\n                        </tr>\n                        <tr>\n                            <td class=\"p-4 border\"><b>Panel AC Digital Controller</b></td>\n                            <td class=\"p-4 border\">₹4,500</td>\n                            <td class=\"p-4 border\">Universal</td>\n                            <td class=\"p-4 border\"><a href=\"/shop\" class=\"price-link\">Buy Part</a></td>\n                        </tr>\n                        <tr>\n                            <td class=\"p-4 border\"><b>High Speed Condenser Fan</b></td>\n                            <td class=\"p-4 border\">₹2,800</td>\n                            <td class=\"p-4 border\">Dust Sealed</td>\n                            <td class=\"p-4 border\"><a href=\"/shop\" class=\"price-link\">Buy Part</a></td>\n                        </tr>\n                        <tr>\n                            <td class=\"p-4 border\"><b>Industrial Compressor</b></td>\n                            <td class=\"p-4 border\">₹10,500+</td>\n                            <td class=\"p-4 border\">High Ambient</td>\n                            <td class=\"p-4 border\"><a href=\"/shop\" class=\"price-link\">Inquire</a></td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n        </section>\n\n        <!-- Industrial Hub Section -->\n        <section class=\"mb-20 bg-gray-900 text-white p-12 rounded-3xl\">\n            <h2 class=\"text-3xl font-bold mb-8 text-secondary\">Morbi &#038; Wankaner Industrial Presence</h2>\n            <p class=\"mb-8 opacity-80\">We offer rapid response for <b>Panel AC service Morbi</b> across these ceramic zones:</p>\n            <div class=\"industrial-list text-xs uppercase tracking-wider leading-relaxed\">\n                <b>Lakhdhirpur Road</b> | <b>Rafaleshwar GIDC</b> | <b>Pipli Road (Jetpar)</b> | <b>Wankaner GIDC</b> | Morbi-Halvad Road | Tankara Industrial Zone | Maliya Miyana Industrial Area | Navlakhi Port Road | Sartanpar Road | Matel Road | Dhuva Industrial Zone | Makansar | Jambudiya.\n            </div>\n        </section>\n\n        <!-- All Services -->\n        <section class=\"mb-20\">\n            <h2 class=\"text-3xl font-bold section-title\">Comprehensive Cooling in Morbi</h2>\n            <div class=\"grid md:grid-cols-3 gap-6\">\n                <div class=\"bg-white rounded-xl shadow-md overflow-hidden hover-card border border-gray-100\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/10/cold-room.webp\" alt=\"Cold Room Service Morbi\" class=\"service-img\" title=\"\">\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-bold mb-2\">Cold Room Solutions</h3>\n                        <p class=\"text-sm text-gray-600 mb-4\">Storage cooling for chemical additives and food processing.</p>\n                        <a href=\"/cold-room-repair-services-vadodara\" class=\"text-primary font-bold\">Details →</a>\n                    </div>\n                </div>\n                <div class=\"bg-white rounded-xl shadow-md overflow-hidden hover-card border border-gray-100\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/deep-freezer-repair-service-in-vadodara.webp\" alt=\"Deep Freezer Repair Morbi\" class=\"service-img\" title=\"\">\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-bold mb-2\">Commercial Freezers</h3>\n                        <p class=\"text-sm text-gray-600 mb-4\">Deep freezer repair for canteens and hospitality units in Morbi.</p>\n                        <a href=\"/deep-freezer-repair-services-vadodara\" class=\"text-primary font-bold\">Details →</a>\n                    </div>\n                </div>\n                <div class=\"bg-white rounded-xl shadow-md overflow-hidden hover-card border border-gray-100\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2024/01/Water-Cooler-Repair-Service-near-me-in-vadodara-scaled.webp\" alt=\"Water Cooler Repair Morbi\" class=\"service-img\" title=\"\">\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-bold mb-2\">Water Cooler Service</h3>\n                        <p class=\"text-sm text-gray-600 mb-4\">Heavy-duty water cooler maintenance for large ceramic factory workforces.</p>\n                        <a href=\"/water-cooler-repair-services-vadodara\" class=\"text-primary font-bold\">Details →</a>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- Error Codes -->\n        <section class=\"mb-20\">\n            <h2 class=\"text-3xl font-bold section-title\">Diagnostic Guide: Panel AC Error Codes</h2>\n            <div class=\"grid md:grid-cols-2 lg:grid-cols-4 gap-4\">\n                <div class=\"p-4 bg-white rounded shadow-sm border-l-4 border-red-500\">\n                    <h4 class=\"font-bold\">E0: Probe Fault</h4>\n                    <p class=\"text-xs\">Controller cannot read internal temperature. <b>Fix:</b> Inspect NTC sensor wiring.</p>\n                </div>\n                <div class=\"p-4 bg-white rounded shadow-sm border-l-4 border-red-500\">\n                    <h4 class=\"font-bold\">E1: Cabinet High</h4>\n                    <p class=\"text-xs\">Critical heat in cabinet. <b>Fix:</b> Clean dust from condenser fins immediately.</p>\n                </div>\n                <div class=\"p-4 bg-white rounded shadow-sm border-l-4 border-red-500\">\n                    <h4 class=\"font-bold\">E2: Low Pressure</h4>\n                    <p class=\"text-xs\">System lost refrigerant or coil is frozen. <b>Fix:</b> Call for <b>Panel AC service Morbi</b>.</p>\n                </div>\n                <div class=\"p-4 bg-white rounded shadow-sm border-l-4 border-red-500\">\n                    <h4 class=\"font-bold\">E3: Phase Swap</h4>\n                    <p class=\"text-xs\">Electrical phase reversal detected. <b>Fix:</b> Check main power phase sequence.</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- Used/Scrap Section -->\n        <section class=\"mb-20 bg-yellow-50 p-10 rounded-3xl border-2 border-yellow-200 text-center\">\n            <h2 class=\"text-3xl font-bold mb-4\">Industrial Buy-Back &#038; Scrap Solutions</h2>\n            <p class=\"mb-8\">Upgrade your plant&#8217;s cooling infrastructure. We buy old or damaged industrial ACs for <b>scrap</b> and sell refurbished <b>used panel AC</b> units with warranty for ceramic units in Morbi.</p>\n            <div class=\"flex justify-center gap-6\">\n                <a href=\"/contact-us\" class=\"bg-gray-800 text-white px-8 py-3 rounded-lg font-bold\">Sell Scrap Units</a>\n                <a href=\"/shop\" class=\"bg-secondary text-white px-8 py-3 rounded-lg font-bold\">Buy Certified Used</a>\n            </div>\n        </section>\n\n        <!-- FAQs -->\n        <section class=\"mb-20\">\n            <h2 class=\"text-3xl font-bold section-title text-center\">Morbi Panel AC Service FAQ</h2>\n            <div class=\"max-w-4xl mx-auto space-y-4\">\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">Do you provide service on Lakhdhirpur Road?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Yes, we serve the entire Lakhdhirpur Road ceramic belt daily with specialized dust-proof maintenance.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">What is the response time for Rafaleshwar GIDC?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Our technicians are stationed nearby and can usually reach Rafaleshwar within 2 hours for emergency breakdowns.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">How do you handle ceramic dust?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">We use high-pressure air and chemical cleaning agents to remove fine ceramic dust that cements onto condenser coils.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">Do you sell spare parts for Rittal ACs?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Yes, we stock high-quality condenser fans, compressors, and controllers for all major industrial AC brands.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">Can you repair units for Digital Printing machines?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Yes, we specialize in cooling units for digital printers (System/Durst/Creta) to prevent head overheating.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">What is the cost of gas refilling?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Industrial gas charging starts from ₹3,500, which includes a full leak test and system evacuation.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">Do you offer AMC services?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Yes, we provide comprehensive AMC plans tailored for high-dust environments in Morbi and Wankaner.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">How can I book an industrial audit?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">You can contact us via the WhatsApp button or call +91 97272 57141 for a full thermal audit of your panels.</p>\n                </details>\n            </div>\n        </section>\n\n        <!-- Residential Morbi Areas -->\n        <section class=\"py-12 bg-white border rounded-2xl px-8 mb-20\">\n            <h3 class=\"text-xl font-bold mb-4\">Residential/Commercial Areas Served in Morbi</h3>\n            <p class=\"text-xs text-gray-400 uppercase tracking-tighter leading-relaxed\">\n                Ravapar Road | Shanala Road | Avani Cross Road | Sardar Nagar | Patel Nagar | GIDC Housing | Vavdi Road | Morbi-Wankaner Highway | Sanala | Mahendranagar | Trajpar | Lalpar | Ghuntu | Papala Mal | So Ordi | Green Chowk | Nehru Gate.\n            </p>\n        </section>\n\n    </main>\n\n    <!-- Global Reach -->\n    <section class=\"bg-primary text-white py-16 text-center\">\n        <div class=\"container mx-auto px-4\">\n            <h2 class=\"text-4xl font-bold mb-6\">Cooling the Ceramic Capital</h2>\n            <p class=\"max-w-3xl mx-auto text-lg mb-10\">We are your trusted technical experts for <b>Panel AC service Morbi</b>. Reliable, dust-proof thermal solutions for your ceramic plants are just one call away.</p>\n            <a href=\"tel:+919727257141\" class=\"bg-secondary text-white px-12 py-4 rounded-full font-bold text-xl inline-block shadow-lg\">Call Atlas Aircon</a>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"bg-gray-900 text-gray-500 py-20\">\n        <div class=\"container mx-auto px-4 grid md:grid-cols-4 gap-12 text-sm\">\n            <div>\n                <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\" alt=\"Atlas Aircon Logo\" class=\"h-10 mb-6 grayscale brightness-150\" title=\"\">\n                <p class=\"italic\">&#8220;The Industrial Cooling Experts.&#8221; Serving Morbi&#8217;s Ceramic &#038; Paper belts with technical excellence since 2010.</p>\n            </div>\n            <div>\n                <h4 class=\"text-white font-bold mb-4 uppercase\">Services</h4>\n                <ul class=\"space-y-2\">\n                    <li><a href=\"/panel-ac-service-vadodara\" class=\"hover:text-white\">Panel AC Repair</a></li>\n                    <li><a href=\"/chiller-repair-services-vadodara\" class=\"hover:text-white\">Industrial Chillers</a></li>\n                    <li><a href=\"/cold-room-repair-services-vadodara\" class=\"hover:text-white\">Cold Storage</a></li>\n                    <li><a href=\"/ac-service-vadodara\" class=\"hover:text-white\">AC Service Center</a></li>\n                </ul>\n            </div>\n            <div>\n                <h4 class=\"text-white font-bold mb-4 uppercase\">Hubs</h4>\n                <ul class=\"space-y-2\">\n                    <li><a href=\"/locations\" class=\"hover:text-white\">Lakhdhirpur Road</a></li>\n                    <li><a href=\"/locations\" class=\"hover:text-white\">Rafaleshwar GIDC</a></li>\n                    <li><a href=\"/locations\" class=\"hover:text-white\">Jetpar/Pipli Road</a></li>\n                    <li><a href=\"/locations\" class=\"hover:text-white\">Wankaner GIDC</a></li>\n                </ul>\n            </div>\n            <div>\n                <h4 class=\"text-white font-bold mb-4 uppercase\">Contact</h4>\n                <p class=\"mb-2\">Morbi Office: Ravapar Rd, GJ</p>\n                <p class=\"mb-2\">Phone: +91 97272 57141</p>\n                <p>Email: atlasaircon1@gmail.com</p>\n            </div>\n        </div>\n        <div class=\"text-center mt-12 text-xs border-t border-gray-800 pt-8 uppercase tracking-tighter\">\n            © 2026 Atlas Aircon. Leading <b>Panel AC service Morbi</b> provider. All brands mentioned are property of respective owners.\n        </div>\n    </footer>\n\n    <!-- Fixed WhatsApp -->\n    <a href=\"https://wa.me/919727257141\" class=\"fixed bottom-6 right-6 z-50 btn-whatsapp p-5 rounded-full shadow-2xl transition\" target=\"_blank\" rel=\"noopener\">\n        <svg class=\"w-8 h-8 fill-current\" viewBox=\"0 0 24 24\"><path d=\"M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.588-5.946 0-6.556 5.332-11.888 11.888-11.888 3.176 0 6.161 1.237 8.404 3.48s3.481 5.229 3.481 8.404c0 6.556-5.331 11.888-11.888 11.888-2.003 0-3.963-.505-5.7-1.467l-6.305 1.692zm6.39-4.321c1.556.924 3.167 1.411 4.841 1.411 5.097 0 9.245-4.148 9.245-9.245 0-2.468-.962-4.789-2.709-6.537-1.747-1.747-4.068-2.708-6.536-2.708-5.097 0-9.245 4.148-9.245 9.245 0 1.785.513 3.52 1.484 5.016l-.979 3.575 3.655-.957zm10.334-3.52c-.27-.135-1.598-.788-1.846-.878-.248-.09-.428-.135-.608.135-.18.27-.698.878-.855 1.058-.158.18-.315.203-.585.068-.27-.135-1.14-.421-2.172-1.341-.803-.715-1.346-1.598-1.503-1.868-.158-.27-.017-.417.118-.552.122-.122.27-.315.405-.473.135-.158.18-.27.27-.45.09-.18.045-.338-.023-.473-.068-.135-.608-1.463-.833-2.003-.22-.529-.44-.457-.608-.466-.157-.008-.337-.009-.517-.009-.18 0-.473.068-.72.338-.248.27-.945.923-.945 2.25 0 1.328.968 2.61 1.103 2.79.135.18 1.905 2.909 4.614 4.082.645.278 1.148.445 1.541.569.648.206 1.237.177 1.704.107.52-.078 1.598-.653 1.823-1.283.225-.63.225-1.17.157-1.283-.068-.113-.248-.18-.517