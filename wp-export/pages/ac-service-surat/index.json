    "rendered": "<div class=\"atlas-purified-matrix\"><style>\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap');\n        body { font-family: 'Inter', sans-serif; }\n        .hero-gradient { background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 50%, #f97316 100%); }\n        .glass { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); }\n        .section-heading { position: relative; padding-bottom: 1rem; margin-bottom: 2rem; }\n        .section-heading::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 100px; height: 4px; background: linear-gradient(to right, #f97316, #fbbf24); border-radius: 2px; }\n        .gold-border { border-color: #fbbf24; }\n    </style>\n<script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@graph\": [\n        {\n          \"@type\": \"Service\",\n          \"name\": \"AC Service and Repair in Surat\",\n          \"serviceType\": \"Air Conditioning Maintenance\",\n          \"provider\": {\n            \"@type\": \"LocalBusiness\",\n            \"name\": \"Atlas Aircon\",\n            \"image\": \"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\",\n            \"address\": {\n              \"@type\": \"PostalAddress\",\n              \"streetAddress\": \"Surat\",\n              \"addressLocality\": \"Surat\",\n              \"addressRegion\": \"Gujarat\",\n              \"postalCode\": \"395003\",\n              \"addressCountry\": \"IN\"\n            },\n            \"telephone\": \"+91 97272 57141\",\n            \"priceRange\": \"₹499 - ₹15000\"\n          },\n          \"areaServed\": {\n            \"@type\": \"City\",\n            \"name\": \"Surat\"\n          },\n          \"aggregateRating\": {\n            \"@type\": \"AggregateRating\",\n            \"ratingValue\": \"4.9\",\n            \"reviewCount\": \"2150\"\n          }\n        },\n        {\n          \"@type\": \"BreadcrumbList\",\n          \"itemListElement\": [{\n            \"@type\": \"ListItem\",\n            \"position\": 1,\n            \"name\": \"Home\",\n            \"item\": \"https://atlasaircons.com\"\n          },{\n            \"@type\": \"ListItem\",\n            \"position\": 2,\n            \"name\": \"AC Service Surat\",\n            \"item\": \"https://atlasaircons.com/ac-service-surat\"\n          }]\n        }\n      ]\n    }\n    </script>\n<script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    colors: {\n                        brandOrange: '#f97316',\n                        brandGold: '#fbbf24',\n                        brandDeepBlue: '#1e3a8a',\n                    }\n                }\n            }\n        }\n    </script>\n\n\n    <!-- Navigation -->\n    <nav class=\"sticky top-0 z-50 glass border-b border-gray-200 py-4 px-6\">\n        <div class=\"max-w-7xl mx-auto flex justify-between items-center\">\n            <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com\" class=\"flex items-center space-x-2\">\n                <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\" alt=\"Atlas Aircon Logo\" class=\"h-10\" title=\"\">\n            </a>\n            <div class=\"hidden md:flex space-x-6 font-semibold\">\n                <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com\" class=\"hover:text-brandOrange transition\">Home</a>\n                <a href=\"/ac-service-surat\" class=\"text-brandOrange underline\">AC Service</a>\n                <a href=\"/ac-repair-surat\" class=\"hover:text-brandOrange transition\">AC Repair</a>\n                <a href=\"#pricing\" class=\"hover:text-brandOrange transition\">Pricing</a>\n            </div>\n            <a href=\"https://wa.me/919727257141\" class=\"bg-green-500 text-white px-5 py-2 rounded-full font-bold flex items-center space-x-2 hover:bg-green-600 transition shadow-md\" target=\"_blank\" rel=\"noopener\">\n                <span>Book via WhatsApp</span>\n            </a>\n        </div>\n    </nav>\n\n    <!-- Hero Banner -->\n    <header class=\"hero-gradient text-white py-24 px-6 relative overflow-hidden\">\n        <div class=\"max-w-7xl mx-auto grid md:grid-cols-2 gap-12 items-center relative z-10\">\n            <div>\n                <span class=\"bg-brandGold text-brandDeepBlue px-4 py-1 rounded-full text-sm font-extrabold uppercase tracking-widest mb-4 inline-block shadow-lg\">Surat&#8217;s Premium Cooling Team</span>\n                <h1 class=\"text-4xl md:text-6xl font-extrabold mb-6 leading-tight\">Surat&#8217;s #1 <span class=\"text-brandGold\">AC Service Provider</span> | All Areas Covered</h1>\n                <p class=\"text-xl mb-8 opacity-95\"><strong>Atlas Aircon</strong> delivers elite <strong>Air Conditioner Repair and Maintenance</strong>. From high-capacity <strong>Industrial Chiller Repair</strong> for textile giants to swift <strong>Split AC Installation</strong>, our gold-standard service is unmatched in the Diamond City.</p>\n                <div class=\"flex flex-col sm:flex-row gap-4\">\n                    <a href=\"https://wa.me/919727257141\" class=\"bg-brandOrange text-white px-8 py-4 rounded-xl font-extrabold text-lg flex items-center justify-center hover:bg-orange-600 transition shadow-2xl\" target=\"_blank\" rel=\"noopener\">\n                        <svg class=\"w-6 h-6 mr-2\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.319 1.592 5.548 0 10.061-4.512 10.063-10.062.001-2.69-1.048-5.219-2.953-7.124s-4.434-2.952-7.125-2.952c-5.549 0-10.06 4.515-10.063 10.063-.001 2.112.566 3.705 1.582 5.393l-1.041 3.805 3.918-1.025z\"/></svg>\n                        Instant Booking\n                    </a>\n                    <a href=\"/ac-repair-service-price-list-air-conditioner-repair-service-cost-surat-gujarat\" class=\"bg-white/10 backdrop-blur-md border-2 border-white text-white px-8 py-4 rounded-xl font-bold text-lg text-center hover:bg-white hover:text-brandDeepBlue transition\">Price Directory</a>\n                </div>\n            </div>\n            <div class=\"hidden md:block\">\n                <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/10/Split-Air-Conditioner.webp\" alt=\"Professional AC Service Surat\" class=\"rounded-3xl shadow-2xl border-4 border-brandGold transform rotate-2 hover:rotate-0 transition duration-500\" title=\"\">\n            </div>\n        </div>\n    </header>\n\n    <!-- Zonal Content Architecture Section -->\n    <section class=\"py-16 px-6 bg-white border-b border-gray-100\">\n        <div class=\"max-w-7xl mx-auto\">\n            <h2 class=\"text-3xl font-bold text-center section-heading\">Our Zonal Expertise in Surat</h2>\n            <div class=\"grid md:grid-cols-2 gap-8\">\n                <!-- West Surat -->\n                <div class=\"p-8 rounded-3xl border border-gray-100 bg-gray-50 hover:border-brandGold transition shadow-sm\">\n                    <h2 class=\"text-xl font-bold text-brandDeepBlue mb-4\">Premium AC Maintenance for West Surat (Adajan, Pal, Piplod, Rander)</h2>\n                    <p class=\"text-gray-700 text-sm\">Targeting the high-end residential and riverside developments. We provide specialized <strong>Split AC Service</strong> and <strong>Cassette AC Maintenance</strong> for premium towers and office complexes in the Adajan and Pal expansion zones.</p>\n                </div>\n                <!-- South Surat -->\n                <div class=\"p-8 rounded-3xl border border-gray-100 bg-gray-50 hover:border-brandOrange transition shadow-sm\">\n                    <h2 class=\"text-xl font-bold text-brandDeepBlue mb-4\">Reliable AC Repair for South Surat (Vesu, Althan, City Light, Bharthana)</h2>\n                    <p class=\"text-gray-700 text-sm\">Focused on swift response times for the city&#8217;s most affluent residential heart. From <strong>Gas Charging Service</strong> to complex <strong>Inverter PCB Recovery</strong>, we ensure elite cooling in Vesu and City Light neighborhoods.</p>\n                </div>\n                <!-- East Surat -->\n                <div class=\"p-8 rounded-3xl border border-gray-100 bg-gray-50 hover:border-brandGold transition shadow-sm\">\n                    <h2 class=\"text-xl font-bold text-brandDeepBlue mb-4\">Affordable AC Service for East Surat (Varachha, Katargam, Puna Kumbhariya)</h2>\n                    <p class=\"text-gray-700 text-sm\">Delivering value-driven <strong>Power Jet Deep Cleaning</strong> and routine maintenance for the bustling diamond and textile corridors. Our 100% efficiency guarantee covers the dense residential areas of Varachha and Katargam.</p>\n                </div>\n                <!-- Industrial Zones -->\n                <div class=\"p-8 rounded-3xl border border-gray-100 bg-gray-50 hover:border-brandDeepBlue transition shadow-sm\">\n                    <h2 class=\"text-xl font-bold text-brandDeepBlue mb-4\">Industrial AC Solutions for Hazira, Sachin &#038; Ichchhapore GIDC</h2>\n                    <p class=\"text-gray-700 text-sm\">Providing robust support for critical heavy industry cooling. We specialize in <strong>Panel AC</strong>, high-capacity <strong>Chillers</strong>, and <strong>HVAC plants</strong> for production units within the massive Hazira and Sachin industrial belts.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Specialized Service Sections -->\n    <section class=\"py-16 px-6 bg-white\">\n        <div class=\"max-w-7xl mx-auto\">\n            <h2 class=\"text-3xl font-bold text-center section-heading\">Elite AC Cleaning Technologies</h2>\n            \n            <!-- Power Jet AC Service -->\n            <div class=\"grid md:grid-cols-3 gap-8 mb-20 items-center\">\n                <div class=\"md:col-span-1\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/05/Power-jet-ac-service-in-vadodara-2.webp\" alt=\"Power Jet AC Service Surat\" class=\"rounded-2xl shadow-xl border-2 border-brandOrange\" title=\"\">\n                </div>\n                <div class=\"md:col-span-2\">\n                    <h3 class=\"text-2xl font-bold text-brandDeepBlue mb-4 uppercase tracking-wide border-l-4 border-brandOrange pl-4\">Advanced Power Jet AC Service</h3>\n                    <p class=\"mb-4 text-gray-700 leading-relaxed\">Harness the strength of our <strong>High-Pressure Power Jet AC Service</strong>, engineered specifically to combat <strong>Surat&#8217;s</strong> unique combination of textile lint and high coastal humidity. Our specialized pumps deliver a concentrated water stream that dislodges even the most stubborn carbon grime from deep within your machine.</p>\n                    <p class=\"mb-6 text-gray-700 leading-relaxed\">This process guarantees that your cooling coils remain completely unobstructed, resulting in a 30% increase in airflow efficiency. It is the premier choice for customers demanding the absolute best in <strong>Air Conditioner Maintenance</strong> in the Diamond City.</p>\n                    <p class=\"bg-orange-50 p-6 rounded-xl text-gray-800 border-l-4 border-brandOrange shadow-sm\">The <strong>Power Jet AC Cleaning</strong> methodology at Atlas Aircon is a rigorous technical procedure applied locally to handle the specific environmental factors of a coastal industrial hub. We use industrial-grade pressure washers that target the cooling fins with precision, removing the sticky textile micro-fibers and road dust that cause compressors to overheat during peak Surat summers. By scheduling a <strong>Water Jet AC Service</strong>, you are effectively resetting your unit&#8217;s performance levels and preventing costly <strong>AC PCB Circuit Repair</strong> visits caused by coastal salt air corrosion. Our technicians meticulously clean the indoor blower wheel and the outdoor condenser, ensuring every vent is cleared. This high-impact cleaning also flushes the internal drain line, preventing common water leakage issues.</p>\n                </div>\n            </div>\n\n            <!-- Chemical Wash / Deep Cleaning -->\n            <div class=\"grid md:grid-cols-3 gap-8 mb-20 items-center\">\n                <div class=\"md:col-span-2 order-2 md:order-1\">\n                    <h3 class=\"text-2xl font-bold text-brandDeepBlue mb-4 uppercase tracking-wide border-l-4 border-brandGold pl-4\">Premium Chemical Wash &#038; Deep Cleaning</h3>\n                    <p class=\"mb-4 text-gray-700 leading-relaxed\">Our <strong>AC Chemical Wash service in Surat</strong> is a comprehensive sanitation process that dissolves oil deposits and bacterial colonies common in humid environments. We use non-corrosive, eco-friendly chemicals to protect your coils while ensuring total hygiene in residential hubs like Vesu and Adajan.</p>\n                    <p class=\"mb-6 text-gray-700 leading-relaxed\">This <strong>Deep Cleaning AC Service</strong> is vital for units that operate in proximity to the Tapi river or within the busy commercial textile markets. It eliminates the foul odors and allergens that compromise your indoor air quality.</p>\n                    <p class=\"bg-yellow-50 p-6 rounded-xl text-gray-800 border-l-4 border-brandGold shadow-sm\">A <strong>Chemical Deep Cleaning</strong> involves the complete disassembly of your air conditioner&#8217;s front panel and water tray. Standard servicing often misses the mold that thrives in the humid dark corners of the indoor unit, but our chemical foam expands into every crevice. This foam encapsulates dust and grime, which is then safely rinsed away using a <strong>Water Jet AC Service</strong>. This procedure is especially critical for <strong>Cassette AC</strong> and <strong>Ductable AC</strong> units in commercial buildings and luxury apartments. By removing the insulating layer of dirt and salt residue, we restore the heat exchange capacity of the evaporator, leading to ice-cold cooling and reduced electricity consumption immediately after the service.</p>\n                </div>\n                <div class=\"md:col-span-1 order-1 md:order-2\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/04/AC-Chemical-Wash-service-in-Vadodara.webp\" alt=\"AC Chemical Wash Surat\" class=\"rounded-2xl shadow-xl border-2 border-brandGold\" title=\"\">\n                </div>\n            </div>\n\n            <!-- Industrial Cleaning -->\n            <div class=\"grid md:grid-cols-3 gap-8 items-center\">\n                <div class=\"md:col-span-1\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/02/b7914dbe-da32-4479-9b2b-db1f88b6410f.webp\" alt=\"Industrial AC Cleaning Surat\" class=\"rounded-2xl shadow-xl border-2 border-brandDeepBlue\" title=\"\">\n                </div>\n                <div class=\"md:col-span-2\">\n                    <h3 class=\"text-2xl font-bold text-brandDeepBlue mb-4 uppercase tracking-wide border-l-4 border-brandDeepBlue pl-4\">Heavy-Duty Industrial Pressure Washing</h3>\n                    <p class=\"mb-4 text-gray-700 leading-relaxed\">For massive installations in <strong>Surat&#8217;s industrial belts</strong> like Hazira and Sachin GIDC, we provide high-volume <strong>Pressure Washer Wet Cleaning</strong>. Our equipment is capable of cleaning large-scale condensers and industrial <strong>HVAC Plants</strong> efficiently.</p>\n                    <p class=\"mb-6 text-gray-700 leading-relaxed\">We understand the critical nature of cooling in production zones for chemicals, heavy engineering, and textiles. Our mobile units offer rapid on-site <strong>Water Jet AC Service</strong> to prevent manufacturing downtime and critical equipment failure.</p>\n                    <p class=\"bg-blue-50 p-6 rounded-xl text-gray-800 border-l-4 border-brandDeepBlue shadow-sm\">The industrial <strong>Pressure Washer AC Service</strong> is designed for the most challenging environments in <strong>Surat</strong>. When <strong>Panel AC</strong> or <strong>Chiller</strong> condensers are blocked by industrial soot and salty coastal air, the resulting high discharge pressure can lead to immediate <strong>Compressor</strong> failure. Our experts utilize variable pressure nozzles to clean heavy-duty fins without causing mechanical deformation. This service includes a comprehensive analysis of the <strong>Gas Charging Service</strong> requirements to ensure the system is operating within safe parameters. Whether it is a <strong>Package AC</strong> in a control room or a <strong>Central AC</strong> plant, our water jet methodology ensures peak performance even under extreme Gujarat coastal conditions.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Product Grid -->\n    <section class=\"py-16 px-6 bg-gray-50\">\n        <div class=\"max-w-7xl mx-auto\">\n            <h2 class=\"text-3xl font-bold text-center section-heading\">Products Serviced in Surat</h2>\n            <div class=\"grid grid-cols-2 md:grid-cols-4 gap-6\">\n                <a href=\"/split-ac-service-surat\" class=\"bg-white p-6 rounded-xl shadow-md hover:shadow-xl transition-all text-center group border-b-4 border-brandOrange\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/10/Split-Air-Conditioner.webp\" alt=\"Split AC\" class=\"w-full h-32 object-cover mb-4 rounded-lg\" title=\"\">\n                    <h4 class=\"font-bold group-hover:text-brandOrange\">Split AC Service</h4>\n                </a>\n                <a href=\"/window-ac-service-surat\" class=\"bg-white p-6 rounded-xl shadow-md hover:shadow-xl transition-all text-center group border-b-4 border-brandGold\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/Window-ac-repair-service.webp\" alt=\"Window AC\" class=\"w-full h-32 object-cover mb-4 rounded-lg\" title=\"\">\n                    <h4 class=\"font-bold group-hover:text-brandOrange\">Window AC Repair</h4>\n                </a>\n                <a href=\"/cassette-ac-service-surat\" class=\"bg-white p-6 rounded-xl shadow-md hover:shadow-xl transition-all text-center group border-b-4 border-brandDeepBlue\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/04/cassette-ac-repair-service-vadodara.png\" alt=\"Cassette AC\" class=\"w-full h-32 object-cover mb-4 rounded-lg\" title=\"\">\n                    <h4 class=\"font-bold group-hover:text-brandOrange\">Cassette AC</h4>\n                </a>\n                <a href=\"/panel-ac-service-surat\" class=\"bg-white p-6 rounded-xl shadow-md hover:shadow-xl transition-all text-center group border-b-4 border-brandOrange\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/advance-panel-ac-repair-service.webp\" alt=\"Panel AC\" class=\"w-full h-32 object-cover mb-4 rounded-lg\" title=\"\">\n                    <h4 class=\"font-bold group-hover:text-brandOrange\">Panel AC Service</h4>\n                </a>\n                <a href=\"/central-ac-repair-services-surat\" class=\"bg-white p-6 rounded-xl shadow-md hover:shadow-xl transition-all text-center group border-b-4 border-brandGold\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2017/02/Central-Air-Conditioners.jpg\" alt=\"Central AC\" class=\"w-full h-32 object-cover mb-4 rounded-lg\" title=\"\">\n                    <h4 class=\"font-bold group-hover:text-brandOrange\">Central AC Repair</h4>\n                </a>\n                <a href=\"/chiller-repair-services-surat\" class=\"bg-white p-6 rounded-xl shadow-md hover:shadow-xl transition-all text-center group border-b-4 border-brandDeepBlue\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/chiller-service-in-vadodara.webp\" alt=\"Chiller\" class=\"w-full h-32 object-cover mb-4 rounded-lg\" title=\"\">\n                    <h4 class=\"font-bold group-hover:text-brandOrange\">Industrial Chillers</h4>\n                </a>\n                <a href=\"/hvac-repair-services-surat\" class=\"bg-white p-6 rounded-xl shadow-md hover:shadow-xl transition-all text-center group border-b-4 border-brandOrange\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/hvac-repair-in-vadodara.webp\" alt=\"HVAC\" class=\"w-full h-32 object-cover mb-4 rounded-lg\" title=\"\">\n                    <h4 class=\"font-bold group-hover:text-brandOrange\">HVAC Systems</h4>\n                </a>\n                <a href=\"/refrigerator-repair-services-surat\" class=\"bg-white p-6 rounded-xl shadow-md hover:shadow-xl transition-all text-center group border-b-4 border-brandGold\">\n                    <div class=\"w-full h-32 bg-orange-100 mb-4 rounded-lg flex items-center justify-center\">\n                        <svg class=\"w-16 h-16 text-brandOrange\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 16h-1v-4h1m0-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"/></svg>\n                    </div>\n                    <h4 class=\"font-bold group-hover:text-brandOrange\">Refrigerators</h4>\n                </a>\n            </div>\n            <div class=\"mt-12 flex flex-wrap justify-center gap-x-6 gap-y-4 text-sm font-bold uppercase tracking-widest text-brandDeepBlue\">\n                <a href=\"/air-handling-unit-services-surat\" class=\"hover:text-brandOrange underline decoration-brandGold\">AHU Service</a>\n                <a href=\"/ducting-repair-services-surat\" class=\"hover:text-brandOrange underline decoration-brandGold\">Ducting Repair</a>\n                <a href=\"/air-cooler-repair-services-surat\" class=\"hover:text-brandOrange underline decoration-brandGold\">Air Cooler Repair</a>\n                <a href=\"/deep-freezer-repair-services-surat\" class=\"hover:text-brandOrange underline decoration-brandGold\">Deep Freezer Service</a>\n                <a href=\"/water-cooler-repair-services-surat\" class=\"hover:text-brandOrange underline decoration-brandGold\">Water Cooler Repair</a>\n                <a href=\"/package-ac-service-surat\" class=\"hover:text-brandOrange underline decoration-brandGold\">Package AC</a>\n                <a href=\"/precision-ac-service-surat\" class=\"hover:text-brandOrange underline decoration-brandGold\">Precision AC</a>\n                <a href=\"/cold-room-repair-services-surat\" class=\"hover:text-brandOrange underline decoration-brandGold\">Cold Room Repair</a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Pricing Hub -->\n    <section id=\"pricing\" class=\"py-16 px-6 bg-white\">\n        <div class=\"max-w-7xl mx-auto\">\n            <h2 class=\"text-3xl font-bold text-center section-heading\">Service Pricing &#038; Genuine Spares</h2>\n            <div class=\"grid md:grid-cols-3 gap-8\">\n                <!-- Spare Parts -->\n                <div class=\"md:col-span-1 bg-white p-8 rounded-3xl shadow-xl border-t-8 border-brandGold\">\n                    <h3 class=\"font-bold text-xl mb-6 text-brandDeepBlue border-b-2 border-brandGold pb-2\">Surat Inventory</h3>\n                    <ul class=\"space-y-4 text-sm font-bold text-gray-700\">\n                        <li><a href