der rounded hover:shadow-md transition\"><b>Citizen</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Trane</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Hitachi</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Mitsubishi</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>LG</b></div>\n            </div>\n        </div>\n    </section>\n\n    <!-- GIDC & INDUSTRIAL FOCUS SECTION (Valsad Specific) -->\n    <section class=\"section-padding bg-yellow-50\">\n        <div class=\"container mx-auto px-4\">\n            <h2 class=\"text-3xl font-bold mb-8 text-center text-gray-900\">Dedicated Service for Valsad Industrial Estates &#038; Vapi GIDC</h2>\n            <div class=\"bg-white p-8 rounded-3xl shadow-lg\">\n                <p class=\"mb-6 text-lg text-justify\">\n                    The Valsad district, featuring Vapi—one of the largest industrial hubs in Asia—requires specialized <b>Air Handling Unit services Valsad</b> that can handle non-stop operations. Atlas Aircon provides high-priority technical support to all GIDC areas in the district, ensuring that your HVAC systems don&#8217;t fail during peak production hours.\n                </p>\n                <div class=\"grid md:grid-cols-2 gap-8\">\n                    <div>\n                        <h4 class=\"font-bold text-xl mb-4 text-blue-800\"><i class=\"fas fa-industry mr-2\"></i> Major Industrial Clusters</h4>\n                        <div class=\"flex flex-wrap gap-2\">\n                            <span class=\"bg-gray-100 px-3 py-1 rounded-full text-sm font-bold\">Vapi GIDC (I to IV)</span>\n                            <span class=\"bg-gray-100 px-3 py-1 rounded-full text-sm font-bold\">Sarigam GIDC</span>\n                            <span class=\"bg-gray-100 px-3 py-1 rounded-full text-sm font-bold\">Umbergaon GIDC</span>\n           