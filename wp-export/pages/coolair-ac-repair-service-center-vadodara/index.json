  "content": {
    "rendered": "\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"Service\",\n      \"name\": \"CoolAir AC Repair & Installation Vadodara\",\n      \"provider\": {\n        \"@type\": \"LocalBusiness\",\n        \"name\": \"Atlas Aircon\",\n        \"image\": \"https://atlasaircons.com/wp-content/uploads/2025/07/Atlas-Aircon-Vehicle-2.webp\",\n        \"telephone\": \"+91-9727257141\",\n        \"address\": {\n          \"@type\": \"PostalAddress\",\n          \"streetAddress\": \"27 Payal Complex, Sayajigunj\",\n          \"addressLocality\": \"Vadodara\",\n          \"postalCode\": \"390005\",\n          \"addressCountry\": \"IN\"\n        }\n      },\n      \"areaServed\": { \"@type\": \"City\", \"name\": \"Vadodara\" },\n      \"description\": \"Specialized independent service for CoolAir air conditioners in Vadodara. Same-day repair, PCB troubleshooting, and genuine gas charging.\"\n    },\n    {\n      \"@type\": \"FAQPage\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Why is my CoolAir AC showing an E1 error?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"E1 on CoolAir units typically signals a room sensor failure or communication glitch. Our team carries ready-stock sensors to fix this at your doorstep in Vadodara.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Does Atlas Aircon provide genuine spares for CoolAir?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Yes, we utilize 100% compatible OEM-grade spares for all CoolAir models, backed by our 3-month Atlas service guarantee.\"\n          }\n        }\n      ]\n    }\n  ]\n}\n</script>\n\n<style>\n    .ca-wrapper-v2 { font-family: 'Inter', sans-serif; color: #333; }\n    .ca-wrapper-v2 .hero-bg-v2 { \n        background: linear-gradient(135deg, #ffffff 0%, rgba(253, 184, 19, 0.1) 50%, rgba(212, 175, 55, 0.2) 100%); \n    }\n    .ca-wrapper-v2 .gold-btn {\n        background-color: #D4AF37 !important;\n        color: white !important;\n        transition: 0.3s ease;\n        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.4);\n    }\n    .ca-wrapper-v2 .gold-btn:hover { background-color: #FDB813 !important; transform: translateY(-2px); }\n    .ca-wrapper-v2 .dark-btn { background-color: #36454F !important; color: white !important; transition: 0.3s; }\n    .ca-wrapper-v2 .ca-gold-text { color: #D4AF37; }\n    .ca-wrapper-v2 .faq-slide-box {\n        max-height: 0; overflow: hidden; transition: max-height 0.4s ease;\n    }\n    .ca-wrapper-v2 details[open] .faq-slide-box { max-height: 500px; padding-top: 1rem; }\n    .ca-wrapper-v2 summary { list-style: none; cursor: pointer; outline: none; }\n    .ca-wrapper-v2 summary::-webkit-details-marker { display: none; }\n    \n    #ca-popup-overlay {\n        position: fixed; top: 0; left: 0; width: 100%; height: 100%;\n        background: rgba(0,0,0,0.7); z-index: 100000; display: none;\n        align-items: center; justify-content: center; backdrop-filter: blur(4px);\n    }\n    #ca-popup-overlay.active { display: flex; }\n</style>\n\n<div class=\"ca-wrapper-v2 bg-white leading-relaxed\">\n\n    <section class=\"hero-bg-v2 py-16 md:py-28 px-6\">\n        <div class=\"max-w-7xl mx-auto grid md:grid-cols-2 gap-12 items-center\">\n            <div class=\"text-center md:text-left\">\n                <span class=\"bg-slate-800 text-white text-xs font-bold px-4 py-1 rounded-full uppercase tracking-tighter mb-4 inline-block\">Direct Engineering Support</span>\n                <h1 class=\"text-4xl md:text-6xl font-black text-slate-900 leading-tight mb-6\">\n                    Professional <span class=\"ca-gold-text\">CoolAir AC</span> Service center in Vadodara\n                </h1>\n                <p class=\"text-lg md:text-xl text-slate-600 mb-10 max-w-xl\">\n                    Struggling with &#8216;E1&#8217; sensors or a choked evaporator? <strong>CoolAir</strong> units need technical handling, not just a basic wash. We provide same-day troubleshooting across Baroda with genuine backup parts.\n                </p>\n                <div class=\"flex flex-col sm:flex-row gap-4 justify-center md:justify-start\">\n                    <a href=\"tel:+919727257141\" class=\"gold-btn px-10 py-4 rounded-full font-black text-lg text-center flex items-center justify-center\">\n                        <i class=\"fas fa-phone-alt mr-2\"></i> Fix It Now\n                    </a>\n                    <a href=\"https://wa.me/919727257141\" class=\"dark-btn px-10 py-4 rounded-full font-bold text-lg text-center flex items-center justify-center hover:bg-slate-700 transition\" target=\"_blank\" rel=\"noopener\">\n                        <i class=\"fab fa-whatsapp mr-2 text-green-400\"></i> WhatsApp Quote\n                    </a>\n                </div>\n            </div>\n            <div class=\"relative\">\n                <img decoding=\"async\" class=\"rounded-3xl shadow-2xl w-full border-8 border-white\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/Atlas-Aircon-Vehicle-2.webp\" alt=\"CoolAir AC Repair Vadodara\" title=\"\">\n            </div>\n        </div>\n    </section>\n\n    <section class=\"py-20 px-6 bg-white\">\n        <div class=\"max-w-4xl mx-auto\">\n            <h2 class=\"text-3xl md:text-5xl font-black text-slate-900 mb-8 text-center\">Stop Ignoring the <span class=\"ca-gold-text\">&#8220;Puffing&#8221;</span> Noise</h2>\n            <p class=\"text-lg text-slate-600 mb-6 text-justify\">\n                CoolAir air conditioners are great value, but they are highly susceptible to coil-pitting in <strong>Vadodara&#8217;s</strong> salty groundwater atmosphere. If your AC makes a hissing sound or stops cooling every 2 months, a simple gas top-up is a waste of your money.\n            </p>\n            <p class=\"text-lg text-slate-600 text-justify\">\n                At <strong>Atlas Aircon</strong>, we perform a mandatory <strong>Nitrogen pressure test</strong> on every CoolAir unit. We find the microscopic leak in the condenser, weld it with high-grade silver, and then refill the gas. This technical approach is why we can offer a 3-month work guarantee where others fail.\n            </p>\n        </div>\n    </section>\n\n    <section class=\"py-16 px-6 bg-gray-50\">\n        <div class=\"max-w-7xl mx-auto grid md:grid-cols-3 gap-8\">\n            <div class=\"bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl transition-all\">\n                <div class=\"text-4xl mb-4 ca-gold-text\"><i class=\"fas fa-tools\"></i></div>\n                <h3 class=\"text-xl font-bold mb-2\">Error Code Rescue</h3>\n                <p class=\"text-slate-500 text-sm\">Facing E1, E6, or &#8216;CF&#8217;? Our team carries diagnostic meters to fix sensor errors on the first visit.</p>\n                <span class=\"mt-4 block font-bold ca-gold-text\">Starts @ ₹399</span>\n            </div>\n            <div class=\"bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl transition-all\">\n                <div class=\"text-4xl mb-4 ca-gold-text\"><i class=\"fas fa-shower\"></i></div>\n                <h3 class=\"text-xl font-bold mb-2\">High-Pressure Wash</h3>\n                <p class=\"text-slate-500 text-sm\">We use 120-bar jet pumps to clear the &#8220;Baroda Dust&#8221; that chokes your CoolAir machine&#8217;s efficiency.</p>\n                <span class=\"mt-4 block font-bold ca-gold-text\">Starts @ ₹999</span>\n            </div>\n            <div class=\"bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl transition-all\">\n                <div class=\"text-4xl mb-4 ca-gold-text\"><i class=\"fas fa-microchip\"></i></div>\n                <h3 class=\"text-xl font-bold mb-2\">Inverter Board Repair</h3>\n                <p class=\"text-slate-500 text-sm\">Board not firing? We do component-level soldering for CoolAir PCBs to save you from buying a new board.</p>\n                <span class=\"mt-4 block font-bold ca-gold-text\">Reliable Support</span>\n            </div>\n        </div>\n    </section>\n\n    <section class=\"py-16 bg-white px-6\">\n        <div class=\"max-w-4xl mx-auto\">\n            <h2 class=\"text-3xl font-black text-center mb-10\">Transparent <span class=\"ca-gold-text\">Tariff</span></h2>\n            <div class=\"bg-slate-900 rounded-3xl overflow-hidden shadow-2xl border border-slate-800\">\n                <div class=\"p-6 border-b border-slate-800 flex justify-between text-white hover:bg-slate-800 transition\">\n                    <span class=\"font-bold\">Split AC Installation</span> <span class=\"ca-gold-text font-black\">₹1500+</span>\n                </div>\n                <div class=\"p-6 border-b border-slate-800 flex justify-between text-white hover:bg-slate-800 transition\">\n                    <span class=\"font-bold\">Gas Charging (R32/R410)</span> <span class=\"ca-gold-text font-black\">₹2500+</span>\n                </div>\n                <div class=\"p-6 border-b border-slate-800 flex justify-between text-white hover:bg-slate-800 transition\">\n                    <span class=\"font-bold\">PCB Repair (Inverter)</span> <span class=\"ca-gold-text font-black\">₹1500+</span>\n                </div>\n                <div class=\"p-6 flex justify-between text-white hover:bg-slate-800 transition\">\n                    <span class=\"font-bold\">Visiting &#038; Inspection</span> <span class=\"ca-gold-text font-black\">₹299</span>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <section class=\"py-20 px-6 bg-gray-50 border-t border-gray-200\">\n        <div class=\"max-w-7xl mx-auto text-center\">\n            <h2 class=\"text-2xl font-black text-slate-800 mb-8 uppercase tracking-widest\">Active In Your Zone:</h2>\n            <div class=\"flex flex-wrap justify-center gap-3\">\n                <span class=\"px-5 py-2 bg-white rounded-lg text-xs font-black uppercase text-slate-600 border border-slate-200\">Alkapuri</span>\n                <span class=\"px-5 py-2 bg-white rounded-lg text-xs font-black uppercase text-slate-600 border border-slate-200\">Makarpura</span>\n                <span class=\"px-5 py-2 bg-white rounded-lg text-xs font-black uppercase text-slate-600 border border-slate-200\">Sayajigunj</span>\n                <span class=\"px-5 py-2 bg-white rounded-lg text-xs font-black uppercase text-slate-600 border border-slate-200\">Gotri</span>\n                <span class=\"px-5 py-2 bg-white rounded-lg text-xs font-black uppercase text-slate-600 border border-slate-200\">Karelibaug</span>\n            </div>\n        </div>\n    </section>\n\n    <section class=\"py-12 bg-yellow-50 px-6 border-t border-yellow-100\">\n        <div class=\"max-w-4xl mx-auto text-center text-sm text-slate-500\">\n            <strong>Disclaimer:</strong> Atlas Aircon is an independent third-party specialized service provider. We are not an official CoolAir service center. All trademarks are the property of their respective owners.\n        </div>\n    </section>\n\n</div>\n\n<div id=\"ca-popup-overlay\">\n    <div class=\"bg-white p-8 rounded-3xl shadow-2xl relative max-w-sm w-full mx-6\">\n        <button id=\"ca-popup-close\" class=\"absolute top-4 right-5 text-3xl text-gray-300 hover:text-gray-500\">&times;</button>\n        <div class=\"text-center\">\n            <h3 class=\"text-2xl font-black text-slate-900 mb-2\">Low Cooling in <span class=\"ca-gold-text\">CoolAir AC?</span></h3>\n            <p class=\"text-gray-500 text-sm mb-8\">Our technicians are currently active in Sayajigunj and Akota.</p>\n            <a href=\"https://wa.me/919727257141\" class=\"bg-green-500 text-white font-black py-4 px-6 rounded-2xl block w-full shadow-lg hover:bg-green-600 transition mb-4 uppercase tracking-tighter\" target=\"_blank\" rel=\"noopener\">\n                WhatsApp Dispatch\n            </a>\n            <a href=\"tel:+919727257141\" class=\"text-blue-600 font-bold text-sm hover:underline\">Or Call: +91 97272 57141</a>\n        </div>\n    </div>\n</div>\n\n<div id=\"ca-min-btn\" class=\"fixed bottom-6 right-6 w-14 h-14 bg-yellow-600 text-white rounded-full flex items-center justify-center shadow-2xl cursor-pointer z-[99999] hover:scale-110 transition transform\">\n    <i class=\"fas fa-comment-dots text-2xl\"></i>\n</div>\n\n<script>\n    // FAQ Toggle\n    document.querySelectorAll('.ca-wrapper-v2 details').forEach((el) => {\n        el.addEventListener('toggle', function() {\n            const content = this.querySelector('.faq-slide-box');\n            if (this.open) {\n                content.style.maxHeight = content.scrollHeight + \"px\";\n            } else {\n                content.style.maxHeight = \"0px\";\n            }\n        });\n    });\n\n    // Popup logic\n    const overlay = document.getElementById('ca-popup-overlay');\n    const minBtn = document.getElementById('ca-min-btn');\n    const closeBtn = document.getElementById('ca-popup-close');\n\n    const openCA = () => { overlay.classList.add('active'); minBtn.style.display = 'none'; };\n    const closeCA = () => { overlay.classList.remove('active'); minBtn.style.display = 'flex'; };\n\n    minBtn.addEventListener('click', openCA);\n    closeBtn.addEventListener('click', closeCA);\n\n    // Show after 45s\n    setTimeout(() => { if(!sessionStorage.getItem('ca-p')) { openCA(); sessionStorage.setItem('ca-p', '1'); } }, 45000);\n</script>\n\n\n",
