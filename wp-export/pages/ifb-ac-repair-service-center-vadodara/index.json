    "rendered": "\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"FAQPage\",\n      \"mainEntity\": [\n        { \"@type\": \"Question\", \"name\": \"What are your IFB AC installation charges in Vadodara?\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Our standard IFB AC installation charges in Vadodara for a split AC start from ₹1500 and for a window AC from ₹700.\" } },\n        { \"@type\": \"Question\", \"name\": \"How much does IFB AC gas filling cost?\", \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"IFB AC gas filling charges range from ₹2500 to ₹4500 depending on the refrigerant type (R32, R410A) and tonnage.\" } }\n      ]\n    }\n  ]\n}\n</script>\n\n<div class=\"scroll-smooth antialiased selection:bg-[#D4AF37] selection:text-white\" style=\"font-family: 'Inter', sans-serif;\">\n\n    <div class=\"pt-8\">\n        \n        <section class=\"bg-[linear-gradient(135deg,#ffffff_0%,#fdfbf7_40%,rgba(212,175,55,0.15)_100%)] relative overflow-hidden before:content-[''] before:absolute before:-top-1/2 before:-left-1/2 before:w-[200%] before:h-[200%] before:bg-[radial-gradient(circle,rgba(253,184,19,0.05)_0%,transparent_60%)] before:z-0 before:pointer-events-none min-h-[80vh] flex items-center rounded-3xl mb-12 border border-gray-100 shadow-sm\">\n            <div class=\"container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 py-12\">\n                <div class=\"grid lg:grid-cols-2 gap-12 items-center\">\n                    <div class=\"text-center lg:text-left space-y-8\">\n                        <div class=\"inline-flex items-center px-4 py-2 rounded-full bg-yellow-100/80 border border-yellow-200 text-yellow-800 font-semibold text-sm mb-4\">\n                            <i class=\"fas fa-star text-yellow-500 mr-2\"></i> Trusted Independent IFB AC Specialists in Vadodara\n                        </div>\n                        <h1 class=\"text-5xl md:text-6xl lg