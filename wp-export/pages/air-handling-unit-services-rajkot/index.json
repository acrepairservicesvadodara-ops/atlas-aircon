  "content": {
    "rendered": "<div class=\"atlas-purified-matrix\"><style>\n        :root {\n            --primary-blue: #0056b3;\n            --secondary-green: #28a745;\n            --accent-yellow: #ffc107;\n            --dark-black: #1a1a1a;\n        }\n        .hero-gradient {\n            background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('https://atlasaircons.com/wp-content/uploads/2025/09/air-handling-units.webp');\n            background-size: cover;\n            background-position: center;\n        }\n        .whatsapp-float {\n            position: fixed;\n            bottom: 20px;\n            right: 20px;\n            background-color: #25d366;\n            color: white;\n            padding: 15px;\n            border-radius: 50px;\n            z-index: 1000;\n            display: flex;\n            align-items: center;\n            box-shadow: 0 4px 10px rgba(0,0,0,0.3);\n        }\n        .section-padding { padding: 80px 0; }\n        .text-justify { text-align: justify; }\n        .bg-custom-green { background-color: var(--secondary-green); }\n        .bg-custom-blue { background-color: var(--primary-blue); }\n        .bg-custom-yellow { background-color: var(--accent-yellow); }\n    </style>\n<script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"Service\",\n      \"serviceType\": \"Air Handling Unit Services\",\n      \"provider\": {\n        \"@type\": \"LocalBusiness\",\n        \"name\": \"Atlas Aircon Rajkot\",\n        \"image\": \"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\",\n        \"address\": {\n          \"@type\": \"PostalAddress\",\n          \"streetAddress\": \"Metoda GIDC Area\",\n          \"addressLocality\": \"Rajkot\",\n          \"addressRegion\": \"Gujarat\",\n          \"postalCode\": \"360001\",\n          \"addressCountry\": \"IN\"\n        },\n        \"telephone\": \"+919727257141\",\n        \"priceRange\": \"₹₹\",\n        \"email\": \"atlasaircon1@gmail.com\"\n      },\n      \"areaServed\": {\n        \"@type\": \"AdministrativeArea\",\n        \"name\": \"Rajkot District\"\n      },\n      \"aggregateRating\": {\n        \"@type\": \"AggregateRating\",\n        \"ratingValue\": \"4.9\",\n        \"reviewCount\": \"1420\"\n      }\n    }\n    </script>\n\n\n    <!-- HEADER MENU -->\n    <header class=\"bg-white shadow-md sticky top-0 z-50\">\n        <nav class=\"container mx-auto px-4 py-3 flex justify-between items-center\">\n            <a href=\"/home\">\n                <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\" alt=\"Atlas Aircon Logo\" class=\"h-12\" title=\"\">\n            </a>\n            <div class=\"hidden lg:flex space-x-4 text-[10px] font-bold uppercase overflow-x-auto\">\n                <a href=\"/home\" class=\"hover:text-blue-600\">Home</a>\n                <a href=\"/shop\" class=\"hover:text-blue-600\">Shop</a>\n                <a href=\"/ac-service-vadodara\" class=\"hover:text-blue-600\">AC Service</a>\n                <a href=\"/chiller-repair-services-vadodara\" class=\"hover:text-blue-600\">Chiller</a>\n                <a href=\"/hvac-repair-services-vadodara\" class=\"hover:text-blue-600\">HVAC</a>\n                <a href=\"/air-handling-unit-services-vadodara\" class=\"hover:text-blue-600\">AHU</a>\n                <a href=\"/locations\" class=\"hover:text-blue-600\">Locations</a>\n                <a href=\"/contact-us\" class=\"hover:text-blue-600\">Contact</a>\n            </div>\n            <button class=\"lg:hidden text-2xl\"><i class=\"fas fa-bars\"></i></button>\n        </nav>\n    </header>\n\n    <!-- HERO BANNER -->\n    <section class=\"hero-gradient h-[600px] flex items-center text-white relative\">\n        <div class=\"container mx-auto px-4\">\n            <h1 class=\"text-4xl md:text-6xl font-extrabold mb-4 leading-tight\">\n                Premium <span class=\"text-yellow-400\">Air Handling Unit services Rajkot</span>\n            </h1>\n            <p class=\"text-xl md:text-2xl mb-8 max-w-2xl\">\n                Atlas Aircon provides industrial-grade <b>AHU repair, maintenance, and AMC services</b> for Rajkot&#8217;s massive engineering, auto-parts, and forging clusters. Reliable cooling for the heart of Saurashtra.\n            </p>\n            <div class=\"flex flex-wrap gap-4\">\n                <a href=\"https://wa.me/919727257141\" class=\"bg-[#25d366] hover:bg-green-600 text-white px-8 py-4 rounded-full font-bold flex items-center transition\" target=\"_blank\" rel=\"noopener\">\n                    <i class=\"fab fa-whatsapp mr-2 text-2xl\"></i> Chat on WhatsApp\n                </a>\n                <a href=\"tel:+919727257141\" class=\"bg-blue-600 hover:bg-blue-700 text-white px-8 py-4 rounded-full font-bold transition\">\n                    Call: +91 97272 57141\n                </a>\n            </div>\n        </div>\n    </section>\n\n    <!-- INTRODUCTION SECTION -->\n    <section class=\"section-padding bg-gray-50\">\n        <div class=\"container mx-auto px-4\">\n            <div class=\"grid md:grid-cols-2 gap-12 items-center\">\n                <div class=\"text-justify\">\n                    <h2 class=\"text-3xl font-bold mb-6\">Expert <span class=\"text-blue-700\">Air Handling Unit services Rajkot</span> for Industrial Precision</h2>\n                    <p class=\"mb-4 text-lg leading-relaxed\">\n                        Rajkot is the beating heart of Gujarat&#8217;s engineering sector. Maintaining heavy-duty climate control systems is crucial for high-precision manufacturing. Atlas Aircon provides top-tier <b>Air Handling Unit services Rajkot</b> designed to meet the rigorous demands of forging units, CNC machining centers, and automotive assembly lines. Whether you are located in <b>Metoda GIDC</b> or <b>Shapar-Veraval</b>, our technical team ensures your industrial air quality is never compromised.\n                    </p>\n                    <p class=\"mb-6\">\n                        An Air Handling Unit (AHU) in an engineering environment must manage high heat loads and fine metallic dust. Our <b>Air Handling Unit services Rajkot</b> focus on deep-cycle maintenance to protect your expensive machinery and workforce. We specialize in <b>Double Skin AHUs</b> for cleanroom standards and <b>Single Skin AHUs</b> for large factory floor ventilation. Our services cover <b>coil cleaning</b>, <b>blower fan balancing</b>, and <b>VFD integration</b> to optimize power consumption across your facility.\n                    </p>\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/09/ahu-manufacturers-in-vadodara.webp\" alt=\"Air Handling Unit services Rajkot\" class=\"rounded-lg shadow-xl mb-6 w-full\" title=\"\">\n                </div>\n                <div class=\"bg-white p-8 rounded-2xl shadow-lg border-t-4 border-blue-600\">\n                    <h3 class=\"text-2xl font-bold mb-4\">Why Rajkot Industries Choose Us?</h3>\n                    <ul class=\"space-y-4\">\n                        <li class=\"flex items-start\">\n                            <i class=\"fas fa-check-circle text-green-500 mt-1 mr-3\"></i>\n                            <span><b>Engineering Hub Expertise:</b> We understand the specific cooling needs of auto-parts and forging plants.</span>\n                        </li>\n                        <li class=\"flex items-start\">\n                            <i class=\"fas fa-check-circle text-green-500 mt-1 mr-3\"></i>\n                            <span><b>Fast GIDC Response:</b> Dedicated teams for <b>Metoda</b>, <b>Shapar</b>, <b>Aji</b>, and <b>Kuwadva</b> industrial zones.</span>\n                        </li>\n                        <li class=\"flex items-start\">\n                            <i class=\"fas fa-check-circle text-green-500 mt-1 mr-3\"></i>\n                            <span><b>Custom Filtration:</b> Multi-stage filters to trap fine metal particles and industrial fumes.</span>\n                        </li>\n                        <li class=\"flex items-start\">\n                            <i class=\"fas fa-check-circle text-green-500 mt-1 mr-3\"></i>\n                            <span><b>Ready Spares:</b> Immediate availability of <b>AHU motors</b>, <b>fan belts</b>, and <b>actuators</b> in Rajkot.</span>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- BRANDS WE REPAIR -->\n    <section class=\"section-padding bg-white\">\n        <div class=\"container mx-auto px-4 text-center\">\n            <h2 class=\"text-3xl font-bold mb-4\">Leading Brands We Service in Rajkot</h2>\n            <p class=\"mb-10 text-gray-600\">We offer specialized repair and AMC for all global and national AHU brands available in the Rajkot market.</p>\n            <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-8 items-center opacity-80\">\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Blue Star</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Daikin</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Carrier</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>York</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Zeco</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Edgetech</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Citizen</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Trane</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Voltas</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Hitachi</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>Mitsubishi</b></div>\n                <div class=\"p-4 border rounded hover:shadow-md transition\"><b>LG</b></div>\n            </div>\n        </div>\n    </section>\n\n    <!-- TYPES WE REPAIR -->\n    <section class=\"section-padding bg-gray-900 text-white\">\n        <div class=\"container mx-auto px-4\">\n            <h2 class=\"text-3xl font-bold mb-12 text-center\">Types of AHU We Service in Rajkot</h2>\n            <div class=\"grid md:grid-cols-3 gap-8\">\n                <div class=\"bg-gray-800 p-6 rounded-xl border-l-4 border-yellow-500\">\n                    <h3 class=\"text-xl font-bold mb-3\">Double Skin Industrial AHUs</h3>\n                    <p class=\"text-gray-400 mb-4\">Used in high-precision labs and office blocks in Metoda. We ensure thermal break integrity and maximum insulation.</p>\n                    <a href=\"/central-ac-repair-services-vadodara\" class=\"text-yellow-500 font-bold\">Industrial AC &rarr;</a>\n                </div>\n                <div class=\"bg-gray-800 p-6 rounded-xl border-l-4 border-green-500\">\n                    <h3 class=\"text-xl font-bold mb-3\">Heavy-Duty Single Skin AHUs</h3>\n                    <p class=\"text-gray-400 mb-4\">Designed for massive ventilation in forging units. We handle high-static fan repairs and motor rewinding.</p>\n                    <a href=\"/hvac-repair-services-vadodara\" class=\"text-green-500 font-bold\">HVAC Solutions &rarr;</a>\n                </div>\n                <div class=\"bg-gray-800 p-6 rounded-xl border-l-4 border-blue-500\">\n                    <h3 class=\"text-xl font-bold mb-3\">Ceiling Suspended AHUs</h3>\n                    <p class=\"text-gray-400 mb-4\">Space-saving solutions for Rajkot showrooms and commercial spaces. Expert in drain line clearing and noise reduction.</p>\n                    <a href=\"/ac-service-vadodara\" class=\"text-blue-500 font-bold\">Commercial Service &rarr;</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- INDUSTRIAL FOCUS SECTION (Rajkot Specific) -->\n    <section class=\"section-padding bg-yellow-50\">\n        <div class=\"container mx-auto px-4\">\n            <h2 class=\"text-3xl font-bold mb-8 text-center text-gray-900\">Dedicated Service for Rajkot Industrial GIDCs &#038; Parks</h2>\n            <div class=\"bg-white p-8 rounded-3xl shadow-lg\">\n                <p class=\"mb-6 text-lg text-justify\">\n                    Rajkot’s industrial zones are the engine of Saurashtra’s economy. Atlas Aircon provides custom-tailored <b>Air Handling Unit services Rajkot</b> that align with the maintenance schedules of auto-component manufacturers and machine tool builders. We provide on-site support to minimize downtime and ensure your process cooling remains consistent 24/7.\n                </p>\n                <div class=\"grid md:grid-cols-2 gap-8\">\n                    <div>\n                        <h4 class=\"font-bold text-xl mb-4 text-blue-800\"><i class=\"fas fa-industry mr-2\"></i> Major Industrial Hubs</h4>\n                        <div class=\"flex flex-wrap gap-2\">\n                            <span class=\"bg-gray-100 px-3 py-1 rounded-full text-sm\">Metoda GIDC</span>\n                            <span class=\"bg-gray-100 px-3 py-1 rounded-full text-sm\">Shapar-Veraval GIDC</span>\n                            <span class=\"bg-gray-100 px-3 py-1 rounded-full text-sm\">Aji Industrial Estate</span>\n                            <span class=\"bg-gray-100 px-3 py-1 rounded-full text-sm\">Kuwadva GIDC</span>\n                            <span class=\"bg-gray-100 px-3 py-1 rounded-full text-sm\">Hadamtala GIDC</span>\n                            <span class=\"bg-gray-100 px-3 py-1 rounded-full text-sm\">Bhakti Nagar Industrial Area</span>\n                            <span class=\"bg-gray-100 px-3 py-1 rounded-full text-sm\">Lodhika Industrial Zone</span>\n                        </div>\n                    </div>\n                    <div>\n                        <h4 class=\"font-bold text-xl mb-4 text-green-800\"><i class=\"fas fa-map-marker-alt mr-2\"></i> Rajkot Residential &#038; Commercial Areas</h4>\n                        <ul class=\"grid grid-cols-2 gap-2 text-sm\">\n                            <li>Kalavad Road</li>\n                            <li>University Road</li>\n                            <li>Yagnik Road</li>\n                            <li>Amin Marg</li>\n                            <li>Nana Mava</li>\n                            <li>Raiya Road</li>\n                            <li>Bhakti Nagar</li>\n                            <li>Mavdi Area</li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- PRICE TABLE -->\n    <section class=\"section-padding bg-white\">\n        <div class=\"container mx-auto px-4\">\n            <h2 class=\"text-3xl font-bold mb-8 text-center\">AHU Spare Parts &#038; Service Price List (Rajkot District)</h2>\n            <div class=\"overflow-x-auto\">\n                <table class=\"w-full text-left border-collapse\">\n                    <thead>\n                        <tr class=\"bg-blue-600 text-white uppercase text-sm\">\n                            <th class=\"p-4 border\">AHU Maintenance Item / Service</th>\n                            <th class=\"p-4 border\">Approximate Cost</th>\n                            <th class=\"p-4 border\">Action</th>\n                        </tr>\n                    </thead>\n                    <tbody class=\"text-gray-700\">\n                        <tr class=\"hover:bg-gray-50\">\n                            <td class=\"p-4 border\"><b>Annual Maintenance Contract (AMC)</b></td>\n                            <td class=\"p-4 border\">₹ 9,000 &#8211; 30,000+</td>\n                            <td class=\"p-4 border\"><a href=\"tel:+919727257141\" class=\"text-blue-600 font-bold underline\">Get Quote</a></td>\n                        </tr>\n                        <tr class=\"hover:bg-gray-50 bg-gray-50\">\n                            <td class=\"p-4 border\"><b>Filter Replacement</b> (Standard/High Efficiency)</td>\n                            <td class=\"p-4 border\">₹ 1,500 &#8211; 5,000</td>\n                            <td class=\"p-4 border\"><a href=\"/shop\" class=\"text-blue-600 font-bold underline\">Shop Now</a></td>\n                        </tr>\n                        <tr class=\"hover:bg-gray-50\">\n                            <td class=\"p-4 border\"><b>AHU Coil Restoration &#038; Cleaning</b></td>\n                            <td class=\"p-4 border\">₹ 3,000 &#8211; 10,000</td>\n                            <td class=\"p-4 border\"><a href=\"tel:+919727257141\" class=\"text-blue-600 font-bold underline\">Book Service</a></td>\n                        </tr>\n                        <tr class=\"hover:bg-gray-50 bg-gray-50\">\n                            <td class=\"p-4 border\"><b>Fan Motor Repair / Bearing Service</b></td>\n                            <td class=\"p-4 border\">₹ 4,500 &#8211; 12,000</td>\n                            <td class=\"p-4 border\"><a href=\"/fan-motor\" class=\"text-blue-600 font-bold underline\">Order Spares</a></td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n            <p class=\"text-xs text-gray-400 mt-4 italic text-center\">* Pricing varies based on unit CFM capacity and distance from Rajkot main city.</p>\n        </div>\n    </section>\n\n    <!-- PROS AND CONS -->\n    <section class=\"section-padding bg-gray-50\">\n        <div class=\"container mx-auto px-4\">\n            <h2 class=\"text-3xl font-bold mb-10 text-center\">Pros and Cons of Professional AHU Maintenance</h2>\n            <div class=\"grid md:grid-cols-2 gap-10\">\n                <div class=\"bg-green-50 p-8 rounded-2xl shadow-sm border-l-8 border-green-500\">\n                    <h3 class=\"text-2xl font-bold mb-4 text-green-800\">Advantages (Pros)</h3>\n                    <ul class=\"space-y-3\">\n                        <li><i class=\"fas fa-plus-circle text-green-500 mr-2\"></i> <b>Peak Machine Performance:</b> Prevents precision tools from overheating.</li>\n                        <li><i class=\"fas fa-plus-circle text-green-500 mr-2\"></i> <b>Reduced Power Consumption:</b> Clean filters save up to 25% on industrial electricity bills.</li>\n                        <li><i class=\"fas fa-plus-circle text-green-500 mr-2\"></i> <b>Superior Air Quality:</b> Removes metal dust and welding fumes from the factory floor.</li>\n                        <li><i class=\"fas fa-plus-circle text-green-500 mr-2\"></i> <b>Extended Blower Life:</b> Regular bearing greasing prevents catastrophic motor failure.</li>\n                        <li><i class=\"fas fa-plus-circle text-green-500 mr-2\"></i> <b>Silent Factory Environment:</b> Dynamic balancing eliminates loud AHU vibrations.</li>\n                        <li><i class=\"fas fa-plus-circle text-green-500 mr-2\"></i> <b>Stable Temperature Control:</b> Essential for sensitive measuring equipment in labs.</li>\n                        <li><i class=\"fas fa-plus-circle text-green-500 mr-2\"></i> <b>AMC Reliability:</b> Peace of mind with scheduled visits and emergency breakdown cover.</li>\n                    </ul>\n                </div>\n                <div class=\"bg-red-50 p-8 rounded-2xl shadow-sm border-l-8 border-red-500\">\n                    <h3 class=\"text-2xl font-bold mb-4 text-red-800\">Risks of Neglect (Cons)</h3>\n                    <ul class=\"space-y-3\">\n                        <li><i class=\"fas fa-minus-circle text-red-500 mr-2\"></i> <b>Sudden Plant Shutdown:</b> AHU failure can halt entire production lines.</li>\n                        <li><i class=\"fas fa-minus-circle text-red-500 mr-2\"></i> <b>Corrosive Damage:</b> Industrial pollutants in Rajkot air can eat through unmaintained coils.</li>\n                        <li><i class=\"fas fa-minus-circle text-red-500 mr-2\"></i> <b>Health Hazards:</b> Dusty AHUs circulate allergens, affecting worker productivity.</li>\n                        <li><i class=\"fas fa-minus-circle text-red-500 mr-2\"></i> <b>Inflated Energy Bills:</b> Clogged systems draw significantly more kVA from the grid.</li>\n                        <li><i class=\"fas fa-minus-circle text-red-500 mr-2\"></i> <b>Mold Growth:</b> Stagnant water in drain pans causes bad odors in offices.</li>\n                        <li><i class=\"fas fa-minus-circle text-red-500 mr-2\"></i> <b>High Component Cost:</b> Replacing a burnt-out motor is much pricier than a service.</li>\n                        <li><i class=\"fas fa-minus-circle text-red-500 mr-2\"></i> <b>Warranty Void:</b> Lack of professional service records voids manufacturer support.</li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- ERROR CODES -->\n    <section class=\"section-padding bg-white\">\n        <div class=\"container mx-auto px-4\">\n            <h2 class=\"text-3xl font-bold mb-8 text-center\">Common Industrial AHU Error Codes &#038; Solutions</h2>\n            <div class=\"grid md:grid-cols-2 lg:grid-cols-4 gap-4\">\n                <div class=\"p-6 border rounded hover:border-blue-500 transition shadow-sm\">\n                    <h4 class=\"font-bold text-red-600 mb-2\">E1: High Static Pressure</h4>\n                    <p class=\"text-xs\"><b>Solution:</b> Replace clogged primary/fine filters immediately. Check damper positions.</p>\n                </div>\n                <div class=\"p-6 border rounded hover:border-blue-500 transition shadow-sm\">\n                    <h4 class=\"font-bold text-red-600 mb-2\">E5: Motor Thermal Trip</h4>\n                    <p class=\"text-xs\"><b>Solution:</b> Inspect motor bearings for friction. Verify electrical phase balance.</p>\n                </div>\n                <div class=\"p-6 border rounded hover:border-blue-500 transition shadow-sm\">\n                    <h4 class=\"font-bold text-red-600 mb-2\">E8: Drain Overflow</h4>\n                    <p class=\"text-xs\"><b>Solution:</b> Clear sludge from the condensate drain pan. Flush the entire drain line.</p>\n                </div>\n                <div class=\"p-6 border rounded hover:border-blue-500 transition shadow-sm\">\n                    <h4 class=\"font-bold text-red-600 mb-2\">L2: VFD Communication Failure</h4>\n                    <p class=\"text-xs\"><b>Solution:</b> Check control wiring. Reset the Variable Frequency Drive controller.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- FAQS -->\n    <section class=\"section-padding bg-gray-50\">\n        <div class=\"container mx-auto px-4 max-w-4xl\">\n            <h2 class=\"text-3xl font-bold mb-10 text-center\">Rajkot AHU Service FAQs</h2>\n            <div class=\"space-y-6\">\n                <div class=\"bg-white p-6 rounded-xl shadow-sm\">\n                    <h4 class=\"font-bold text-lg mb-2\">1. Do you provide AHU services in Metoda GIDC?</h4>\n                    <p class=\"text-gray-600\">Yes, Metoda GIDC is one of our primary service hubs. we provide same-day inspection and breakdown support for all industrial units there.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl shadow-sm\">\n                    <h4 class=\"font-bold text-lg mb-2\">2. How often should industrial AHUs be serviced in Rajkot?</h4>\n                    <p class=\"text-gray-600\">Due to the high dust levels in engineering zones like Shapar, we recommend a general check-up every month and deep chemical cleaning quarterly.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl shadow-sm\">\n                    <h4 class=\"font-bold text-lg mb-2\">3. Can you repair large 50,000 CFM AHU units?</h4>\n                    <p class=\"text-gray-600\">Absolutely. Atlas Aircon has the technical equipment and manpower to service and repair ultra-large industrial Air Handling Units.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl shadow-sm\">\n                    <h4 class=\"font-bold text-lg mb-2\">4. Do you supply genuine AHU spare parts in Rajkot?</h4>\n                    <p class=\"text-gray-600\">Yes, we maintain a stock of genuine fan motors, pulleys, V-belts, and filtration systems for all major brands in our Rajkot warehouse.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl shadow-sm\">\n                    <h4 class=\"font-bold text-lg mb-2\">5. Why is my AHU leaking water into the plant?</h4>\n                    <p class=\"text-gray-600\">This is usually due to a blocked condensate drain or an incorrectly leveled drain pan. Our technicians can fix this within a few hours.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl shadow-sm\">\n                    <h4 class=\"font-bold text-lg mb-2\">6. Can AHU maintenance help pass industrial quality audits?</h4>\n                    <p class=\"text-gray-600\">Yes. Properly maintained AHUs ensure consistent indoor air quality (IAQ) and temperature, which are critical for many ISO and safety audits.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl shadow-sm\">\n                    <h4 class=\"font-bold text-lg mb-2\">7. Do you offer 24/7 breakdown support?</h4>\n                    <p class=\"text-gray-600\">We offer priority 24/7 breakdown support to our AMC clients in Rajkot to ensure their production lines never stop.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl shadow-sm\">\n                    <h4 class=\"font-bold text-lg mb-2\">8. Can you handle VFD programming for AHUs?</h4>\n                    <p class=\"text-gray-600\">Yes, our electrical experts can program and optimize Variable Frequency Drives to maximize the energy efficiency of your AHU motors.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl shadow-sm\">\n                    <h4 class=\"font-bold text-lg mb-2\">9. What areas in Rajkot do you cover?</h4>\n                    <p class=\"text-gray-600\">We cover the entire Rajkot city including Kalavad Road, University Road, and all peripheral GIDC areas like Hadamtala and Kuwadva.</p>\n                </div>\n                <div class=\"bg-white p-6 rounded-xl shadow-sm\">\n                    <h4 class=\"font-bold text-lg mb-2\">10. How can I get an AMC quote for my factory?</h4>\n                    <p class=\"text-gray-600\">Call +91 97272 57141 or contact us on WhatsApp. We provide a free site audit before submitting a customized AMC proposal.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- AREAS SERVED LIST -->\n    <section class=\"section-padding bg-white border-t\">\n        <div class=\"container mx-auto px-4\">\n            <h2 class=\"text-2xl font-bold mb-6\">Service Presence Across Rajkot District</h2>\n            <div class=\"text-sm text-gray-500 leading-relaxed overflow-y-auto max-h-40 p-4 bg-gray-50 rounded\">\n                Rajkot City | Kalavad Road | University Road | Yagnik Road | Amin Marg | Kotecha Chowk | Nana Mava | Mavdi | Raiya Road | Bhakti Nagar | Mavdi Plot | Metoda GIDC | Shapar-Veraval GIDC | Aji Industrial Estate | Kuwadva GIDC | Hadamtala GIDC | Gondal Road | 150 Feet Ring Road | Madhapar | Kothariya | Tankara | Jetpur | Gondal.\n            </div>\n        </div>\n    </section>\n\n    <!-- FOOTER -->\n    <footer class=\"bg-gray-900 text-white section-padding\">\n        <div class=\"container mx-auto px-4 grid md:grid-cols-4 gap-12\">\n            <div>\n                <img dec