/span> this summer season.\n            </p>\n        </section>\n\n        <!-- PRICING TABLE: STATE-WIDE -->\n        <section>\n            <div class=\"flex flex-col items-center gap-4 mb-12\">\n                <div class=\"bg-orange-500 p-4 rounded-full shadow-xl\">\n                    <svg class=\"w-10 h-10 text-white\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z\"></path></svg>\n                </div>\n                <h2 class=\"text-4xl font-black text-blue-900 uppercase text-center\">Gujarat Service Rates &#038; Spare Parts</h2>\n            </div>\n            \n            <div class=\"overflow-x-auto rounded-[2rem] border border-gray-200 shadow-2xl bg-white\">\n                <table class=\"w-full text-left\">\n                    <thead class=\"bg-gray-900 text-white uppercase text-sm font-black\">\n                        <tr>\n                            <th class=\"p-8\">Component / Service</th>\n                            <th class=\"p-8\">Technical Utility</th>\n                            <th class=\"p-8\">Price (INR)</th>\n                            <th class=\"p-8\">Shop Link</th>\n                        </tr>\n                    </thead>\n                    <tbody class=\"divide-y text-base font-semibold\">\n                        <tr class=\"hover:bg-gray-50 transition\">\n                            <td class=\"p-8 text-blue-900 uppercase\">State-Wide Service Visit</td>\n                            <td class=\"p-8 text-gray-500 italic\">Multi-point inspection and cleaning</td>\n                            <td class=\"p-8 highlight-orange\">₹150</td>\n                            <td class=\"p-8\"><a href=\"/ac-repair-service-price-list-air-conditioner-repair-service-cost-