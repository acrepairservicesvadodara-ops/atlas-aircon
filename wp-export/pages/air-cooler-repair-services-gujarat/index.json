text-xs border-b pb-2\">Contact Us</a>\n            </div>\n        </div>\n    </header>\n\n    <script>function toggleMobileMenu() { document.getElementById('mobileMenu').classList.toggle('active'); }</script>\n\n    <!-- Hero Banner -->\n    <section class=\"hero-section text-white py-20 lg:py-40 px-4 text-center\">\n        <div class=\"max-w-7xl mx-auto space-y-8\">\n            <h1 class=\"text-5xl lg:text-8xl font-extrabold leading-tight\">\n                Gujarat&#8217;s #1 <br><span class=\"highlight-gold lowercase\">air cooler repair services gujarat</span>\n            </h1>\n            <p class=\"text-xl opacity-90 max-w-3xl mx-auto\">\n                Providing specialized <span class=\"highlight-orange\">air cooler repair services gujarat</span> across every district. From household desert coolers to massive industrial GIDC evaporative systems, Atlas Aircon ensures 100% cooling efficiency.\n            </p>\n            <div class=\"flex flex-wrap justify-center gap-4\">\n                <a href=\"https://wa.me/919727257141\" class=\"bg-green-500 hover:bg-green-600 text-white px-10 py-5 rounded-full font-black shadow-2xl uppercase tracking-widest text-xs transition-all transform hover:scale-105\" target=\"_blank\" rel=\"noopener\">\n                    WhatsApp State Support\n                </a>\n            </div>\n            <div class=\"pt-10 flex justify-center gap-12 text-center opacity-80\">\n                <div><p class=\"text-4xl font-bold highlight-gold\">25+</p><p class=\"text-[10px] uppercase font-bold\">Cities Covered</p></div>\n                <div><p class=\"text-4xl font-bold highlight-gold\">50+</p><p class=\"text-[10px] uppercase font-bold\">GIDC Zones</p></div>\n                <div><p class=\"text-4xl font-bold highlight-gold\">24/7</p><p class=\"text-[10px] uppercase font-bold\">On-Site Service</p></div>\n            </div>\n        </div>\n    </section>\n\n    <main class=\"max-w-7xl mx-auto px-4 py-24 space-y-32\">\n\n      