  "content": {
    "rendered": "<div class=\"atlas-purified-matrix\"><style>\n        body { font-family: 'Inter', sans-serif; }\n        .chart-container {\n            position: relative;\n            width: 100%;\n            max-width: 450px;\n            margin: auto;\n            height: 400px;\n        }\n        .custom-scroll::-webkit-scrollbar { width: 4px; }\n        .custom-scroll::-webkit-scrollbar-track { background: #f1f5f9; }\n        .custom-scroll::-webkit-scrollbar-thumb { background: #0891B2; border-radius: 10px; }\n        .fade-in { animation: fadeIn 0.6s ease-out; }\n        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }\n        .matrix-btn-active { background-color: #0891B2; color: white; border-color: #0891B2; box-shadow: 0 10px 15px -3px rgba(8, 145, 178, 0.3); }\n    </style>\n<script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n<script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"LocalBusiness\",\n      \"name\": \"Atlas Aircon Surat\",\n      \"image\": \"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\",\n      \"@id\": \"https://atlasaircons.com/surat\",\n      \"url\": \"https://atlasaircons.com/surat\",\n      \"telephone\": \"+91 97272 57141\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"addressLocality\": \"Surat\",\n        \"addressRegion\": \"Gujarat\",\n        \"postalCode\": \"395001\",\n        \"addressCountry\": \"IN\"\n      }\n    }\n    </script>\n<script>\n        const residential = [\n            \"Adajan\", \"Vesu\", \"Piplod\", \"City Light\", \"Pal\", \"New City Light\", \"Bharthana\", \"Althan\", \"Bhatar\", \"Majura Gate\", \n            \"Ghod Dod Road\", \"Ring Road\", \"Athwalines\", \"Parle Point\", \"Vip Road\", \"Amroli\", \"Katargam\", \"Varachha\", \"Mota Varachha\", \n            \"Punagam\", \"Dindoli\", \"Udhna\", \"Limbayat\", \"Nanpura\", \"Chowk Bazar\", \"Rander\", \"Olpad Road\", \"Dumas Road\", \"Sultanabad\",\n            \"Mughalsarai\", \"Sagrampura\", \"Begampura\", \"Gopipura\", \"Sayedpura\", \"Rustampura\"\n        ];\n        \n        const industrial = [\n            \"Sachin GIDC\", \"Hazira Industrial Belt\", \"Pandesara GIDC\", \"Ichchhapore Industrial Estate\", \"Diamond Research & Mercantile (DREAM) City\",\n            \"Diamond Bourse Hub\", \"Katargam Diamond Clusters\", \"Varachha Textile Hub\", \"Udhna Industrial Estate\", \"Khatodra GIDC\",\n            \"Hojiwala Industrial Estate\", \"Surat SEZ Zone\", \"Sarsana Exhibition Center Area\", \"Magdalla Port Industrial\"\n        ];\n        \n        const allAreas = [...residential, ...industrial];\n\n        const matrixData = {\n            residential: `\n                <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                    <a href=\"/split-ac-service-surat\" class=\"p-6 bg-cyan-600 text-white rounded-3xl h-48 flex flex-col justify-between shadow-lg\">\n                        <i class=\"fas fa-snowflake text-2xl\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">Luxury Split AC Care</span>\n                    </a>\n                    <a href=\"/cassette-ac-service-surat\" class=\"p-6 bg-white border-2 border-cyan-100 rounded-3xl h-48 flex flex-col justify-between\">\n                        <i class=\"fas fa-th-large text-2xl text-indigo-600\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">Cassette AC Portals</span>\n                    </a>\n                    <a href=\"/ac-gas-charging-surat\" class=\"p-6 bg-indigo-600 text-white rounded-3xl h-48 flex flex-col justify-between shadow-lg\">\n                        <i class=\"fas fa-gas-pump text-2xl\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">R32 & R410 Refilling</span>\n                    </a>\n                </div>\n            `,\n            industrial: `\n                <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                    <a href=\"/chiller-repair-surat\" class=\"p-6 bg-slate-900 text-white rounded-3xl h-48 flex flex-col justify-between\">\n                        <i class=\"fas fa-industry text-2xl text-cyan-400\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">Industrial Chillers</span>\n                    </a>\n                    <a href=\"/panel-ac-repair-surat\" class=\"p-6 bg-white border-2 border-indigo-100 rounded-3xl h-48 flex flex-col justify-between\">\n                        <i class=\"fas fa-server text-2xl text-indigo-600\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">Panel AC Repair</span>\n                    </a>\n                    <a href=\"/textile-hvac-amc-surat\" class=\"p-6 bg-cyan-600 text-white rounded-3xl h-48 flex flex-col justify-between\">\n                        <i class=\"fas fa-shirt text-2xl\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">Textile Mill AMC</span>\n                    </a>\n                </div>\n            `,\n            brands: `\n                <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3\">\n                    <a href=\"/blue-star-ac-service-surat\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-cyan-600 hover:text-white transition shadow-sm border border-slate-100\">Blue Star</a>\n                    <a href=\"/daikin-ac-service-surat\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-cyan-600 hover:text-white transition shadow-sm border border-slate-100\">Daikin Center</a>\n                    <a href=\"/lg-ac-service-surat\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-cyan-600 hover:text-white transition shadow-sm border border-slate-100\">LG Support</a>\n                    <a href=\"/voltas-ac-service-surat\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-cyan-600 hover:text-white transition shadow-sm border border-slate-100\">Voltas Center</a>\n                    <a href=\"/samsung-ac-service-surat\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-cyan-600 hover:text-white transition shadow-sm border border-slate-100\">Samsung</a>\n                    <a href=\"/mitsubishi-ac-service-surat\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-cyan-600 hover:text-white transition shadow-sm border border-slate-100\">Mitsubishi</a>\n                </div>\n            `\n        };\n\n        function updateMatrix(key) {\n            document.getElementById('matrix-content').innerHTML = matrixData[key];\n            document.querySelectorAll('#matrix button').forEach(btn => btn.classList.remove('matrix-btn-active'));\n            document.getElementById('m-' + key).classList.add('matrix-btn-active');\n        }\n\n        function renderAreas(list) {\n            const grid = document.getElementById('areaGrid');\n            grid.innerHTML = '';\n            list.forEach(area => {\n                const div = document.createElement('div');\n                div.className = \"bg-white/5 p-3 rounded-xl border border-indigo-700 hover:bg-cyan-600/20 transition cursor-default text-center text-indigo-100\";\n                div.textContent = area;\n                grid.appendChild(div);\n            });\n        }\n\n        function filterAreas() {\n            const query = document.getElementById('areaSearch').value.toLowerCase();\n            const filtered = allAreas.filter(a => a.toLowerCase().includes(query));\n            renderAreas(filtered);\n        }\n\n        function solveError() {\n            const code = document.getElementById('errorSelect').value;\n            const hub = document.getElementById('solutionResult');\n            const issue = document.getElementById('issueText');\n            const solution = document.getElementById('solutionText');\n\n            const errors = {\n                \"E1\": [\"Sensor Fault (Salt Erosion)\", \"Coastal humidity causing resistance bridge in thermistor; sensor replacement and epoxy sealing required.\"],\n                \"E4\": [\"Motor Fail (Fiber Clog)\", \"Textile micro-fibers jam in motor bearing; high-pressure chemical wash and lubrication needed.\"],\n                \"F1\": [\"Phase Error (Grid Volatility)\", \"Power surge in Sachin GIDC grid damaged the IPM module; component-level card repair required.\"],\n                \"C6\": [\"Comm Loss (L-N-S Leakage)\", \"Moisture in signal cables causing communication dropout; weather-shielded cable replacement.\"],\n                \"P4\": [\"IPM Overheat (Diamond Dust)\", \"Diamond polishing dust blocking heat sink; descaling and thermal paste reapplication.\"],\n                \"EC\": [\"Refrigerant Leak (Pinhole Leak)\", \"Copper oxidation due to Dumas sea breeze; nitrogen pressure test and silver-brazing required.\"]\n            };\n\n            if (errors[code]) {\n                hub.classList.remove('hidden');\n                issue.textContent = errors[code][0];\n                solution.textContent = errors[code][1];\n            } else {\n                hub.classList.add('hidden');\n            }\n        }\n\n        function initChart() {\n            const ctx = document.getElementById('priceChart').getContext('2d');\n            new Chart(ctx, {\n                type: 'doughnut',\n                data: {\n                    labels: ['Repair Labor', 'Refrigerant', 'Eco-Cleaning', 'Spare Parts', 'PCB Repair'],\n                    datasets: [{\n                        data: [25, 30, 15, 10, 20],\n                        backgroundColor: [\n                            '#0891B2',\n                            '#4F46E5',\n                            '#06B6D4',\n                            '#6366F1',\n                            '#1E293B'\n                        ],\n                        borderWidth: 0,\n                        hoverOffset: 15\n                    }]\n                },\n                options: {\n                    responsive: true,\n                    maintainAspectRatio: false,\n                    plugins: {\n                        legend: { position: 'bottom', labels: { font: { size: 10, weight: 'bold' }, color: '#1e293b' } }\n                    },\n                    cutout: '70%'\n                }\n            });\n        }\n\n        window.onload = () => {\n            renderAreas(allAreas);\n            updateMatrix('residential');\n            initChart();\n        };\n    </script>\n\n\n    <!-- Navigation -->\n    <nav class=\"bg-white/90 backdrop-blur-md shadow-sm sticky top-0 z-50 border-b border-cyan-100\">\n        <div class=\"max-w-7xl mx-auto px-4 h-16 flex justify-between items-center\">\n            <div class=\"flex items-center gap-2\">\n                <div class=\"w-10 h-10 bg-cyan-600 rounded-xl flex items-center justify-center text-white shadow-lg\">\n                    <i class=\"fas fa-gem animate-pulse\"></i>\n                </div>\n                <div class=\"flex flex-col\">\n                    <span class=\"font-extrabold text-lg leading-tight tracking-tight uppercase\">Atlas Aircon</span>\n                    <span class=\"text-[9px] text-cyan-600 font-black uppercase tracking-[0.2em]\">Service Center Surat</span>\n                </div>\n            </div>\n            <div class=\"hidden lg:flex space-x-6 text-[11px] font-bold uppercase tracking-wider text-slate-500\">\n                <a href=\"#matrix\" class=\"hover:text-cyan-600 transition\">Service Matrix</a>\n                <a href=\"#diagnose\" class=\"hover:text-cyan-600 transition\">Diagnostics</a>\n                <a href=\"#pricing\" class=\"hover:text-cyan-600 transition\">Price Radar</a>\n                <a href=\"#areas\" class=\"hover:text-cyan-600 transition\">Surat Zones</a>\n            </div>\n            <a href=\"https://wa.me/919727257141\" target=\"_blank\" class=\"bg-indigo-600 hover:bg-cyan-700 text-white px-5 py-2.5 rounded-full text-xs font-black shadow-md transition flex items-center gap-2\" rel=\"noopener\">\n                <i class=\"fab fa-whatsapp\"></i> +91 97272 57141\n            </a>\n        </div>\n    </nav>\n\n    <!-- Hero Section: Diamond City Focus -->\n    <header class=\"relative bg-white overflow-hidden border-b border-slate-100\">\n        <div class=\"max-w-7xl mx-auto flex flex-col lg:flex-row min-h-[75vh]\">\n            <div class=\"lg:w-1/2 px-6 py-16 lg:py-32 flex flex-col justify-center fade-in\">\n                <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-50 text-cyan-700 text-[10px] font-bold uppercase tracking-widest mb-8 w-fit border border-cyan-100\">\n                    <i class=\"fas fa-industry\"></i> Textile &#038; Diamond Hub HVAC Specialists\n                </div>\n                <h1 class=\"text-5xl lg:text-7xl font-black text-slate-900 leading-[1.05] mb-8 tracking-tighter\">\n                    Official <span class=\"text-cyan-600\">AC Service Center Surat</span>\n                </h1>\n                <p class=\"text-lg text-slate-500 mb-6 leading-relaxed max-w-lg\">\n                    Surat&#8217;s fastest response independent hub for precision cooling in luxury high-rises and heavy industrial estates.\n                </p>\n                <div class=\"p-4 bg-indigo-50 rounded-2xl border-l-4 border-indigo-600 mb-10\">\n                    <p class=\"text-xs font-bold text-indigo-900 uppercase italic\">*Independent Specialist: We repair all brands (Out-of-Warranty) with genuine technical precision.</p>\n                </div>\n                <div class=\"flex flex-wrap gap-4\">\n                    <a href=\"#matrix\" class=\"px-8 py-4 bg-cyan-600 text-white rounded-2xl font-bold shadow-xl hover:bg-cyan-700 transition text-sm\">Explore Service Directory</a>\n                    <a href=\"https://wa.me/919727257141\" class=\"px-8 py-4 bg-slate-900 text-white rounded-2xl font-bold hover:bg-slate-800 transition text-sm\" target=\"_blank\" rel=\"noopener\">Surat Emergency Support</a>\n                </div>\n            </div>\n            <div class=\"lg:w-1/2 relative bg-slate-900 flex items-center justify-center\">\n                <img decoding=\"async\" class=\"w-full h-full object-cover opacity-80\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/Atlas-aircon-vehicle.webp\" alt=\"AC Service Center Surat\" title=\"\">\n                <div class=\"absolute inset-0 bg-gradient-to-r from-white lg:from-transparent to-transparent\"></div>\n                <div class=\"absolute bottom-10 right-10 p-6 bg-white/10 backdrop-blur-xl rounded-3xl text-white border border-white/20 shadow-2xl\">\n                    <p class=\"text-xs font-bold uppercase tracking-widest text-cyan-400\">Response Time</p>\n                    <p class=\"text-2xl font-black\">Adajan to Sachin in 60m</p>\n                </div>\n            </div>\n        </div>\n    </header>\n\n    <!-- Information Synthesis: Surat-Specific Technical Needs -->\n    <section class=\"py-20 bg-slate-50\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-12 items-center\">\n                <div>\n                    <h2 class=\"text-3xl font-black mb-8 tracking-tight text-slate-800\">Surat&#8217;s Dual-Challenge: Coastal Salt &#038; Textile Fiber</h2>\n                    <p class=\"text-slate-600 leading-relaxed mb-6 text-lg\">\n                        Surat&#8217;s geography presents two major enemies for your air conditioner. In coastal areas like **Dumas** and **Hazira**, salt-air leads to rapid copper corrosion. In industrial hubs like **Pandesara**, textile micro-fibers clog cooling fins, causing compressor burnout.\n                    </p>\n                    <p class=\"text-slate-600 leading-relaxed\">\n                        As the premier <strong>AC service center in Surat</strong>, Atlas Aircon utilizes high-ambient testing and anti-corrosive chemical washing to safeguard units. We specialize in component-level PCB repairs for inverter models from brands like Daikin, Voltas, and O General, specifically focusing on out-of-warranty reliability for Surat&#8217;s residential and commercial sectors.\n                    </p>\n                </div>\n                <div class=\"grid grid-cols-2 gap-4\">\n                    <div class=\"p-8 bg-white rounded-[40px] shadow-sm border border-cyan-50 text-center\">\n                        <i class=\"fas fa-microchip text-3xl text-cyan-600 mb-4\"></i>\n                        <h4 class=\"font-bold text-sm uppercase\">Inverter PCB Experts</h4>\n                    </div>\n                    <div class=\"p-8 bg-cyan-600 rounded-[40px] shadow-sm text-white text-center\">\n                        <i class=\"fas fa-shield-virus text-3xl mb-4\"></i>\n                        <h4 class=\"font-bold text-sm uppercase\">Anti-Salt Coating</h4>\n                    </div>\n                    <div class=\"p-8 bg-indigo-600 rounded-[40px] shadow-sm text-white text-center\">\n                        <i class=\"fas fa-bolt text-3xl mb-4\"></i>\n                        <h4 class=\"font-bold text-sm uppercase\">2-Hour Doorstep</h4>\n                    </div>\n                    <div class=\"p-8 bg-white rounded-[40px] shadow-sm border border-cyan-50 text-center\">\n                        <i class=\"fas fa-tools text-3xl text-indigo-600 mb-4\"></i>\n                        <h4 class=\"font-bold text-sm uppercase\">Multi-Brand Hub</h4>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Interactive Service Matrix: Surat Segments -->\n    <section id=\"matrix\" class=\"py-24 bg-white\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"text-center mb-16\">\n                <h2 class=\"text-4xl font-black text-slate-900 mb-4 uppercase tracking-tighter\">The Surat Service Matrix</h2>\n                <p class=\"text-slate-500 italic\">&#8220;Tailored HVAC solutions for the Diamond City&#8217;s diverse sectors.&#8221;</p>\n            </div>\n\n            <div class=\"flex flex-wrap justify-center gap-3 mb-12\">\n                <button onclick=\"updateMatrix('residential')\" id=\"m-residential\" class=\"px-6 py-3 rounded-2xl font-bold text-xs uppercase tracking-widest transition-all border-2 border-slate-100 matrix-btn-active\">Luxury Residential</button>\n                <button onclick=\"updateMatrix('industrial')\" id=\"m-industrial\" class=\"px-6 py-3 rounded-2xl font-bold text-xs uppercase tracking-widest transition-all border-2 border-slate-100\">Textile &#038; Diamond GIDC</button>\n                <button onclick=\"updateMatrix('brands')\" id=\"m-brands\" class=\"px-6 py-3 rounded-2xl font-bold text-xs uppercase tracking-widest transition-all border-2 border-slate-100\">Global Brand Centers</button>\n            </div>\n\n            <div id=\"matrix-content\" class=\"fade-in bg-slate-50 p-8 lg:p-12 rounded-[50px] border border-cyan-50 shadow-inner min-h-[300px]\">\n                <!-- Content injected via JS -->\n            </div>\n        </div>\n    </section>\n\n    <!-- Diagnostic Hub: Interaction Focus -->\n    <section id=\"diagnose\" class=\"py-24 bg-indigo-950 text-white\">\n        <div class=\"max-w-6xl mx-auto px-4\">\n            <div class=\"lg:flex lg:items-center lg:gap-20\">\n                <div class=\"lg:w-1/2\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/02/Emergency-AC-Breakdown-Atlas-Aircon.webp\" class=\"rounded-[40px] shadow-2xl mb-12 border-4 border-indigo-900\" alt=\"AC Repair Surat\" title=\"\">\n                    <h2 class=\"text-4xl font-black mb-6\">Surat Technical Diagnostic</h2>\n                    <p class=\"text-indigo-200 leading-relaxed mb-8\">\n                        Is your AC display flashing a code? Surat&#8217;s frequent power fluctuations often trigger communication errors. Select your code to find the solution used at our <strong>Surat AC Service center</strong>.\n                    </p>\n                    <div class=\"p-6 bg-cyan-600 rounded-3xl shadow-xl border border-cyan-400\">\n                        <h4 class=\"font-black uppercase text-xs mb-2 text-white\">Diagnostic Fact</h4>\n                        <p class=\"text-sm font-bold\">&#8220;70% of communication errors in Adajan and Vesu are due to neutral leakage in high-rise wiring. We offer component-level PCB isolation.&#8221;</p>\n                    </div>\n                </div>\n                <div class=\"lg:w-1/2 mt-16 lg:mt-0\">\n                    <div class=\"bg-white rounded-[50px] p-10 lg:p-14 text-slate-900 shadow-2xl\">\n                        <label class=\"block text-[10px] font-black text-indigo-700 uppercase tracking-[0.3em] mb-6\">Select Error Code</label>\n                        <select id=\"errorSelect\" onchange=\"solveError()\" class=\"w-full p-5 rounded-2xl bg-slate-50 border-2 border-slate-100 focus:border-indigo-600 outline-none transition font-bold text-slate-900 mb-10 shadow-sm\">\n                            <option value=\"\">&#8212; Choose Code &#8212;</option>\n                            <option value=\"E1\">E1 / E2 &#8211; Temp Sensor</option>\n                            <option value=\"E4\">E4 &#8211; Fan Motor Issue</option>\n                            <option value=\"F1\">F1 / F2 &#8211; Phase Error</option>\n                            <option value=\"C6\">C6 &#8211; Comm. Error</option>\n                            <option value=\"P4\">P4 &#8211; Inverter Heat</option>\n                            <option value=\"EC\">EC &#8211; Leak Warning</option>\n                        </select>\n                        <div id=\"solutionResult\" class=\"hidden fade-in space-y-6\">\n                            <div class=\"p-4 bg-slate-50 rounded-2xl\">\n                                <h4 class=\"text-[10px] font-black text-slate-400 uppercase mb-2\">Technical Issue</h4>\n                                <p id=\"issueText\" class=\"text-xl font-black text-indigo-800\"></p>\n                            </div>\n                            <div class=\"p-4 bg-cyan-50 rounded-2xl border border-cyan-100\">\n                                <h4 class=\"text-[10px] font-black text-cyan-600 uppercase mb-2\">Independent Center Fix</h4>\n                                <p id=\"solutionText\" class=\"text-sm text-slate-600 font-medium leading-relaxed\"></p>\n                            </div>\n                            <a href=\"https://wa.me/919727257141\" class=\"block w-full text-center py-4 bg-indigo-600 text-white rounded-2xl font-bold uppercase text-[11px] tracking-widest hover:bg-indigo-700 transition shadow-lg\" target=\"_blank\" rel=\"noopener\">Request Surat On-Site Visit</a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Pricing: Doughnut Chart Focus -->\n    <section id=\"pricing\" class=\"py-24 bg-white\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"text-center mb-20\">\n                <h2 class=\"text-4xl font-black text-slate-900 mb-4 tracking-tight\">Surat Service Price Analysis</h2>\n                <p class=\"text-slate-500\">Transparent market statistics for independent AC maintenance in Surat district.</p>\n            </div>\n\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-20 items-center\">\n                <div class=\"bg-slate-50 p-10 rounded-[60px] border border-cyan-50 shadow-inner\">\n                    <h3 class=\"text-center text-[10px] font-black text-slate-400 uppercase tracking-widest mb-10\">Labor &#038; Part Allocation</h3>\n                    <div class=\"chart-container\">\n                        <canvas id=\"priceChart\"></canvas>\n                    </div>\n                </div>\n                <div>\n                    <h3 class=\"text-3xl font-black text-slate-800 mb-8\">Fixed Rates, Premium Spares</h3>\n                    <p class=\"text-slate-500 mb-10 leading-relaxed text-lg\">\n                        Surat&#8217;s premium residential areas often face &#8220;Area Surcharges.&#8221; Atlas Aircon maintains fixed, competitive pricing across **Adajan**, **Vesu**, and **Varachha**.\n                    </p>\n                    <div class=\"space-y-4\">\n                        <div class=\"flex justify-between items-center p-6 bg-cyan-50 rounded-3xl border border-cyan-100\">\n                            <span class=\"text-sm font-bold text-cyan-800\">Jet Cleaning (Anti-Corrosive)</span>\n                            <span class=\"text-lg font-black text-slate-900\">₹650 &#8211; ₹950</span>\n                        </div>\n                        <div class=\"flex justify-between items-center p-6 bg-white rounded-3xl border border-slate-100 shadow-sm\">\n                            <span class=\"text-sm font-bold text-slate-600\">Gas Refilling (Full R32/R410)</span>\n                            <span class=\"text-lg font-black text-slate-900\">₹2500 &#8211; ₹4500</span>\n                        </div>\n                        <div class=\"flex justify-between items-center p-6 bg-white rounded-3xl border border-slate-100 shadow-sm\">\n                            <span class=\"text-sm font-bold text-slate-600\">Inverter Card Micro-Repair</span>\n                            <span class=\"text-lg font-black text-slate-900\">₹1500 &#8211; ₹5000</span>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Coverage Locator (Integrated Final Section) -->\n    <section id=\"areas\" class=\"py-24 bg-white\">\n        <div class=\"max-w-7xl mx-auto px-4\">\n            <div class=\"bg-indigo-900 rounded-[80px] p-10 lg:p-20 text-white relative overflow-hidden shadow-2xl\">\n                <div class=\"absolute top-0 left-0 p-10 opacity-5\"><i class=\"fas fa-city text-[250px]\"></i></div>\n                \n                <div class=\"text-center mb-16 relative z-10\">\n                    <h2 class=\"text-5xl font-black mb-6 tracking-tight\">Surat Coverage Network</h2>\n                    <p class=\"text-cyan-200 max-w-xl mx-auto text-lg\">From the residential skyline of Vesu to the industrial belts of Sachin &#038; Hazira.</p>\n                </div>\n\n                <div class=\"relative max-w-xl mx-auto mb-16 z-10\">\n                    <input type=\"text\" id=\"areaSearch\" onkeyup=\"filterAreas()\" placeholder=\"Search (e.g. Adajan, Piplod, Sachin GIDC)...\" class=\"w-full px-8 py-6 rounded-full bg-indigo-800 border border-indigo-700 text-white placeholder-indigo-400 focus:ring-2 focus:ring-cyan-500 outline-none transition shadow-2xl font-bold\">\n                </div>\n\n                <div id=\"areaGrid\" class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 text-[10px] font-bold tracking-tight h-[350px] overflow-y-auto custom-scroll pr-6 pb-12 relative z-10\">\n                    <!-- Areas injected by JS -->\n                </div>\n\n                <!-- Contact & Identity -->\n                <div class=\"mt-20 pt-20 border-t border-indigo-800 lg:flex lg:justify-between lg:items-start relative z-10\">\n                    <div class=\"max-w-xs mb-16 lg:mb-0\">\n                        <div class=\"flex items-center gap-2 mb-8\">\n                            <div class=\"w-10 h-10 bg-cyan-500 rounded-xl flex items-center justify-center text-white font-black text-xl shadow-lg\">A</div>\n                            <span class=\"text-2xl font-black tracking-tighter uppercase\">Atlas Aircon</span>\n                        </div>\n                        <p class=\"text-xs text-indigo-300 leading-relaxed mb-8\">The official <strong>AC Service Center Surat</strong> interactive portal. Independent specialists in multi-brand cooling technology.</p>\n                        <p class=\"text-[10px] text-indigo-600 uppercase font-black tracking-[0.2em]\">© 2026 Surat Cooling Network</p>\n                    </div>\n\n                    <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-20\">\n                        <div>\n                            <h4 class=\"text-[10px] font-black text-cyan-400 uppercase tracking-widest mb-6\">Surat Contact Center</h4>\n                            <ul class=\"space-y-6 text-sm font-semibold text-indigo-50\">\n                                <li class=\"flex items-center gap-4\"><i class=\"fas fa-phone text-cyan-400 text-lg\"></i> +91 97272 57141</li>\n                                <li class=\"flex items-center gap-4\"><i class=\"fas fa-envelope text-cyan-400 text-lg\"></i> atlasaircon1@gmail.com</li>\n                                <li class=\"flex items-center gap-4\"><i class=\"fas fa-map-marker-alt text-cyan-400 text-lg\"></i> Surat, Gujarat 395001</li>\n                            </ul>\n                        </div>\n                        <div>\n                            <h4 class=\"text-[10px] font-black text-cyan-400 uppercase tracking-widest mb-6\">Independent Service</h4>\n                            <p class=\"text-[11px] text-indigo-300 font-medium leading-relaxed mb-6\">We are not an authorized center. We operate as an independent maintenance hub specializing in component-level out-of-warranty repairs for LG, Samsung, Daikin, and Voltas.</p>\n                            <div class=\"flex gap-6\">\n                                <i class=\"fab fa-facebook text-indigo-700 hover:text-cyan-400 transition text-xl cursor-pointer\"></i>\n                                <i class=\"fab fa-instagram text-indigo-700 hover:text-cyan-400 transition text-xl cursor-pointer\"></i>\n                                <i class=\"fab fa-linkedin text-indigo-700 hover:text-cyan-400 transition text-xl cursor-pointer\"></i>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Schema Data -->\n    <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"LocalBusiness\",\n      \"name\": \"Atlas Aircon Surat\",\n      \"image\": \"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\",\n      \"@id\": \"https://atlasaircons.com/surat\",\n      \"url\": \"https://atlasaircons.com/surat\",\n      \"telephone\": \"+91 97272 57141\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"addressLocality\": \"Surat\",\n        \"addressRegion\": \"Gujarat\",\n        \"postalCode\": \"395001\",\n        \"addressCountry\": \"IN\"\n      }\n    }\n    </script>\n\n    <script>\n        const residential = [\n            \"Adajan\", \"Vesu\", \"Piplod\", \"City Light\", \"Pal\", \"New City Light\", \"Bharthana\", \"Althan\", \"Bhatar\", \"Majura Gate\", \n            \"Ghod Dod Road\", \"Ring Road\", \"Athwalines\", \"Parle Point\", \"Vip Road\", \"Amroli\", \"Katargam\", \"Varachha\", \"Mota Varachha\", \n            \"Punagam\", \"Dindoli\", \"Udhna\", \"Limbayat\", \"Nanpura\", \"Chowk Bazar\", \"Rander\", \"Olpad Road\", \"Dumas Road\", \"Sultanabad\",\n            \"Mughalsarai\", \"Sagrampura\", \"Begampura\", \"Gopipura\", \"Sayedpura\", \"Rustampura\"\n        ];\n        \n        const industrial = [\n            \"Sachin GIDC\", \"Hazira Industrial Belt\", \"Pandesara GIDC\", \"Ichchhapore Industrial Estate\", \"Diamond Research & Mercantile (DREAM) City\",\n            \"Diamond Bourse Hub\", \"Katargam Diamond Clusters\", \"Varachha Textile Hub\", \"Udhna Industrial Estate\", \"Khatodra GIDC\",\n            \"Hojiwala Industrial Estate\", \"Surat SEZ Zone\", \"Sarsana Exhibition Center Area\", \"Magdalla Port Industrial\"\n        ];\n        \n        const allAreas = [...residential, ...industrial];\n\n        const matrixData = {\n            residential: `\n                <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                    <a href=\"/split-ac-service-surat\" class=\"p-6 bg-cyan-600 text-white rounded-3xl h-48 flex flex-col justify-between shadow-lg\">\n                        <i class=\"fas fa-snowflake text-2xl\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">Luxury Split AC Care</span>\n                    </a>\n                    <a href=\"/cassette-ac-service-surat\" class=\"p-6 bg-white border-2 border-cyan-100 rounded-3xl h-48 flex flex-col justify-between\">\n                        <i class=\"fas fa-th-large text-2xl text-indigo-600\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">Cassette AC Portals</span>\n                    </a>\n                    <a href=\"/ac-gas-charging-surat\" class=\"p-6 bg-indigo-600 text-white rounded-3xl h-48 flex flex-col justify-between shadow-lg\">\n                        <i class=\"fas fa-gas-pump text-2xl\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">R32 & R410 Refilling</span>\n                    </a>\n                </div>\n            `,\n            industrial: `\n                <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n                    <a href=\"/chiller-repair-surat\" class=\"p-6 bg-slate-900 text-white rounded-3xl h-48 flex flex-col justify-between\">\n                        <i class=\"fas fa-industry text-2xl text-cyan-400\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">Industrial Chillers</span>\n                    </a>\n                    <a href=\"/panel-ac-repair-surat\" class=\"p-6 bg-white border-2 border-indigo-100 rounded-3xl h-48 flex flex-col justify-between\">\n                        <i class=\"fas fa-server text-2xl text-indigo-600\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">Panel AC Repair</span>\n                    </a>\n                    <a href=\"/textile-hvac-amc-surat\" class=\"p-6 bg-cyan-600 text-white rounded-3xl h-48 flex flex-col justify-between\">\n                        <i class=\"fas fa-shirt text-2xl\"></i>\n                        <span class=\"text-xl font-black uppercase tracking-tighter\">Textile Mill AMC</span>\n                    </a>\n                </div>\n            `,\n            brands: `\n                <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3\">\n                    <a href=\"/blue-star-ac-service-surat\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-cyan-600 hover:text-white transition shadow-sm border border-slate-100\">Blue Star</a>\n                    <a href=\"/daikin-ac-service-surat\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-cyan-600 hover:text-white transition shadow-sm border border-slate-100\">Daikin Center</a>\n                    <a href=\"/lg-ac-service-surat\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-cyan-600 hover:text-white transition shadow-sm border border-slate-100\">LG Support</a>\n                    <a href=\"/voltas-ac-service-surat\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-cyan-600 hover:text-white transition shadow-sm border border-slate-100\">Voltas Center</a>\n                    <a href=\"/samsung-ac-service-surat\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-cyan-600 hover:text-white transition shadow-sm border border-slate-100\">Samsung</a>\n                    <a href=\"/mitsubishi-ac-service-surat\" class=\"p-4 bg-white rounded-2xl text-[10px] font-black uppercase text-center hover:bg-cyan-600 hover:text-white transition shadow-sm border border-slate-100\">Mitsubishi</a>\n                </div>\n            `\n        };\n\n        function updateMatrix(key) {\n            document.getElementById('matrix-content').innerHTML = matrixData[key];\n            document.querySelectorAll('#matrix button').forEach(btn => btn.classList.remove('matrix-btn-active'));\n            document.getElementById('m-' + key).classList.add('matrix-btn-active');\n        }\n\n        function renderAreas(list) {\n            const grid = document.getElementById('areaGrid');\n            grid.innerHTML = '';\n            list.forEach(area => {\n                const div = document.createElement('div');\n                div.className = \"bg-white/5 p-3 rounded-xl border border-indigo-700 hover:bg-cyan-600/20 transition cursor-default text-center text-indigo-100\";\n                div.textContent = area;\n                grid.appendChild(div);\n            });\n        }\n\n        function filterAreas() {\n            const query = document.getElementById('areaSearch').value.toLowerCase();\n            const filtered = allAreas.filter(a => a.toLowerCase().includes(query));\n            renderAreas(filtered);\n        }\n\n        function solveError() {\n            const code = document.getElementById('errorSelect').value;\n            const hub = document.getElementById('solutionResult');\n            const issue = document.getElementById('issueText');\n            const solution = document.getElementById('solutionText');\n\n            const errors = {\n                \"E1\": [\"Sensor Fault (Salt Erosion)\", \"Coastal humidity causing resistance bridge in thermistor; sensor replacement and epoxy sealing required.\"],\n                \"E4\": [\"Motor Fail (Fiber Clog)\", \"Textile micro-fibers jam in motor bearing; high-pressure chemical wash and lubrication needed.\"],\n                \"F1\": [\"Phase Error (Grid Volatility)\", \"Power surge in Sachin GIDC grid damaged the IPM module; component-level card repair required.\"],\n                \"C6\": [\"Comm Loss (L-N-S Leakage)\", \"Moisture in signal cables causing communication dropout; weather-shielded cable replacement.\"],\n                \"P4\": [\"IPM Overheat (Diamond Dust)\", \"Diamond polishing dust blocking heat sink; descaling and thermal paste reapplication.\"],\n                \"EC\": [\"Refrigerant Leak (Pinhole Leak)\", \"Copper oxidation due to Dumas sea breeze; nitrogen pressure test and silver-brazing required.\"]\n            };\n\n            if (errors[code]) {\n                hub.classList.remove('hidden');\n                issue.textContent = errors[code][0];\n                solution.textContent = errors[code][1];\n            } else {\n                hub.classList.add('hidden');\n            }\n        }\n\n        function initChart() {\n            const ctx = document.getElementById('priceChart').getContext('2d');\n            new Chart(ctx, {\n                type: 'doughnut',\n                data: {\n                    labels: ['Repair Labor', 'Refrigerant', 'Eco-Cleaning', 'Spare Parts', 'PCB Repair'],\n                    datasets: [{\n                        data: [25, 30, 15, 10, 20],\n                        backgroundColor: [\n                            '#0891B2',\n                            '#4F46E5',\n                            '#06B6D4',\n                            '#6366F1',\n                            '#1E293B'\n                        ],\n                        borderWidth: 0,\n                        hoverOffset: 15\n                    }]\n                },\n                options: {\n                    responsive: true,\n                    maintainAspectRatio: false,\n                    plugins: {\n                        legend: { position: 'bottom', labels: { font: { size: 10, weight: 'bold' }, color: '#1e293b' } }\n                    },\n                    cutout: '70%'\n                }\n            });\n        }\n\n        window.onload = () => {\n            renderAreas(allAreas);\n            updateMatrix('residential');\n            initChart();\n        };\n    </script>\n</div>",
