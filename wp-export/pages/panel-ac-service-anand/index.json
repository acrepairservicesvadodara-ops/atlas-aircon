                        </tr>\n                    </thead>\n                    <tbody>\n                        <tr>\n                            <td class=\"p-4 border\"><b>Standard General Maintenance</b></td>\n                            <td class=\"p-4 border\">₹1,800</td>\n                            <td class=\"p-4 border\">Industrial Wash</td>\n                            <td class=\"p-4 border\"><a href=\"/shop\" class=\"price-link\">Book Now</a></td>\n                        </tr>\n                        <tr>\n                            <td class=\"p-4 border\"><b>Refrigerant Gas Charging</b></td>\n                            <td class=\"p-4 border\">₹3,500+</td>\n                            <td class=\"p-4 border\">High Purity</td>\n                            <td class=\"p-4 border\"><a href=\"/shop\" class=\"price-link\">Book Now</a></td>\n                        </tr>\n                        <tr>\n                            <td class=\"p-4 border\"><b>Panel AC Digital Controller</b></td>\n                            <td class=\"p-4 border\">₹4,500</td>\n                            <td class=\"p-4 border\">Universal</td>\n                            <td class=\"p-4 border\"><a href=\"/shop\" class=\"price-link\">Buy Part</a></td>\n                        </tr>\n                        <tr>\n                            <td class=\"p-4 border\"><b>High Speed Condenser Fan</b></td>\n                            <td class=\"p-4 border\">₹2,800</td>\n                            <td class=\"p-4 border\">Heavy Duty</td>\n                            <td class=\"p-4 border\"><a href=\"/shop\" class=\"price-link\">Buy Part</a></td>\n                        </tr>\n                        <tr>\n                            <td class=\"p-4 border\"><b>Industrial Compressor</b></td>\n                            <td class=\"p-4 border\">₹9,500+</td>\n                            <td class=\"p-4 border\">Certified OEM</td>\n                            <td class=\"p-4 border\"><a href=\"/shop\" class=\"price-link\">Inquire</a></td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n        </section>\n\n        <!-- Industrial Hub Section -->\n        <section class=\"mb-20 bg-gray-900 text-white p-12 rounded-3xl\">\n            <h2 class=\"text-3xl font-bold mb-8 text-secondary\">Anand Industrial Area Presence</h2>\n            <p class=\"mb-8 opacity-80\">We offer rapid same-day response for <b>Panel AC service Anand</b> in these industrial corridors:</p>\n            <div class=\"industrial-list text-xs uppercase tracking-wider leading-relaxed\">\n                <b>Vitthal Udyognagar GIDC</b> | <b>Mogar Industrial Estate</b> | <b>Tarapur GIDC</b> | Sojitra GIDC | Khambhat Industrial Zone | Borsad GIDC | Umreth Industrial Estate | Adas Industrial Area | Napad Industrial Zone | Lambhvel Industrial Belt | Kanjari Industrial Area | Karamsad Industrial Cluster | Chikhodra GIDC | Vasad Industrial Area | Petlad GIDC | Anklav Industrial Estate | Sarsa Industrial Hub | Bhadran Industrial Zone.\n            </div>\n        </section>\n\n        <!-- All Services -->\n        <section class=\"mb-20\">\n            <h2 class=\"text-3xl font-bold section-title\">Comprehensive Cooling in Anand</h2>\n            <div class=\"grid md:grid-cols-3 gap-6\">\n                <div class=\"bg-white rounded-xl shadow-md overflow-hidden hover-card border border-gray-100\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/10/cold-room.webp\" alt=\"Cold Room Service Anand\" class=\"service-img\" title=\"\">\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-bold mb-2\">Cold Room Solutions</h3>\n                        <p class=\"text-sm text-gray-600 mb-4\">Deep freezing and ripening chamber maintenance for the Charotar agricultural hub.</p>\n                        <a href=\"/cold-room-repair-services-vadodara\" class=\"text-primary font-bold\">Details →</a>\n                    </div>\n                </div>\n                <div class=\"bg-white rounded-xl shadow-md overflow-hidden hover-card border border-gray-100\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/deep-freezer-repair-service-in-vadodara.webp\" alt=\"Deep Freezer Repair Anand\" class=\"service-img\" title=\"\">\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-bold mb-2\">Industrial Freezers</h3>\n                        <p class=\"text-sm text-gray-600 mb-4\">Vertical and deep freezer repairs for ice cream and dairy distributors in Anand.</p>\n                        <a href=\"/deep-freezer-repair-services-vadodara\" class=\"text-primary font-bold\">Details →</a>\n                    </div>\n                </div>\n                <div class=\"bg-white rounded-xl shadow-md overflow-hidden hover-card border border-gray-100\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2024/01/Water-Cooler-Repair-Service-near-me-in-vadodara-scaled.webp\" alt=\"Water Cooler Repair Anand\" class=\"service-img\" title=\"\">\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-bold mb-2\">Water Cooler Service</h3>\n                        <p class=\"text-sm text-gray-600 mb-4\">Maintaining worker hydration systems across all industrial zones in Anand.</p>\n                        <a href=\"/water-cooler-repair-services-vadodara\" class=\"text-primary font-bold\">Details →</a>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- Error Codes -->\n        <section class=\"mb-20\">\n            <h2 class=\"text-3xl font-bold section-title\">Diagnostic Guide: Panel AC Error Codes</h2>\n            <div class=\"grid md:grid-cols-2 lg:grid-cols-4 gap-4\">\n                <div class=\"p-4 bg-white rounded shadow-sm border-l-4 border-red-500\">\n                    <h4 class=\"font-bold\">E0: Probe Fault</h4>\n                    <p class=\"text-xs\">Controller cannot read internal temperature. <b>Fix:</b> Inspect NTC sensor wiring.</p>\n                </div>\n                <div class=\"p-4 bg-white rounded shadow-sm border-l-4 border-red-500\">\n                    <h4 class=\"font-bold\">E1: Cabinet High</h4>\n                    <p class=\"text-xs\">Critical heat in cabinet. <b>Fix:</b> Clean condenser fins and check fan operation.</p>\n                </div>\n                <div class=\"p-4 bg-white rounded shadow-sm border-l-4 border-red-500\">\n                    <h4 class=\"font-bold\">E2: Low Pressure</h4>\n                    <p class=\"text-xs\">System lost refrigerant or coil is frozen. <b>Fix:</b> Call for <b>Panel AC service Anand</b>.</p>\n                </div>\n                <div class=\"p-4 bg-white rounded shadow-sm border-l-4 border-red-500\">\n                    <h4 class=\"font-bold\">E3: Phase Swap</h4>\n                    <p class=\"text-xs\">Electrical phase reversal detected. <b>Fix:</b> Check main power phase sequence.</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- Used/Scrap Section -->\n        <section class=\"mb-20 bg-yellow-50 p-10 rounded-3xl border-2 border-yellow-200 text-center\">\n            <h2 class=\"text-3xl font-bold mb-4\">Industrial Buy-Back &#038; Scrap Solutions</h2>\n            <p class=\"mb-8\">Upgrade your plant&#8217;s cooling infrastructure. We buy old or damaged industrial ACs for <b>scrap</b> and sell certified <b>used panel AC</b> units with full warranty for cost-conscious engineering units in Anand.</p>\n            <div class=\"flex justify-center gap-6\">\n                <a href=\"/contact-us\" class=\"bg-gray-800 text-white px-8 py-3 rounded-lg font-bold\">Sell Scrap Units</a>\n                <a href=\"/shop\" class=\"bg-secondary text-white px-8 py-3 rounded-lg font-bold\">Buy Certified Used</a>\n            </div>\n        </section>\n\n        <!-- FAQs -->\n        <section class=\"mb-20\">\n            <h2 class=\"text-3xl font-bold section-title text-center\">Anand Panel AC Service FAQ</h2>\n            <div class=\"max-w-4xl mx-auto space-y-4\">\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">Do you provide service in Vitthal Udyognagar GIDC?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Yes, we serve the entire V.U. Nagar GIDC daily, providing maintenance for CNC and electrical enclosure cooling units.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">What is the response time for Mogar industrial units?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Our Anand-based technicians can usually reach Mogar within 2 hours for emergency service calls.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">Can you repair dairy industry panel ACs?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Absolutely. We specialize in <b>Adhunik</b> and <b>Rittal</b> stainless steel units used in high-moisture dairy environments in Anand.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">Is an AMC beneficial for engineering plants?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Yes, an AMC for <b>Panel AC service Anand</b> ensures quarterly deep cleaning, which is vital in dust-heavy machining environments.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">My unit is leaking water inside the panel. What should I do?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Turn it off immediately. Internal water leaks can cause short circuits. This is usually due to a blocked condensate drain line.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">What is the cost of gas refilling?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Industrial gas charging starts from ₹3,500, which includes a full leak test and system evacuation.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">Do you sell spare parts for Rittal ACs?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Yes, we stock high-quality condenser fans, compressors, and controllers for all major industrial AC brands.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">Can you repair CNC machine cooling units?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Yes, we have specialized training in machine cooling for Fanuc, Mitsubishi, and Siemens controlled machine enclosures.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">Do you provide service in Tarapur and Khambhat?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Yes, we extend our <b>Panel AC service Anand</b> to Tarapur and Khambhat for scheduled maintenance and project works.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">How can I book an industrial audit?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">You can contact us via the WhatsApp button or call +91 97272 57141 for a full thermal audit of your panels.</p>\n                </details>\n            </div>\n        </section>\n\n        <!-- Residential Anand Areas -->\n        <section class=\"py-12 bg-white border rounded-2xl px-8 mb-20\">\n            <h3 class=\"text-xl font-bold mb-4\">Residential Areas Served in Anand</h3>\n            <p class=\"text-xs text-gray-400 uppercase tracking-tighter leading-relaxed\">\n                Vallabh Vidyanagar | Karamsad | Bakrol | Lambhvel | Mogar | Chikhodra | Adas | Town Hall Area | Amul Dairy Road | Nana Bazaar | Mota Bazaar | Station Road | Borsad Road | Hadgood | Lambha | Jitodia | Gana | Napad | Sarsa | Kanjari | Samarkha | Navli | Gamdi | Bakrol-Vadtal Road | V.V. Nagar 100 Feet Road | Mayur Nagar | Ganesh Colony | Maruti Sharanam | Shanti Nagar | Amul Nagar | Ravipura | Lambhvel Road | Bhalej Road.\n            </p>\n        </section>\n\n    </main>\n\n    <!-- Global Reach -->\n    <section class=\"bg-primary text-white py-16 text-center\">\n        <div class=\"container mx-auto px-4\">\n            <h2 class=\"text-4xl font-bold mb-6\">Cooling Anand&#8217;s Milk &#038; Machine Industry</h2>\n            <p class=\"max-w-3xl mx-auto text-lg mb-10\">We are your trusted technical experts for <b>Panel AC service Anand</b>. Reliable, professional thermal solutions for your machines are just one call away.</p>\n            <a href=\"tel:+919727257141\" class=\"bg-secondary text-white px-12 py-4 rounded-full font-bold text-xl inline-block shadow-lg\">Call Atlas Aircon</a>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"bg-gray-900 text-gray-500 py-20\">\n        <div class=\"container mx-auto px-4 grid md:grid-cols-4 gap-12 text-sm\">\n            <div>\n                <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\" alt=\"Atlas Aircon Logo\" class=\"h-10 mb-6 grayscale brightness-150\" title=\"\">\n                <p class=\"italic\">&#8220;The Industrial Cooling Experts.&#8221; Serving Anand&#8217;s GIDC belts with technical excellence since 2010.</p>\n            </div>\n            <div>\n                <h4 class=\"text-white font-bold mb-4 uppercase\">Services</h4>\n                <ul class=\"space-y-2\">\n                    <li><a href=\"/panel-ac-service-vadodara\" class=\"hover:text-white\">Panel AC Repair</a></li>\n                    <li><a href=\"/chiller-repair-services-vadodara\" class=\"hover:text-white\">Industrial Chillers</a></li>\n                    <li><a href=\"/cold-room-repair-services-vadodara\" class=\"hover:text-white\">Cold Storage</a></li>\n                    <li><a href=\"/ac-service-vadodara\" class=\"hover:text-white\">AC Service Center</a></li>\n                </ul>\n            </div>\n            <div>\n                <h4 class=\"text-white font-bold mb-4 uppercase\">Hubs</h4>\n                <ul class=\"space-y-2\">\n                    <li><a href=\"/locations\" class=\"hover:text-white\">V.U. Nagar GIDC</a></li>\n                    <li><a href=\"/locations\" class=\"hover:text-white\">Tarapur GIDC</a></li>\n                    <li><a href=\"/locations\" class=\"hover:text-white\">Mogar Industrial</a></li>\n                    <li><a href=\"/locations\" class=\"hover:text-white\">Khambhat Zone</a></li>\n                </ul>\n            </div>\n            <div>\n                <h4 class=\"text-white font-bold mb-4 uppercase\">Contact</h4>\n                <p class=\"mb-2\">Anand Office: Karamsad Rd, GJ</p>\n                <p class=\"mb-2\">Phone: +91 97272 57141</p>\n                <p>Email: atlasaircon1@gmail.com</p>\n            </div>\n        </div>\n        <div class=\"text-center mt-12 text-xs border-t border-gray-800 pt-8 uppercase tracking-tighter\">\n            © 2026 Atlas Aircon. Leading <b>Panel AC service Anand</b> provider. All brands mentioned are property of respective owners.\n        </div>\n    </footer>\n\n    <!-- Fixed WhatsApp -->\n    <a href=\"https://wa.me/919727257141\" class=\"fixed bottom-6 right-6 z-50 btn-whatsapp p-5 rounded-full shadow-2xl transition\" target=\"_blank\" rel=\"noopener\">\n        <svg class=\"w-8 h-8 fill-current\" viewBox=\"0 0 24 24\"><path d=\"M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.588-5.946 0-6.556 5.332-11.888 11.888-11.888 3.176 0 6.161 1.237 8.404 3.48s3.481 5.229 3.481 8.404c0 6.556-5.331 11.888-11.888 11.888-2.003 0-3.963-.505-5.7-1.467l-6.305 1.692zm6.39-4.321c1.556.924 3.167 1.411 4.841 1.411 5.097 0 9.245-4.148 9.245-9.245 0-2.468-.962-4.789-2.709-6.537-1.747-1.747-4.068-2.708-6.536-2.708-5.097 0-9.245 4.148-9.245 9.245 0 1.785.513 3.52 1.484 5.016l-.979 3.575 3.655-.957zm10.334-3.52c-.27-.135-1.598-.788-1.846-.878-.248-.09-.428-.135-.608.135-.18.27-.698.878-.855 1.058-.158.18-.315.203-.585.068-.27-.135-1.14-.421-2.172-1.341-.803-.715-1.346-1.598-1.503-1.868-.158-.27-.017-.417.118-.552.122-.122.27-.315.405-.473.135-.158.18-.27.27-.45.09-.18.045-.338-.023-.473-.068-.135-.608-1.463-.833-2.003-.22-.529-.44-.457-.608-.466-.157-.008-.337-.009-.517-.009-.18 0-.473.068-.72.338-.248.27-.945.923-.945 2.25 0 1.328.968 2.61 1.103 2.79.135.18 1.905 2.909 4.614 4.082.645.278 1.148.445 1.541.569.648.206 1.237.177 1.704.107.52-.078 1.598-.653 1.823-1.283.225-.63.225-1.17.157-1.283-.068-.113-.248-.18-.517-.315z\"/></svg>\n    </a>\n\n</div>",
