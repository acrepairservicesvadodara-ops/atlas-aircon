-right font-bold\">₹ 1,400</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">Dismantling of Air Conditioners</td>\n<td class=\"px-6 py-3 text-right font-bold\">₹ 550</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">Dismantle Service &amp; Water Service</td>\n<td class=\"px-6 py-3 text-right font-bold\">₹ 1,500</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">Gas Charging 1.0 Ton (R22/M22)</td>\n<td class=\"px-6 py-3 text-right font-bold\">₹ 1,800</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">Gas Charging 1.5 Ton (R22/M22)</td>\n<td class=\"px-6 py-3 text-right font-bold\">₹ 2,000</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">Gas Charging 2.0 Ton (R22/M22)</td>\n<td class=\"px-6 py-3 text-right font-bold\">₹ 2,400</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">Gas Charging 2.5 Ton (R22/M22)</td>\n<td class=\"px-6 py-3 text-right font-bold\">₹ 3,180</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">Gas Charging 3.0 Ton (R22/M22)</td>\n<td class=\"px-6 py-3 text-right font-bold\">₹ 3,850</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">Pressure Testing &amp; Vaccumizing</td>\n<td class=\"px-6 py-3 text-right font-bold\">₹ 495</td>\n</tr>\n<tr class=\"bg-blue-50 font-bold\">\n<td class=\"px-6 py-2 text-blue-700 italic underline\" colspan=\"2\">RUNNING CAPACITORS</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">2.5 Mfd Capacitor</td>\n<td class=\"px-6 py-3 text-right\">₹ 180</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">3.0 Mfd Capacitor</td>\n<td class=\"px-6 py-3 text-right\">₹ 250</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">4.0 Mfd Capacitor</td>\n<td class=\"px-6 py-3 text-right\">₹ 385</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">6.0 Mfd Capacitor</td>\n<td class=\"px-6 py-3 text-right\">₹ 430</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">36 Mfd Capacitor</td>\n<td class=\"px-6 py-3 text-right\">₹ 480</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">45 Mfd Capacitor</td>\n<td class=\"px-6 py-3 text-right\">₹ 550</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">60 Mfd Capacitor</td>\n<td class=\"px-6 py-3 text-right\">₹ 690</td>\n</tr