-6 py-3 text-right font-bold\">₹ 13,500</td>\n</tr>\n<tr class=\"bg-slate-50 font-bold\">\n<td class=\"px-6 py-2 text-slate-800 italic underline\" colspan=\"2\">INDUSTRIAL COMPONENTS</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">Compressor 5.5 Ton Replacement</td>\n<td class=\"px-6 py-3 text-right\">₹ 34,950</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">Compressor Replacement Labor (Heavy)</td>\n<td class=\"px-6 py-3 text-right\">₹ 1,100</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">Sub Zero Temperature Controller</td>\n<td class=\"px-6 py-3 text-right\">₹ 4,500</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">Magnetic Contactor 3 Phase</td>\n<td class=\"px-6 py-3 text-right\">₹ 3,200</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">Dryer Filter (3/8 to 5/8)</td>\n<td class=\"px-6 py-3 text-right\">₹ 1,890 &#8211; 3,200</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">AHU / Duct Cleaning</td>\n<td class=\"px-6 py-3 text-right\">As per Quote</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n<p><!-- REFRIGERATOR TABLE --></p>\n<div id=\"tab-fridge\" class=\"tab-content hidden\">\n<div class=\"table-container\">\n<table class=\"w-full text-sm\">\n<tbody class=\"divide-y divide-slate-200\">\n<tr class=\"bg-blue-600 text-white font-bold\">\n<td class=\"px-6 py-2\" colspan=\"2\">FRIDGE GAS &amp; COMPRESSOR</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">Single Door Gas Charging</td>\n<td class=\"px-6 py-3 text-right\">₹ 1,200</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">Double Door Gas Charging</td>\n<td class=\"px-6 py-3 text-right\">₹ 1,800</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">Compressor Single Door (up to 190L)</td>\n<td class=\"px-6 py-3 text-right\">₹ 4,500</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">Compressor Double Door (up to 260L)</td>\n<td class=\"px-6 py-3 text-right\">₹ 6,500</td>\n</tr>\n<tr>\n<td class=\"px-6 py-3\">Thermostat / Relay replacement</td>\n<td class=\"px-6 py-3 text-right\">₹ 715 &#8211; 825</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n<p><!-- AIR COOLER TABLE --></p>\n