lass=\"mb-20 bg-gray-900 text-white p-12 rounded-3xl\">\n            <h2 class=\"text-3xl font-bold mb-8 text-secondary\">Daman Industrial Presence</h2>\n            <p class=\"mb-8 opacity-80\">We offer rapid response for <b>Panel AC service Daman</b> across all major estates:</p>\n            <div class=\"industrial-list text-xs uppercase tracking-wider leading-relaxed\">\n                <b>Dabhel Industrial Estate</b> | <b>Somnath Industrial Area</b> | <b>Bhimpore Industrial Estate</b> | <b>Kadaiya Industrial Area</b> | Kachigam Industrial Estate | Ringanwada Industrial Area | Dunetha Industrial Estate | Varkund Industrial Area | Bharat Industrial Estate | OIDC Industrial Estate | Panchal Udyog Nagar | Mahatma Gandhi Udyog Nagar.\n            </div>\n        </section>\n\n        <!-- All Services -->\n        <section class=\"mb-20\">\n            <h2 class=\"text-3xl font-bold section-title\">Comprehensive Cooling in Daman</h2>\n            <div class=\"grid md:grid-cols-3 gap-6\">\n                <div class=\"bg-white rounded-xl shadow-md overflow-hidden hover-card border border-gray-100\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/10/cold-room.webp\" alt=\"Cold Room Service Daman\" class=\"service-img\" title=\"\">\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-bold mb-2\">Cold Room Solutions</h3>\n                        <p class=\"text-sm text-gray-600 mb-4\">Storage cooling for pharmaceutical raw materials and seafood processing.</p>\n                        <a href=\"/cold-room-repair-services-vadodara\" class=\"text-primary font-bold\">Details →</a>\n                    </div>\n                </div>\n                <div class=\"bg-white rounded-xl shadow-md overflow-hidden hover-card border border-gray-100\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/deep-freezer-repair-service-in-vadodara.webp\" alt=\"Deep Freezer Repair Daman\" class=\"service-img\" title=\"\">\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-bold mb-2\">Lab &#038; Industrial Freezers</h3>\n                        <p class=\"text-sm text-gray-600 mb-4\">Ultra-low temperature freezer repair for labs and hospitality units.</p>\n                        <a href=\"/deep-freezer-repair-services-vadodara\" class=\"text-primary font-bold\">Details →</a>\n                    </div>\n                </div>\n                <div class=\"bg-white rounded-xl shadow-md overflow-hidden hover-card border border-gray-100\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2024/01/Water-Cooler-Repair-Service-near-me-in-vadodara-scaled.webp\" alt=\"Water Cooler Repair Daman\" class=\"service-img\" title=\"\">\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-bold mb-2\">Water Cooler Service</h3>\n                        <p class=\"text-sm text-gray-600 mb-4\">Heavy-duty water cooler maintenance for large industrial workforces.</p>\n                        <a href=\"/water-cooler-repair-services-vadodara\" class=\"text-primary font-bold\">Details →</a>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- Error Codes -->\n        <section class=\"mb-20\">\n            <h2 class=\"text-3xl font-bold section-title\">Diagnostic Guide: Panel AC Error Codes</h2>\n            <div class=\"grid md:grid-cols-2 lg:grid-cols-4 gap-4\">\n                <div class=\"p-4 bg-white rounded shadow-sm border-l-4 border-red-500\">\n                    <h4 class=\"font-bold\">E0: Probe Fault</h4>\n                    <p class=\"text-xs\">Controller cannot read internal temperature. <b>Fix:</b> Inspect NTC sensor wiring.</p>\n                </div>\n                <div class=\"p-4 bg-white rounded shadow-sm border-l-4 border-red-500\">\n                    <h4 class=\"font-bold\">E1: Cabinet High</h4>\n                    <p class=\"text-xs\">Critical heat in cabinet. <b>Fix:</b> Clean condenser fins and check fan operation.</p>\n                </div>\n                <div class=\"p-4 bg-white rounded shadow-sm border-l-4 border-red-500\">\n                    <h4 class=\"font-bold\">E2: Low Pressure</h4>\n                    <p class=\"text-xs\">System lost refrigerant or coil is frozen. <b>Fix:</b> Call for <b>Panel AC service Daman</b>.</p>\n                </div>\n                <div class=\"p-4 bg-white rounded shadow-sm border-l-4 border-red-500\">\n                    <h4 class=\"font-bold\">E3: Phase Swap</h4>\n                    <p class=\"text-xs\">Electrical phase reversal detected. <b>Fix:</b> Check main power phase sequence.</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- Used/Scrap Section -->\n        <section class=\"mb-20 bg-yellow-50 p-10 rounded-3xl border-2 border-yellow-200 text-center\">\n            <h2 class=\"text-3xl font-bold mb-4\">Industrial Buy-Back &#038; Scrap Solutions</h2>\n            <p class=\"mb-8\">Upgrade your plant&#8217;s cooling infrastructure. We buy old or corroded industrial ACs for <b>scrap</b> and sell refurbished <b>used panel AC</b> units with warranty for startups in Daman.</p>\n            <div class=\"flex justify-center gap-6\">\n                <a href=\"/contact-us\" class=\"bg-gray-800 text-white px-8 py-3 rounded-lg font-bold\">Sell Scrap Units</a>\n                <a href=\"/shop\" class=\"bg-secondary text-white px-8 py-3 rounded-lg font-bold\">Buy Certified Used</a>\n            </div>\n        </section>\n\n        <!-- FAQs -->\n        <section class=\"mb-20\">\n            <h2 class=\"text-3xl font-bold section-title text-center\">Daman Panel AC Service FAQ</h2>\n            <div class=\"max-w-4xl mx-auto space-y-4\">\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">Do you provide service in Dabhel Industrial Estate?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Yes, we have technicians stationed in Dabhel for rapid response to plastic and packaging units.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">What is the response time for Somnath area?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Our team can usually reach Somnath within 2 hours for emergency industrial AC repairs.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">Do you treat coils for coastal corrosion?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Yes, we apply specialized anti-corrosive coatings to condenser coils to withstand Daman&#8217;s salty coastal air.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">Can you repair units for Injection Molding machines?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Yes, we specialize in cooling units for injection molding PLC panels to prevent production stoppages.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">Do you service stainless steel units for Pharma?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Yes, we maintain <b>Adhunik</b> and <b>Rittal</b> SS316 units for pharmaceutical plants in Bhimpore to ensure hygiene compliance.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">What is the cost of gas refilling?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Industrial gas charging starts from ₹3,500, which includes a full leak test and system evacuation.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">Do you sell spare parts for Rittal ACs?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Yes, we stock high-quality condenser fans, compressors, and controllers for all major industrial AC brands.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">Can you handle high dust loads from textile mills?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Yes, we provide specialized filter maintenance plans for textile units in Somnath to manage lint and fluff.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">Do you provide service in Silvassa and Vapi?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">Yes, we extend our <b>Panel AC service Daman</b> to the nearby industrial hubs of Silvassa and Vapi.</p>\n                </details>\n                <details class=\"bg-white p-5 rounded-lg border shadow-sm group\">\n                    <summary class=\"font-bold cursor-pointer\">How can I book an industrial audit?</summary>\n                    <p class=\"mt-3 text-sm text-gray-600\">You can contact us via the WhatsApp button or call +91 97272 57141 for a full thermal audit of your panels.</p>\n                </details>\n            </div>\n        </section>\n\n        <!-- Residential Daman Areas -->\n        <section class=\"py-12 bg-white border rounded-2xl px-8 mb-20\">\n            <h3 class=\"text-xl font-bold mb-4\">Residential/Commercial Areas Served in Daman</h3>\n            <p class=\"text-xs text-gray-400 uppercase tracking-tighter leading-relaxed\">\n                Nani Daman | Moti Daman | Tin Batti | Dilip Nagar | Mashal Chowk | Seaface Road | Devka Road | Marwad | Khariwad | Dunetha | Varkund | Kathiria | Nani Daman Jetty | Moti Daman Fort Area | Zapabar | Pariyari | Magarwada | Patlara | Damanwada.\n            </p>\n        </section>\n\n    </main>\n\n    <!-- Global Reach -->\n    <section class=\"bg-primary text-white py-16 text-center\">\n        <div class=\"container mx-auto px-4\">\n            <h2 class=\"text-4xl font-bold mb-6\">Cooling Daman&#8217;s Industry</h2>\n            <p class=\"max-w-3xl mx-auto text-lg mb-10\">We are your trusted technical experts for <b>Panel AC service Daman</b>. Reliable, coastal-ready thermal solutions for your plants are just one call away.</p>\n            <a href=\"tel:+919727257141\" class=\"bg-secondary text-white px-12 py-4 rounded-full font-bold text-xl inline-block shadow-lg\">Call Atlas Aircon</a>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"bg-gray-900 text-gray-500 py-20\">\n        <div class=\"container mx-auto px-4 grid md:grid-cols-4 gap-12 text-sm\">\n            <div>\n                <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\" alt=\"Atlas Aircon Logo\" class=\"h-10 mb-6 grayscale brightness-150\" title=\"\">\n                <p class=\"italic\">&#8220;The Industrial Cooling Experts.&#8221; Serving Daman&#8217;s Plastic &#038; Textile belts with technical excellence since 2010.</p>\n            </div>\n            <div>\n                <h4 class=\"text-white font-bold mb-4 uppercase\">Services</h4>\n                <ul class=\"space-y-2\">\n                    <li>