lass=\"h-12 w-auto\" title=\"\">\n            </a>\n            \n            <nav class=\"hidden lg:flex space-x-6 text-sm font-medium\">\n                <a href=\"/home\" class=\"hover:text-primary transition\">Home</a>\n                <a href=\"/about-us\" class=\"hover:text-primary transition\">About Us</a>\n                <div class=\"relative group\">\n                    <button class=\"hover:text-primary flex items-center transition\">Services <i data-lucide=\"chevron-down\" class=\"w-4 h-4 ml-1\"></i></button>\n                    <div class=\"absolute left-0 mt-2 w-64 bg-white border rounded shadow-xl opacity-0 group-hover:opacity-100 invisible group-hover:visible transition-all duration-300\">\n                        <a href=\"/ac-service-daman\" class=\"block px-4 py-2 hover:bg-gray-100\">AC Service</a>\n                        <a href=\"/refrigerator-repair-services-daman\" class=\"block px-4 py-2 hover:bg-gray-100\">Refrigerator Repair</a>\n                        <a href=\"/hvac-repair-services-daman\" class=\"block px-4 py-2 hover:bg-gray-100\">HVAC Services</a>\n                        <a href=\"/cold-room-repair-services-daman\" class=\"block px-4 py-2 hover:bg-gray-100\">Cold Room</a>\n                    </div>\n                </div>\n                <a href=\"/shop\" class=\"hover:text-primary transition\">Shop</a>\n                <a href=\"/blogs\" class=\"hover:text-primary transition\">Blogs</a>\n                <a href=\"/contact-us\" class=\"hover:text-primary transition\">Contact Us</a>\n            </nav>\n\n            <a href=\"tel:+919727257141\" class=\"hidden md:inline-flex items-center bg-secondary text-white px-4 py-2 rounded-full font-bold hover:bg-orange-600 transition\">\n                <i data-lucide=\"phone-call\" class=\"w-4 h-4 mr-2\"></i> +91 97272 57141\n            </a>\n            \n            <!-- Mobile Menu Button -->\n            <button class=\"lg:hidden text-gray-700\" onclick=\"document.getElementById('mobile-menu').classList.toggle('hidden')\">\n                <i data-lucide=\"menu\" class=\"w-6 h-6\"></i>\n            </button>\n        </div>\n        \n        <!-- Mobile Menu -->\n        <div id=\"mobile-menu\" class=\"hidden lg:hidden bg-white border-t p-4\">\n            <a href=\"/home\" class=\"block py-2\">Home</a>\n            <a href=\"/refrigerator-service-center-daman\" class=\"block py-2 font-bold text-primary\">Fridge Repair</a>\n            <a href=\"/ac-repair-daman\" class=\"block py-2\">AC Repair</a>\n            <a href=\"/contact-us\" class=\"block py-2\">Contact</a>\n        </div>\n    </header>\n\n    <!-- Hero Section -->\n    <section class=\"hero-bg text-white py-24 relative\">\n        <div class=\"container mx-auto px-4 text-center lg:text-left\">\n            <h1 class=\"text-4xl lg:text-6xl font-extrabold mb-6 leading-tight\">\n                Refrigerator Service <br> <span class=\"text-secondary\">Center Daman</span>\n            </h1>\n            <p class=\"text-xl mb-8 max-w-2xl text-gray-200\">\n                Is your fridge not cooling? Need urgent <strong>refrigerator repair near me Daman</strong>? We are the region&#8217;s trusted experts for Single Door, Double Door, and Commercial Fridge repairs. Reliable, affordable, and fast.\n            </p>\n            <div class=\"flex flex-col sm:flex-row gap-4 justify-center lg:justify-start\">\n                <a href=\"https://wa.me/919727257141?text=Hi%20Atlas%20Aircon,%20I%20need%20refrigerator%20service\" class=\"inline-flex items-center justify-center bg-green-500 hover:bg-green-600 text-white px-8 py-4 rounded-full font-bold text-lg transition shadow-lg transform hover:scale-105\" target=\"_blank\" rel=\"noopener\">\n                    <i data-lucide=\"message-circle\" class=\"w-6 h-6 mr-2\"></i> WhatsApp Now\n                </a>\n                <a href=\"tel:+919727257141\" class=\"inline-flex items-center justify-center bg-white text-secondary hover:bg-gray-100 px-8 py-4 rounded-full font-bold text-lg transition shadow-lg\">\n                    <i data-lucide=\"phone\" class=\"w-6 h-6 mr-2\"></i> Call Expert\n                </a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Main Content -->\n    <main class=\"container mx-auto px-4 py-12\">\n        \n        <!-- Introduction with Focus Keyword -->\n        <section class=\"mb-16\">\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-12 items-center\">\n                <div>\n                    <h2 class=\"text-3xl font-bold mb-4 text-dark\">Premium <span class=\"text-primary\">Refrigerator Service Center Daman</span></h2>\n                    <p class=\"mb-4 text-gray-600 text-lg\">\n                        Welcome to Atlas Aircon, the leading name when you search for a <strong>refrigerator service center Daman</strong>. In the humid coastal climate of Daman, a malfunctioning fridge can lead to rapid food spoilage. Whether you are living in <strong>Nani Daman</strong>, <strong>Moti Daman</strong>, or running a business in <strong>Dabhel Industrial Estate</strong>, our team of certified technicians is ready to provide swift and efficient solutions.\n                    </p>\n                    <p class=\"mb-4 text-gray-600\">\n                        We specialize in repairing all major brands including Samsung, LG, Whirlpool, Godrej, and Haier. Unlike local mechanics, we follow standard operating procedures to ensure your appliance gets the best care. From **gas refilling** to **compressor repair**, we handle it all with transparency and professionalism.\n                    </p>\n                    <ul class=\"space-y-2 mt-6\">\n                        <li class=\"flex items-center text-gray-700\"><i data-lucide=\"check-circle\" class=\"w-5 h-5 text-green-500 mr-2\"></i> 100% Genuine Spare Parts</li>\n                        <li class=\"flex items-center text-gray-700\"><i data-lucide=\"check-circle\" class=\"w-5 h-5 text-green-500 mr-2\"></i> 90-Day Service Warranty</li>\n                        <li class=\"flex items-center text-gray-700\"><i data-lucide=\"check-circle\" class=\"w-5 h-5 text-green-500 mr-2\"></i> Doorstep Service across Daman</li>\n                    </ul>\n                </div>\n                <div class=\"relative\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/02/Atlas-Aircon-1.webp\" alt=\"Refrigerator Service Center Daman Technician at work\" class=\"rounded-xl shadow-2xl w-full object-cover h-96 transform hover:-translate-y-2 transition duration-500\" title=\"\">\n                    <div class=\"absolute -bottom-6 -left-6 bg-white p-4 rounded-lg shadow-xl hidden md:block\">\n                        <div class=\"flex items-center gap-3\">\n                            <div class=\"bg-primary p-3 rounded-full text-white\">\n                                <i data-lucide=\"thumbs-up\" class=\"w-6 h-6\"></i>\n                            </div>\n                            <div>\n                                <p class=\"font-bold text-xl\">10+ Years</p>\n                                <p class=\"text-sm text-gray-500\">Of Experience</p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- Types of Fridges We Repair -->\n        <section class=\"mb-16\">\n            <h2 class=\"text-3xl font-bold text-center mb-10\">We Repair All Types of Refrigerators</h2>\n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n                <!-- Single Door -->\n                <div class=\"bg-white p-6 rounded-xl shadow-md border hover:border-primary transition group\">\n                    <div class=\"h-12 w-12 bg-blue-100 text-primary rounded-full flex items-center justify-center mb-4 group-hover:bg-primary group-hover:text-white transition\">\n                        <i data-lucide=\"snowflake\" class=\"w-6 h-6\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-bold mb-3\">Single Door Fridge Repair</h3>\n                    <p class=\"text-gray-600 mb-4\">Expert repair for frost-free and direct cool single door models. We fix thermostat issues, ice buildup, and cooling problems instantly.</p>\n                    <a href=\"/refrigerator-repair-services-daman\" class=\"text-secondary font-semibold hover:underline\">Learn more &rarr;</a>\n                </div>\n\n                <!-- Double Door -->\n                <div class=\"bg-white p-6 rounded-xl shadow-md border hover:border-primary transition group\">\n                    <div class=\"h-12 w-12 bg-blue-100 text-primary rounded-full flex items-center justify-center mb-4 group-hover:bg-primary group-hover:text-white transition\">\n                        <i data-lucide=\"columns\" class=\"w-6 h-6\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-bold mb-3\">Double Door Refrigerator Service</h3>\n                    <p class=\"text-gray-600 mb-4\">Complete servicing for top-mount and bottom-mount double door fridges. PCB repair, fan motor replacement, and gas charging.</p>\n                    <a href=\"/refrigerator-repair-services-daman\" class=\"text-secondary font-semibold hover:underline\">Learn more &rarr;</a>\n                </div>\n\n                <!-- Side by Side -->\n                <div class=\"bg-white p-6 rounded-xl shadow-md border hover:border-primary transition group\">\n                    <div class=\"h-12 w-12 bg-blue-100 text-primary rounded-full flex items-center justify-center mb-4 group-hover:bg-primary group-hover:text-white transition\">\n                        <i data-lucide=\"box\" class=\"w-6 h-6\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-bold mb-3\">Side by Side Fridge Repair</h3>\n                    <p class=\"text-gray-600 mb-4\">Premium service for high-end side-by-side refrigerators. Inverter compressor troubleshooting and digital panel repairs.</p>\n                    <a href=\"/refrigerator-repair-services-daman\" class=\"text-secondary font-semibold hover:underline\">Learn more &rarr;</a>\n                </div>\n\n                <!-- Deep Freezer -->\n                <div class=\"bg-white p-6 rounded-xl shadow-md border hover:border-primary transition group\">\n                    <div class=\"h-12 w-12 bg-blue-100 text-primary rounded-full flex items-center justify-center mb-4 group-hover:bg-primary group-hover:text-white transition\">\n                        <i data-lucide=\"thermometer-snowflake\" class=\"w-6 h-6\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-bold mb-3\">Deep Freezer Repair</h3>\n                    <p class=\"text-gray-600 mb-4\">Commercial deep freezer repair for shops and industries. We ensure your frozen goods stay frozen with rapid compressor fixes.</p>\n                    <a href=\"/deep-freezer-repair-services-daman\" class=\"text-secondary font-semibold hover:underline\">Learn more &rarr;</a>\n                </div>\n\n                <!-- Cold Room -->\n                <div class=\"bg-white p-6 rounded-xl shadow-md border hover:border-primary transition group\">\n                    <div class=\"h-12 w-12 bg-blue-100 text-primary rounded-full flex items-center justify-center mb-4 group-hover:bg-primary group-hover:text-white transition\">\n                        <i data-lucide=\"warehouse\" class=\"w-6 h-6\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-bold mb-3\">Cold Room &#038; Chiller</h3>\n                    <p class=\"text-gray-600 mb-4\">Industrial cold storage solutions. We serve pharmaceutical and food industries in OIDC areas with specialized technicians.</p>\n                    <a href=\"/cold-room-repair-services-daman\" class=\"text-secondary font-semibold hover:underline\">Learn more &rarr;</a>\n                </div>\n\n                <!-- Water Cooler -->\n                <div class=\"bg-white p-6 rounded-xl shadow-md border hover:border-primary transition group\">\n                    <div class=\"h-12 w-12 bg-blue-100 text-primary rounded-full flex items-center justify-center mb-4 group-hover:bg-primary group-hover:text-white transition\">\n                        <i data-lucide=\"glass-water\" class=\"w-6 h-6\"></i>\n                    </div>\n                    <h3 class=\"text-xl font-bold mb-3\">Water Cooler Repair</h3>\n                    <p class=\"text-gray-600 mb-4\">Commercial water cooler service for schools, offices, and factories. Tank cleaning, tap replacement, and cooling repair.</p>\n                    <a href=\"/water-cooler-repair-services-daman\" class=\"text-secondary font-semibold hover:underline\">Learn more &rarr;</a>\n                </div>\n            </div>\n        </section>\n\n        <!-- Brands We Service -->\n        <section class=\"py-12 bg-gray-100 rounded-2xl mb-16\">\n            <div class=\"container mx-auto px-6\">\n                <h2 class=\"text-3xl font-bold text-center mb-8\">Brands We Service</h2>\n                <p class=\"text-center text-gray-600 mb-10 max-w-3xl mx-auto\">We are specialists in multi-brand refrigerator repair. While we are an independent service center, our technicians are trained to handle the specific technologies of all major manufacturers found in Indian homes.</p>\n                <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-6 text-center\">\n                    <div class=\"bg-white p-4 rounded shadow hover:shadow-lg transition flex items-center justify-center font-bold text-gray-700\">Samsung</div>\n                    <div class=\"bg-white p-4 rounded shadow hover:shadow-lg transition flex items-center justify-center font-bold text-gray-700\">LG</div>\n                    <div class=\"bg-white p-4 rounded shadow hover:shadow-lg transition flex items-center justify-center font-bold text-gray-700\">Whirlpool</div>\n                    <div class=\"bg-white p-4 rounded shadow hover:shadow-lg transition flex items-center justify-center font-bold text-gray-700\">Godrej</div>\n                    <div class=\"bg-white p-4 rounded shadow hover:shadow-lg transition flex items-center justify-center font-bold text-gray-700\">Haier</div>\n                    <div class=\"bg-white p-4 rounded shadow hover:shadow-lg transition flex items-center justify-center font-bold text-gray-700\">Voltas</div>\n                    <div class=\"bg-white p-4 rounded shadow hover:shadow-lg transition flex items-center justify-center font-bold text-gray-700\">Panasonic</div>\n                    <div class=\"bg-white p-4 rounded shadow hover:shadow-lg transition flex items-center justify-center font-bold text-gray-700\">Hitachi</div>\n                    <div class=\"bg-white p-4 rounded shadow hover:shadow-lg transition flex items-center justify-center font-bold text-gray-700\">Blue Star</div>\n                    <div class=\"bg-white p-4 rounded shadow hover:shadow-lg transition flex items-center justify-center font-bold text-gray-700\">Kelvinator</div>\n                    <div class=\"bg-white p-4 rounded shadow hover:shadow-lg transition flex items-center justify-center font-bold text-gray-700\">Videocon</div>\n                    <div class=\"bg-white p-4 rounded shadow hover:shadow-lg transition flex items-center justify-center font-bold text-gray-700\">Mitashi</div>\n                </div>\n            </div>\n        </section>\n\n        <!-- Pricing Table -->\n        <section class=\"mb-16\">\n            <h2 class=\"text-3xl font-bold text-center mb-4\">Refrigerator Repair Price List Daman</h2>\n            <p class=\"text-center text-gray-600 mb-8\">Transparent pricing with no hidden charges. Labor charges may vary based on complexity.</p>\n            \n            <div class=\"overflow-x-auto shadow-lg rounded-lg\">\n                <table class=\"min-w-full bg-white\">\n                    <thead class=\"bg-dark text-white\">\n                        <tr>\n                            <th class=\"py-3 px-6 text-left\">Service Description</th>\n                            <th class=\"py-3 px-6 text-left\">Product Type</th>\n                            <th class=\"py-3 px-6 text-left\">Estimated Cost (INR)</th>\n                            <th class=\"py-3 px-6 text-center\">Action</th>\n                        </tr>\n                    </thead>\n                    <tbody class=\"text-gray-700\">\n                        <tr class=\"border-b hover:bg-gray-50\">\n                            <td class=\"py-3 px-6\">Inspection / Visit Charge</td>\n                            <td class=\"py-3 px-6\">All Types</td>\n                            <td class=\"py-3 px-6\">₹199 &#8211; ₹350</td>\n                            <td class=\"py-3 px-6 text-center\"><a href=\"/contact-us\" class=\"text-secondary font-bold hover:underline\">Book</a></td>\n                        </tr>\n                        <tr class=\"border-b hover:bg-gray-50\">\n                            <td class=\"py-3 px-6\">Gas Refilling (R134a/R600a)</td>\n                            <td class=\"py-3 px-6\">Single Door</td>\n                            <td class=\"py-3 px-6\">₹1,200 &#8211; ₹1,800</td>\n                            <td class=\"py-3 px-6 text-center\"><a href=\"/contact-us\" class=\"text-secondary font-bold hover:underline\">Book</a></td>\n                        </tr>\n                        <tr class=\"border-b hover:bg-gray-50\">\n                            <td class=\"py-3 px-6\">Gas Refilling (R134a/R600a)</td>\n                            <td class=\"py-3 px-6\">Double Door</td>\n                            <td class=\"py-3 px-6\">₹1,800 &#8211; ₹2,500</td>\n                            <td class=\"py-3 px-6 text-center\"><a href=\"/contact-us\" class=\"text-secondary font-bold hover:underline\">Book</a></td>\n                        </tr>\n                        <tr class=\"border-b hover:bg-gray-50\">\n                            <td class=\"py-3 px-6\">Compressor Replacement</td>\n                            <td class=\"py-3 px-6\">All Types</td>\n                            <td class=\"py-3 px-6\">₹3,500 &#8211; ₹8,000 +</td>\n                            <td class=\"py-3 px-6 text-center\"><a href=\"/contact-us\" class=\"text-secondary font-bold hover:underline\">Book</a></td>\n                        </tr>\n                        <tr class=\"border-b hover:bg-gray-50\">\n                            <td class=\"py-3 px-6\">Thermostat Replacement</td>\n                            <td class=\"py-3 px-6\">Single/Double</td>\n                            <td class=\"py-3 px-6\">₹650 &#8211; ₹1,200</td>\n                            <td class=\"py-3 px-6 text-center\"><a href=\"/contact-us\" class=\"text-secondary font-bold hover:underline\">Book</a></td>\n                        </tr>\n                        <tr class=\"border-b hover:bg-gray-50\">\n                            <td class=\"py-3 px-6\">PCB Repair / Replacement</td>\n                            <td class=\"py-3 px-6\">Inverter Models</td>\n                            <td class=\"py-3 px-6\">₹1,500 &#8211; ₹4,500</td>\n                            <td class=\"py-3 px-6 text-center\"><a href=\"/contact-us\" class=\"text-secondary font-bold hover:underline\">Book</a></td>\n                        </tr>\n                        <tr class=\"border-b hover:bg-gray-50\">\n                            <td class=\"py-3 px-6\">Door Gasket Replacement</td>\n                            <td class=\"py-3 px-6\">Per Door</td>\n                            <td class=\"py-3 px-6\">₹600 &#8211; ₹1,200</td>\n                            <td class=\"py-3 px-6 text-center\"><a href=\"/contact-us\" class=\"text-secondary font-bold hover:underline\">Book</a></td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n            <p class=\"text-sm text-gray-500 mt-2\">* Prices are indicative and may change based on brand and spare part availability.</p>\n        </section>\n\n        <!-- Pros and Cons -->\n        <section class=\"grid grid-cols-1 md:grid-cols-2 gap-8 mb-16\">\n            <div class=\"bg-green-50 p-8 rounded-xl border border-green-200\">\n                <h3 class=\"text-2xl font-bold mb-6 text-green-700 flex items-center\"><i data-lucide=\"thumbs-up\" class=\"w-6 h-6 mr-2\"></i> Pros of Choosing Atlas Aircon</h3>\n                <ul class=\"space-y-3\">\n                    <li class=\"pro-con-item pro-item\">Experienced technicians with background checks.</li>\n                    <li class=\"pro-con-item pro-item\">Transparent pricing provided before work begins.</li>\n                    <li class=\"pro-con-item pro-item\">Usage of 100% genuine spare parts for longevity.</li>\n                    <li class=\"pro-con-item pro-item\">90-day warranty on all repairs and parts.</li>\n                    <li class=\"pro-con-item pro-item\">Prompt response time in Daman city limits.</li>\n                    <li class=\"pro-con-item pro-item\">Adherence to safety protocols and cleanliness.</li>\n                    <li class=\"pro-con-item pro-item\">Available for emergency breakdowns 7 days a week.</li>\n                </ul>\n            </div>\n            <div class=\"bg-red-50 p-8 rounded-xl border border-red-200\">\n                <h3 class=\"text-2xl font-bold mb-6 text-red-700 flex items-center\"><i data-lucide=\"thumbs-down\" class=\"w-6 h-6 mr-2\"></i> Cons of Neglecting Service</h3>\n                <ul class=\"space-y-3\">\n                    <li class=\"pro-con-item con-item\">Increased electricity bills due to inefficient cooling.</li>\n                    <li class=\"pro-con-item con-item\">Food spoilage leading to health risks and waste.</li>\n                    <li class=\"pro-con-item con-item\">Minor issues escalating into major compressor failures.</li>\n                    <li class=\"pro-con-item con-item\">Water leakage causing damage to kitchen flooring.</li>\n                    <li class=\"pro-con-item con-item\">Unpleasant odors developing inside the refrigerator.</li>\n                    <li class=\"pro-con-item con-item\">Reduced lifespan of the appliance.</li>\n                    <li class=\"pro-con-item con-item\">Risk of electrical short circuits.</li>\n                </ul>\n            </div>\n        </section>\n\n        <!-- Used, Buy & Sell Section -->\n        <section class=\"bg-dark text-white p-12 rounded-2xl mb-16 relative overflow-hidden\">\n            <div class=\"relative z-10 text-center\">\n                <h2 class=\"text-3xl font-bold mb-4\">We Buy &#038; Sell Used Refrigerators &#038; Scrap</h2>\n                <p class=\"mb-8 max-w-2xl mx-auto text-gray-300\">Looking to upgrade? We buy old, non-working, or scrap refrigerators at the best market price in Daman. We also sell refurbished, second-hand units with warranty.</p>\n                <div class=\"flex flex-col sm:flex-row gap-4 justify-center\">\n                    <a href=\"/shop\" class=\"bg-secondary hover:bg-orange-600 text-white px-6 py-3 rounded-lg font-bold transition\">Buy Refurbished Fridge</a>\n                    <a href=\"/contact-us\" class=\"bg-transparent border border-white hover:bg-white hover:text-dark text-white px-6 py-3 rounded-lg font-bold transition\">Sell Old Fridge</a>\n                </div>\n            </div>\n            <div class=\"absolute top-0 right-0 opacity-10 transform translate-x-1/4 -translate-y-1/4\">\n                <i data-lucide=\"recycle\" class=\"w-96 h-96\"></i>\n            </div>\n        </section>\n\n        <!-- Troubleshooting / Error Codes -->\n        <section class=\"mb-16\">\n            <h2 class=\"text-3xl font-bold mb-6\">Common Refrigerator Error Codes &#038; Solutions</h2>\n            <div class=\"bg-white shadow-md rounded-lg p-6\">\n                <p class=\"mb-4\">Modern fridges display error codes on the digital panel. Here is what they often mean:</p>\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                    <div class=\"border-l-4 border-primary pl-4 py-2 bg-gray-50\">\n                        <strong class=\"block text-lg\">E1 / 1E / SE</strong>\n                        <span class=\"text-gray-600\">Usually indicates a sensor error or power outage issue. Try resetting the fridge.</span>\n                    </div>\n                    <div class=\"border-l-4 border-secondary pl-4 py-2 bg-gray-50\">\n                        <strong class=\"block text-lg\">E2 / 5E</strong>\n                        <span class=\"text-gray-600\">Often related to the defrost system or freezer sensor malfunction.</span>\n                    </div>\n                    <div class=\"border-l-4 border-primary pl-4 py-2 bg-gray-50\">\n                        <strong class=\"block text-lg\">H1 / HE</strong>\n                        <span class=\"text-gray-600\">Temperature is too high in the freezer compartment. Check door seal.</span>\n                    </div>\n                    <div class=\"border-l-4 border-secondary pl-4 py-2 bg-gray-50\">\n                        <strong class=\"block text-lg\">Water Leakage</strong>\n                        <span class=\"text-gray-600\">Blocked drain pipe or cracked drain pan. Requires physical cleaning.</span>\n                    </div>\n                </div>\n                <p class=\"mt-4 text-sm text-red-500 font-bold\">Note: Always unplug your appliance before attempting any DIY checks. For complex codes, call our professional refrigerator repair service Daman.</p>\n            </div>\n        </section>\n\n        <!-- Areas Served -->\n        <section class=\"mb-16\">\n            <h2 class=\"text-3xl font-bold mb-8 text-center\">Areas We Serve in Daman</h2>\n            \n            <div class=\"mb-8\">\n                <h3 class=\"text-xl font-bold text-primary mb-4 border-b pb-2\">Residential Areas</h3>\n                <div class=\"text-sm text-gray-600 leading-relaxed text-justify\">\n                    Nani Daman | Moti Daman | Dunetha | Kathiria | Marwad | Kadaiya | Varkund | Bhimpore | Tin Batti | Dilip Nagar | Mashal Chowk | Seaface Road | Khariwad | Vapi Road | Daman Road | Somnath | Kachigam | Jampore Beach Road | Devka Beach Area | Kolak.\n                </div>\n            </div>\n\n            <div>\n                <h3 class=\"text-xl font-bold text-secondary mb-4 border-b pb-2\">Industrial &#038; OIDC Areas</h3>\n                <div class=\"text-sm text-gray-600 leading-relaxed text-justify\">\n                    Dabhel Industrial Estate | Bhimpore Industrial Area | Ringanwada Industrial Complex | Somnath Industrial Estate | Kachigam Industrial Zone | Kadaiya Industrial Zone | OIDC Industrial Estates | Bharat Industrial Estate | Daman Ganga Industrial Park | Panchal Udyog Nagar.\n                </div>\n            </div>\n        </section>\n\n        <!-- FAQs -->\n        <section class=\"mb-16 max-w-4xl mx-auto\">\n            <h2 class=\"text-3xl font-bold text-center mb-8\">Frequently Asked Questions</h2>\n            <div class=\"space-y-4\">\n                <!-- FAQ 1 -->\n                <details class=\"group bg-white rounded-lg shadow-sm border border-gray-200\">\n                    <summary class=\"flex justify-between items-center font-medium cursor-pointer list-none p-5 text-lg\">\n                        <span>How quickly can you fix my refrigerator in Daman?</span>\n                        <span class=\"transition group-open:rotate-180\"><i data-lucide=\"chevron-down\"></i></span>\n                    </summary>\n                    <div class=\"text-gray-600 mt-0 px-5 pb-5\">\n                        We strive for same-day service. Once you book a complaint, our technician usually arrives within 2-4 hours depending on your location in Daman.\n                    </div>\n                </details>\n\n                <!-- FAQ 2 -->\n                <details class=\"group bg-white rounded-lg shadow-sm border border-gray-200\">\n                    <summary class=\"flex justify-between items-center font-medium cursor-pointer list-none p-5 text-lg\">\n                        <span>Do you provide a warranty on repairs?</span>\n                        <span class=\"transition group-open:rotate-180\"><i data-lucide=\"chevron-down\"></i></span>\n                    </summary>\n                    <div class=\"text-gray-600 mt-0 px-5 pb-5\">\n                        Yes, we offer a 90-day service warranty on repairs and a manufacturer warranty on any new spare parts installed.\n                    </div>\n                </details>\n\n                <!-- FAQ 3 -->\n                <details class=\"group bg-white rounded-lg shadow-sm border border-gray-200\">\n                    <summary class=\"flex justify-between items-center font-medium cursor-pointer list-none p-5 text-lg\">\n                        <span>Why is my fridge running but not cooling?</span>\n                        <span class=\"transition group-open:rotate-180\"><i data-lucide=\"chevron-down\"></i></span>\n                    </summary>\n                    <div class=\"text-gray-600 mt-0 px-5 pb-5\">\n                        This is commonly caused by dirty condenser coils, a faulty evaporator fan, or a lack of refrigerant (gas). Our technicians can diagnose this quickly.\n                    </div>\n                </details>\n\n                <!-- FAQ 4 -->\n                <details class=\"group bg-white rounded-lg shadow-sm border border-gray-200\">\n                    <summary class=\"flex justify-between items-center font-medium cursor-pointer list-none p-5 text-lg\">\n                        <span>Do you repair old refrigerator models?</span>\n                        <span class=\"transition group-open:rotate-180\"><i data-lucide=\"chevron-down\"></i></span>\n                    </summary>\n                    <div class=\"text-gray-600 mt-0 px-5 pb-5\">\n                        Yes, we repair models of all ages. If the spare parts are available in the market or can be sourced, we will fix it.\n                    </div>\n                </details>\n\n                <!-- FAQ 5 -->\n                <details class=\"group bg-white rounded-lg shadow-sm border border-gray-200\">\n                    <summary class=\"flex justify-between items-center font-medium cursor-pointer list-none p-5 text-lg\">\n                        <span>Is there a visiting charge?</span>\n                        <span class=\"transition group-open:rotate-180\"><i data-lucide=\"chevron-down\"></i></span>\n                    </summary>\n                    <div class=\"text-gray-600 mt-0 px-5 pb-5\">\n                        Yes, there is a nominal inspection charge. However, if you proceed with the repair service, this amount is often adjusted in the final bill.\n                    </div>\n                </details>\n\n                <!-- FAQ 6 -->\n                <details class=\"group bg-white rounded-lg shadow-sm border border-gray-200\">\n                    <summary class=\"flex justify-between items-center font-medium cursor-pointer list-none p-5 text-lg\">\n                        <span>Do you serve industrial areas like Dabhel?</span>\n                        <span class=\"transition group-open:rotate-180\"><i data-lucide=\"chevron-down\"></i></span>\n                    </summary>\n                    <div class=\"text-gray-600 mt-0 px-5 pb-5\">\n                        Absolutely. We have specialized teams for industrial and commercial refrigeration units in areas like Dabhel, Bhimpore, and Kachigam.\n                    </div>\n                </details>\n                \n                 <!-- FAQ 7 -->\n                <details class=\"group bg-white rounded-lg shadow-sm border border-gray-200\">\n                    <summary class=\"flex justify-between items-center font-medium cursor-pointer list-none p-5 text-lg\">\n                        <span>Which brands do you service?</span>\n                        <span class=\"transition group-open:rotate-180\"><i data-lucide=\"chevron-down\"></i></span>\n                    </summary>\n                    <div class=\"text-gray-600 mt-0 px-5 pb-5\">\n                        We service all major brands including LG, Samsung, Whirlpool, Godrej, Haier, Panasonic, and Hitachi.\n                    </div>\n                </details>\n                 <!-- FAQ 8 -->\n                <details class=\"group bg-white rounded-lg shadow-sm border border-gray-200\">\n                    <summary class=\"flex justify-between items-center font-medium cursor-pointer list-none p-5 text-lg\">\n                        <span>Can I pay online?</span>\n                        <span class=\"transition group-open:rotate-180\"><i data-lucide=\"chevron-down\"></i></span>\n                    </summary>\n                    <div class=\"text-gray-600 mt-0 px-5 pb-5\">\n                        Yes, we accept Cash, UPI (GPay, PhonePe), and Online Transfers.\n                    </div>\n                </details>\n                  <!-- FAQ 9 -->\n                <details class=\"group bg-white rounded-lg shadow-sm border border-gray-200\">\n                    <summary class=\"flex justify-between items-center font-medium cursor-pointer list-none p-5 text-lg\">\n                        <span>Why is my fridge leaking water?</span>\n                        <span class=\"transition group-open:rotate-180\"><i data-lucide=\"chevron-down\"></i></span>\n                    </summary>\n                    <div class=\"text-gray-600 mt-0 px-5 pb-5\">\n                       Water leakage is often due to a clogged defrost drain. This causes water to overflow and leak onto the floor. It is a simple fix for our experts.\n                    </div>\n                </details>\n                 <!-- FAQ 10 -->\n                <details class=\"group bg-white rounded-lg shadow-sm border border-gray-200\">\n                    <summary class=\"flex justify-between items-center font-medium cursor-pointer list-none p-5 text-lg\">\n                        <span>How do I book a service?</span>\n                        <span class=\"transition group-open:rotate-180\"><i data-lucide=\"chevron-down\"></i></span>\n                    </summary>\n                    <div class=\"text-gray-600 mt-0 px-5 pb-5\">\n                        You can call us directly at +91 97272 57141 or click the WhatsApp button on our website to schedule a visit.\n                    </div>\n                </details>\n            </div>\n        </section>\n\n    </main>\n\n    <!-- Footer -->\n    <footer class=\"bg-dark text-gray-300 py-12\">\n        <div class=\"container mx-auto px-4\">\n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-8\">\n                <!-- About -->\n                <div>\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\" alt=\"Atlas Aircon Logo\" class=\"h-12 mb-4 bg-white rounded px-2\" title=\"\">\n                    <p class=\"text-sm leading-relaxed\">\n                        Atlas Aircon is the premier repair service for air conditioners and refrigerators. We provide reliable, cost-effective solutions for homes and industries.\n                    </p>\n                    <div class=\"mt-4 flex space-x-4\">\n                        <a href=\"#\" class=\"hover:text-white\"><i data-lucide=\"facebook\"></i></a>\n                        <a href=\"#\" class=\"hover:text-white\"><i data-lucide=\"instagram\"></i></a>\n                        <a href=\"#\" class=\"hover:text-white\"><i data-lucide=\"twitter\"></i></a>\n                    </div>\n                </div>\n\n                <!-- Quick Links -->\n                <div>\n                    <h4 class=\"text-white font-bold text-lg mb-4\">Quick Links</h4>\n                    <ul class=\"space-y-2 text-sm\">\n                        <li><a href=\"/home\" class=\"hover:text-secondary\">Home</a></li>\n                        <li><a href=\"/about-us\" class=\"hover:text-secondary\">About Us</a></li>\n                        <li><a href=\"/shop\" class=\"hover:text-secondary\">Shop Spares</a></li>\n                        <li><a href=\"/ac-technician-jobs\" class=\"hover:text-secondary\">Technician Jobs</a></li>\n                        <li><a href=\"/blogs\" class=\"hover:text-secondary\">Our Blog</a></li>\n                        <li><a href=\"/privacy-policy\" class=\"hover:text-secondary\">Privacy Policy</a></li>\n                        <li><a href=\"/locations\" class=\"hover:text-secondary\">Locations</a></li>\n                    </ul>\n                </div>\n\n                <!-- Services -->\n                <div>\n                    <h4 class=\"text-white font-bold text-lg mb-4\">Our Services</h4>\n                    <ul class=\"space-y-2 text-sm\">\n                        <li><a href=\"/ac-service-daman\" class=\"hover:text-secondary\">AC Service Daman</a></li>\n                        <li><a href=\"/refrigerator-repair-services-daman\" class=\"hover:text-secondary\">Refrigerator Repair</a></li>\n                        <li><a href=\"/deep-freezer-repair-services-daman\" class=\"hover:text-secondary\">Deep Freezer Service</a></li>\n                        <li><a href=\"/central-ac-repair-services-daman\" class=\"hover:text-secondary\">Central AC Repair</a></li>\n                        <li><a href=\"/water-cooler-repair-services-daman\" class=\"hover:text-secondary\">Water Cooler Repair</a></li>\n                        <li><a href=\"/hvac-repair-services-daman\" class=\"hover:text-secondary\">HVAC Services</a></li>\n                        <li><a href=\"/ducting-repair-services-daman\" class=\"hover:text-secondary\">Ducting Repair</a></li>\n                    </ul>\n                </div>\n\n                <!-- Contact -->\n                <div>\n                    <h4 class=\"text-white font-bold text-lg mb-4\">Contact Info</h4>\n                    <ul class=\"space-y-3 text-sm\">\n                        <li class=\"flex items-start\">\n                            <i data-lucide=\"map-pin\" class=\"w-5 h-5 mr-2 text-secondary shrink-0\"></i>\n                            <span>Daman, Daman and Diu 396210</span>\n                        </li>\n                        <li class=\"flex items-center\">\n                            <i data-lucide=\"phone\" class=\"w-5 h-5 mr-2 text-secondary shrink-0\"></i>\n                            <a href=\"tel:+919727257141\" class=\"hover:text-white\">+91 97272 57141</a>\n                        </li>\n                        <li class=\"flex items-center\">\n                            <i data-lucide=\"mail\" class=\"w-5 h-5 mr-2 text-secondary shrink-0\"></i>\n                            <a href=\"mailto:atlasaircon1@gmail.com\" class=\"hover:text-white\">atlasaircon1@gmail.com</a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n            \n            <div class=\"border-t border-gray-700 pt-8 mt-8 text-center text-sm text-gray-500\">\n                <p>&copy; 2025 Atlas Aircon. All Rights Reserved.</p>\n                <div class=\"mt-4 flex flex-wrap justify-center gap-2\">\n                    <a href=\"/carrier-ac-service-center-daman\" class=\"text-xs hover:text-gray-300\">Carrier Service</a> |\n                    <a href=\"/panasonic-ac-service-center-daman\" class=\"text-xs hover:text-gray-300\">Panasonic Service</a> |\n                    <a href=\"/ac-installation-daman\" class=\"text-xs hover:text-gray-300\">AC Installation</a> | \n                    <a href=\"/split-ac-service-daman\" class=\"text-xs hover:text-gray-300\">Split AC Service</a>\n                </div>\n            </div>\n        </div>\n    </footer>\n\n    <!-- Initializing Icons -->\n    <script>\n        lucide.createIcons();\n    </script>\n</div>",
