over:underline\">Read More <i class=\"fas fa-arrow-right ml-1\"></i></a>\n                </div>\n            </div>\n\n            <!-- Service Block 3 -->\n            <div class=\"bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition duration-300 group\">\n                <div class=\"h-48 overflow-hidden flex items-center justify-center bg-gray-200\">\n                    <i class=\"fas fa-snowflake text-6xl text-blue-400\"></i>\n                </div>\n                <div class=\"p-6\">\n                    <h3 class=\"text-xl font-bold mb-2\">Central AC Repair</h3>\n                    <p class=\"text-gray-600 text-sm mb-4\">Fixing air handling units (AHU) and fan coil units (FCU) connected to your central ducting system.</p>\n                    <a href=\"/central-ac-repair-services-bharuch\" class=\"text-blue-600 font-bold hover:underline\">Read More <i class=\"fas fa-arrow-right ml-1\"></i></a>\n                </div>\n            </div>\n\n            <!-- Service Block 4 -->\n            <div class=\"bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition duration-300 group\">\n                <div class=\"h-48 overflow-hidden\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/07/rittal-panel-ac-service.webp\" alt=\"Panel AC Repair\" class=\"w-full h-full object-cover group-hover:scale-110 transition duration-500\" title=\"\">\n                </div>\n                <div class=\"p-6\">\n                    <h3 class=\"text-xl font-bold mb-2\">Panel AC Service</h3>\n                    <p class=\"text-gray-600 text-sm mb-4\">Specialized ducting and cooling for CNC machines and electrical control panels in Panoli/Dahej industries.</p>\n                    <a href=\"/panel-ac-service-bharuch\" class=\"text-blue-600 font-bold hover:underline\">Read More <i class=\"fas fa-arrow-right ml-1\"></i></a>\n                </div>\n            </div>\n\n            <!-- Service Block 5 -->\n            <div class=\"bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition duration-300 group\">\n                <div class=\"h-48 overflow-hidden\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2024/01/Water-Cooler-Repair-Service-near-me-in-vadodara-scaled.webp\" alt=\"Water Cooler Repair\" class=\"w-full h-full object-cover group-hover:scale-110 transition duration-500\" title=\"\">\n                </div>\n                <div class=\"p-6\">\n                    <h3 class=\"text-xl font-bold mb-2\">Water Cooler Repair</h3>\n                    <p class=\"text-gray-600 text-sm mb-4\">Industrial water cooler servicing and installation for factories and commercial complexes.</p>\n                    <a href=\"/water-cooler-repair-services-bharuch\" class=\"text-blue-600 font-bold hover:underline\">Read More <i class=\"fas fa-arrow-right ml-1\"></i></a>\n                </div>\n            </div>\n\n            <!-- Service Block 6 -->\n            <div class=\"bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition duration-300 group\">\n                <div class=\"h-48 overflow-hidden flex items-center justify-center bg-gray-200\">\n                    <i class=\"fas fa-wind text-6xl text-gray-500\"></i>\n                </div>\n                <div class=\"p-6\">\n                    <h3 class=\"text-xl font-bold mb-2\">Ventilation &#038; Exhaust</h3>\n                    <p class=\"text-gray-600 text-sm mb-4\">Design and repair of industrial exhaust systems, fresh air units, and kitchen exhausts.</p>\n                    <a href=\"/air-handling-unit-services-bharuch\" class=\"text-blue-600 font-bold hover:underline\">Read More <i class=\"fas fa-arrow-right ml-1\"></i></a>\n                </div>\n            </div>\n        </div>\n        \n        <!-- More Links Text -->\n        <div class=\"mt-8 text-center text-sm text-gray-500 space-x-2 content-area\">\n            <span>Also serving:</span>\n            <a href=\"/chiller-repair-services-bharuch\">Chiller Repair</a> |\n            <a href=\"/ac-service-bharuch\">AC Service</a> |\n            <a href=\"/deep-freezer-repair-services-bharuch\">Deep Freezer Repair</a> |\n            <a href=\"/refrigerator-repair-services-bharuch\">Refrigerator Service</a> |\n            <a href=\"/hvac-repair-services-bharuch\">HVAC Projects</a>\n        </div>\n    </section>\n\n    <!-- BRANDS WE SERVICE -->\n    <section class=\"py-12 bg-white\">\n        <div class=\"container mx-auto px-4\">\n            <h2 class=\"text-3xl font-bold text-center mb-8\">Brands We Service</h2>\n            <p class=\"text-center mb-8 text-gray-600 max-w-3xl mx-auto\">\n                Our technicians are trained to handle ducting and HVAC systems from all major global and local manufacturers. \n                <span class=\"italic text-sm\">(Note: We are a third-party multi-brand service center).</span>\n            </p>\n            <div class=\"flex flex-wrap justify-center gap-6 items-center opacity-80\">\n                <span class=\"text-2xl font-bold text-gray-400 hover:text-blue-600 transition p-4 border rounded\">Voltas</span>\n                <span class=\"text-2xl font-bold text-gray-400 hover:text-blue-600 transition p-4 border rounded\">Blue Star</span>\n                <span class=\"text-2xl font-bold text-gray-400 hover:text-blue-600 transition p-4 border rounded\">Daikin</span>\n                <span class=\"text-2xl font-bold text-gray-400 hover:text-blue-600 transition p-4 border rounded\">Carrier</span>\n                <span class=\"text-2xl font-bold text-gray-400 hover:text-blue-600 transition p-4 border rounded\">Hitachi</span>\n                <span class=\"text-2xl font-bold text-gray-400 hover:text-blue-600 transition p-4 border rounded\">Mitsubishi</span>\n                <span class=\"text-2xl font-bold text-gray-400 hover:text-blue-600 transition p-4 border rounded\">LG</span>\n                <span class=\"text-2xl font-bold text-gray-400 hover:text-blue-600 transition p-4 border rounded\">Samsung</span>\n                <span class=\"text-2xl font-bold text-gray-400 hover:text-blue-600 transition p-4 border rounded\">O-General</span>\n                <span class=\"text-2xl font-bold text-gray-400 hover:text-blue-600 transition p-4 border rounded\">Lloyd</span>\n                <span class=\"text-2xl font-bold text-gray-400 hover:text-blue-600 transition p-4 border rounded\">Panasonic</span>\n                <span class=\"text-2xl font-bold text-gray-400 hover:text-blue-600 transition p-4 border rounded\">Godrej</span>\n            </div>\n            <div class=\"text-center mt-6\">\n                <a href=\"/ac-repair-bharuch\" class=\"text-blue-600 underline\">View all supported AC brands</a>\n            </div>\n        </div>\n    </section>\n\n    <!-- PRICING TABLE (WooCommerce Style) -->\n    <section class=\"py-16 bg-gray-50\">\n        <div class=\"container mx-auto px-4\">\n            <h2 class=\"text-3xl font-bold text-center mb-10\">Ducting Service Price List Bharuch</h2>\n            <div class=\"overflow-x-auto shadow-lg rounded-lg\">\n                <table class=\"min-w-full bg-white price-table text-left border-collapse\">\n                    <thead>\n                        <tr>\n                            <th class=\"py-4 px-6 font-bold uppercase text-sm border-b\">Service Name</th>\n                            <th class=\"py-4 px-6 font-bold uppercase text-sm border-b\">Unit / Type</th>\n                            <th class=\"py-4 px-6 font-bold uppercase text-sm border-b\">Estimated Price</th>\n                            <th class=\"py-4 px-6 font-bold uppercase text-sm border-b\">Action</th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        <tr>\n                            <td class=\"py-4 px-6 border-b font-medium\">Basic Duct Cleaning</td>\n                            <td class=\"py-4 px-6 border-b\">Per Sq. Ft.</td>\n                            <td class=\"py-4 px-6 border-b\">₹15 &#8211; ₹25</td>\n                            <td class=\"py-4 px-6 border-b\"><a href=\"/contact-us\" class=\"bg-blue-600 text-white px-3 py-1 rounded text-sm hover:bg-blue-700\">Book Now</a></td>\n                        </tr>\n                        <tr>\n                            <td class=\"py-4 px-6 border-b font-medium\">Duct Leakage Testing &#038; Sealing</td>\n                            <td class=\"py-4 px-6 border-b\">Per Joint/Section</td>\n                            <td class=\"py-4 px-6 border-b\">₹500 &#8211; ₹1500</td>\n                            <td class=\"py-4 px-6 border-b\"><a href=\"/contact-us\" class=\"bg-blue-600 text-white px-3 py-1 rounded text-sm hover:bg-blue-700\">Book Now</a></td>\n                        </tr>\n                        <tr>\n                            <td class=\"py-4 px-6 border-b font-medium\">Canvas Connection Replacement</td>\n                            <td class=\"py-4 px-6 border-b\">Per Unit</td>\n                            <td class=\"py-4 px-6 border-b\">₹1200 &#8211; ₹2500</td>\n                            <td class=\"py-4 px-6 border-b\"><a href=\"/contact-us\" class=\"bg-blue-600 text-white px-3 py-1 rounded text-sm hover:bg-blue-700\">Book Now</a></td>\n                        </tr>\n                        <tr>\n                            <td class=\"py-4 px-6 border-b font-medium\">Insulation Repair (Nitrile/Glasswool)</td>\n                            <td class=\"py-4 px-6 border-b\">Per Sq. Meter</td>\n                            <td class=\"py-4 px-6 border-b\">₹250 &#8211; ₹450</td>\n                            <td class=\"py-4 px-6 border-b\"><a href=\"/contact-us\" class=\"bg-blue-600 text-white px-3 py-1 rounded text-sm hover:bg-blue-700\">Book Now</a></td>\n                        </tr>\n                        <tr>\n                            <td class=\"py-4 px-6 border-b font-medium\">Grille/Diffuser Cleaning &#038; Alignment</td>\n                            <td class=\"py-4 px-6 border-b\">Per Piece</td>\n                            <td class=\"py-4 px-6 border-b\">₹350 &#8211; ₹750</td>\n                            <td class=\"py-4 px-6 border-b\"><a href=\"/contact-us\" class=\"bg-blue-600 text-white px-3 py-1 rounded text-sm hover:bg-blue-700\">Book Now</a></td>\n                        </tr>\n                        <tr>\n                            <td class=\"py-4 px-6 border-b font-medium\">Complete System Sanitization</td>\n                            <td class=\"py-4 px-6 border-b\">Lump Sum (Small Office)</td>\n                            <td class=\"py-4 px-6 border-b\">₹5000 onwards</td>\n                            <td class=\"py-4 px-6 border-b\"><a href=\"/contact-us\" class=\"bg-blue-600 text-white px-3 py-1 rounded text-sm hover:bg-blue-700\">Book Now</a></td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n            <p class=\"text-xs text-gray-500 mt-4 text-center\">* Prices are indicative and subject to site inspection and GST. For a detailed quote, visit <a href=\"/ac-repair-service-price-list-bharuch\" class=\"text-blue-500 underline\">our complete price list</a>.</p>\n        </div>\n    </section>\n\n    <!-- TROUBLESHOOTING / ERROR CODES -->\n    <section class=\"py-12 bg-white\">\n        <div class=\"container mx-auto px-4\">\n            <h2 class=\"text-3xl font-bold text-center mb-8\">Common Ducting Issues &#038; Solutions</h2>\n            <div class=\"grid md:grid-cols-2 gap-8\">\n                <div>\n                    <h3 class=\"text-xl font-bold mb-4 text-blue-700\">Diagnostics Guide</h3>\n                    <p class=\"mb-4\">While ducts don&#8217;t have digital error codes, they exhibit physical symptoms. Here is how we diagnose them:</p>\n                    <ul class=\"space-y-3 list-none\">\n                        <li class=\"bg-gray-50 p-3 rounded border-l-4 border-yellow-500\">\n                            <strong>Symptom: Whistling Noise</strong><br>\n                            <span class=\"text-sm text-gray-600\">Usually indicates high static pressure or a gap in the duct joints. Requires sealing or damper adjustment.</span>\n                        </li>\n                        <li class=\"bg-gray-50 p-3 rounded border-l-4 border-red-500\">\n                            <strong>Symptom: Hot/Cold Spots</strong><br>\n                            <span class=\"text-sm text-gray-600\">Airflow is not reaching certain areas. Could be a crushed flexible duct or disconnected section.</span>\n                        </li>\n                        <li class=\"bg-gray-50 p-3 rounded border-l-4 border-gray-500\">\n                            <strong>Symptom: Musty Smell</strong><br>\n                            <span class=\"text-sm text-gray-600\">Mold growth inside the duct or insulation due to moisture condensation. Needs deep cleaning and chemical treatment.</span>\n                        </li>\n                        <li class=\"bg-gray-50 p-3 rounded border-l-4 border-blue-500\">\n                            <strong>Symptom: High Energy Bills</strong><br>\n                            <span class=\"text-sm text-gray-600\">Leakage in the supply air duct causes cooled air to escape into the false ceiling. Requires leak testing.</span>\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"flex items-center justify-center\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/10/cold-room.webp\" alt=\"Technician inspecting ductwork\" class=\"rounded-lg shadow-lg max-h-80 w-full object-cover\" title=\"\">\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- AREAS SERVED -->\n    <section class=\"py-16 bg-gray-900 text-gray-300\">\n        <div class=\"container mx-auto px-4\">\n            <h2 class=\"text-3xl font-bold text-white text-center mb-10\">We Serve All Areas of Bharuch District</h2>\n            \n            <div class=\"grid md:grid-cols-2 gap-8\">\n                <!-- Residential -->\n                <div>\n                    <h3 class=\"text-2xl font-bold text-white mb-4\"><i class=\"fas fa-home mr-2\"></i> Residential Areas</h3>\n                    <div class=\"area-box bg-gray-800 p-4 rounded text-sm leading-relaxed border border-gray-700\">\n                        Zadeshwar | Maktampur | Kasak Circle | Link Road | Shaktinath | Tulsidham | Bholav | Nandelav | Dahej Bypass | Old Bharuch | Station Road | Falshruti Nagar | Jyotinagar | Pritam Society | Umraj | Chavaj | Sherpura | Tavra | Manubar | GNFC Township | ABC Circle | Narayan Nagar | Panch Batti | Sevashram Road | College Road | Ankleshwar City | GIDC Housing (Ankleshwar) | Valia Road | Rajpipla Road | Hansot | Jambusar Town | Amod | Vagra | Netrang.\n                    </div>\n                </div>\n\n                <!-- Industrial -->\n                <div>\n                    <h3 class=\"text-2xl font-bold text-white mb-4\"><i class=\"fas fa-industry mr-2\"></i> Industrial GIDC Areas</h3>\n                    <div class=\"area-box bg-gray-800 p-4 rounded text-sm leading-relaxed border border-gray-700\">\n                        Ankleshwar GIDC (Asia&#8217;s Largest Chemical Zone) | Dahej GIDC (PCPIR) | Dahej SEZ | Panoli GIDC | Jhagadia GIDC | Vilayat GIDC | Saykha GIDC | Jambusar GIDC | Palej GIDC | Vagra Industrial Area | Valia Industrial Area | Bharuch GIDC | Narmadanagar | GNFC Complex Area | ABG Shipyard Area | Birla Copper Area | Reliance Dahej Area.\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- FAQ SECTION -->\n    <section class=\"py-16 bg-white\">\n        <div class=\"container mx-auto px-4 max-w-4xl\">\n            <h2 class=\"text-3xl font-bold text-center mb-10\">Frequently Asked Questions</h2>\n            <div class=\"space-y-4\">\n                \n                <details class=\"faq-details bg-gray-50 rounded-lg p-4 cursor-pointer group\">\n                    <summary class=\"font-bold text-lg flex justify-between items-center list-none\">\n                        <span>How often should ducting be cleaned?</span>\n                        <span class=\"text-blue-600 transition group-open:rotate-180\"><i class=\"fas fa-chevron-down\"></i></span>\n                    </summary>\n                    <p class=\"mt-4 text-gray-600\">For residential ACs, every 2-3 years. For industrial zones like Ankleshwar and Dahej where chemical exposure is high, we recommend annual or bi-annual inspection and cleaning.</p>\n                </details>\n\n                <details class=\"faq-details bg-gray-50 rounded-lg p-4 cursor-pointer group\">\n                    <summary class=\"font-bold text-lg flex justify-between items-center list-none\">\n                        <span>Do you serve GIDC areas like Dahej and Panoli?</span>\n                        <span class=\"text-blue-600 transition group-open:rotate-180\"><i class=\"fas fa-chevron-down\"></i></span>\n                    </summary>\n                    <p class=\"mt-4 text-gray-600\">Yes, we provide extensive services to Dahej GIDC, Panoli, Jhagadia, and Vilayat. Our team is fully equipped with safety gear for industrial site visits.</p>\n                </details>\n\n                <details class=\"faq-details bg-gray-50 rounded-lg p-4 cursor-pointer group\">\n                    <summary class=\"font-bold text-lg flex justify-between items-center list-none\">\n                        <span>Can you repair corroded industrial ducts?</span>\n                        <span class=\"text-blue-600 transition group-open:rotate-180\"><i class=\"fas fa-chevron-down\"></i></span>\n                    </summary>\n                    <p class=\"mt-4 text-gray-600\">Yes. For chemical plants, we can replace damaged sections with corrosion-resistant materials (SS 316 or specialized coatings) and seal leaks effectively.</p>\n                </details>\n\n                <details class=\"faq-details bg-gray-50 rounded-lg p-4 cursor-pointer group\">\n                    <summary class=\"font-bold text-lg flex justify-between items-center list-none\">\n                        <span>Do you fabricate new ducts?</span>\n                        <span class=\"text-blue-600 transition group-open:rotate-180\"><i class=\"fas fa-chevron-down\"></i></span>\n                    </summary>\n                    <p class=\"mt-4 text-gray-600\">Yes, we have a manufacturing facility for GI (Galvanized Iron) rectangular and spiral ducts, as well as PI (Pre-Insulated) ducts suitable for industrial use.</p>\n                </details>\n\n                <details class=\"faq-details bg-gray-50 rounded-lg p-4 cursor-pointer group\">\n                    <summary class=\"font-bold text-lg flex justify-between items-center list-none\">\n                        <span>What is the price for duct leakage testing?</span>\n                        <span class=\"text-blue-600 transition group-open:rotate-180\"><i class=\"fas fa-chevron-down\"></i></span>\n                    </summary>\n                    <p class=\"mt-4 text-gray-600\">Pricing depends on the total square footage and accessibility. Please check our <a href=\"/ac-repair-service-price-list-bharuch\">price list</a> or call us for a site visit quote.</p>\n                </details>\n\n                <details class=\"faq-details bg-gray-50 rounded-lg p-4 cursor-pointer group\">\n                    <summary class=\"font-bold text-lg flex justify-between items-center list-none\">\n                        <span>Why is water dripping from my AC vent?</span>\n                        <span class=\"text-blue-600 transition group-open:rotate-180\"><i class=\"fas fa-chevron-down\"></i></span>\n                    </summary>\n                    <p class=\"mt-4 text-gray-600\">This usually happens due to poor insulation causing condensation (sweating) on the duct surface, or a clogged drain pan. We can fix both issues.</p>\n                </details>\n\n                <details class=\"faq-details bg-gray-50 rounded-lg p-4 cursor-pointer group\">\n                    <summary class=\"font-bold text-lg flex justify-between items-center list-none\">\n                        <span>Do you repair kitchen exhaust ducts?</span>\n                        <span class=\"text-blue-600 transition group-open:rotate-180\"><i class=\"fas fa-chevron-down\"></i></span>\n                    </summary>\n                    <p class=\"mt-4 text-gray-600\">Yes, we specialize in cleaning and repairing oil-laden kitchen exhaust ducts for hotels and canteens to prevent fire hazards.</p>\n                </details>\n\n                <details class=\"faq-details bg-gray-50 rounded-lg p-4 cursor-pointer group\">\n                    <summary class=\"font-bold text-lg flex justify-between items-center list-none\">\n                        <span>Is there a warranty on repairs?</span>\n                        <span class=\"text-blue-600 transition group-open:rotate-180\"><i class=\"fas fa-chevron-down\"></i></span>\n                    </summary>\n                    <p class=\"mt-4 text-gray-600\">Yes, we provide a service warranty on leakage repairs and fabrication work. The duration depends on the specific service provided.</p>\n                </details>\n\n                <details class=\"faq-details bg-gray-50 rounded-lg p-4 cursor-pointer group\">\n                    <summary class=\"font-bold text-lg flex justify-between items-center list-none\">\n                        <span>Do you work on weekends?</span>\n                        <span class=\"text-blue-600 transition group-open:rotate-180\"><i class=\"fas fa-chevron-down\"></i></span>\n                    </summary>\n                    <p class=\"mt-4 text-gray-600\">Yes, our team is available 7 days a week to ensure minimum downtime for your business or home comfort.</p>\n                </details>\n\n                <details class=\"faq-details bg-gray-50 rounded-lg p-4 cursor-pointer group\">\n                    <summary class=\"font-bold text-lg flex justify-between items-center list-none\">\n                        <span>How can I book a service?</span>\n                        <span class=\"text-blue-600 transition group-open:rotate-180\"><i class=\"fas fa-chevron-down\"></i></span>\n                    </summary>\n                    <p class=\"mt-4 text-gray-600\">You can call us at +91 97272 57141, use the WhatsApp button on this page, or visit our <a href=\"/contact-us\">Contact Us</a> page.</p>\n                </details>\n            </div>\n        </div>\n    </section>\n\n    <!-- FOOTER -->\n    <footer class=\"bg-gray-800 text-gray-400 py-12 border-t-4 border-blue-600\">\n        <div class=\"container mx-auto px-4\">\n            <div class=\"grid md:grid-cols-4 gap-8\">\n                <!-- About -->\n                <div>\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2019/03/cropped-AtlasAircon-Logo.png\" alt=\"Atlas Aircon Footer Logo\" class=\"h-12 mb-4 bg-white p-1 rounded\" title=\"\">\n                    <p class=\"text-sm\">Atlas Aircon is Bharuch&#8217;s leading HVAC and Ducting service provider. We deliver quality, reliability, and expert solutions for all your cooling needs.</p>\n                    <div class=\"mt-4 flex space-x-4\">\n                        <a href=\"#\" class=\"hover:text-white\"><i class=\"fab fa-facebook fa-lg\"></i></a>\n                        <a href=\"#\" class=\"hover:text-white\"><i class=\"fab fa-instagram fa-lg\"></i></a>\n                        <a href=\"#\" class=\"hover:text-white\"><i class=\"fab fa-youtube fa-lg\"></i></a>\n                    </div>\n                </div>\n\n                <!-- Quick Links -->\n                <div>\n                    <h4 class=\"text-white font-bold text-lg mb-4\">Quick Links</h4>\n                    <ul class=\"space-y-2 text-sm\">\n                        <li><a href=\"/home\" class=\"hover:text-white\">Home</a></li>\n                        <li><a href=\"/about-us\" class=\"hover:text-white\">About Us</a></li>\n                        <li><a href=\"/shop\" class=\"hover:text-white\">Shop Spares</a></li>\n                        <li><a href=\"/blogs\" class=\"hover:text-white\">HVAC Tips Blog</a></li>\n                        <li><a href=\"/ac-technician-jobs\" class=\"hover:text-white\">Careers / Jobs</a></li>\n                        <li><a href=\"/privacy-policy/\" class=\"hover:text-white\">Privacy Policy</a></li>\n                    </ul>\n                </div>\n\n                <!-- Services -->\n                <div>\n                    <h4 class=\"text-white font-bold text-lg mb-4\">Our Services</h4>\n                    <ul class=\"space-y-2 text-sm\">\n                        <li><a href=\"/ducting-repair-services-bharuch\" class=\"hover:text-white\">Ducting Repair</a></li>\n                        <li><a href=\"/ac-installation-bharuch\" class=\"hover:text-white\">AC Installation</a></li>\n                        <li><a href=\"/cassette-ac-service-bharuch\" class=\"hover:text-white\">Cassette AC Service</a></li>\n                        <li><a href=\"/package-ac-service-bharuch\" class=\"hover:text-white\">Package AC Service</a></li>\n                        <li><a href=\"/precision-ac-service-bharuch\" class=\"hover:text-white\">Precision AC Service</a></li>\n                        <li><a href=\"/ductable-ac-service-bharuch\" class=\"hover:text-white\">Ductable AC Service</a></li>\n                    </ul>\n                </div>\n\n                <!-- Contact -->\n                <div>\n                    <h4 class=\"text-white font-bold text-lg mb-4\">Contact Info</h4>\n                    <ul class=\"space-y-3 text-sm\">\n                        <li class=\"flex items-start\"><i class=\"fas fa-map-marker-alt mt-1 mr-2 text-blue-500\"></i> Bharuch, Gujarat (Pin: 392001)</li>\n                        <li class=\"flex items-center\"><i class=\"fas fa-phone-alt mr-2 text-blue-500\"></i> +91 97272 57141</li>\n                        <li class=\"flex items-center\"><i class=\"fas fa-envelope mr-2 text-blue-500\"></i> atlasaircon1@gmail.com</li>\n                        <li class=\"flex items-center\"><i class=\"far fa-clock mr-2 text-blue-500\"></i> Mon-Sun: 9:00 AM &#8211; 9:00 PM</li>\n                    </ul>\n                </div>\n            </div>\n            \n            <div class=\"border-t border-gray-700 mt-12 pt-8 text-center text-sm\">\n                <p>&copy; 2026 Atlas Aircon. All Rights Reserved. Designed for Excellence.</p>\n            </div>\n        </div>\n    </footer>\n\n</div>",
