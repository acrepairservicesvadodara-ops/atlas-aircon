lex flex-col items-center text-center\">\n                <div class=\"w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mb-4 text-blue-600\"><i class=\"fas fa-grip-lines text-2xl\"></i></div>\n                <h4 class=\"font-bold text-gray-800 text-sm mb-2 text-center\">Insulation Pipe</h4>\n                <span class=\"text-blue-600 font-bold text-xs uppercase tracking-wider\">Heat Shield</span>\n            </a>\n            <a href=\"/drain-pipe/\" class=\"product-card bg-gray-50 p-6 rounded-3xl border border-gray-100 flex flex-col items-center\">\n                <div class=\"w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mb-4 text-blue-600\"><i class=\"fas fa-faucet text-2xl\"></i></div>\n                <h4 class=\"font-bold text-gray-800 text-sm mb-2 text-center\">Drain Pipe</h4>\n                <span class=\"text-blue-600 font-bold text-xs uppercase tracking-wider\">Anti-Leak</span>\n            </a>\n            <a href=\"/copper-wire/\" class=\"product-card bg-gray-50 p-6 rounded-3xl border border-gray-100 flex flex-col items-center\">\n                <div class=\"w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mb-4 text-blue-600\"><i class=\"fas fa-bolt text-2xl\"></i></div>\n                <h4 class=\"font-bold text-gray-800 text-sm mb-2 text-center\">Copper Wire</h4>\n                <span class=\"text-blue-600 font-bold text-xs uppercase tracking-wider\">Electrical Grade</span>\n            </a>\n            <a href=\"/flair-nut-sets/\" class=\"product-card bg-gray-50 p-6 rounded-3xl border border-gray-100 flex flex-col items-center\">\n                <div class=\"w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mb-4 text-blue-600\"><i class=\"fas fa-cog text-2xl\"></i></div>\n                <h4 class=\"font-bold text-gray-800 text-sm mb-2 text-center\">Flair Nut Set</h4>\n                <span class=\"text-blue-600 font-bold text-xs uppercase tracking-wider\">Brass Quality</span>\n            </a>\n            <a href=\"/gas-charging-service/\" class=\"product-card bg-gray-50 p-6 rounded-3xl border border-gray-100 flex flex-col items-center lg:col-span-2\">\n                <div class=\"w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mb-4 text-blue-600\"><i class=\"fas fa-gas-pump text-2xl\"></i></div>\n                <h4 class=\"font-bold text-gray-800 text-sm mb-2 text-center\">AC Gas Charging</h4>\n                <span class=\"text-blue-600 font-bold text-xs uppercase tracking-wider\">Full Refill Service</span>\n            </a>\n        </div>\n    </div>\n</section>\n\n<!-- SERVICES GRID - COMPREHENSIVE LINKS FOR SEO -->\n<section class=\"py-20 px-4 bg-gray-50 border-y\">\n    <div class=\"max-w-7xl mx-auto\">\n        <div class=\"text-center mb-16\">\n            <h2 class=\"text-3xl md:text-5xl font-black text-gray-900 mb-4 italic\">Complete HVAC &#038; Appliance Solutions for Surat</h2>\n            <p class=\"text-gray-600\">Certified engineering services for residential and industrial complexes state-wide.</p>\n        </div>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8\">\n            <!-- Core Services -->\n            <div class=\"space-y-4\">\n                <h3 class=\"text-xl font-bold text-blue-800 border-b-2 border-blue-100 pb-2\">Core AC Services</h3>\n                <ul class=\"space-y-2 text-sm\">\n                    <li><a href=\"/ac-repair-surat\" class=\"hover:text-blue-600 flex items-center gap-2 text-blue-500 font-semibold\"><i class=\"fas fa-tools text-xs\"></i> AC Repair Surat</a></li>\n                    <li><a href=\"/ac-service-surat\" class=\"hover:text-blue-600 flex items-center gap-2 text-blue-500 font-semibold\"><i class=\"fas fa-sync text-xs\"></i> AC Service Surat</a></li>\n                    <li><a href=\"/ac-service-center-surat\" class=\"hover:text-blue-600 flex items-center gap-2 text-blue-500 font-semibold\"><i class=\"fas fa-building text-xs\"></i> Service Center Surat</a></li>\n                    <li><a href=\"/ac-repair-service-price-list-air-conditioner-repair-service-cost-surat-gujarat\" class=\"hover:text-blue-600 font-semibold text-blue-500\">AC Price List Surat</a></li>\n                </ul>\n            </div>\n            <!-- Type Support -->\n            <div class=\"space-y-4\">\n                <h3 class=\"text-xl font-bold text-blue-800 border-b-2 border-blue-100 pb-2\">Technical Units</h3>\n                <ul class=\"space-y-2 text-sm text-gray-600\">\n                    <li><a href=\"/split-ac-service-surat\" class=\"hover:text-blue-600 text-blue-500\">Split AC Service Surat</a></li>\n                    <li><a href=\"/window-ac-service-surat\" class=\"hover:text-blue-600 text-blue-500\">Window AC Service Surat</a></li>\n                    <li><a href=\"/cassette-ac-service-surat\" class=\"hover:text-blue-600 text-blue-500\">Cassette AC Service Surat</a></li>\n                    <li><a href=\"/ductable-ac-service-surat\" class=\"hover:text-blue-600 text-blue-500\">Ductable AC Service Surat</a></li>\n                    <li><a href=\"/package-ac-service-surat\" class=\"hover:text-blue-600 text-blue-500\">Package AC Service Surat</a></li>\n                    <li><a href=\"/precision-ac-service-surat\" class=\"hover:text-blue-600 text-blue-500\">Precision AC Service Surat</a></li>\n                    <li><a href=\"/panel-ac-service-surat\" class=\"hover:text-blue-600 text-blue-500\">Panel AC Service Surat</a></li>\n                </ul>\n            </div>\n            <!-- Brands -->\n            <div class=\"space-y-4\">\n                <h3 class=\"text-xl font-bold text-blue-800 border-b-2 border-blue-100 pb-2\">Brand Service Support</h3>\n                <div class=\"grid grid-cols-1 gap-1 text-xs text-gray-500 overflow-y-auto max-h-64 pr-2\">\n                    <a href=\"/daikin-ac-service-center-surat\" class=\"hover:text-blue-600 text-blue-500\">Daikin Service Center</a>\n                    <a href=\"/mitsubishi-ac-service-center-surat\" class=\"hover:text-blue-600 text-blue-500\">Mitsubishi Service Center</a>\n                    <a href=\"/o-general-ac-service-center-surat\" class=\"hover:text-blue-600 text-blue-500\">O General Service Center</a>\n                    <a href=\"/samsung-ac-service-center-surat\" class=\"hover:text-blue-600 text-blue-500\">Samsung Service Center</a>\n                    <a href=\"/lg-ac-service-center-surat\" class=\"hover:text-blue-600 text-blue-500\">LG Service Center</a>\n                    <a href=\"/voltas-ac-service-center-surat\" class=\"hover:text-blue-600 text-blue-500\">Voltas Service Center</a>\n                    <a href=\"/blue-star-ac-service-center-surat\" class=\"hover:text-blue-600 text-blue-500\">Blue Star Service Center</a>\n                    <a href=\"/carrier-ac-service-center-surat\" class=\"hover:text-blue-600 text-blue-500\">Carrier Service Center</a>\n                    <a href=\"/hitachi-ac-service-center-surat\" class=\"hover:text-blue-600 text-blue-500\">Hitachi Service Center</a>\n                    <a href=\"/panasonic-ac-service-center-surat\" class=\"hover:text-blue-600 text-blue-500\">Panasonic Service Center</a>\n                    <a href=\"/haier-ac-service-center-surat\" class=\"hover:text-blue-600 text-blue-500\">Haier Service Center</a>\n                    <a href=\"/york-ac-service-center-surat\" class=\"hover:text-blue-600 text-blue-500\">York Service Center</a>\n                    <a href=\"/onida-ac-service-center-surat\" class=\"hover:text-blue-600 text-blue-500\">Onida Service Center</a>\n                    <a href=\"/kelvinator-ac-service-center-surat\" class=\"hover:text-blue-600 text-blue-500\">Kelvinator Service Center</a>\n                    <a href=\"/electrolux-ac-service-center-surat\" class=\"hover:text-blue-600 text-blue-500\">Electrolux Service Center</a>\n                </div>\n            </div>\n            <!-- I