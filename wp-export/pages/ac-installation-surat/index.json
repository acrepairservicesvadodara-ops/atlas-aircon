<section id=\"pricing\" class=\"py-20 px-4 max-w-7xl mx-auto text-center\">\n    <div class=\"mb-10\">\n        <h2 class=\"text-3xl font-bold mb-4 text-gray-900\">AC Installation &#038; Material Rate Card</h2>\n        <p class=\"text-gray-500\">Fixed standard rates as per our verified <a href=\"/ac-repair-service-price-list-air-conditioner-repair-service-cost-in-vadodara-gujarat\" class=\"text-blue-600 font-bold underline\">Standard Rate Card</a>.</p>\n    </div>\n    <div class=\"overflow-x-auto rounded-3xl shadow-xl border border-gray-200\">\n        <table class=\"w-full text-left bg-white min-w-[700px]\">\n            <thead class=\"bg-blue-900 text-white\">\n                <tr><th class=\"p-6\">Efficiency Level</th><th class=\"p-6\">3-Star Inverter</th><th class=\"p-6 text-blue-300 font-bold\">5-Star Inverter (Best for Surat)</th></tr>\n            </thead>\n            <tbody class=\"divide-y text-gray-600 text-sm\">\n                <tr><td class=\"p-6 font-semibold\">Annual Savings</td><td class=\"p-6\">~₹1,500/year</td><td class=\"p-6 text-green-600 font-bold\">~₹4,500/year</td></tr>\n                <tr><td class=\"p-6 font-semibold\">Cooling Speed</td><td class=\"p-6\">Standard</td><td class=\"p-6 font-bold\">Turbo (15% Faster)</td></tr>\n                <tr><td class=\"p-6 font-semibold\">Coastal Resistance</td><td class=\"p-6 text-gray-400\">Basic</td><td class=\"p-6 font-bold text-blue-600\">Anti-Corrosive Coating</td></tr>\n            </tbody>\n        </table>\n    </div>\n</section>\n\n<!-- PRE-INSTALLATION CHECKLIST -->\n<section class=\"py-20 px-4\">\n    <div class=\"max-w-7xl mx-auto\">\n        <div class=\"bg-blue-900 rounded-[3rem] p-10 md:p-16 text-white flex flex-col lg:flex-row gap-12 items-center shadow-2xl\">\n            <div class=\"lg:w-1/2\">\n                <h2 class=\"text-3xl md:text-4xl font-bold mb-6\">Homeowner&#8217;s Pre-Installation Checklist</h2>\n                <p class=\"text-blue-200 mb-8\">Ensure a smooth service 