/div>\r\n</div>\r\n<!-- Minimized Quote Icon -->\r\n<div id=\"minimized-quote-icon\" class=\"minimized-quote-icon\"> </div>\r\n<p><script>\r\n        document.addEventListener('DOMContentLoaded', () => {\r\n            const popupOverlay = document.getElementById('popup-overlay');\r\n            const closeButton = document.getElementById('popup-close');\r\n            const minimizedIcon = document.getElementById('minimized-quote-icon');\r\n\r\n            const showPopup = () => {\r\n                if (sessionStorage.getItem('popupShown')) return;\r\n                popupOverlay.style.display = 'flex';\r\n                sessionStorage.setItem('popupShown', 'true');\r\n            };\r\n\r\n            const closePopup = () => {\r\n                popupOverlay.style.display = 'none';\r\n                minimizedIcon.style.display = 'flex';\r\n            };\r\n\r\n            const openPopupFromIcon = () => {\r\n                minimizedIcon.style.display = 'none';\r\n                popupOverlay.style.display = 'flex';\r\n            };\r\n\r\n            // Show popup after 60 seconds\r\n            setTimeout(showPopup, 60000);\r\n\r\n            // Event listeners\r\n            closeButton.addEventListener('click', closePopup);\r\n            minimizedIcon.addEventListener('click', openPopupFromIcon);\r\n            \r\n            // Close popup if user clicks outside the content area\r\n            popupOverlay.addEventListener('click', (e) => {\r\n                if (e.target === popupOverlay) {\r\n                    closePopup();\r\n                }\r\n            });\r\n        });\r\n    </script></p>\r\n",
