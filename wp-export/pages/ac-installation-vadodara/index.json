  "content": {
    "rendered": "\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"BreadcrumbList\",\n      \"itemListElement\": [\n        { \"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://atlasaircons.com/\" },\n        { \"@type\": \"ListItem\", \"position\": 2, \"name\": \"AC Services\", \"item\": \"https://atlasaircons.com/ac-service-vadodara\" },\n        { \"@type\": \"ListItem\", \"position\": 3, \"name\": \"AC Installation Vadodara\", \"item\": \"https://atlasaircons.com/ac-installation-vadodara\" }\n      ]\n    },\n    {\n      \"@type\": \"HVACBusiness\",\n      \"name\": \"Atlas Aircon Vadodara\",\n      \"image\": \"https://atlasaircons.com/wp-content/uploads/2023/04/Split-Ac-Installation-and-Repair-Service-1.webp\",\n      \"description\": \"Professional AC installation, deep vacuuming, and core engineering services for residential and industrial sectors in Vadodara.\",\n      \"telephone\": \"+919727257141\",\n      \"priceRange\": \"₹1500 - ₹25000\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"streetAddress\": \"27 Payal Complex, Sayajigunj\",\n        \"addressLocality\": \"Vadodara\",\n        \"addressRegion\": \"Gujarat\",\n        \"postalCode\": \"390005\",\n        \"addressCountry\": \"IN\"\n      },\n      \"areaServed\": [\n        { \"@type\": \"City\", \"name\": \"Vadodara\" },\n        { \"@type\": \"Neighborhood\", \"name\": \"Alkapuri\" },\n        { \"@type\": \"Neighborhood\", \"name\": \"Makarpura GIDC\" }\n      ]\n    }\n  ]\n}\n</script>\n\n<script>\n    if (typeof tailwind !== 'undefined') {\n        tailwind.config = {\n            theme: {\n                extend: {\n                    colors: {\n                        primary: '#0f172a', \n                        secondary: '#2563eb', \n                        accent: '#f59e0b', \n                    }\n                }\n            }\n        }\n    }\n</script>\n\n<style>\n    .v-install-wrapper { \n        font-family: 'Plus Jakarta Sans', sans-serif; \n        scroll-behavior: smooth; \n        color: #334155; \n    }\n    .v-install-wrapper .hero-mesh { \n        background-color: #0f172a;\n        background-image: radial-gradient(at 40% 20%, #1e3a8a 0px, transparent 50%),\n                          radial-gradient(at 80% 0%, #082f49 0px, transparent 50%),\n                          radial-gradient(at 0% 50%, #0f172a 0px, transparent 50%);\n    }\n    .v-install-wrapper .glass-card { \n        background: rgba(30, 41, 59, 0.7); \n        backdrop-filter: blur(12px); \n        border: 1px solid rgba(255,255,255,0.1);\n    }\n    .v-install-wrapper .hover-lift { transition: transform 0.3s ease, box-shadow 0.3s ease; }\n    .v-install-wrapper .hover-lift:hover { transform: translateY(-5px); box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3); }\n    \n    /* Calculator Inputs */\n    .v-install-wrapper .calc-input { \n        background: #0f172a; border: 1px solid #334155; color: white; \n        border-radius: 0.5rem; padding: 0.75rem 1rem; width: 100%; \n        margin-bottom: 1rem; outline: none; transition: 0.2s; font-weight: 600;\n    }\n    .v-install-wrapper .calc-input:focus { border-color: #38bdf8; }\n    .v-install-wrapper .calc-btn { \n        background: #2563eb; color: white; width: 100%; padding: 0.75rem; \n        border-radius: 0.5rem; font-weight: 800; text-transform: uppercase; \n        transition: 0.2s; cursor: pointer; letter-spacing: 0.05em;\n    }\n    .v-install-wrapper .calc-btn:hover { background: #1d4ed8; }\n</style>\n\n<div class=\"v-install-wrapper bg-slate-50 antialiased\">\n\n    <div style=\"display: none;\" id=\"wp-backend-shortcodes\">\n        [atlas_app] [atlas_local_portfolio] [atlas_local_links] \r\n    <div class=\"atlas-calc-wrap\">\r\n        <h3>⚡ AC & Area Calculator</h3>\r\n        <div class=\"atlas-calc-row\"><label>Length (Ft)</label><input type=\"number\" id=\"ac-len\" placeholder=\"e.g. 20\"></div>\r\n        <div class=\"atlas-calc-row\"><label>Width (Ft)</label><input type=\"number\" id=\"ac-wid\" placeholder=\"e.g. 15\"></div>\r\n        <button class=\"atlas-calc-btn\" onclick=\"calcAC()\">Calculate Capacity</button>\r\n        <div class=\"atlas-calc-result\" id=\"ac-res\"><span>0</span><p>Required TR</p></div>\r\n    </div>\r\n    <script>function calcAC() { let l=parseFloat(document.getElementById(\"ac-len\").value)||0, w=parseFloat(document.getElementById(\"ac-wid\").value)||0, tons=((l*w*20)/12000).toFixed(2), box=document.getElementById(\"ac-res\"); box.style.display=\"block\"; box.querySelector(\"span\").innerText=tons>0?tons+\" TR\":\"0 TR\"; }</script> \r\n    <div class=\"atlas-calc-wrap\">\r\n        <h3>🔥 Industrial Heat Load</h3>\r\n        <div class=\"atlas-calc-row\"><label>Area (Sq.Ft)</label><input type=\"number\" id=\"hl-area\" placeholder=\"e.g. 1000\"></div>\r\n        <div class=\"atlas-calc-row\"><label>Occupants</label><input type=\"number\" id=\"hl-ppl\" placeholder=\"e.g. 10\"></div>\r\n        <div class=\"atlas-calc-row\"><label>Machinery (Watts)</label><input type=\"number\" id=\"hl-watts\" placeholder=\"e.g. 5000\"></div>\r\n        <button class=\"atlas-calc-btn\" onclick=\"calcHeatLoad()\">Calculate Load</button>\r\n        <div class=\"atlas-calc-result\" id=\"hl-res\"><span>0</span><p>Total Heat Load (BTU/hr)</p></div>\r\n    </div>\r\n    <script>function calcHeatLoad() { let a=parseFloat(document.getElementById(\"hl-area\").value)||0, p=parseFloat(document.getElementById(\"hl-ppl\").value)||0, w=parseFloat(document.getElementById(\"hl-watts\").value)||0, btu=Math.round((a*30)+(p*400)+(w*3.412)), box=document.getElementById(\"hl-res\"); box.style.display=\"block\"; box.querySelector(\"span\").innerText=btu+\" BTU\"; box.querySelector(\"p\").innerText=\"Equivalent: \"+(btu/12000).toFixed(2)+\" TR\"; }</script> [atlas_calc_cfm] [atlas_calc_chiller] \r\n    <div class=\"atlas-calc-wrap\">\r\n        <h3>🔌 Power Consumption Cost</h3>\r\n        <div class=\"atlas-calc-row\"><label>Capacity (Tons)</label><input type=\"number\" id=\"pwr-tons\" placeholder=\"e.g. 50\"></div>\r\n        <div class=\"atlas-calc-row\"><label>Hours Per Day</label><input type=\"number\" id=\"pwr-hrs\" placeholder=\"e.g. 12\"></div>\r\n        <div class=\"atlas-calc-row\"><label>Rate (₹/kWh)</label><input type=\"number\" id=\"pwr-rate\" placeholder=\"e.g. 8.5\"></div>\r\n        <button class=\"atlas-calc-btn\" onclick=\"calcPower()\">Calculate Cost</button>\r\n        <div class=\"atlas-calc-result\" id=\"pwr-res\"><span>0</span><p>Estimated Daily Cost</p></div>\r\n    </div>\r\n    <script>function calcPower() { let t=parseFloat(document.getElementById(\"pwr-tons\").value)||0, h=parseFloat(document.getElementById(\"pwr-hrs\").value)||0, r=parseFloat(document.getElementById(\"pwr-rate\").value)||0, cost=Math.round(t*1.2*h*r), box=document.getElementById(\"pwr-res\"); box.style.display=\"block\"; box.querySelector(\"span\").innerText=\"₹\"+cost.toLocaleString(\"en-IN\"); }</script>\n    </div>\n\n    <div class=\"bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b border-slate-200 py-3 px-6 shadow-sm flex justify-between items-center\">\n        <div class=\"text-xs md:text-sm flex items-center gap-2 text-slate-500 font-bold\">\n            <a class=\"hover:text-blue-600 transition\" href=\"/\">Atlas Aircon</a> \n            <i class=\"fas fa-chevron-right text-[10px]\"></i> \n            <span class=\"text-slate-900\">AC Installation Vadodara</span>\n        </div>\n        <div class=\"flex items-center gap-3\">\n            <span class=\"text-xs text-slate-500 hidden sm:block font-bold\" id=\"read-time\">⏱️ 3 Min Read</span>\n            <a href=\"tel:+919727257141\" class=\"bg-blue-600 text-white px-4 py-1.5 rounded-full text-xs font-bold hover:bg-blue-700 transition\">Call: +91 97272 57141</a>\n        </div>\n    </div>\n\n    <header class=\"hero-mesh text-white py-20 md:py-28 px-6 relative overflow-hidden\">\n        <div class=\"max-w-5xl mx-auto text-center relative z-10\">\n            <div class=\"mb-6 inline-flex items-center gap-2 bg-blue-900/50 border border-blue-400/30 px-5 py-2 rounded-full text-sm font-bold tracking-wide text-blue-200\">\n                <span class=\"relative flex h-3 w-3\">\n                  <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-yellow-400 opacity-75\"></span>\n                  <span class=\"relative inline-flex rounded-full h-3 w-3 bg-yellow-500\"></span>\n                </span>\n                Active in <span class=\"dynamic-loc\">Vadodara</span> Since <span class=\"auto-year\">1996</span>\n            </div>\n            \n            <h1 class=\"text-4xl md:text-6xl lg:text-7xl font-black mb-8 leading-tight tracking-tighter\">\n                The Truth About <br><span class=\"text-blue-400\">AC Installation</span> in Vadodara\n            </h1>\n            \n            <p class=\"text-lg md:text-xl text-slate-300 mb-10 max-w-3xl mx-auto leading-relaxed text-justify md:text-center\">\n                Did you know 90% of local mechanics skip the &#8220;Deep Vacuuming&#8221; process to save 20 minutes? The result: moisture mixes with the R32 gas, compressor life drops by half, and your MGVCL bill skyrockets. We don&#8217;t cut corners. We follow a strict 7-Step Technical Protocol for every installation.\n            </p>\n            \n            <div class=\"flex flex-col sm:flex-row justify-center gap-4\">\n                <a class=\"bg-yellow-500 hover:bg-yellow-400 text-slate-900 px-10 py-4 rounded-xl font-black text-lg shadow-xl transition transform hover:-translate-y-1 flex items-center justify-center gap-3\" href=\"https://wa.me/919727257141\" target=\"_blank\" rel=\"noopener\"> \n                    <i class=\"fab fa-whatsapp text-2xl text-green-700\"></i> Book Proper Installation \n                </a> \n                <a class=\"bg-slate-800/80 hover:bg-slate-700 text-white border border-slate-600 px-10 py-4 rounded-xl font-bold text-lg transition flex items-center justify-center\" href=\"#calculators\">\n                    Use Free HVAC Calculators\n                </a>\n            </div>\n        </div>\n    </header>\n\n    <section class=\"py-20 px-6 bg-white\">\n        <div class=\"max-w-7xl mx-auto grid lg:grid-cols-2 gap-16 items-center\">\n            <div class=\"relative\">\n                <img decoding=\"async\" class=\"rounded-3xl shadow-2xl w-full h-[500px] object-cover border-4 border-slate-100\" src=\"https://atlasaircons.com/wp-content/uploads/2023/04/Split-Ac-Installation-and-Repair-Service-1.webp\" alt=\"Proper AC Installation Vadodara\" title=\"\">\n                <div class=\"absolute -bottom-6 -right-6 bg-slate-900 text-white p-6 rounded-2xl shadow-xl max-w-xs\">\n                    <h4 class=\"font-black text-yellow-400 text-xl mb-1\">Zero Gas Leaks</h4>\n                    <p class=\"text-sm text-slate-300\">Flared copper joints tested at 400 PSI.</p>\n                </div>\n            </div>\n            \n            <div>\n                <h2 class=\"text-3xl md:text-5xl font-black text-slate-900 leading-tight mb-8\">The Atlas <span class=\"text-blue-600\">7-Step</span> Protocol</h2>\n                <div class=\"space-y-6 text-slate-700 font-medium\">\n                    <div class=\"flex gap-4\">\n                        <div class=\"w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-black flex-shrink-0\">1</div>\n                        <p><strong>Site Load Assessment:</strong> We don&#8217;t blindly install. We check wall strength, direct sunlight heatload, and room square footage.</p>\n                    </div>\n                    <div class=\"flex gap-4\">\n                        <div class=\"w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-black flex-shrink-0\">2</div>\n                        <p><strong>Heavy-Duty Bracketing:</strong> Using anti-vibration MS stands to prevent the outdoor unit from shaking the wall.</p>\n                    </div>\n                    <div class=\"flex gap-4\">\n                        <div class=\"w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-black flex-shrink-0\">3</div>\n                        <p><strong>Perfect Flaring:</strong> We use specialized mechanical flaring tools on the copper pipes to ensure absolutely zero gas leakage.</p>\n                    </div>\n                    <div class=\"flex gap-4\">\n                        <div class=\"w-8 h-8 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-black flex-shrink-0\">4</div>\n                        <p><strong>500-Micron Dehydration:</strong> We connect a vacuum pump for 20 minutes to suck out all air and moisture from the pipes before releasing the gas.</p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <section id=\"calculators\" class=\"py-20 px-6 bg-slate-900 text-white\">\n        <div class=\"max-w-7xl mx-auto\">\n            <div class=\"text-center mb-16\">\n                <span class=\"text-yellow-400 font-bold tracking-widest uppercase text-sm\">Engineering Tools</span>\n                <h2 class=\"text-3xl md:text-5xl font-black mb-4 mt-2\">Free HVAC Calculators</h2>\n                <p class=\"text-slate-400 max-w-2xl mx-auto text-lg\">Whether you are cooling a single bedroom in Alkapuri or sizing a chiller plant in Makarpura GIDC, use our formulas to get the exact requirements.</p>\n            </div>\n            \n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n                \n                <div class=\"glass-card p-8 rounded-3xl hover-lift\">\n                    <h3 class=\"text-xl font-black mb-2 text-blue-400\"><i class=\"fas fa-home mr-2\"></i> Room AC Sizer</h3>\n                    <p class=\"text-slate-400 text-sm mb-6\">Find the right tonnage to beat the 45°C heat.</p>\n                    <input type=\"number\" id=\"calc-ac-area\" placeholder=\"Room Area (Sq Ft)\" class=\"calc-input\">\n                    <select id=\"calc-ac-sun\" class=\"calc-input text-slate-300\">\n                        <option value=\"120\">Standard Room / Shaded</option>\n                        <option value=\"100\">Top Floor / Direct Sunlight</option>\n                    </select>\n                    <button onclick=\"calculateAC()\" class=\"calc-btn\">Calculate Tonnage</button>\n                    <div id=\"res-ac\" class=\"mt-4 text-center font-black text-2xl text-white hidden\"></div>\n                </div>\n                \n                <div class=\"glass-card p-8 rounded-3xl hover-lift\">\n                    <h3 class=\"text-xl font-black mb-2 text-yellow-400\"><i class=\"fas fa-plug mr-2\"></i> MGVCL Bill Estimator</h3>\n                    <p class=\"text-slate-400 text-sm mb-6\">Forecast your monthly power cost (based on ₹8/unit).</p>\n                    <select id=\"calc-pwr-type\" class=\"calc-input text-slate-300\">\n                        <option value=\"1.2\">1.5 Ton Normal AC</option>\n                        <option value=\"0.9\">1.5 Ton Inverter AC</option>\n                        <option value=\"1.8\">2.0 Ton Normal AC</option>\n                    </select>\n                    <input type=\"number\" id=\"calc-pwr-hrs\" placeholder=\"Daily Usage (Hours)\" class=\"calc-input\">\n                    <button onclick=\"calculatePower()\" class=\"calc-btn bg-yellow-600 hover:bg-yellow-700\">Estimate Bill</button>\n                    <div id=\"res-pwr\" class=\"mt-4 text-center font-black text-2xl text-yellow-400 hidden\"></div>\n                </div>\n\n                <div class=\"glass-card p-8 rounded-3xl hover-lift\">\n                    <h3 class=\"text-xl font-black mb-2 text-red-400\"><i class=\"fas fa-industry mr-2\"></i> Industrial Heatload</h3>\n                    <p class=\"text-slate-400 text-sm mb-6\">For IT server rooms and manufacturing floors.</p>\n                    <input type=\"number\" id=\"calc-hl-area\" placeholder=\"Total Area (Sq Ft)\" class=\"calc-input\">\n                    <input type=\"number\" id=\"calc-hl-people\" placeholder=\"Number of Occupants/Machines\" class=\"calc-input\">\n                    <button onclick=\"calculateHeatload()\" class=\"calc-btn bg-red-600 hover:bg-red-700\">Calculate BTU/hr</button>\n                    <div id=\"res-hl\" class=\"mt-4 text-center font-black text-2xl text-red-400 hidden\"></div>\n                </div>\n\n                <div class=\"glass-card p-8 rounded-3xl hover-lift\">\n                    <h3 class=\"text-xl font-black mb-2 text-green-400\"><i class=\"fas fa-wind mr-2\"></i> Ducting CFM Sizer</h3>\n                    <p class=\"text-slate-400 text-sm mb-6\">Airflow requirements for AHUs and fresh air ducts.</p>\n                    <input type=\"number\" id=\"calc-cfm-vol\" placeholder=\"Room Volume (L x W x H)\" class=\"calc-input\">\n                    <input type=\"number\" id=\"calc-cfm-ach\" placeholder=\"Air Changes per Hour (ACH)\" class=\"calc-input\" value=\"6\">\n                    <button onclick=\"calculateCFM()\" class=\"calc-btn bg-green-600 hover:bg-green-700\">Calculate CFM</button>\n                    <div id=\"res-cfm\" class=\"mt-4 text-center font-black text-2xl text-green-400 hidden\"></div>\n                </div>\n\n                <div class=\"glass-card p-8 rounded-3xl hover-lift lg:col-span-2\">\n                    <h3 class=\"text-xl font-black mb-2 text-cyan-400\"><i class=\"fas fa-snowflake mr-2\"></i> GIDC Chiller Plant Sizer</h3>\n                    <p class=\"text-slate-400 text-sm mb-6\">Determine precise capacity for water or chemical chilling plants.</p>\n                    <div class=\"grid grid-cols-2 gap-4\">\n                        <input type=\"number\" id=\"calc-ch-gpm\" placeholder=\"Flow Rate (GPM)\" class=\"calc-input\">\n                        <input type=\"number\" id=\"calc-ch-dt\" placeholder=\"Temp Difference (ΔT °F)\" class=\"calc-input\">\n                    </div>\n                    <button onclick=\"calculateChiller()\" class=\"calc-btn bg-cyan-600 hover:bg-cyan-700\">Compute Chiller Tonnage</button>\n                    <div id=\"res-ch\" class=\"mt-4 text-center font-black text-3xl text-cyan-400 hidden\"></div>\n                </div>\n\n            </div>\n        </div>\n    </section>\n\n    <section class=\"py-20 px-6 bg-white border-t border-slate-200\">\n        <div class=\"max-w-6xl mx-auto grid md:grid-cols-2 gap-16\">\n            <div>\n                <h3 class=\"text-2xl font-black text-slate-900 mb-6 border-b-4 border-blue-600 pb-2 inline-block\">Pre-Installation Checklist</h3>\n                <p class=\"text-slate-600 mb-6\">Before our engineers arrive at your location, ensure these basics are covered to avoid setup delays:</p>\n                <ul class=\"space-y-4 text-slate-800 font-medium\">\n                    <li class=\"flex items-center gap-3 bg-slate-50 p-4 rounded-xl border border-slate-200\"><i class=\"fas fa-plug text-blue-600 text-xl\"></i> Dedicated 16 Amp Power Socket</li>\n                    <li class=\"flex items-center gap-3 bg-slate-50 p-4 rounded-xl border border-slate-200\"><i class=\"fas fa-tint text-blue-600 text-xl\"></i> Pre-planned water drainage route</li>\n                    <li class=\"flex items-center gap-3 bg-slate-50 p-4 rounded-xl border border-slate-200\"><i class=\"fas fa-building text-blue-600 text-xl\"></i> Society/Builder drilling permission</li>\n                    <li class=\"flex items-center gap-3 bg-slate-50 p-4 rounded-xl border border-slate-200\"><i class=\"fas fa-fan text-blue-600 text-xl\"></i> Ventilated space for the outdoor unit</li>\n                </ul>\n            </div>\n            \n            <div class=\"bg-blue-50 p-8 rounded-3xl border border-blue-100\">\n                <h3 class=\"text-2xl font-black text-slate-900 mb-6\">Standard Installation Cost</h3>\n                <div class=\"space-y-4\">\n                    <div class=\"flex justify-between items-center border-b border-blue-200 pb-3\">\n                        <span class=\"font-bold text-slate-700\">Split AC Installation</span>\n                        <span class=\"font-black text-blue-700 text-xl\">₹1500+</span>\n                    </div>\n                    <div class=\"flex justify-between items-center border-b border-blue-200 pb-3\">\n                        <span class=\"font-bold text-slate-700\">Window AC Installation</span>\n                        <span class=\"font-black text-blue-700 text-xl\">₹700+</span>\n                    </div>\n                    <div class=\"flex justify-between items-center border-b border-blue-200 pb-3\">\n                        <span class=\"font-bold text-slate-700\">Extra Copper Pipe (Per Meter)</span>\n                        <span class=\"font-black text-blue-700 text-xl\">Market Rate</span>\n                    </div>\n                    <div class=\"flex justify-between items-center\">\n                        <span class=\"font-bold text-slate-700\">Heavy MS Outdoor Stand</span>\n                        <span class=\"font-black text-blue-700 text-xl\">₹750+</span>\n                    </div>\n                </div>\n                <a href=\"tel:+919727257141\" class=\"mt-8 block text-center bg-slate-900 text-white font-bold py-4 rounded-xl hover:bg-blue-700 transition\">Call For Site Inspection</a>\n            </div>\n        </div>\n    </section>\n\n</div>\n\n<script>\n    document.addEventListener('DOMContentLoaded', () => {\n        // Dynamic Locality\n        const urlParams = new URLSearchParams(window.location.search);\n        let loc = urlParams.get('loc') || 'Vadodara';\n        loc = loc.charAt(0).toUpperCase() + loc.slice(1);\n        document.querySelectorAll('.dynamic-loc').forEach(el => el.textContent = loc);\n\n        // Dynamic Year\n        const currentYear = new Date().getFullYear();\n        document.querySelectorAll('.auto-year').forEach(el => el.textContent = currentYear);\n\n        // Reading Time\n        const text = document.querySelector('.v-install-wrapper').innerText;\n        const time = Math.max(1, Math.ceil(text.split(/\\s+/).length / 200));\n        const rt = document.getElementById('read-time');\n        if(rt) rt.textContent = `⏱️ ${time} Min Read`;\n    });\n\n    // 1. AC Sizer\n    function calculateAC() {\n        const area = parseFloat(document.getElementById('calc-ac-area').value);\n        const factor = parseFloat(document.getElementById('calc-ac-sun').value);\n        const res = document.getElementById('res-ac');\n        if(!area || area <= 0) return;\n        \n        let tons = Math.ceil((area / factor) * 2) / 2; // Rounds to nearest 0.5\n        res.innerHTML = `${tons < 1 ? 1.0 : tons.toFixed(1)} Tons Required`;\n        res.classList.remove('hidden');\n    }\n\n    // 2. Power Bill\n    function calculatePower() {\n        const kw = parseFloat(document.getElementById('calc-pwr-type').value);\n        const hours = parseFloat(document.getElementById('calc-pwr-hrs').value);\n        const res = document.getElementById('res-pwr');\n        if(!hours || hours <= 0 || hours > 24) return;\n        \n        const monthly = kw * hours * 30 * 8; // 30 days, ₹8 per unit\n        res.innerHTML = `₹${Math.round(monthly).toLocaleString()} / Month`;\n        res.classList.remove('hidden');\n    }\n\n    // 3. Heatload\n    function calculateHeatload() {\n        const area = parseFloat(document.getElementById('calc-hl-area').value);\n        const people = parseFloat(document.getElementById('calc-hl-people').value) || 0;\n        const res = document.getElementById('res-hl');\n        if(!area || area <= 0) return;\n        \n        const btu = (area * 31.25) + (people * 400);\n        res.innerHTML = `${Math.round(btu).toLocaleString()} BTU/hr`;\n        res.classList.remove('hidden');\n    }\n\n    // 4. CFM\n    function calculateCFM() {\n        const vol = parseFloat(document.getElementById('calc-cfm-vol').value);\n        const ach = parseFloat(document.getElementById('calc-cfm-ach').value);\n        const res = document.getElementById('res-cfm');\n        if(!vol || !ach || vol <= 0) return;\n        \n        const cfm = (vol * ach) / 60;\n        res.innerHTML = `${Math.round(cfm).toLocaleString()} CFM Needed`;\n        res.classList.remove('hidden');\n    }\n\n    // 5. Chiller\n    function calculateChiller() {\n        const gpm = parseFloat(document.getElementById('calc-ch-gpm').value);\n        const dt = parseFloat(document.getElementById('calc-ch-dt').value);\n        const res = document.getElementById('res-ch');\n        if(!gpm || !dt || gpm <= 0 || dt <= 0) return;\n        \n        const tons = (gpm * dt) / 24;\n        res.innerHTML = `${tons.toFixed(1)} Tons Capacity`;\n        res.classList.remove('hidden');\n    }\n</script>\n",
    "protected": false
