                       <td class=\"p-4\">Visiting charge for diagnosis, waived if you proceed with the repair.</td>\n                                <td class=\"p-4 font-bold text-golden\">₹250</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n        </section>\n\n        <!-- Service Areas Section -->\n        <section id=\"service-areas\" class=\"py-20 px-6 bg-golden text-white\">\n            <div class=\"container mx-auto text-center\">\n                <h2 class=\"section-title text-center text-white\" style=\"--tw-text-opacity: 1;\">Serving All of Vadodara &#038; Beyond</h2>\n                <p class=\"max-w-3xl mx-auto mb-12\">From <strong>AC drainage repair in Alkapuri</strong> to <strong>emergency AC repair in Karelibaug</strong>, we&#8217;ve got you covered. We also serve major GIDCs across Gujarat.</p>\n                <div class=\"bg-white text-silver-black rounded-lg p-8 text-left max-w-5xl mx-auto shadow-2xl\">\n                    <h3 class=\"font-bold text-2xl mb-4 text-center\">Key Vadodara Localities We Serve:</h3>\n                    <div class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-x-6 gap-y-2 text-sm\">\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Ajwa Road</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Akota</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Alkapuri</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Bhayli</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Chhani</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Dandia Bazar</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Diwalipura</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Fatehgunj</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Gorwa</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i><strong>Gotri</strong></span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Harni</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Jetalpur Road</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Kalali</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i><strong>Karelibaug</strong></span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Makarpura</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Makarpura GIDC</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Maneja</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i><strong>Manjalpur</strong></span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Nandesari GIDC</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>New VIP Road</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i><strong>Nizampura</strong></span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Old Padra Road</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Race Course</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Sama</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Sayajigunj</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Subhanpura</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Tandalja</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Tarsali</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Vadiwadi</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Vasna-Bhayli Road</span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i><strong>Waghodia Road</strong></span>\n                        <span><i class=\"fas fa-map-marker-alt text-golden mr-2\"></i>Waghodia GIDC</span>\n                        <span>&#8230;and all other areas!</span>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n\n        <!-- FAQ Section -->\n        <section id=\"faq\" class=\"py-20 px-6\">\n            <div class=\"container mx-auto\">\n                <h2 class=\"section-title text-center text-silver-black\">Frequently Asked Questions (FAQ)</h2>\n                <div class=\"max-w-4xl mx-auto mt-12 space-y-4\">\n                    <!-- FAQ Item 1 -->\n                    <details class=\"bg-white p-6 rounded-lg shadow-md group\" open>\n                        <summary class=\"font-semibold text-lg cursor-pointer flex justify-between items-center\">\n                            Why is my AC leaking water inside in Vadodara?\n                            <i class=\"fas fa-plus group-open:hidden\"></i>\n                            <i class=\"fas fa-minus hidden group-open:block\"></i>\n                        </summary>\n                        <p class=\"mt-4 text-gray-600\">The most common reason for an <strong>AC leaking water inside in Vadodara</strong> is a <strong>clogged AC drain line</strong>. Over time, algae, dirt, and dust can form a blockage, causing water to back up and overflow from the drain pan into your home. Other possible causes include a rusted drain pan, a broken condensate pump, or incorrect installation.</p>\n                    </details>\n                    <!-- FAQ Item 2 -->\n                    <details class=\"bg-white p-6 rounded-lg shadow-md group\">\n                        <summary class=\"font-semibold text-lg cursor-pointer flex justify-between items-center\">\n                            What are the signs of a clogged AC drain line?\n                             <i class=\"fas fa-plus group-open:hidden\"></i>\n                            <i class=\"fas fa-minus hidden group-open:block\"></i>\n                        </summary>\n                        <p class=\"mt-4 text-gray-600\">Key signs include: water pooling around your indoor AC unit (<strong>AC unit leaking from bottom Vadodara</strong>), a musty or moldy smell coming from your vents (<strong>musty smell from AC vent Vadodara</strong>), the AC system shutting down unexpectedly, or visible water damage on walls or ceilings near the unit.</p>\n                    </details>\n                    <!-- FAQ Item 3 -->\n                    <details class=\"bg-white p-6 rounded-lg shadow-md group\">\n                        <summary class=\"font-semibold text-lg cursor-pointer flex justify-between items-center\">\n                            How much does it cost to fix a clogged AC drain in Vadodara?\n                            <i class=\"fas fa-plus group-open:hidden\"></i>\n                            <i class=\"fas fa-minus hidden group-open:block\"></i>\n                        </summary>\n                        <p class=\"mt-4 text-gray-600\">The <strong>cost to repair AC drain line in Vadodara</strong> is very affordable with Atlas Aircon. Our basic unclogging service starts from just ₹399. The final price depends on the severity of the clog and if any parts like the pipe or pan need repair or replacement. We always provide a final quote before starting any work.</p>\n                    </details>\n                    <!-- FAQ Item 4 -->\n                     <details class=\"bg-white p-6 rounded-lg shadow-md group\">\n                        <summary class=\"font-semibold text-lg cursor-pointer flex justify-between items-center\">\n                           How do you fix a clogged air conditioner drain?\n                           <i class=\"fas fa-plus group-open:hidden\"></i>\n                            <i class=\"fas fa-minus hidden group-open:block\"></i>\n                        </summary>\n                        <p class=\"mt-4 text-gray-600\">Our professionals typically <strong>fix a clogged air conditioner drain</strong> by using a powerful wet/dry vacuum to suction out the blockage from the drain&#8217;s termination point. For severe clogs, we may need to access the line and use specialized tools to break up and flush out the debris, ensuring a long-lasting solution.</p>\n                    </details>\n                     <details class=\"bg-white p-6 rounded-lg shadow-md group\">\n                        <summary class=\"font-semibold text-lg cursor-pointer flex justify-between items-center\">\n                            Can I prevent my AC drain line from clogging?\n                            <i class=\"fas fa-plus group-open:hidden\"></i>\n                            <i class=\"fas fa-minus hidden group-open:block\"></i>\n                        </summary>\n                        <p class=\"mt-4 text-gray-600\">Absolutely! The best way is regular maintenance. We offer <strong>AC drain line maintenance tips in Vadodara</strong>, including annual professional check-ups and cleanings. This is crucial for <strong>preventing future AC drain clogs in Vadodara</strong> and extends the life of your AC unit.</p>\n                    </details>\n                </div>\n            </div>\n        </section>\n        \n    </main>\n    \n    <!-- Popup Modal -->\n    <div id=\"exit-popup\" class=\"fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50 hidden\">\n        <div class=\"bg-white rounded-lg shadow-2xl max-w-md w-full relative transform transition-all scale-95 opacity-0\" id=\"popup-content\">\n            <button id=\"close-popup\" class=\"absolute top-3 right-4 text-gray-500 hover:text-black text-2xl\">&times;</button>\n            <div class=\"p-8 text-center\">\n                <i class=\"fas fa-tag text-4xl text-golden mb-4\"></i>\n                <h3 class=\"text-2xl font-bold text-silver-black mb-2\">Wait! Get a Free Quote.</h3>\n                <p class=\"text-gray-600 mb-6\">Let us fix your AC problem today. Fill out the form or call us now for an instant quote and fast service!</p>\n                <form action=\"#\" class=\"space-y-4\">\n                    <input type=\"text\" placeholder=\"Your Name\" class=\"w-full p-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-golden\">\n                    <input type=\"tel\" placeholder=\"Your Phone Number\" class=\"w-full p-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-golden\">\n                    <input type=\"text\" placeholder=\"Service Needed (e.g., Drain Repair)\" class=\"w-full p-3 border rounded-lg focus:outline-none focus:ring-golden\">\n                    <button type=\"submit\" class=\"w-full btn-cta text-lg\">Submit Request</button>\n                </form>\n                <div class=\"mt-6 flex flex-col sm:flex-row gap-4\">\n                     <a href=\"tel:+919727257141\" class=\"flex-1 bg-green-500 text-white font-bold py-3 px-4 rounded-lg hover:bg-green-600 transition flex items-center justify-center\">\n                        <i class=\"fas fa-phone-alt mr-2\"></i> Call Now\n                    </a>\n                    <a href=\"https://wa.me/919727257141\" target=\"_blank\" class=\"flex-1 bg-green-400 text-white font-bold py-3 px-4 rounded-lg hover:bg-green-500 transition flex items-center justify-center\" rel=\"noopener\">\n                        <i class=\"fab fa-whatsapp mr-2\"></i> WhatsApp\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n\n\n    <script>\n        // Mobile Menu Toggle\n        const mobileMenuButton = document.getElementById('mobile-menu-button');\n        const mobileMenu = document.getElementById('mobile-menu');\n        if (mobileMenuButton && mobileMenu) {\n            mobileMenuButton.addEventListener('click', () => {\n                mobileMenu.classList.toggle('hidden');\n            });\n        }\n\n\n        // Popup Logic\n        const exitPopup = document.getElementById('exit-popup');\n        const popupContent = document.getElementById('popup-content');\n        const closePopupButton = document.getElementById('close-popup');\n\n        const showPopup = () => {\n            if (!exitPopup) return;\n            exitPopup.classList.remove('hidden');\n            setTimeout(() => {\n                if(popupContent) popupContent.classList.remove('scale-95', 'opacity-0');\n            }, 50); // Small delay for transition\n        };\n\n        const hidePopup = () => {\n            if (!exitPopup || !popupContent) return;\n            popupContent.classList.add('scale-95', 'opacity-0');\n            setTimeout(() => {\n                exitPopup.classList.add('hidden');\n            }, 300); // Match transition duration\n        };\n\n        // Trigger on exit intent\n        document.addEventListener('mouseleave', (e) => {\n            if (e.clientY < 0) { // Mouse leaves top of viewport\n                showPopup();\n            }\n        });\n\n        // Trigger after 60 seconds of inactivity\n        let inactivityTimer;\n        const resetInactivityTimer = () => {\n            clearTimeout(inactivityTimer);\n            inactivityTimer = setTimeout(showPopup, 60000); // 60 seconds\n        };\n        \n        window.onload = resetInactivityTimer;\n        document.onmousemove = resetInactivityTimer;\n        document.onkeypress = resetInactivityTimer;\n        \n        // Close popup listeners\n        if (closePopupButton) closePopupButton.addEventListener('click', hidePopup);\n        if (exitPopup) {\n            exitPopup.addEventListener('click', (e) => {\n                if (e.target === exitPopup) { // Click on background\n                    hidePopup();\n                }\n            });\n        }\n        \n        // Smooth scroll for anchor links\n        document.querySelectorAll('a[href^=\"#\"]').forEach(anchor => {\n            anchor.addEventListener('click', function (e) {\n                e.preventDefault();\n                const targetElement = document.querySelector(this.getAttribute('href'));\n                if (targetElement) {\n                    targetElement.scrollIntoView({\n                        behavior: 'smooth'\n                    });\n                }\n            });\n        });\n    </script>\n\n</div>",
