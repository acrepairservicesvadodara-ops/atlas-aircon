        \"priceSpecification\": {\n              \"@type\": \"PriceSpecification\",\n              \"minPrice\": \"500\",\n              \"maxPrice\": \"25000\",\n              \"priceType\": \"ListPrice\"\n            }\n          },\n          \"brand\": [\n            {\"@type\": \"Brand\", \"name\": \"Blue Star\"},\n            {\"@type\": \"Brand\", \"name\": \"Carrier\"},\n            {\"@type\": \"Brand\", \"name\": \"Daikin\"},\n            {\"@type\": \"Brand\", \"name\": \"Voltas\"}\n          ]\n        },\n        {\n          \"@type\": \"Product\",\n          \"name\": \"Walk-in Freezer Repair Service\",\n          \"description\": \"Professional repair and maintenance for commercial and industrial walk-in freezers.\",\n          \"brand\": {\"@type\": \"Brand\", \"name\": \"Atlas Aircon\"},\n          \"offers\": {\n            \"@type\": \"AggregateOffer\",\n            \"priceCurrency\": \"INR\",\n            \"lowPrice\": \"500\",\n            \"highPrice\": \"25000\",\n            \"offerCount\": \"15\"\n          }\n        },\n        {\n          \"@type\": \"FAQPage\",\n          \"mainEntity\": [\n            {\n              \"@type\": \"Question\",\n              \"name\": \"How much does walk-in freezer repair cost in Vadodara?\",\n              \"acceptedAnswer\": {\n                \"@type\": \"Answer\",\n                \"text\": \"The cost for walk-in freezer repair in Vadodara varies based on the issue. A basic inspection starts at ₹500. More complex repairs like compressor replacement can range from ₹8,000 to ₹25,000, while gas refilling charges are typically between ₹2,500 and ₹7,000. We provide a detailed quote before starting any work.\"\n              }\n            },\n            {\n              \"@type\": \"Question\",\n              \"name\": \"Do you offer 24/7 emergency walk-in freezer repair services?\",\n              \"acceptedAnswer\": {\n                \"@type\": \"Answer\",\n                \"text\": \"Yes, we specialize in 24/7 emergency walk-in freezer repair in Vadodara. Our technicians are available around the clock to address urgent breakdowns and minimize your business downtime.\"\n              }\n            },\n            {\n              \"@type\": \"Question\",\n              \"name\": \"What brands of walk-in freezers do you service?\",\n              \"acceptedAnswer\": {\n                \"@type\": \"Answer\",\n                \"text\": \"Our certified technicians are experienced in repairing all major brands, including Blue Star walk-in freezer repair, Carrier, Daikin, Voltas, and many more.\"\n              }\n            },\n            {\n              \"@type\": \"Question\",\n              \"name\": \"Is there a warranty on your repair services?\",\n              \"acceptedAnswer\": {\n                \"@type\": \"Answer\",\n                \"text\": \"Absolutely. We offer a 3-month guarantee on all our services and any parts we replace, giving you complete peace of mind.\"\n              }\n            },\n            {\n              \"@type\": \"Question\",\n              \"name\": \"My walk-in freezer is not freezing. What could be the problem?\",\n              \"acceptedAnswer\": {\n                \"@type\": \"Answer\",\n                \"text\": \"A walk-in freezer not freezing can be due to several issues: low refrigerant levels, a faulty compressor, a malfunctioning evaporator fan, or a dirty condenser coil. Our experts can quickly diagnose and fix the root cause.\"\n              }\n            }\n          ]\n        },\n        {\n          \"@type\": \"ItemList\",\n          \"name\": \"Walk-in Freezer Repair Services\",\n          \"itemListElement\": [\n            {\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Compressor Repair & Replacement\"},\n            {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Gas Refilling Service\"},\n            {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Door Gasket & Seal Repair\"},\n            {\"@type\": \"ListItem\", \"position\": 4, \"name\": \"Thermostat & Electrical Fault Repair\"},\n            {\"@type\": \"ListItem\", \"position\": 5, \"name\": \"Condenser & Evaporator Coil Cleaning\"}\n          ]\n        },\n        {\n          \"@type\": \"HowTo\",\n          \"name\": \"How to Get Your Walk-in Freezer Repaired\",\n          \"step\": [\n            {\n              \"@type\": \"HowToStep\",\n              \"name\": \"Step 1: Contact Us\",\n              \"text\": \"Call us at +91-9727257141 or fill out our online form. Describe the issue with your walk-in freezer.\",\n              \"url\": \"https://atlasaircons.com/comprehensive-walk-in-freezer-repair-services-ensuring-optimal-performance/#contact\"\n            },\n            {\n              \"@type\": \"HowToStep\",\n              \"name\": \"Step 2: Get a Quote\",\n              \"text\": \"We provide a transparent and upfront quote for the required repair service. No hidden charges.\"\n            },\n            {\n              \"@type\": \"HowToStep\",\n              \"name\": \"Step 3: Schedule Service\",\n              \"text\": \"We schedule a visit from our certified technician at a time that is convenient for you, including for emergency same-day service.\"\n            },\n            {\n              \"@type\": \"HowToStep\",\n              \"name\": \"Step 4: Expert Repair\",\n              \"text\": \"Our technician arrives, diagnoses the problem, and performs the repair efficiently using genuine parts.\"\n            }\n          ]\n        },\n        {\n          \"@type\": \"Offer\",\n          \"name\": \"3-Month Service Guarantee\",\n          \"category\": \"Warranty\",\n          \"offeredBy\": {\"@type\": \"Organization\", \"name\": \"Atlas Aircon\"},\n          \"warrantyScope\": {\n            \"@type\": \"WarrantyPromise\",\n            \"durationOfWarranty\": {\"@type\": \"QuantitativeValue\", \"value\": 3, \"unitCode\": \"MON\"},\n            \"warrantyPromise\": \"Guarantee on all repair services and replaced parts.\"\n          }\n        }\n      ]\n    }\n    </script>\n<script>\n        document.addEventListener('DOMContentLoaded', function() {\n            const popupOverlay = document.getElementById('popup-overlay');\n            const popupContainer = document.getElementById('popup-container');\n            const closePopupButton = document.getElementById('close-popup');\n            const minimizedPopup = document.getElementById('minimized-popup');\n\n            // --- Popup Logic ---\n            const showPopup = () => {\n                popupOverlay.style.display = 'flex';\n                setTimeout(() => popupContainer.style.transform = 'scale(1)', 50);\n            };\n\n            const hidePopup = () => {\n                popupContainer.style.transform = 'scale(0.95)';\n                setTimeout(() => {\n                    popupOverlay.style.display = 'none';\n                    minimizedPopup.style.display = 'flex';\n                }, 300);\n            };\n\n            // Show popup after 60 seconds, only once per session\n            if (!sessionStorage.getItem('popupShown')) {\n                setTimeout(() => {\n                    showPopup();\n                    sessionStorage.setItem('popupShown', 'true');\n                }, 60000);\n            }\n\n            closePopupButton.addEventListener('click', hidePopup);\n            minimizedPopup.addEventListener('click', () => {\n                minimizedPopup.style.display = 'none';\n                showPopup();\n            });\n            \n            // Close popup if clicking on the overlay\n            popupOverlay.addEventListener('click', function(e) {\n                if (e.target === popupOverlay) {\n                    hidePopup();\n                }\n            });\n\n            // --- Mobile Menu Logic ---\n            const menuButton = document.querySelector('.md\\\\:hidden');\n            const nav = document.querySelector('nav');\n            if (menuButton && nav) {\n                menuButton.addEventListener('click', () => {\n                    nav.classList.toggle('hidden');\n                });\n            }\n        });\n    </script>\n\n\n    <!-- Hero Section -->\n    <section class=\"hero-gradient py-20\">\n        <div class=\"container mx-auto px-6 text-center md:text-left\">\n            <div class=\"grid md:grid-cols-2 gap-12 items-center\">\n                <div class=\"md:pr-10\">\n                    <h1 class=\"text-4xl md:text-6xl font-extrabold text-gray-900 leading-tight mb-4\">\n                        Expert <span class=\"text-amber-600\">Walk-in Freezer Repair</span> Services in Vadodara\n                    </h1>\n                    <p class=\"text-lg text-gray-700 mb-8\">\n                        Is a broken walk-in freezer threatening your business? Get <strong>24/7 emergency walk-in freezer repair</strong> from certified experts. We offer <strong>fast walk-in freezer service</strong>, transparent <strong>walk-in freezer repair charges</strong>, and a 3-month guarantee.\n                    </p>\n                    <div class=\"flex flex-col sm:flex-row justify-center md:justify-start space-y-4 sm:space-y-0 sm:space-x-4\">\n                        <a href=\"#contact\" class=\"btn-primary\">Get a Free Quote</a>\n                        <a href=\"tel:+919727257141\" class=\"btn-secondary\">Call For Emergency</a>\n                    </div>\n                </div>\n                <div>\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2024/03/Walkin-Freezer-Repair-Service.webp\" alt=\"Professional Walk-in Freezer Repair Services by Atlas Aircon\" class=\"rounded-xl shadow-2xl w-full\" title=\"\">\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Main Content -->\n    <main class=\"container mx-auto px-6 py-16\">\n\n        <!-- Why Choose Us Section -->\n        <section id=\"why-us\" class=\"py-16\">\n            <h2 class=\"section-title\">Why Trust Atlas Aircon?</h2>\n            <p class=\"section-subtitle\">We are Vadodara&#8217;s leading choice for <strong>commercial freezer repair</strong> because we deliver reliability, speed, and quality every time.</p>\n            <div class=\"grid md:grid-cols-2 lg:grid-cols-4 gap-8 text-center\">\n                <div class=\"card p-8\">\n                    <div class=\"icon-box\"><i class=\"fas fa-user-shield\"></i></div>\n                    <h3 class=\"text-2xl font-bold mb-2\">Certified Technicians</h3>\n                    <p>Our team consists of <strong>experienced walk-in freezer technicians</strong> trained to handle any issue.</p>\n                </div>\n                <div class=\"card p-8\">\n                    <div class=\"icon-box\"><i class=\"fas fa-clock\"></i></div>\n                    <h3 class=\"text-2xl font-bold mb-2\">24/7 Emergency Service</h3>\n                    <p>We offer <strong>urgent walk-in freezer service in Vadodara</strong> day or night to protect your inventory.</p>\n                </div>\n                <div class=\"card p-8\">\n                    <div class=\"icon-box\"><i class=\"fas fa-hand-holding-usd\"></i></div>\n                    <h3 class=\"text-2xl font-bold mb-2\">Transparent Pricing</h3>\n                    <p>Get <strong>affordable walk-in freezer repair</strong> with clear, upfront <strong>walk-in freezer service cost</strong>. No surprises.</p>\n                </div>\n                <div class=\"card p-8\">\n                    <div class=\"icon-box\"><i class=\"fas fa-check-circle\"></i></div>\n                    <h3 class=\"text-2xl font-bold mb-2\">3-Month Guarantee</h3>\n                    <p>We stand by our work with a comprehensive guarantee on all repairs and parts.</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- WooCommerce-Style Services Section -->\n        <section id=\"services\" class=\"py-16 bg-gray-50 rounded-2xl\">\n            <h2 class=\"section-title\">Our Walk-in Freezer Repair Solutions</h2>\n            <p class=\"section-subtitle\">From minor fixes to major overhauls, we provide a complete range of <strong>specialized walk-in freezer repair</strong> services.</p>\n            <div class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-8\">\n                <!-- Service Item 1 -->\n                <div class=\"card\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/06/modern-digital-thermostat-perhaps-showing-an-error-message-or-incorrect-temperature.webp\" alt=\"Walk-in freezer temperature issue repair Vadodara\" class=\"w-full h-56 object-cover\" title=\"\">\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-bold mb-2\">Temperature &#038; Thermostat Repair</h3>\n                        <p class=\"text-gray-600 mb-4\">Fixing a <strong>walk-in freezer not freezing</strong> or temperature fluctuations. We handle thermostat calibration and replacement.</p>\n                        <p class=\"text-lg font-semibold text-amber-600\">Starting from ₹800</p>\n                    </div>\n                </div>\n                <!-- Service Item 2 -->\n                <div class=\"card\">\n                    <img decoding=\"async\" src=\"https://placehold.co/600x400/ffc107/333333?text=Compressor+Repair\" alt=\"walk-in freezer compressor replacement Vadodara\" class=\"w-full h-56 object-cover\" title=\"\">\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-bold mb-2\">Compressor Repair &#038; Replacement</h3>\n                        <p class=\"text-gray-600 mb-4\">Expert diagnostics and repair for the heart of your freezer. We offer cost-effective <strong>walk-in freezer compressor repair cost</strong>.</p>\n                        <p class=\"text-lg font-semibold text-amber-600\">Starting from ₹5,000</p>\n                    </div>\n                </div>\n                <!-- Service Item 3 -->\n                <div class=\"card\">\n                    <img decoding=\"async\" src=\"https://placehold.co/600x400/343a40/ffffff?text=Gas+Refilling\" alt=\"walk-in freezer gas refilling charges Vadodara\" class=\"w-full h-56 object-cover\" title=\"\">\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-bold mb-2\">Refrigerant Gas Refilling</h3>\n                        <p class=\"text-gray-600 mb-4\">Safe and efficient <strong>walk-in freezer gas refilling charges</strong> to restore optimal cooling performance.</p>\n                        <p class=\"text-lg font-semibold text-amber-600\">Starting from ₹2,500</p>\n                    </div>\n                </div>\n                <!-- Service Item 4 -->\n                <div class=\"card\">\n                    <img decoding=\"async\" src=\"https://placehold.co/600x400/ffc107/333333?text=Door+Seal+Repair\" alt=\"walk-in freezer door gasket repair Vadodara\" class=\"w-full h-56 object-cover\" title=\"\">\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-bold mb-2\">Door Gasket &#038; Panel Repair</h3>\n                        <p class=\"text-gray-600 mb-4\">We perform <strong>walk-in freezer door gasket repair</strong> and <strong>walk-in freezer panel repair</strong> to prevent energy loss.</p>\n                        <p class=\"text-lg font-semibold text-amber-600\">Starting from ₹1,500</p>\n                    </div>\n                </div>\n                <!-- Service Item 5 -->\n                <div class=\"card\">\n                    <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/06/clean-air-filter-next-to-a-very-dirty.webp\" alt=\"walk-in freezer condenser cleaning Vadodara\" class=\"w-full h-56 object-cover\" title=\"\">\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-bold mb-2\">Condenser &#038; Fan Motor Service</h3>\n                        <p class=\"text-gray-600 mb-4\">Includes <strong>walk-in freezer condenser cleaning</strong> and <strong>walk-in freezer fan motor repair</strong> for system efficiency.</p>\n                        <p class=\"text-lg font-semibold text-amber-600\">Starting from ₹1,200</p>\n                    </div>\n                </div>\n                <!-- Service Item 6 -->\n                <div class=\"card\">\n                    <img decoding=\"async\" src=\"https://placehold.co/600x400/343a40/ffffff?text=Electrical+Repair\" alt=\"walk-in freezer electrical fault repair Vadodara\" class=\"w-full h-56 object-cover\" title=\"\">\n                    <div class=\"p-6\">\n                        <h3 class=\"text-xl font-bold mb-2\">Electrical &#038; Defrost System Repair</h3>\n                        <p class=\"text-gray-600 mb-4\">Solving <strong>walk-in freezer defrost problem</strong> and <strong>electrical fault repair</strong> to ensure safety and functionality.</p>\n                        <p class=\"text-lg font-semibold text-amber-600\">Starting from ₹900</p>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- Price List Section -->\n        <section id=\"pricing\" class=\"py-16\">\n            <h2 class=\"section-title\">Transparent Service Charges</h2>\n            <p class=\"section-subtitle\">We believe in honest pricing. Here is a detailed breakdown of our <strong>walk-in freezer repair charges in Vadodara</strong>.</p>\n            <div class=\"overflow-x-auto\">\n                <table class=\"min-w-full bg-white shadow-md rounded-lg\">\n                    <thead class=\"bg-gray-800 text-white\">\n                        <tr>\n                            <th class=\"text-left py-3 px-4 uppercase font-semibold text-sm\">Service / Part</th>\n                            <th class=\"text-left py-3 px-4 uppercase font-semibold text-sm\">Description</th>\n                            <th class=\"text-left py-3 px-4 uppercase font-semibold text-sm\">Estimated Cost (INR)</th>\n                        </tr>\n                    </thead>\n                    <tbody class=\"text-gray-700\">\n                        <tr class=\"border-b\">\n                            <td class=\"py-3 px-4 font-semibold\">Inspection Charge</td>\n                            <td class=\"py-3 px-4\">Initial diagnostic visit to identify the problem.</td>\n                            <td class=\"py-3 px-4 font-bold\">₹500 &#8211; ₹800</td>\n                        </tr>\n                        <tr class=\"bg-gray-50 border-b\">\n                            <td class=\"py-3 px-4 font-semibold\">Gas Refilling</td>\n                            <td class=\"py-3 px-4\">Includes leak test and refilling with appropriate refrigerant.</td>\n                            <td class=\"py-3 px-4 font-bold\">₹2,500 &#8211; ₹7,000</td>\n                        </tr>\n                        <tr class=\"border-b\">\n                            <td class=\"py-3 px-4 font-semibold\">Compressor Repair</td>\n                            <td class=\"py-3 px-4\">Minor repairs to the compressor unit.</td>\n                            <td class=\"py-3 px-4 font-bold\">₹5,000 &#8211; ₹12,000</td>\n                        </tr>\n                        <tr class=\"bg-gray-50 border-b\">\n                            <td class=\"py-3 px-4 font-semibold\">Compressor Replacement</td>\n                            <td class=\"py-3 px-4\">Includes new compressor unit and installation.</td>\n                            <td class=\"py-3 px-4 font-bold\">₹8,000 &#8211; ₹25,000+</td>\n                        </tr>\n                        <tr class=\"border-b\">\n                            <td class=\"py-3 px-4 font-semibold\">Fan Motor Repair/Replacement</td>\n                            <td class=\"py-3 px-4\">Repair or replacement of evaporator or condenser fan motor.</td>\n                            <td class=\"py-3 px-4 font-bold\">₹1,500 &#8211; ₹5,500</td>\n                        </tr>\n                        <tr class=\"bg-gray-50 border-b\">\n                            <td class=\"py-3 px-4 font-semibold\">Door Gasket Replacement</td>\n                            <td class=\"py-3 px-4\">Replacement of worn-out door seals.</td>\n                            <td class=\"py-3 px-4 font-bold\">₹1,500 &#8211; ₹4,000</td>\n                        </tr>\n                        <tr class=\"border-b\">\n                            <td class=\"py-3 px-4 font-semibold\">Thermostat Replacement</td>\n                            <td class=\"py-3 px-4\">Installation of a new digital or analog thermostat.</td>\n                            <td class=\"py-3 px-4 font-bold\">₹1,200 &#8211; ₹3,500</td>\n                        </tr>\n                        <tr class=\"bg-gray-50\">\n                            <td class=\"py-3 px-4 font-semibold\">Annual Maintenance Contract (AMC)</td>\n                            <td class=\"py-3 px-4\">Comprehensive yearly plan including 2-4 services.</td>\n                            <td class=\"py-3 px-4 font-bold\">Starting from ₹6,000/year</td>\n                        </tr>\n                    </tbody>\n                </table>\n            </div>\n            <p class=\"text-center text-sm text-gray-500 mt-4\">*Final prices may vary based on the specific model, brand, and complexity of the issue. All charges will be confirmed before work begins.</p>\n        </section>\n\n        <!-- Service Area Section -->\n        <section id=\"service-areas\" class=\"py-16 bg-gray-800 text-white rounded-2xl\">\n            <h2 class=\"section-title !text-white\">Serving All of Vadodara and Gujarat GIDCs</h2>\n            <p class=\"section-subtitle !text-gray-300\">We provide <strong>on-site walk-in freezer repair</strong> across every neighborhood and industrial estate. If you&#8217;re in Vadodara, we&#8217;ve got you covered.</p>\n            <div class=\"flex flex-wrap gap-3 justify-center\">\n                <span class=\"area-tag !bg-amber-400 !text-black\">Makarpura GIDC</span>\n                <span class=\"area-tag !bg-amber-400 !text-black\">Nandesari GIDC</span>\n                <span class=\"area-tag !bg-amber-400 !text-black\">Waghodia GIDC</span>\n                <span class=\"area-tag !bg-amber-400 !text-black\">Savli (Manjusar) GIDC</span>\n                <span class=\"area-tag\">Alkapuri</span><span class=\"area-tag\">Akota</span><span class=\"area-tag\">Gotri</span>\n                <span class=\"area-tag\">Manjalpur</span><span class=\"area-tag\">Karelibaug</span><span class=\"area-tag\">Sama</span>\n                <span class=\"area-tag\">Fatehganj</span><span class=\"area-tag\">Harni</span><span class=\"area-tag\">Tarsali</span>\n                <span class=\"area-tag\">Bhayli</span><span class=\"area-tag\">Chhani</span><span class=\"area-tag\">Atladara</span>\n                <span class=\"area-tag\">Old Padra Road</span><span class=\"area-tag\">New VIP Road</span><span class=\"area-tag\">Vasna Road</span>\n                <span class=\"area-tag\">Dabhoi Road</span><span class=\"area-tag\">Ajwa Road</span><span class=\"area-tag\">Por-Ramangamdi GIDC</span>\n                <!-- Add all other areas here -->\n            </div>\n            <p class=\"text-center text-gray-400 mt-8\">&#8230;and all other surrounding areas in Gujarat!</p>\n        </section>\n\n        <!-- FAQ Section -->\n        <section id=\"faq\" class=\"py-16\">\n            <h2 class=\"section-title\">Frequently Asked Questions</h2>\n            <p class=\"section-subtitle\">Have questions? We have answers. Here are some common queries about our <strong>walk-in freezer maintenance</strong> and repair services.</p>\n            <div class=\"max-w-4xl mx-auto space-y-4\">\n                <details class=\"bg-white p-6 rounded-lg shadow-md group\">\n                    <summary class=\"font-semibold text-lg cursor-pointer flex justify-between items-center\">\n                        What are the signs that my walk-in freezer needs repair?\n                        <i class=\"fas fa-chevron-down group-open:rotate-180 transition-transform\"></i>\n                    </summary>\n                    <p class=\"mt-4 text-gray-600\">Common signs include: the <strong>walk-in freezer not freezing</strong>, visible frost buildup, strange noises (<strong>walk-in freezer noise repair</strong>), water leakage, and unusually high electricity bills.</p>\n                </details>\n                <details class=\"bg-white p-6 rounded-lg shadow-md group\">\n                    <summary class=\"font-semibold text-lg cursor-pointer flex justify-between items-center\">\n                        How quickly can you respond to an emergency call?\n                        <i class=\"fas fa-chevron-down group-open:rotate-180 transition-transform\"></i>\n                    </summary>\n                    <p class=\"mt-4 text-gray-600\">We pride ourselves on <strong>quick response walk-in freezer Vadodara</strong> service. For emergencies, our goal is to have a technician at your location within 60-90 minutes of your call.</p>\n                </details>\n                <details class=\"bg-white p-6 rounded-lg shadow-md group\">\n                    <summary class=\"font-semibold text-lg cursor-pointer flex justify-between items-center\">\n                        Is it better to repair or replace my old walk-in freezer?\n                        <i class=\"fas fa-chevron-down group-open:rotate-180 transition-transform\"></i>\n                    </summary>\n                    <p class=\"mt-4 text-gray-600\">This depends on the age, condition, and repair cost. If the repair cost is more than 50% of a new unit&#8217;s price, or if it&#8217;s over 15 years old and needs frequent repairs, replacement might be more economical. We provide honest advice to help you decide.</p>\n                </details>\n                 <details class=\"bg-white p-6 rounded-lg shadow-md group\">\n                    <summary class=\"font-semibold text-lg cursor-pointer flex justify-between items-center\">\n                        Do you service specific types like ice cream or meat cold storage?\n                        <i class=\"fas fa-chevron-down group-open:rotate-180 transition-transform\"></i>\n                    </summary>\n                    <p class=\"mt-4 text-gray-600\">Yes, we are experts in all types of commercial refrigeration. We handle <strong>ice cream freezer repair</strong>, <strong>meat cold storage repair</strong>, <strong>vegetable cold storage repair</strong>, and more.</p>\n                </details>\n                <details class=\"bg-white p-6 rounded-lg shadow-md group\">\n                    <summary class=\"font-semibold text-lg cursor-pointer flex justify-between items-center\">\n                        What is included in a walk-in freezer AMC?\n                        <i class=\"fas fa-chevron-down group-open:rotate-180 transition-transform\"></i>\n                    </summary>\n                    <p class=\"mt-4 text-gray-600\">Our <strong>walk-in freezer AMC charges</strong> typically cover 2-4 scheduled maintenance visits per year. This includes <strong>condenser cleaning</strong>, system diagnostics, temperature calibration, and checking all electrical and mechanical components to prevent breakdowns.</p>\n                </details>\n            </div>\n        </section>\n        \n        <!-- Internal Links Section -->\n        <section id=\"other-services\" class=\"py-16 bg-gray-50 rounded-2xl\">\n            <h2 class=\"section-title\">Explore Our Other Expert Services</h2>\n            <p class=\"section-subtitle\">Atlas Aircon is your one-stop solution for all cooling and appliance repair needs in Vadodara.</p>\n            <div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 text-center\">\n                <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/ac-repair-in-samta/\" class=\"p-4 bg-white rounded-lg shadow-md hover:bg-amber-100 transition-colors font-semibold\">AC AMC Services</a>\n                <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/ac-gas-refilling/\" class=\"p-4 bg-white rounded-lg shadow-md hover:bg-amber-100 transition-colors font-semibold\">AC Gas Filling</a>\n                <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/professional-standard-ac-installation-service/\" class=\"p-4 bg-white rounded-lg shadow-md hover:bg-amber-100 transition-colors font-semibold\">AC Installation</a>\n                <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/ac-on-rent-vadodara/\" class=\"p-4 bg-white rounded-lg shadow-md hover:bg-amber-100 transition-colors font-semibold\">AC on Rent</a>\n                <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/refrigerator-repair-services.html\" class=\"p-4 bg-white rounded-lg shadow-md hover:bg-amber-100 transition-colors font-semibold\">Refrigerator Repair</a>\n                <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/washing-machine-repair-in-vadodara/\" class=\"p-4 bg-white rounded-lg shadow-md hover:bg-amber-100 transition-colors font-semibold\">Washing Machine Repair</a>\n                <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/cold-room-repair-in-vadodara/\" class=\"p-4 bg-white rounded-lg shadow-md hover:bg-amber-100 transition-colors font-semibold\">Cold Room Repair</a>\n                <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/services/other-repairing/chiller-repair-services.html\" class=\"p-4 bg-white rounded-lg shadow-md hover:bg-amber-100 transition-colors font-semibold\">Chiller Repair Service</a>\n            </div>\n        </section>\n\n\n    </main>\n\n    <!-- Popup Feature -->\n    <div id=\"popup-overlay\">\n        <div id=\"popup-container\">\n            <span id=\"close-popup\">&times;</span>\n            <h3 class=\"text-2xl font-bold text-gray-800 mb-2\">Get a FREE, No-Obligation Quote!</h3>\n            <p class=\"text-gray-600 mb-6\">Facing a freezer emergency? Let us help you now.</p>\n            <form class=\"space-y-4\">\n                <input type=\"text\" placeholder=\"Your Name\" class=\"w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500\">\n                <input type=\"tel\" placeholder=\"Your Phone Number\" class=\"w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500\">\n                <input type=\"text\" placeholder=\"Service Needed (e.g., Freezer Not Cooling)\" class=\"w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-500\">\n                <button type=\"submit\" class=\"btn-primary w-full\">Submit Request</button>\n            </form>\n            <div class=\"flex items-center my-4\">\n                <hr class=\"w-full border-gray-300\">\n                <span class=\"px-2 text-gray-500 font-semibold\">OR</span>\n                <hr class=\"w-full border-gray-300\">\n            </div>\n            <div class=\"flex flex-col sm:flex-row gap-4\">\n                <a href=\"tel:+919727257141\" class=\"flex-1 bg-green-500 text-white font-bold py-3 px-4 rounded-lg flex items-center justify-center gap-2 hover:bg-green-600 transition-colors\">\n                    <i class=\"fas fa-phone-alt\"></i> Call Now\n                </a>\n                <a href=\"https://wa.me/919727257141\" target=\"_blank\" class=\"flex-1 bg-green-500 text-white font-bold py-3 px-4 rounded-lg flex items-center justify-center gap-2 hover:bg-green-600 transition-colors\" rel=\"noopener\">\n                    <i class=\"fab fa-whatsapp\"></i> WhatsApp Us\n                </a>\n            </div>\n        </div>\n    </div>\n\n    <div id=\"minimized-popup\">\n        <i class=\"fas fa-quote-left\"></i>\n    </div>\n\n    <script>\n        document.addEventListener('DOMContentLoaded', function() {\n            const popupOverlay = document.getElementById('popup-overlay');\n            const popupContainer = document.getElementById('popup-container');\n            const closePopupButton = document.getElementById('close-popup');\n            const minimizedPopup = document.getElementById('minimized-popup');\n\n            // --- Popup Logic ---\n            const showPopup = () => {\n                popupOverlay.style.display = 'flex';\n                setTimeout(() => popupContainer.style.transform = 'scale(1)', 50);\n            };\n\n            const hidePopup = () => {\n                popupContainer.style.transform = 'scale(0.95)';\n                setTimeout(() => {\n                    popupOverlay.style.display = 'none';\n                    minimizedPopup.style.display = 'flex';\n                }, 300);\n            };\n\n            // Show popup after 60 seconds, only once per session\n            if (!sessionStorage.getItem('popupShown')) {\n                setTimeout(() => {\n                    showPopup();\n                    sessionStorage.setItem('popupShown', 'true');\n                }, 60000);\n            }\n\n            closePopupButton.addEventListener('click', hidePopup);\n            minimizedPopup.addEventListener('click', () => {\n                minimizedPopup.style.display = 'none';\n                showPopup();\n            });\n            \n            // Close popup if clicking on the overlay\n            popupOverlay.addEventListener('click', function(e) {\n                if (e.target === popupOverlay) {\n                    hidePopup();\n                }\n            });\n\n            // --- Mobile Menu Logic ---\n            const menuButton = document.querySelector('.md\\\\:hidden');\n            const nav = document.querySelector('nav');\n            if (menuButton && nav) {\n                menuButton.addEventListener('click', () => {\n                    nav.classList.toggle('hidden');\n                });\n            }\n        });\n    </script>\n\n</div>",
