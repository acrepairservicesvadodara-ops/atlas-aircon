  "content": {
    "rendered": "<div class=\"atlas-purified-matrix\"><style>\n        body {\n            font-family: 'Inter', sans-serif;\n            background-color: #f8f9fa; /* Clean matte white/light grey background */\n            color: #333333;\n        }\n        .hero-gradient {\n            background: linear-gradient(135deg, #FFD700, #FFFFFF); /* Yellow Golden to White */\n        }\n        .btn-primary {\n            @apply inline-block bg-gray-800 text-white font-bold text-lg px-8 py-4 rounded-lg shadow-lg transition-transform transform hover:scale-105;\n        }\n        .btn-secondary {\n            @apply inline-block bg-amber-400 text-gray-900 font-bold text-lg px-8 py-4 rounded-lg shadow-lg transition-transform transform hover:scale-105;\n        }\n        .section-title {\n            @apply text-4xl font-extrabold text-gray-800 mb-4 text-center;\n        }\n        .section-subtitle {\n            @apply text-xl text-gray-600 mb-12 text-center max-w-3xl mx-auto;\n        }\n        .card {\n            @apply bg-white rounded-xl shadow-lg overflow-hidden transition-all duration-300 hover:shadow-2xl hover:-translate-y-2;\n        }\n        .icon-box {\n            @apply text-amber-500 text-5xl mb-4;\n        }\n        .area-tag {\n            @apply bg-gray-200 text-gray-700 px-4 py-2 rounded-full font-semibold transition-colors hover:bg-amber-400 hover:text-black;\n        }\n        /* Popup Styles */\n        #popup-overlay {\n            @apply fixed inset-0 bg-black bg-opacity-60 z-40 hidden items-center justify-center;\n        }\n        #popup-container {\n            @apply bg-white p-8 rounded-2xl shadow-2xl w-11/12 md:w-1/3 text-center relative transform transition-transform duration-300 scale-95;\n        }\n        #close-popup {\n            @apply absolute top-4 right-4 text-gray-500 hover:text-gray-800 text-2xl cursor-pointer;\n        }\n        #minimized-popup {\n            @apply fixed bottom-5 right-5 bg-amber-500 text-white w-16 h