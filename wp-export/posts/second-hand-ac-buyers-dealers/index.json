\n                popup.style.display = 'none';\n                document.body.style.overflow = 'auto';\n            }\n        };\n\n        // Show popup on exit intent\n        document.addEventListener('mouseleave', (e) => {\n            if (e.clientY < 0) {\n                showPopup();\n            }\n        });\n\n        // Show popup after 120 seconds of inactivity\n        const resetInactivityTimer = () => {\n            clearTimeout(inactivityTimer);\n            inactivityTimer = setTimeout(showPopup, 120000); // 120 seconds\n        };\n\n        window.onload = resetInactivityTimer;\n        document.onmousemove = resetInactivityTimer;\n        document.onkeypress = resetInactivityTimer;\n        \n        // Close button functionality\n        if (closePopupButton) {\n            closePopupButton.addEventListener('click', hidePopup);\n        }\n        if (popup) {\n            popup.addEventListener('click', (e) => {\n                if (e.target === popup) {\n                    hidePopup();\n                }\n            });\n        }\n    </script>\n\n\n    <main>\n        <!-- Hero Section -->\n        <section class=\"hero-gradient pt-16 pb-20\">\n            <div class=\"container mx-auto px-6 text-center\">\n                <div class=\"max-w-4xl mx-auto\">\n                    <h1 class=\"text-4xl md:text-6xl font-extrabold text-gray-800 leading-tight mb-6\">\n                        Gujarat&#8217;s #1 <span class=\"text-yellow-600\">Second Hand &#038; Used AC</span> Buyer and Seller\n                    </h1>\n                    <p class=\"text-lg md:text-xl text-gray-600 mb-8\">\n                        Get the <strong>best price for your used AC</strong> or buy a certified <strong>pre-owned air conditioner</strong> with a warranty. Fast, fair, and reliable service across Gujarat.\n                    </p>\n                    <div class=\"flex justify-center space-x-4\">\n                        <a href=\"tel:+919727257141\" class=\"btn-golden text-lg font-bold py-4 px-8 rounded-full\">Sell Your AC Now</a>\n                        <a href=\"#buy-ac\" class=\"btn-dark text-lg font-bold py-4 px-8 rounded-full\">Buy a Used AC</a>\n                    </div>\n                </div>\n                 <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2023/03/Buy-and-Sell-Air-Conditioner-1024x512.webp\" alt=\"Best second hand and used AC buyer and seller in Gujarat\" class=\"mt-12 mx-auto rounded-lg shadow-2xl w-full max-w-4xl\" title=\"\">\n            </div>\n        </section>\n\n        <!-- Why Choose Us Section -->\n        <section id=\"why-us\" class=\"py-20 bg-gray-50\">\n            <div class=\"container mx-auto px-6\">\n                <h2 class=\"section-title\">Why We Are The Best in Gujarat</h2>\n                <p class=\"section-subtitle\">When you choose Atlas Aircon, you&#8217;re choosing reliability, transparency, and unmatched value. We are the most trusted <strong>second hand and used ac buyer and seller</strong> for a reason.</p>\n                <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8\">\n                    <div class=\"bg-white p-8 rounded-lg shadow-lg text-center hover:shadow-xl transition-shadow duration-300\">\n                        <i class=\"fas fa-hand-holding-usd fa-3x text-yellow-500 mb-4\"></i>\n                        <h3 class=\"text-xl font-bold mb-2\">Best Market Price</h3>\n                        <p class=\"text-gray-600\">We offer the most competitive prices whether you want to <strong>sell your old AC</strong> or buy one. No hidden fees, just honest valuation.</p>\n                    </div>\n                    <div class=\"bg-white p-8 rounded-lg shadow-lg text-center hover:shadow-xl transition-shadow duration-300\">\n                        <i class=\"fas fa-shield-alt fa-3x text-yellow-500 mb-4\"></i>\n                        <h3 class=\"text-xl font-bold mb-2\">3-Month Guarantee</h3>\n                        <p class=\"text-gray-600\">Buy with confidence. All our <strong>refurbished AC units</strong> come with a 3-month warranty on services and parts for your peace of mind.</p>\n                    </div>\n                    <div class=\"bg-white p-8 rounded-lg shadow-lg text-center hover:shadow-xl transition-shadow duration-300\">\n                        <i class=\"fas fa-check-circle fa-3x text-yellow-500 mb-4\"></i>\n                        <h3 class=\"text-xl font-bold mb-2\">Certified Technicians</h3>\n                        <p class=\"text-gray-600\">Our team consists of certified and experienced technicians who thoroughly inspect and restore every AC unit to perfect working condition.</p>\n                    </div>\n                    <div class=\"bg-white p-8 rounded-lg shadow-lg text-center hover:shadow-xl transition-shadow duration-300\">\n                        <i class=\"fas fa-truck-fast fa-3x text-yellow-500 mb-4\"></i>\n                        <h3 class=\"text-xl font-bold mb-2\">Free &#038; Fast Pickup</h3>\n                        <p class=\"text-gray-600\">Selling your AC is hassle-free. We provide quick and free pickup from your doorstep across all major cities in Gujarat.</p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        \n        <!-- Buy Used AC Section -->\n        <section id=\"buy-ac\" class=\"py-20 bg-white\">\n            <div class=\"container mx-auto px-6\">\n                <h2 class=\"section-title\">Find Your Perfect Pre-Owned AC</h2>\n                <p class=\"section-subtitle\">Explore our range of high-quality, <strong>working condition used AC for sale in Ahmedabad</strong>, Surat, and beyond. Every unit is deep cleaned, fully tested, and ready to cool your space.</p>\n                <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n                    <!-- Product Card 1 -->\n                    <div class=\"border rounded-lg shadow-md overflow-hidden group\">\n                        <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2017/02/AC-Installation-in-Vadodara-Guide.jpg\" alt=\"Second hand 1 ton window AC Rajkot\" class=\"w-full h-56 object-cover transform group-hover:scale-105 transition-transform duration-300\" title=\"\">\n                        <div class=\"p-6\">\n                            <h3 class=\"text-xl font-bold mb-2\">Used Window ACs</h3>\n                            <p class=\"text-gray-600 mb-4\">Affordable and reliable. Perfect for small to medium rooms. Starting from ₹7,000.</p>\n                            <span class=\"text-2xl font-bold text-yellow-600\">₹7,000 onwards</span>\n                        </div>\n                    </div>\n                    <!-- Product Card 2 -->\n                    <div class=\"border rounded-lg shadow-md overflow-hidden group\">\n                        <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2023/04/Split-Ac-Installation-and-Repair-Service-1.webp\" alt=\"Used 1.5 ton split AC price in Surat\" class=\"w-full h-56 object-cover transform group-hover:scale-105 transition-transform duration-300\" title=\"\">\n                        <div class=\"p-6\">\n                            <h3 class=\"text-xl font-bold mb-2\">Used Split ACs</h3>\n                            <p class=\"text-gray-600 mb-4\">Powerful cooling with modern features. Ideal for homes and offices. Starting from ₹12,000.</p>\n                            <span class=\"text-2xl font-bold text-yellow-600\">₹12,000 onwards</span>\n                        </div>\n                    </div>\n                    <!-- Product Card 3 -->\n                    <div class=\"border rounded-lg shadow-md overflow-hidden group\">\n                        <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2017/02/AI-Controlled-Air-Conditioner.jpg\" alt=\"Used inverter AC for sale Gandhinagar\" class=\"w-full h-56 object-cover transform group-hover:scale-105 transition-transform duration-300\" title=\"\">\n                        <div class=\"p-6\">\n                            <h3 class=\"text-xl font-bold mb-2\">Used Inverter ACs</h3>\n                            <p class=\"text-gray-600 mb-4\">Energy-efficient models for lower electricity bills. Get a <strong>used Voltas AC in Vadodara</strong> or a <strong>second hand LG AC Ahmedabad</strong>.</p>\n                            <span class=\"text-2xl font-bold text-yellow-600\">₹15,000 onwards</span>\n                        </div>\n                    </div>\n                </div>\n                 <div class=\"text-center mt-12\">\n                     <p>We deal in all major brands like <strong>Daikin, Samsung, Hitachi, LG, Voltas,</strong> and more. Whether you need a <strong>used 1.5 ton split AC price in Surat</strong> or want to <strong>sell old Samsung AC Rajkot</strong>, we are your go-to experts.</p>\n                </div>\n            </div>\n        </section>\n\n\n        <!-- Price List Section -->\n        <section id=\"pricing\" class=\"py-20 bg-gray-50\">\n            <div class=\"container mx-auto px-6\">\n                <h2 class=\"section-title\">Transparent Buying &#038; Selling Prices</h2>\n                <p class=\"section-subtitle\">We believe in complete transparency. Below is an estimated price list for buying and selling used ACs. The final price depends on the AC&#8217;s condition, brand, and model.</p>\n                <div class=\"max-w-4xl mx-auto\">\n                    <div class=\"bg-white rounded-lg shadow-xl overflow-hidden\">\n                        <table class=\"w-full text-left\">\n                            <thead class=\"bg-gray-800 text-white\">\n                                <tr>\n                                    <th class=\"p-4 font-semibold\">AC Type &#038; Condition</th>\n                                    <th class=\"p-4 font-semibold\">Our Buying Price (From You)</th>\n                                    <th class=\"p-4 font-semibold\">Our Selling Price (To You)</th>\n                                </tr>\n                            </thead>\n                            <tbody>\n                                <tr class=\"border-b\">\n                                    <td class=\"p-4 font-medium\">Window AC (1-1.5 Ton, Good Condition)</td>\n                                    <td class=\"p-4 text-green-600 font-bold\">₹2,500 &#8211; ₹5,000</td>\n                                    <td class=\"p-4 text-blue-600 font-bold\">₹7,000 &#8211; ₹10,000</td>\n                                </tr>\n                                <tr class=\"bg-gray-50 border-b\">\n                                    <td class=\"p-4 font-medium\">Split AC (1-1.5 Ton, Good Condition)</td>\n                                    <td class=\"p-4 text-green-600 font-bold\">₹4,000 &#8211; ₹8,000</td>\n                                    <td class=\"p-4 text-blue-600 font-bold\">₹12,000 &#8211; ₹18,000</td>\n                                </tr>\n                                <tr class=\"border-b\">\n                                    <td class=\"p-4 font-medium\">Inverter Split AC (1-1.5 Ton, Good Condition)</td>\n                                    <td class=\"p-4 text-green-600 font-bold\">₹6,000 &#8211; ₹12,000</td>\n                                    <td class=\"p-4 text-blue-600 font-bold\">₹15,000 &#8211; ₹25,000</td>\n                                </tr>\n                                <tr class=\"bg-gray-50\">\n                                    <td class=\"p-4 font-medium\">Non-working / Scrap AC Unit</td>\n                                    <td class=\"p-4 text-green-600 font-bold\">₹500 &#8211; ₹2,000</td>\n                                    <td class=\"p-4 text-blue-600 font-bold\">N/A</td>\n                                </tr>\n                            </tbody>\n                        </table>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n\n        <!-- Service Areas Section -->\n        <section id=\"locations\" class=\"py-20 bg-white\">\n            <div class=\"container mx-auto px-6\">\n                <h2 class=\"section-title\">Serving All of Gujarat</h2>\n                <p class=\"section-subtitle\">From major cities to local GIDCs, we are your local <strong>used AC buyer in Ahmedabad</strong> and seller across the state. Find your area below.</p>\n                \n                <!-- Major Cities -->\n                <h3 class=\"text-2xl font-bold text-center mb-8\">Major Cities We Serve</h3>\n                <div class=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-4 text-center mb-12\">\n                    <div class=\"bg-yellow-100 p-4 rounded-lg shadow\"><strong>Vadodara</strong></div>\n                    <div class=\"bg-yellow-100 p-4 rounded-lg shadow\"><strong>Ahmedabad</strong></div>\n                    <div class=\"bg-yellow-100 p-4 rounded-lg shadow\"><strong>Surat</strong></div>\n                    <div class=\"bg-yellow-100 p-4 rounded-lg shadow\"><strong>Rajkot</strong></div>\n                    <div class=\"bg-yellow-100 p-4 rounded-lg shadow\"><strong>Gandhinagar</strong></div>\n                    <div class=\"bg-yellow-100 p-4 rounded-lg shadow\"><strong>Bhavnagar</strong></div>\n                    <div class=\"bg-yellow-100 p-4 rounded-lg shadow\"><strong>Jamnagar</strong></div>\n                </div>\n\n                <!-- Vadodara Localities -->\n                <h3 class=\"text-2xl font-bold text-center mb-8\">Extensive Service in Vadodara</h3>\n                <div class=\"max-w-6xl mx-auto bg-gray-50 p-6 rounded-lg shadow\">\n                    <div class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 text-sm\">\n                        <span>Ajwa Road</span><span>Akota</span><span>Alkapuri</span><span>Asoj</span><span>Atladara</span><span>Bajwa</span><span>Baranpura</span><