  "content": {
    "rendered": "<div class=\"atlas-purified-matrix\"><style>\n        body {\n            font-family: 'Poppins', sans-serif;\n        }\n        .hero-banner {\n            background: linear-gradient(135deg, #FFD700 0%, #FFFFFF 50%, #FFD700 100%);\n        }\n        .golden-text {\n            color: #DAA520;\n        }\n        .shining-golden-bg {\n            background-color: #DAA520;\n        }\n        .silver-black-bg {\n            background-color: #333333;\n        }\n        .cta-button {\n            transition: all 0.3s ease;\n        }\n        .cta-button:hover {\n            transform: scale(1.05);\n            box-shadow: 0 10px 20px rgba(0,0,0,0.2);\n        }\n        .service-card:hover {\n            transform: translateY(-10px);\n            box-shadow: 0 15px 30px rgba(218, 165, 32, 0.3);\n        }\n        .faq-item {\n            border-left: 4px solid #DAA520;\n        }\n        .city-grid a {\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n        }\n        .city-grid a:hover {\n            transform: scale(1.05);\n            box-shadow: 0px 8px 15px rgba(0, 0, 0, 0.1);\n        }\n    </style>\n<script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"WebPage\",\n      \"name\": \"Expert Portable AC Repair & Service | Atlas Aircon | 24/7 Support\",\n      \"url\": \"https://atlasaircons.com/portable-air-conditioner-ac-repairing-service/\",\n      \"description\": \"Need fast, reliable portable AC repair and service? Atlas Aircon offers same-day service, certified technicians, and a 3-month guarantee on all portable air conditioner repairs, installation, and maintenance across Gujarat. Call now!\",\n      \"mainEntity\": {\n        \"@type\": \"Service\",\n        \"serviceType\": \"Portable AC Repair and Service\",\n        \"provider\": {\n          \"@type\": \"LocalBusiness\",\n          \"name\": \"Atlas Aircon\",\n          \"image\": \"https://atlasaircons.com/wp-content/uploads/2023/02/Portable-Ac-Service-scaled.webp\",\n          \"telephone\": \"+91-9727257141\",\n          \"email\": \"hello@atlasaircons.com\",\n          \"address\": {\n            \"@type\": \"PostalAddress\",\n            \"streetAddress\": \"Serving all of Gujarat\",\n            \"addressLocality\": \"Vadodara\",\n            \"addressRegion\": \"GJ\",\n            \"addressCountry\": \"IN\"\n          },\n          \"url\": \"https://atlasaircons.com/\",\n          \"priceRange\": \"₹\"\n        },\n        \"areaServed\": [\n            { \"@type\": \"City\", \"name\": \"Vadodara\" },\n            { \"@type\": \"City\", \"name\": \"Ahmedabad\" },\n            { \"@type\": \"City\", \"name\": \"Surat\" },\n            { \"@type\": \"City\", \"name\": \"Rajkot\" },\n            { \"@type\": \"City\", \"name\": \"Bhavnagar\" },\n            { \"@type\": \"City\", \"name\": \"Jamnagar\" },\n            { \"@type\": \"City\", \"name\": \"Gandhinagar\" },\n            { \"@type\": \"City\", \"name\": \"Anand\" },\n            { \"@type\": \"City\", \"name\": \"Bharuch\" },\n            { \"@type\": \"City\", \"name\": \"Navsari\" }\n        ],\n        \"hasOfferCatalog\": {\n          \"@type\": \"OfferCatalog\",\n          \"name\": \"Portable AC Services\",\n          \"itemListElement\": [\n            {\n              \"@type\": \"Offer\",\n              \"itemOffered\": {\n                \"@type\": \"Service\",\n                \"name\": \"Portable AC Repair\"\n              }\n            },\n            {\n              \"@type\": \"Offer\",\n              \"itemOffered\": {\n                \"@type\": \"Service\",\n                \"name\": \"Portable AC Service\"\n              }\n            },\n            {\n              \"@type\": \"Offer\",\n              \"itemOffered\": {\n                \"@type\": \"Service\",\n                \"name\": \"Portable AC Installation\"\n              }\n            }\n          ]\n        }\n      },\n      \"publisher\": {\n        \"@type\": \"Organization\",\n        \"name\": \"Atlas Aircon\",\n        \"logo\": {\n          \"@type\": \"ImageObject\",\n          \"url\": \"https://atlasaircons.com/wp-content/uploads/2024/02/Atlas-Aircon-Ac-Service-in-vadodara-2.webp\"\n        }\n      }\n    }\n    </script>\n<script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"FAQPage\",\n      \"mainEntity\": [{\n        \"@type\": \"Question\",\n        \"name\": \"How often should I get my portable AC serviced?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"For optimal performance and longevity, we recommend a professional portable AC service at least once a year, preferably before the summer season starts. This ensures it runs efficiently and helps prevent unexpected breakdowns.\"\n        }\n      }, {\n        \"@type\": \"Question\",\n        \"name\": \"What are common signs my portable AC needs repair?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Common signs include the portable AC not cooling, leaking water, making unusual noises (grinding, rattling), the fan not working, or the unit frequently turning on and off. If you notice any of these, it's time to call a technician.\"\n        }\n      },\n        {\n        \"@type\": \"Question\",\n        \"name\": \"Do you offer a warranty on your repair services?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Yes! We stand by our work. Atlas Aircon provides a 3-month guarantee on services and parts used during the repair, giving you complete peace of mind.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"Can you fix my portable AC on the same day?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Absolutely. We specialize in same day portable AC service and emergency portable AC repair. Our goal is to diagnose and fix your unit as quickly as possible, often on the very first visit.\"\n        }\n      },\n       {\n        \"@type\": \"Question\",\n        \"name\": \"What brands of portable air conditioners do you service?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Our certified technicians are experienced in repairing and servicing all major portable AC brands, including LG, Blue Star, Voltas, Lloyd, Cruise, and many more. No matter the brand, we have the expertise to fix it.\"\n        }\n      },\n       {\n        \"@type\": \"Question\",\n        \"name\": \"Is a portable AC Annual Maintenance Contract (AMC) worth it?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"A portable AC annual maintenance contract (AMC) is highly recommended. It saves you money in the long run by preventing major breakdowns, improving energy efficiency, and extending the life of your unit. Our AMC plans are affordable and comprehensive.\"\n        }\n      }]\n    }\n    </script>\n<script type=\"application/ld+json\">\n    {\n        \"@context\": \"https://schema.org\",\n        \"@type\": \"PriceSpecification\",\n        \"priceCurrency\": \"INR\",\n        \"priceType\": \"https://schema.org/SalePrice\",\n        \"price\": \"399\",\n        \"valueAddedTaxIncluded\": true,\n        \"name\": \"Starting Price for Portable AC Service\"\n    }\n    </script>\n<script>\n        document.addEventListener('DOMContentLoaded', () => {\n            const popup = document.getElementById('exit-popup');\n            const closeBtn = document.getElementById('close-popup');\n            let inactivityTimer;\n            let popupShown = false;\n\n            const showPopup = () => {\n                if (!popupShown) {\n                    popup.style.display = 'flex';\n                    popupShown = true;\n                }\n            };\n\n            const hidePopup = () => {\n                popup.style.display = 'none';\n            };\n\n            const resetInactivityTimer = () => {\n                clearTimeout(inactivityTimer);\n                inactivityTimer = setTimeout(showPopup, 120000); // 120 seconds\n            };\n\n            // Show on exit intent\n            document.addEventListener('mouseleave', (e) => {\n                if (e.clientY < 0) {\n                    showPopup();\n                }\n            });\n\n            // Show on inactivity\n            window.onload = resetInactivityTimer;\n            document.onmousemove = resetInactivityTimer;\n            document.onkeypress = resetInactivityTimer;\n            document.onscroll = resetInactivityTimer;\n            document.onclick = resetInactivityTimer;\n\n\n            closeBtn.addEventListener('click', hidePopup);\n            popup.addEventListener('click', (e) => {\n                if (e.target === popup) {\n                    hidePopup();\n                }\n            });\n        });\n    </script>\n\n\n    <!-- Hero Banner -->\n    <section class=\"hero-banner relative\">\n        <div class=\"container mx-auto px-6 py-16 md:py-24 flex flex-col md:flex-row items-center\">\n            <div class=\"md:w-1/2 text-center md:text-left mb-10 md:mb-0\">\n                <h1 class=\"text-4xl md:text-6xl font-extrabold text-gray-800 leading-tight mb-4\">Expert <span class=\"golden-text\"><b>Portable AC Repair</b></span> and Service</h1>\n                <p class=\"text-lg text-gray-600 mb-8\">Fast, reliable, and affordable <b>portable air conditioner repair</b>, <b>installation</b>, and <b>maintenance</b> when you need it most. Get your comfort back today with our <b>same day portable AC service</b>!</p>\n                <div class=\"flex justify-center md:justify-start space-x-4\">\n                    <a href=\"tel:+919727257141\" class=\"shining-golden-bg text-white px-8 py-3 rounded-full font-bold text-lg cta-button\">\n                        Call Now for a Free Quote\n                    </a>\n                    <a href=\"#price-list\" class=\"silver-black-bg text-white px-8 py-3 rounded-full font-bold text-lg cta-button\">\n                        View Prices\n                    </a>\n                </div>\n            </div>\n            <div class=\"md:w-1/2\">\n                <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2023/02/Portable-Ac-Service-scaled.webp\" alt=\"Professional portable AC repair and service by Atlas Aircon\" class=\"rounded-lg shadow-2xl mx-auto w-full max-w-md\" title=\"\">\n            </div>\n        </div>\n    </section>\n\n    <main>\n        <!-- Why Choose Us Section -->\n        <section class=\"py-20 bg-white\">\n            <div class=\"container mx-auto px-6\">\n                <div class=\"text-center mb-12\">\n                     <h2 class=\"text-3xl md:text-4xl font-bold text-gray-800\">Why We Are The Best for <span class=\"golden-text\"><b>Portable AC Repair</b></span></h2>\n                    <p class=\"text-gray-600 mt-4 max-w-2xl mx-auto\">When your portable AC breaks down, you need a service you can trust. Atlas Aircon is your reliable solution.</p>\n                </div>\n                <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8\">\n                    <div class=\"text-center p-6 bg-gray-50 rounded-lg shadow-md\">\n                        <i class=\"fas fa-user-shield fa-3x golden-text mb-4\"></i>\n                        <h3 class=\"text-xl font-bold mb-2\">Certified Technicians</h3>\n                        <p class=\"text-gray-600\">Our team consists of highly trained and <b>experienced technicians</b> specializing in all models of portable ACs.</p>\n                    </div>\n                     <div class=\"text-center p-6 bg-gray-50 rounded-lg shadow-md\">\n                        <i class=\"fas fa-shipping-fast fa-3x golden-text mb-4\"></i>\n                        <h3 class=\"text-xl font-bold mb-2\">Quick &#038; Same-Day Service</h3>\n                        <p class=\"text-gray-600\">We offer <b>emergency portable AC repair</b> and strive to provide <b>same day portable AC service</b> across Gujarat.</p>\n                    </div>\n                     <div class=\"text-center p-6 bg-gray-50 rounded-lg shadow-md\">\n                        <i class=\"fas fa-check-circle fa-3x golden-text mb-4\"></i>\n                        <h3 class=\"text-xl font-bold mb-2\">3-Month Guarantee</h3>\n                        <p class=\"text-gray-600\">We provide a <b>3-month guarantee on services and parts</b>, ensuring your peace of mind.</p>\n                    </div>\n                     <div class=\"text-center p-6 bg-gray-50 rounded-lg shadow-md\">\n                        <i class=\"fas fa-hand-holding-usd fa-3x golden-text mb-4\"></i>\n                        <h3 class=\"text-xl font-bold mb-2\">Transparent Pricing</h3>\n                        <p class=\"text-gray-600\">Get <b>affordable portable AC service</b> with no hidden charges. We provide upfront quotes before any work begins.</p>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- WooCommerce-Style Service Section -->\n        <section class=\"py-20 bg-gray-100\">\n            <div class=\"container mx-auto px-6\">\n                <div class=\"text-center mb-12\">\n                     <h2 class=\"text-3xl md:text-4xl font-bold text-gray-800\">Our <span class=\"golden-text\">Portable AC</span> Services</h2>\n                     <p class=\"text-gray-600 mt-4 max-w-2xl mx-auto\">From minor fixes to major repairs and installations, we cover all your portable AC needs.</p>\n                </div>\n                <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8\">\n                    <!-- Service Card 1 -->\n                    <div class=\"bg-white rounded-lg shadow-lg overflow-hidden transition duration-300 service-card\">\n                        <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/06/modern-digital-thermostat-perhaps-showing-an-error-message-or-incorrect-temperature.webp\" alt=\"Portable AC not cooling issue being fixed\" class=\"w-full h-56 object-cover\" title=\"\">\n                        <div class=\"p-6\">\n                            <h3 class=\"text-2xl font-bold mb-2 golden-text\"><b>Portable AC Repair</b></h3>\n                            <p class=\"text-gray-600 mb-4\">Facing issues like <b>portable AC not cooling</b>, making noise, or leaking water? Our experts can diagnose and fix it fast.</p>\n                            <p class=\"text-2xl font-bold silver-black-text mb-4\">Starting at ₹499</p>\n                            <a href=\"tel:+919727257141\" class=\"block w-full text-center silver-black-bg text-white py-2 rounded-full font-bold cta-button\">Book Repair</a>\n                        </div>\n                    </div>\n                     <!-- Service Card 2 -->\n                    <div class=\"bg-white rounded-lg shadow-lg overflow-hidden transition duration-300 service-card\">\n                        <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2025/06/clean-air-filter-next-to-a-very-dirty.webp\" alt=\"Portable AC deep cleaning service\" class=\"w-full h-56 object-cover\" title=\"\">\n                        <div class=\"p-6\">\n                            <h3 class=\"text-2xl font-bold mb-2 golden-text\"><b>Portable AC Service</b> &#038; Maintenance</h3>\n                            <p class=\"text-gray-600 mb-4\">Keep your unit running efficiently with our comprehensive <b>portable AC service</b>, including filter cleaning and performance checks.</p>\n                             <p class=\"text-2xl font-bold silver-black-text mb-4\">Starting at ₹399</p>\n                             <a href=\"tel:+919727257141\" class=\"block w-full text-center silver-black-bg text-white py-2 rounded-full font-bold cta-button\">Schedule Service</a>\n                        </div>\n                    </div>\n                     <!-- Service Card 3 -->\n                    <div class=\"bg-white rounded-lg shadow-lg overflow-hidden transition duration-300 service-card\">\n                        <img decoding=\"async\" src=\"https://atlasaircons.com/wp-content/uploads/2023/04/Split-Ac-Installation-and-Repair-Service-1.webp\" alt=\"Portable AC installation service\" class=\"w-full h-56 object-cover\" title=\"\">\n                        <div class=\"p-6\">\n                            <h3 class=\"text-2xl font-bold mb-2 golden-text\"><b>Portable AC Installation</b></h3>\n                            <p class=\"text-gray-600 mb-4\">Bought a new portable AC? We provide professional and secure <b>portable AC installation</b> for optimal cooling performance.</p>\n                             <p class=\"text-2xl font-bold silver-black-text mb-4\">Starting at ₹799</p>\n                             <a href=\"tel:+919727257141\" class=\"block w-full text-center silver-black-bg text-white py-2 rounded-full font-bold cta-button\">Request Install</a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- Common Problems & Solutions Section -->\n        <section class=\"py-20 bg-white\">\n            <div class=\"container mx-auto px-6\">\n                <div class=\"text-center mb-12\">\n                    <h2 class=\"text-3xl md:text-4xl font-bold text-gray-800\">Common <span class=\"golden-text\"><b>Portable AC Problems</b></span> &#038; Error Codes</h2>\n                    <p class=\"text-gray-600 mt-4 max-w-2xl mx-auto\">Quick solutions for common issues. For persistent problems, call our <b>portable AC technician at home</b>.</p>\n                </div>\n                <div class=\"bg-gray-50 p-8 rounded-lg shadow-inner\">\n                    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n                        <div>\n                            <h4 class=\"text-xl font-bold mb-3 golden-text\">Common Faults</h4>\n                            <ul class=\"space-y-3 list-disc list-inside\">\n                                <li><b>Portable AC not cooling</b>: Often due to dirty filters or low refrigerant. Try cleaning the filters first.</li>\n                                <li><b>Portable AC leaking water</b>: Usually caused by a clogged drain line or full internal reservoir.</li>\n                                <li><b>Portable AC making noise</b>: Rattling or grinding can indicate a loose part or a problem with the fan motor.</li>\n                                 <li><b>Portable AC fan not working</b>: Could be a motor issue or a problem with the control board (<b>portable AC PCB repair</b> needed).</li>\n                            </ul>\n                        </div>\n                        <div>\n                             <h4 class=\"text-xl font-bold mb-3 golden-text\">Error Codes</h4>\n                            <ul class=\"space-y-3 list-disc list-inside\">\n                                <li><b>E1/F1:</b> Room temperature sensor error. The unit may not operate correctly.</li>\n                                <li><b>E2/F2:</b> Coil sensor error. This can affect the cooling cycle.</li>\n                                <li><b>P1/Ft:</b> Water tank is full. The unit will stop cooling until the tank is emptied.</li>\n                                <li><b>E4:</b> Communication error between display and main control board. Requires a technician.</li>\n                            </ul>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- Price List Section -->\n        <section id=\"price-list\" class=\"py-20 bg-gray-100\">\n            <div class=\"container mx-auto px-6\">\n                 <div class=\"text-center mb-12\">\n                    <h2 class=\"text-3xl md:text-4xl font-bold text-gray-800\">Transparent <span class=\"golden-text\">Service Pricing</span></h2>\n                    <p class=\"text-gray-600 mt-4 max-w-2xl mx-auto\">No surprises. Here is a clear breakdown of our <b>affordable portable AC service</b> charges.</p>\n                </div>\n                <div class=\"overflow-x-auto bg-white rounded-lg shadow-lg\">\n                    <table class=\"w-full text-left\">\n                        <thead class=\"bg-gray-800 text-white\">\n                            <tr>\n                                <th class=\"p-4 font-semibold\">Service Type</th>\n                                <th class=\"p-4 font-semibold\">Description</th>\n                                <th class=\"p-4 font-semibold\">Price (INR)</th>\n                            </tr>\n                        </thead>\n                        <tbody class=\"divide-y divide-gray-200\">\n                            <tr class=\"hover:bg-yellow-50\">\n                                <td class=\"p-4 font-semibold golden-text\"><b>Portable AC Service</b></td>\n                                <td class=\"p-4 text-gray-600\">Basic cleaning, filter check, and performance diagnostics.</td>\n                                <td class=\"p-4 font-bold\">₹399 &#8211; ₹599</td>\n                            </tr>\n                            <tr class=\"hover:bg-yellow-50\">\n                                <td class=\"p-4 font-semibold golden-text\"><b>Portable AC Repair</b> (Minor)</td>\n                                <td class=\"p-4 text-gray-600\">Inspection charge &#038; small fixes (e.g., wiring, sensor).</td>\n                                <td class=\"p-4 font-bold\">₹499 onwards</td>\n                            </tr>\n                            <tr class=\"hover:bg-yellow-50\">\n                                <td class=\"p-4 font-semibold golden-text\"><b>Portable AC Gas Filling</b></td>\n                                <td class=\"p-4 text-gray-600\">Refrigerant check and top-up/refill (gas cost extra).</td>\n                                <td class=\"p-4 font-bold\">₹800 &#8211; ₹2500</td>\n                            </tr>\n                             <tr class=\"hover:bg-yellow-50\">\n                                <td class=\"p-4 font-semibold golden-text\"><b>Portable AC Installation</b></td>\n                                <td class=\"p-4 text-gray-600\">Standard installation including window kit setup.</td>\n                                <td class=\"p-4 font-bold\">₹799 &#8211; ₹1200</td>\n                            </tr>\n                            <tr class=\"hover:bg-yellow-50\">\n                                <td class=\"p-4 font-semibold golden-text\"><b>Portable AC PCB Repair</b></td>\n                                <td class=\"p-4 text-gray-600\">Repairing the main circuit board.</td>\n                                <td class=\"p-4 font-bold\">₹1500 onwards</td>\n                            </tr>\n                            <tr class=\"hover:bg-yellow-50\">\n                                <td class=\"p-4 font-semibold golden-text\"><b>Portable AC AMC</b></td>\n                                <td class=\"p-4 text-gray-600\">Annual Maintenance Contract (2 services/year).</td>\n                                <td class=\"p-4 font-bold\">₹999 onwards</td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n                 <p class=\"text-center text-gray-500 mt-4 text-sm\">*Final prices may vary based on the AC model, issue complexity, and parts required. Inspection charge of ₹299 is applicable if no service is availed.</p>\n            </div>\n        </section>\n\n        <!-- Service Area Section -->\n        <section class=\"py-20 bg-white\">\n            <div class=\"container mx-auto px-6\">\n                <div class=\"text-center mb-12\">\n                    <h2 class=\"text-3xl md:text-4xl font-bold text-gray-800\">Serving All Major Cities &#038; GIDCs in <span class=\"golden-text\">Gujarat</span></h2>\n                    <p class=\"text-gray-600 mt-4 max-w-2xl mx-auto\">Looking for the <b>best portable AC repair near me</b>? We&#8217;ve got you covered across the state.</p>\n                </div>\n                <div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 text-center city-grid\">\n                    <a href=\"#\" class=\"p-4 bg-gray-100 rounded-lg font-semibold text-gray-700 hover:bg-yellow-400 hover:text-white\"><i class=\"fas fa-map-marker-alt mr-2\"></i>Vadodara</a>\n                    <a href=\"#\" class=\"p-4 bg-gray-100 rounded-lg font-semibold text-gray-700 hover:bg-yellow-400 hover:text-white\"><i class=\"fas fa-map-marker-alt mr-2\"></i>Ahmedabad</a>\n                    <a href=\"#\" class=\"p-4 bg-gray-100 rounded-lg font-semibold text-gray-700 hover:bg-yellow-400 hover:text-white\"><i class=\"fas fa-map-marker-alt mr-2\"></i>Surat</a>\n                    <a href=\"#\" class=\"p-4 bg-gray-100 rounded-lg font-semibold text-gray-700 hover:bg-yellow-400 hover:text-white\"><i class=\"fas fa-map-marker-alt mr-2\"></i>Rajkot</a>\n                    <a href=\"#\" class=\"p-4 bg-gray-100 rounded-lg font-semibold text-gray-700 hover:bg-yellow-400 hover:text-white\"><i class=\"fas fa-map-marker-alt mr-2\"></i>Bhavnagar</a>\n                     <a href=\"#\" class=\"p-4 bg-gray-100 rounded-lg font-semibold text-gray-700 hover:bg-yellow-400 hover:text-white\"><i class=\"fas fa-map-marker-alt mr-2\"></i>Jamnagar</a>\n                    <a href=\"#\" class=\"p-4 bg-gray-100 rounded-lg font-semibold text-gray-700 hover:bg-yellow-400 hover:text-white\"><i class=\"fas fa-map-marker-alt mr-2\"></i>Gandhinagar</a>\n                    <a href=\"#\" class=\"p-4 bg-gray-100 rounded-lg font-semibold text-gray-700 hover:bg-yellow-400 hover:text-white\"><i class=\"fas fa-map-marker-alt mr-2\"></i>Anand</a>\n                    <a href=\"#\" class=\"p-4 bg-gray-100 rounded-lg font-semibold text-gray-700 hover:bg-yellow-400 hover:text-white\"><i class=\"fas fa-map-marker-alt mr-2\"></i>Bharuch</a>\n                    <a href=\"#\" class=\"p-4 bg-gray-100 rounded-lg font-semibold text-gray-700 hover:bg-yellow-400 hover:text-white\"><i class=\"fas fa-map-marker-alt mr-2\"></i>Navsari</a>\n                     <a href=\"#\" class=\"p-4 bg-gray-100 rounded-lg font-semibold text-gray-700 hover:bg-yellow-400 hover:text-white\"><i class=\"fas fa-industry mr-2\"></i>Makarpura GIDC</a>\n                    <a href=\"#\" class=\"p-4 bg-gray-100 rounded-lg font-semibold text-gray-700 hover:bg-yellow-400 hover:text-white\"><i class=\"fas fa-industry mr-2\"></i>Nandesari GIDC</a>\n                    <a href=\"#\" class=\"p-4 bg-gray-100 rounded-lg font-semibold text-gray-700 hover:bg-yellow-400 hover:text-white\"><i class=\"fas fa-industry mr-2\"></i>Savli GIDC</a>\n                    <a href=\"#\" class=\"p-4 bg-gray-100 rounded-lg font-semibold text-gray-700 hover:bg-yellow-400 hover:text-white\"><i class=\"fas fa-industry mr-2\"></i>Waghodia GIDC</a>\n                    <a href=\"#\" class=\"p-4 bg-gray-100 rounded-lg font-semibold text-gray-700 hover:bg-yellow-400 hover:text-white\"><i class=\"fas fa-industry mr-2\"></i>Por-Ramangamdi GIDC</a>\n                </div>\n\n                <div class=\"mt-12\">\n                    <h3 class=\"text-2xl font-bold text-center text-gray-800 mb-6\">Detailed Service Areas in Vadodara</h3>\n                    <div class=\"text-xs text-center text-gray-500 bg-gray-50 p-4 rounded-lg\">\n                        Ajwa Road | Akota | Alkapuri | Asoj | Atladara | Bajwa | Baranpura | Bhayli | Bill | Chhani | Dabhoi Road | Dandia Bazar | Danteshwar | Dashrath | Diwalipura | Dumad | Ellora Park | Fatehganj | Gorwa | Gotri | Harni | Jetalpur Road | Kalali | Karelibaug | Makarpura GIDC | Maneja | Manjalpur | Muj Mahuda | Nandesari | New VIP Road | Nizampura | Old Padra Road | Race Course | Ranoli | Sama | Sayajigunj | Sevasi | Subhanpura | Tandalja | Tarsali | Vasna Road | Waghodia Road &#038; many more.\n                    </div>\n                </div>\n            </div>\n        </section>\n\n        <!-- FAQ Section -->\n        <section class=\"py-20 bg-gray-100\">\n            <div class=\"container mx-auto px-6\">\n                 <div class=\"text-center mb-12\">\n                    <h2 class=\"text-3xl md:text-4xl font-bold text-gray-800\">Frequently Asked Questions (<span class=\"golden-text\">FAQ</span>)</h2>\n                    <p class=\"text-gray-600 mt-4 max-w-2xl mx-auto\">Got questions? We have answers. Find solutions to common queries below.</p>\n                </div>\n                <div class=\"max-w-4xl mx-auto space-y-4\">\n                    <!-- FAQ Item 1 -->\n                    <details class=\"bg-white p-6 rounded-lg shadow-md faq-item\">\n                        <summary class=\"font-semibold text-lg cursor-pointer\">How often should I get my portable AC serviced?</summary>\n                        <p class=\"text-gray-600 mt-4\">For optimal performance and longevity, we recommend a professional <b>portable AC service</b> at least once a year, preferably before the summer season starts. This ensures it runs efficiently and helps prevent unexpected breakdowns.</p>\n                    </details>\n                    <!-- FAQ Item 2 -->\n                    <details class=\"bg-white p-6 rounded-lg shadow-md faq-item\">\n                        <summary class=\"font-semibold text-lg cursor-pointer\">What are common signs my portable AC needs repair?</summary>\n                        <p class=\"text-gray-600 mt-4\">Common signs include the <b>portable AC not cooling</b>, <b>leaking water</b>, making <b>unusual noises</b> (grinding, rattling), the fan not working, or the unit frequently turning on and off. If you notice any of these, it&#8217;s time to call a technician.</p>\n                    </details>\n                    <!-- FAQ Item 3 -->\n                    <details class=\"bg-white p-6 rounded-lg shadow-md faq-item\">\n                        <summary class=\"font-semibold text-lg cursor-pointer\">Do you offer a warranty on your repair services?</summary>\n                        <p class=\"text-gray-600 mt-4\">Yes! We stand by our work. Atlas Aircon provides a <b>3-month guarantee on services and parts</b> used during the repair, giving you complete peace of mind.</p>\n                    </details>\n                    <!-- FAQ Item 4 -->\n                     <details class=\"bg-white p-6 rounded-lg shadow-md faq-item\">\n                        <summary class=\"font-semibold text-lg cursor-pointer\">Can you fix my portable AC on the same day?</summary>\n                        <p class=\"text-gray-600 mt-4\">Absolutely. We specialize in <b>same day portable AC service</b> and <b>emergency portable AC repair</b>. Our goal is to diagnose and fix your unit as quickly as possible, often on the very first visit.</p>\n                    </details>\n                    <!-- FAQ Item 5 -->\n                     <details class=\"bg-white p-6 rounded-lg shadow-md faq-item\">\n                        <summary class=\"font-semibold text-lg cursor-pointer\">What brands of portable air conditioners do you service?</summary>\n                        <p class=\"text-gray-600 mt-4\">Our certified technicians are experienced in repairing and servicing all major portable AC brands, including LG, Blue Star, Voltas, Lloyd, Cruise, and many more. No matter the brand, we have the expertise to fix it.</p>\n                    </details>\n                     <!-- FAQ Item 6 -->\n                     <details class=\"bg-white p-6 rounded-lg shadow-md faq-item\">\n                        <summary class=\"font-semibold text-lg cursor-pointer\">Is a portable AC Annual Maintenance Contract (AMC) worth it?</summary>\n                        <p class=\"text-gray-600 mt-4\">A <b>portable AC annual maintenance contract (AMC)</b> is highly recommended. It saves you money in the long run by preventing major breakdowns, improving energy efficiency, and extending the life of your unit. Our AMC plans are affordable and comprehensive.</p>\n                    </details>\n                </div>\n            </div>\n        </section>\n\n        <!-- Internal Links Section -->\n        <section class=\"py-20 bg-white\">\n            <div class=\"container mx-auto px-6\">\n                <div class=\"text-center mb-12\">\n                    <h2 class=\"text-3xl md:text-4xl font-bold text-gray-800\">Explore Our Other <span class=\"golden-text\">Services</span></h2>\n                    <p class=\"text-gray-600 mt-4 max-w-2xl mx-auto\">We are a one-stop solution for all your cooling and home appliance needs.</p>\n                </div>\n                 <div class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 text-center\">\n                    <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/ac-repair-in-samta/\" class=\"p-3 bg-gray-100 rounded-md font-medium text-gray-700 hover:bg-yellow-400 hover:text-white transition-all duration-300\">AC AMC Services</a>\n                    <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/ac-gas-refilling/\" class=\"p-3 bg-gray-100 rounded-md font-medium text-gray-700 hover:bg-yellow-400 hover:text-white transition-all duration-300\">AC Gas Filling</a>\n                    <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/professional-standard-ac-installation-service/\" class=\"p-3 bg-gray-100 rounded-md font-medium text-gray-700 hover:bg-yellow-400 hover:text-white transition-all duration-300\">AC Installation</a>\n                    <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/ac-on-rent-vadodara/\" class=\"p-3 bg-gray-100 rounded-md font-medium text-gray-700 hover:bg-yellow-400 hover:text-white transition-all duration-300\">AC on Rent</a>\n                    <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/cassette-ac-repair-services-in-vadodara/\" class=\"p-3 bg-gray-100 rounded-md font-medium text-gray-700 hover:bg-yellow-400 hover:text-white transition-all duration-300\">Cassette AC Repair</a>\n                    <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/split-ac-installation-and-repair-service/\" class=\"p-3 bg-gray-100 rounded-md font-medium text-gray-700 hover:bg-yellow-400 hover:text-white transition-all duration-300\">Split AC Installation</a>\n                    <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/tower-ac-repair-and-service-in-vadodara/\" class=\"p-3 bg-gray-100 rounded-md font-medium text-gray-700 hover:bg-yellow-400 hover:text-white transition-all duration-300\">Tower AC Repair</a>\n                    <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/window-ac-repair-and-service/\" class=\"p-3 bg-gray-100 rounded-md font-medium text-gray-700 hover:bg-yellow-400 hover:text-white transition-all duration-300\">Window AC Repair</a>\n                    <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/circuit-pcb-repair-service/\" class=\"p-3 bg-gray-100 rounded-md font-medium text-gray-700 hover:bg-yellow-400 hover:text-white transition-all duration-300\">AC Circuit Repair</a>\n                    <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/refrigerator-repair-services.html\" class=\"p-3 bg-gray-100 rounded-md font-medium text-gray-700 hover:bg-yellow-400 hover:text-white transition-all duration-300\">Refrigerator Repair</a>\n                    <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/washing-machine-repair-in-vadodara/\" class=\"p-3 bg-gray-100 rounded-md font-medium text-gray-700 hover:bg-yellow-400 hover:text-white transition-all duration-300\">Washing Machine Repair</a>\n                    <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/cold-room-repair-in-vadodara/\" class=\"p-3 bg-gray-100 rounded-md font-medium text-gray-700 hover:bg-yellow-400 hover:text-white transition-all duration-300\">Cold Room Repair</a>\n                    <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/services/other-repairing/air-cooler-repair-services.html\" class=\"p-3 bg-gray-100 rounded-md font-medium text-gray-700 hover:bg-yellow-400 hover:text-white transition-all duration-300\">Air Cooler Repair</a>\n                                    </div>\n            </div>\n        </section>\n\n    </main>\n    \n    <!-- Call to Action for Mobile -->\n    <a href=\"tel:+919727257141\" class=\"sm:hidden fixed bottom-0 left-0 right-0 silver-black-bg text-white text-center py-4 font-bold text-lg z-50\">\n        <i class=\"fas fa-phone mr-2\"></i> Tap to Call Now\n    </a>\n\n    <!-- Exit-Intent Popup -->\n    <div id=\"exit-popup\" class=\"fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 p-4\">\n        <div class=\"bg-white rounded-lg shadow-2xl p-8 max-w-sm w-full relative\">\n            <button id=\"close-popup\" class=\"absolute top-2 right-4 text-gray-500 hover:text-gray-800 text-2xl\">&times;</button>\n            <h3 class=\"text-2xl font-bold text-center mb-4 golden-text\">Need Help?</h3>\n            <p class=\"text-center text-gray-600 mb-6\">Get a free, no-obligation quote for your AC needs!</p>\n            <form>\n                <div class=\"mb-4\">\n                    <label for=\"popup-name\" class=\"block text-gray-700 mb-1\">Name</label>\n                    <input type=\"text\" id=\"popup-name\" class=\"w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-400\" placeholder=\"Your Name\">\n                </div>\n                <div class=\"mb-4\">\n                    <label for=\"popup-phone\" class=\"block text-gray-700 mb-1\">Phone Number</label>\n                    <input type=\"tel\" id=\"popup-phone\" class=\"w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-400\" placeholder=\"Your Phone\">\n                </div>\n                 <div class=\"mb-6\">\n                    <label for=\"popup-service\" class=\"block text-gray-700 mb-1\">Service Needed</label>\n                    <select id=\"popup-service\" class=\"w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-400\">\n                        <option>Portable AC Repair</option>\n                        <option>Portable AC Service</option>\n                        <option>Portable AC Installation</option>\n                        <option>Other</option>\n                    </select>\n                </div>\n                <button type=\"submit\" class=\"w-full shining-golden-bg text-white py-3 rounded-full font-bold cta-button mb-3\">Get a Free Quote</button>\n                <a href=\"tel:+919727257141\" class=\"w-full block text-center silver-black-bg text-white py-3 rounded-full font-bold cta-button mb-3\">\n                    <i class=\"fas fa-phone mr-2\"></i> Call Now\n                </a>\n                 <a href=\"https://wa.me/919727257141\" class=\"w-full block text-center bg-green-500 text-white py-3 rounded-full font-bold cta-button\" target=\"_blank\" rel=\"noopener\">\n                    <i class=\"fab fa-whatsapp mr-2\"></i> Chat on WhatsApp\n                </a>\n            </form>\n        </div>\n    </div>\n\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n            const popup = document.getElementById('exit-popup');\n            const closeBtn = document.getElementById('close-popup');\n            let inactivityTimer;\n            let popupShown = false;\n\n            const showPopup = () => {\n                if (!popupShown) {\n                    popup.style.display = 'flex';\n                    popupShown = true;\n                }\n            };\n\n            const hidePopup = () => {\n                popup.style.display = 'none';\n            };\n\n            const resetInactivityTimer = () => {\n                clearTimeout(inactivityTimer);\n                inactivityTimer = setTimeout(showPopup, 120000); // 120 seconds\n            };\n\n            // Show on exit intent\n            document.addEventListener('mouseleave', (e) => {\n                if (e.clientY < 0) {\n                    showPopup();\n                }\n            });\n\n            // Show on inactivity\n            window.onload = resetInactivityTimer;\n            document.onmousemove = resetInactivityTimer;\n            document.onkeypress = resetInactivityTimer;\n            document.onscroll = resetInactivityTimer;\n            document.onclick = resetInactivityTimer;\n\n\n            closeBtn.addEventListener('click', hidePopup);\n            popup.addEventListener('click', (e) => {\n                if (e.target === popup) {\n                    hidePopup();\n                }\n            });\n        });\n    </script>\n</div>",
