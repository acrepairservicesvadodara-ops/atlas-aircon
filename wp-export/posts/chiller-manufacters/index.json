{\"@type\": \"City\", \"name\": \"Pune\"}, {\"@type\": \"City\", \"name\": \"Ahmedabad\"},\r\n        {\"@type\": \"City\", \"name\": \"Hyderabad\"}, {\"@type\": \"City\", \"name\": \"Kolkata\"}, {\"@type\": \"City\", \"name\": \"Surat\"},\r\n        {\"@type\": \"City\", \"name\": \"Jaipur\"}, {\"@type\": \"City\", \"name\": \"Lucknow\"}, {\"@type\": \"City\", \"name\": \"Kanpur\"},\r\n        {\"@type\": \"City\", \"name\": \"Nagpur\"}, {\"@type\": \"City\", \"name\": \"Indore\"}, {\"@type\": \"City\", \"name\": \"Thane\"},\r\n        {\"@type\": \"City\", \"name\": \"Bhopal\"}, {\"@type\": \"City\", \"name\": \"Visakhapatnam\"}, {\"@type\": \"City\", \"name\": \"Vadodara\"},\r\n        {\"@type\": \"City\", \"name\": \"Ghaziabad\"}, {\"@type\": \"City\", \"name\": \"Ludhiana\"}, {\"@type\": \"City\", \"name\": \"Bharuch\"},\r\n        {\"@type\": \"City\", \"name\": \"Valsad\"}\r\n      ],\r\n      \"contactPoint\": {\r\n        \"@type\": \"ContactPoint\",\r\n        \"telephone\": \"+91-9727257141\",\r\n        \"contactType\": \"sales\",\r\n        \"email\": \"hello@atlasaircons.com\",\r\n        \"areaServed\": \"IN\",\r\n        \"availableLanguage\": \"en\"\r\n      }\r\n    }\r\n    </script></p>\r\n<main><!-- Hero Section -->\r\n<section class=\"relative bg-blue-700 text-white py-20 md:py-32\">\r\n<div class=\"absolute inset-0 bg-black opacity-50\"> </div>\r\n<div class=\"absolute inset-0 bg-cover bg-center\" style=\"background-image: url('chiller.avif');\"> </div>\r\n<div class=\"container mx-auto px-6 text-center relative z-10\">\r\n<h1 class=\"text-4xl md:text-6xl font-extrabold leading-tight mb-4\">Reliable Water Chillers for CNC, Argon &amp; Plasma Welding Machines</h1>\r\n<p class=\"text-lg md:text-xl text-blue-100 max-w-4xl mx-auto mb-8\">Ensuring Peak Performance and Longevity for Your Equipment. Serving All Major Indian Cities.</p>\r\n<div class=\"flex flex-col sm:flex-row justify-center items-center space-y-4 sm:space-y-0 sm:space-x-4\"><a class=\"w-full sm:w-auto bg-green-500 text-white font-bold py-3 px-8 rounded-lg text-lg cta-button shadow-lg\" href=\"#contact\">Get a Free Quote</a> <a class=\"w-full sm:w-auto bg-white text-blue-700 font-bold py-3 px-8 rounded-lg text-lg cta-button shadow-lg\" href=\"#pricelist\">View Pricelist</a></div>\r\n</div>\r\n</section>\r\n<!-- Our Products Section -->\r\n<section id=\"products\" class=\"py-20 bg-white\">\r\n<div class=\"container mx-auto px-6\">\r\n<h2 class=\"section-title\">High-Performance Water Chillers for Precision Machinery</h2>\r\n<p class=\"section-subtitle\">Engineered for reliability and efficiency, our water chillers are the perfect cooling solution. Discover the right chiller for your needs from our full <a class=\"internal-link\" href=\"https://atlasaircons.com/products\" target=\"_blank\" rel=\"noopener\">product line</a>.</p>\r\n<div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12\"><!-- CNC Machine Water Chiller -->\r\n<div class=\"bg-gray-50 rounded-lg shadow-lg overflow-hidden transform hover:-translate-y-2 transition-transform duration-300\"><script type=\"application/ld+json\">\r\n                        {\r\n                          \"@context\": \"https://schema.org\",\r\n                          \"@type\": \"Product\",\r\n                          \"name\": \"CNC Machine Water Chiller\",\r\n                          \"image\": \"https://placehold.co/600x400/3498db/ffffff?text=AI+Image:+CNC+Cooling\",\r\n                          \"description\": \"Our water chillers for CNC machines maintain optimal temperature, preventing spindle overheating and ensuring precision. Ideal for high-speed cutting and long operational hours.\",\r\n                          \"brand\": {\"@type\": \"Brand\", \"name\": \"Atlas Aircon\"},\r\n                          \"aggregateRating\": {\"@type\": \"AggregateRating\", \"ratingValue\": \"4.9\", \"reviewCount\": \"112\"}\r\n                        }\r\n                        </script> <img decoding=\"async\" class=\"w-full h-56 object-cover\" src=\"https://placehold.co/600x400/3498db/ffffff?text=AI+Image:+CNC+Cooling\" alt=\"AI Generated Image: A CNC machine operating with an Atlas Aircon water chiller attached.\" title=\"\">\r\n<div class=\"p-6\">\r\n<h3 class=\"text-2xl font-bold text-gray-800 mb-3\">CNC Machine Water Chillers</h3>\r\n<p class=\"text-gray-600 mb-4\">Our water chillers for CNC machines maintain optimal temperature, preventing spindle overheating and ensuring precision. <a class=\"internal-link\" href=\"https://atlasaircons.com/blog/importance-of-cnc-chillers\" target=\"_blank\" rel=\"noopener\">Learn why it&#8217;s crucial</a> for high-speed cutting.</p>\r\n<ul class=\"text-gray-700 space-y-2\">\r\n<li class=\"flex items-center\">High Cooling Capacity</li>\r\n<li class=\"flex items-center\">Energy-Efficient Operation</li>\r\n<li class=\"flex items-center\">Compact, Space-Saving Design</li>\r\n<li class=\"flex items-center\">Low Maintenance Requirements</li>\r\n</ul>\r\n</div>\r\n</div>\r\n<!-- Argon Welding Water Chiller -->\r\n<div class=\"bg-gray-50 rounded-lg shadow-lg overflow-hidden transform hover:-translate-y-2 transition-transform duration-300\"><script type=\"application/ld+json\">\r\n                        {\r\n                          \"@context\": \"https://schema.org\",\r\n                          \"@type\": \"Product\",\r\n                          \"name\": \"Argon Welding Water Chiller\",\r\n                          \"image\": \"https://placehold.co/600x400/9b59b6/ffffff?text=AI+Image:+Welding+Cooling\",\r\n                          \"description\": \"Essential for TIG/Argon welding, our chillers cool the welding torch, prevent damage, and ensure stable arc performance for clean, strong welds.\",\r\n                          \"brand\": {\"@type\": \"Brand\", \"name\": \"Atlas Aircon\"},\r\n                          \"aggregateRating\": {\"@type\": \"AggregateRating\", \"ratingValue\": \"4.8\", \"reviewCount\": \"98\"}\r\n                        }\r\n                        </script> <img decoding=\"async\" class=\"w-full h-56 object-cover\" src=\"https://placehold.co/600x400/9b59b6/ffffff?text=AI+Image:+Welding+Cooling\" alt=\"AI Generated Image: A close-up of an argon welding torch being cooled by an Atlas Aircon water chiller.\" title=\"\">\r\n<div class=\"p-6\">\r\n<h3 class=\"text-2xl font-bold text-gray-800 mb-3\">Argon Welding Water Chillers</h3>\r\n<p class=\"text-gray-600 mb-4\">Essential for TIG/Argon welding, our chillers cool the welding torch to ensure stable arc performance for clean, strong welds. <a class=\"internal-link\" href=\"https://atlasaircons.com/blog/welding-chiller-benefits\" target=\"_blank\" rel=\"noopener\">Discover the benefits</a>.</p>\r\n<ul class=\"text-gray-700 space-y-2\">\r\n<li class=\"flex items-center\">Rapid &amp; Efficient Cooling</li>\r\n<li class=\"flex items-center\">Durable, Robust Construction</li>\r\n<li class=\"flex items-center\">Compatible With All Welder Brands</li>\r\n<li class=\"flex items-center\">Ensures Stable Arc Performance</li>\r\n</ul>\r\n</div>\r\n</div>\r\n<!-- Plasma Welding Water Chiller -->\r\n<div class=\"bg-gray-50 rounded-lg shadow-lg overflow-hidden transform hover:-translate-y-2 transition-transform duration-300\"><script type=\"application/ld+json\">\r\n                        {\r\n                          \"@context\": \"https://schema.org\",\r\n                          \"@type\": \"Product\",\r\n                          \"name\": \"Plasma Cutter Water Chiller\",\r\n                          \"image\": \"https://placehold.co/600x400/e74c3c/ffffff?text=AI+Image:+Plasma+Cooling\",\r\n                          \"description\": \"Keep your plasma cutter running flawlessly. Our chillers prevent torch overheating, extend consumable life, and guarantee consistent cutting quality.\",\r\n                          \"brand\": {\"@type\": \"Brand\", \"name\": \"Atlas Aircon\"},\r\n                          \"aggregateRating\": {\"@type\": \"AggregateRating\", \"ratingValue\": \"4.9\", \"reviewCount\": \"125\"}\r\n                        }\r\n                        </script> <img decoding=\"async\" class=\"w-full h-56 object-cover\" src=\"https://placehold.co/600x400/e74c3c/ffffff?text=AI+Image:+Plasma+Cooling\" alt=\"AI Generated Image: A plasma cutter in action with the Atlas Aircon cooling system highlighted.\" title=\"\">\r\n<div class=\"p-6\">\r\n<h3 class=\"text-2xl font-bold text-gray-800 mb-3\">Plasma Cutter Water Chillers</h3>\r\n<p class=\"text-gray-600 mb-4\">Our chillers prevent torch overheating, extend consumable life, and guarantee consistent cutting quality. <a class=\"internal-link\" href=\"https://atlasaircons.com/blog/plasma-cutter-cooling-tips\" target=\"_blank\" rel=\"noopener\">See our cooling tips</a>.</p>\r\n<ul class=\"text-gray-700 space-y-2\">\r\n<li class=\"flex items-center\">High-Pressure Water Pump</li>\r\n<li class=\"flex items-center\">Corrosion-Resistant Components</li>\r\n<li class=\"flex items-center\">Automated Temperature Control</li>\r\n<li class=\"flex items-center\">Extends Consumable Life</li>\r\n</ul>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</section>\r\n<!-- Why Choose Us Section -->\r\n<section id=\"why-us\" class=\"py-20 bg-gray-50\">\r\n<div class=\"container mx-auto px-6\">\r\n<h2 class=\"section-title\">Why Choose Atlas Aircon?</h2>\r\n<p class=\"section-subtitle\">We are more than just a manufacturer. We are your partners in precision, dedicated to providing cooling solutions that enhance your productivity and protect your investment. <a class=\"internal-link\" href=\"https://atlasaircons.com/about-us\" target=\"_blank\" rel=\"noopener\">Learn more about our company</a>.</p>\r\n<div class=\"grid md:grid-cols-2 gap-12 items-center\">\r\n<div class=\"grid grid-cols-1 sm:grid-cols-2 gap-8\">\r\n<div class=\"p-6 bg-white rounded-lg shadow-md text-center\">\r\n<div class=\"flex items-center justify-center h-16 w-16 rounded-full b