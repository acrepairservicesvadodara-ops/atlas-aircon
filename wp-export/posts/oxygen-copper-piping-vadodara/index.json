ed-md\" placeholder=\"Service Needed (e.g., Hospital Piping)\">\n                            </div>\n                            <div>\n                                <button type=\"submit\" class=\"w-full flex items-center justify-center px-6 py-3 border border-transparent rounded-md shadow-sm text-base font-medium text-white gold-bg hover:bg-opacity-90 cta-button\">\n                                    Submit Request\n                                </button>\n                            </div>\n                        </form>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n\n    <!-- Exit-Intent Popup -->\n    <div id=\"exit-intent-popup\" class=\"hidden fixed inset-0 bg-black bg-opacity-60 z-50 flex items-center justify-center p-4\">\n        <div class=\"bg-white rounded-2xl shadow-2xl w-full max-w-md p-8 relative transform transition-all scale-95 opacity-0\" id=\"popup-content\">\n            <button id=\"close-popup\" class=\"absolute top-4 right-4 text-gray-400 hover:text-gray-800\">\n                <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"></path></svg>\n            </button>\n            <h3 class=\"text-2xl font-bold text-center text-gray-900\">Wait! Don&#8217;t Leave&#8230;</h3>\n            <p class=\"text-center text-gray-600 mt-2\">Get a Fast, Free Quote for your piping needs!</p>\n            <form action=\"#\" method=\"POST\" class=\"mt-6 grid grid-cols-1 gap-y-4\">\n                <div><input type=\"text\" name=\"popup-name\" autocomplete=\"name\" class=\"block w-full shadow-sm py-3 px-4 placeholder-gray-500 border-gray-300 rounded-md\" placeholder=\"Your Name\"></div>\n                <div><input type=\"tel\" name=\"popup-phone\" autocomplete=\"tel\" class=\"block w-full shadow-sm py-3 px-4 placeholder-gray-500 border-gray-300 rounded-md\" placeholder=\"Your Phone Number\"></div>\n                <div><input type=\"text\" name=\"popup-service\" class=\"block w-full shadow-sm py-3 px-4 placeholder-gray-500 border-gray-300 rounded-md\" placeholder=\"What service do you need?\"></div>\n                <div>\n                    <button type=\"submit\" class=\"w-full flex items-center justify-center px-6 py-3 rounded-md shadow-sm text-base font-medium text-white silver-black-bg hover:bg-opacity-90 cta-button\">\n                        Get My Free Quote\n                    </button>\n                </div>\n            </form>\n            <div class=\"mt-4 flex flex-col space-y-3\">\n                 <a href=\"tel:+919727257141\" class=\"w-full text-center px-6 py-3 rounded-md shadow-sm text-base font-medium text-white gold-bg hover:bg-opacity-90 cta-button\">Call Now</a>\n                 <a href=\"https://api.whatsapp.com/send?phone=919727257141\" target=\"_blank\" class=\"w-full text-center px-6 py-3 rounded-md shadow-sm text-base font-medium text-white bg-green-500 hover:bg-green-600 cta-button\" rel=\"noopener\">Message on WhatsApp</a>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        document.addEventListener('DOMContentLoaded', () => {\n            const popup = document.getElementById('exit-intent-popup');\n            const popupContent = document.getElementById('popup-content');\n            const closeBtn = document.getElementById('close-popup');\n            let inactivityTimer;\n\n            const showPopup = () => {\n                if (sessionStorage.getItem('popupShown')) return;\n                popup.classList.remove('hidden');\n                setTimeout(() => {\n                    popupContent.classList.remove('scale-95', 'opacity-0');\n                }, 50);\n                sessionStorage.setItem('popupShown', 'true');\n            };\n\n            const hidePopup = () => {\n                popupContent.classList.add('scale-95', 'opacity-0');\n                setTimeout(() => {\n                    popup.classList.add('hidden');\n                }, 300);\n            };\n\n            const resetInactivityTimer = () => {\n                clearTimeout(inactivityTimer);\n                inactivityTimer = setTimeout(showPopup, 60000); // 60 seconds\n            };\n\n            // Exit-intent\n            document.addEventListener('mouseleave', (e) => {\n                if (e.clientY < 10) {\n                    showPopup();\n                }\n            });\n\n            // Inactivity\n            window.onload = resetInactivityTimer;\n            document.onmousemove = resetInactivityTimer;\n            document.onkeydown = resetInactivityTimer;\n            \n            // Close button\n            closeBtn.addEventListener('click', hidePopup);\n            popup.addEventListener('click', (e) => {\n                if (e.target === popup) {\n                    hidePopup();\n                }\n            });\n        });\n    </script>\n</div>",
