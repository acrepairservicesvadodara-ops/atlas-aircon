    "rendered": "<script src=\"https://cdn.tailwindcss.com\"></script>\r\n\r\n<style>\r\n        body {<br />            font-family: 'Inter', sans-serif;<br />        }<br />        .hero-bg {<br />            background-image: linear-gradient(rgba(0, 25, 51, 0.7), rgba(0, 25, 51, 0.7)), url('https://atlasaircons.com/wp-content/uploads/2025/07/Atlas-Aircon-Vehicle-2.webp');<br />            background-size: cover;<br />            background-position: center;<br />        }<br />        .accordion-content {<br />            max-height: 0;<br />            overflow: hidden;<br />            transition: max-height 0.3s ease-out;<br />        }<br />        .service-card {<br />            transition: transform 0.3s ease, box-shadow 0.3s ease;<br />        }<br />        .service-card:hover {<br />            transform: translateY(-8px);<br />            box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);<br />        }<br />        /* Fallback for image errors */<br />        img[onerror] {<br />            display: inline-block;<br />            background-color: #f0f2f5;<br />            border-radius: 0.5rem;<br />            display: flex;<br />            align-items: center;<br />            justify-content: center;<br />        }<br />    </style>\r\n\r\n<!-- Comprehensive JSON-LD Schema Markup -->\r\n<script type=\"application/ld+json\">\r\n    {\r\n      \"@context\": \"https://schema.org\",\r\n      \"@type\": \"HVACBusiness\",\r\n      \"name\": \"Atlas Aircon\",\r\n      \"image\": \"https://atlasaircons.com/wp-content/uploads/2025/07/Atlas-Aircon-Vehicle-2.webp\",\r\n      \"@id\": \"https://atlasaircons.com\",\r\n      \"url\": \"https://atlasaircons.com/central-ac-installation-repair-service\",\r\n      \"telephone\": \"+91-9825408593\",\r\n      \"priceRange\": \"₹₹\",\r\n      \"address\": {\r\n        \"@type\": \"PostalAddress\",\r\n        \"streetAddress\": \"G-1, Shreenathji Apartment, Opp. Manisha society, O.P. Road