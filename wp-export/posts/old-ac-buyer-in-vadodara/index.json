blank\" rel=\"noopener\">WhatsApp Us</a></div>\r\n</div>\r\n</div>\r\n<div id=\"minimized-popup-icon\" style=\"display: none;\" aria-label=\"Get a Quote\">Get Quote</div>\r\n<script>\r\n// Basic JavaScript for Popup Functionality\r\n// Note: This is a simplified version. For production, you might want to use cookies to ensure it only shows once per user session/visit.\r\ndocument.addEventListener('DOMContentLoaded', () => {\r\n    const popupOverlay = document.getElementById('popup-overlay');\r\n    const closeBtn = document.getElementById('close-popup-btn');\r\n    const minimizedIcon = document.getElementById('minimized-popup-icon');\r\n    \r\n    // Function to show the popup\r\n    const showPopup = () => {\r\n        if (sessionStorage.getItem('popupShown') !== 'true') {\r\n            popupOverlay.style.display = 'flex';\r\n            sessionStorage.setItem('popupShown', 'true');\r\n        }\r\n    };\r\n\r\n    // Set timeout to show popup after 60 seconds\r\n    setTimeout(showPopup, 60000);\r\n\r\n    // Function to close the popup and show the minimized icon\r\n    const closePopup = () => {\r\n        popupOverlay.style.display = 'none';\r\n        minimizedIcon.style.display = 'flex';\r\n    };\r\n\r\n    // Function to open the popup from the minimized icon\r\n    const openPopupFromIcon = () => {\r\n         popupOverlay.style.display = 'flex';\r\n         minimizedIcon.style.display = 'none';\r\n    };\r\n\r\n    // Event listeners\r\n    closeBtn.addEventListener('click', closePopup);\r\n    minimizedIcon.addEventListener('click', openPopupFromIcon);\r\n    \r\n    // Optional: Close popup if user clicks outside the content area\r\n    popupOverlay.addEventListener('click', (e) => {\r\n        if (e.target === popupOverlay) {\r\n            closePopup();\r\n        }\r\n    });\r\n});\r\n</script>\r\n\r\np-icon span { font-size: 0.7rem; }",
