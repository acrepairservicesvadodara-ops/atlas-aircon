Q: Do you service all brands for <strong>cassette AC service in Vadodara</strong>?</h4>\n                    <p class=\"text-gray-700\">A: Yes, we are the go-to experts for <strong>Daikin cassette AC service in Vadodara</strong>, as well as for <strong>LG</strong>, <strong>Voltas</strong>, <strong>Blue Star</strong>, <strong>Carrier</strong>, and all other major brands. Our technicians are trained to handle any model.</p>\n                </div>\n            </div>\n        </section>\n\n        <!-- Internal Links Section -->\n        <section class=\"mb-16\">\n             <h2 class=\"text-3xl font-bold text-center mb-8 section-title\">Explore Our Other Expert Services</h2>\n             <div class=\"p-6 bg-gray-100 rounded-lg shadow\">\n                 <div class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 text-center\">\n                     <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/split-ac-installation-and-repair-service/\" class=\"font-medium text-brand-silver-black hover:text-brand-gold\">Split AC Service</a>\n                     <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/window-ac-repair-and-service/\" class=\"font-medium text-brand-silver-black hover:text-brand-gold\">Window AC Repair</a>\n                     <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/ac-gas-refilling/\" class=\"font-medium text-brand-silver-black hover:text-brand-gold\">AC Gas Filling</a>\n                     <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/inverter-ac-service-experts-in-vadodara/\" class=\"font-medium text-brand-silver-black hover:text-brand-gold\">Inverter AC Repair</a>\n                     <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/circuit-pcb-repair-service/\" class=\"font-medium text-brand-silver-black hover:text-brand-gold\">AC Circuit Repair</a>\n                     <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/ac-on-rent-vadodara/\" class=\"font-medium text-brand-silver-black hover:text-brand-gold\">AC on Rent</a>\n                     <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/refrigerator-repair-services.html\" class=\"font-medium text-brand-silver-black hover:text-brand-gold\">Refrigerator Repair</a>\n                     <a rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://atlasaircons.com/washing-machine-repair-in-vadodara/\" class=\"font-medium text-brand-silver-black hover:text-brand-gold\">Washing Machine Repair</a>\n                 </div>\n             </div>\n        </section>\n    </main>\n    \n    <!-- Popup Modal -->\n    <div id=\"exit-popup\" class=\"popup-hidden fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center z-50 p-4\">\n        <div class=\"bg-white rounded-lg shadow-2xl p-8 max-w-md w-full relative transform transition-all duration-300 scale-95\" id=\"popup-content\">\n            <button id=\"close-popup\" class=\"absolute top-3 right-4 text-gray-500 hover:text-black text-2xl\">&times;</button>\n            <h3 class=\"text-2xl font-bold text-center mb-4 text-brand-silver-black\">Get a Free Quote!</h3>\n            <p class=\"text-center text-gray-600 mb-6\">Leave your details and we&#8217;ll call you back with a free estimate for your cassette AC service.</p>\n            <form>\n                <div class=\"mb-4\">\n                    <label for=\"popup-name\" class=\"block text-sm font-medium text-gray-700\">Name</label>\n                    <input type=\"text\" id=\"popup-name\" class=\"mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-brand-gold focus:border-brand-gold\" placeholder=\"Your Name\">\n                </div>\n                <div class=\"mb-4\">\n                    <label for=\"popup-phone\" class=\"block text-sm font-medium text-gray-700\">Phone Number</label>\n                    <input type=\"tel\" id=\"popup-phone\" class=\"mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-brand-gold focus:border-brand-gold\" placeholder=\"Your Phone Number\">\n                </div>\n                <div class=\"mb-6\">\n                    <label for=\"popup-service\" class=\"block text-sm font-medium text-gray-700\">Service Needed</label>\n                    <select id=\"popup-service\" class=\"mt-1 block w-full px-3 py-2 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-brand-gold focus:border-brand-gold\">\n                        <option>Cassette AC Service</option>\n                        <option>Cassette AC Repair</option>\n                        <option>Cassette AC Installation</option>\n                        <option>Other</option>\n                    </select>\n                </div>\n                 <button type=\"submit\" class=\"w-full bg-brand-gold text-white font-bold py-3 px-4 rounded-lg shadow-lg cta-button text-lg mb-3\">Submit Request</button>\n                 <a href=\"https://wa.me/919727257141?text=Hi, I need a cassette AC service in Vadodara.\" target=\"_blank\" class=\"w-full block text-center bg-green-500 text-white font-bold py-3 px-4 rounded-lg shadow-lg cta-button text-lg\" rel=\"noopener\">\n                    <i class=\"fab fa-whatsapp mr-2\"></i>Chat on WhatsApp\n                 </a>\n            </form>\n        </div>\n    </div>\n    \n    <script>\n        // Smart Popup Logic\n        document.addEventListener('DOMContentLoaded', () => {\n            const popup = document.getElementById('exit-popup');\n            const popupContent = document.getElementById('popup-content');\n            const closeBtn = document.getElementById('close-popup');\n            let inactivityTimer;\n\n            const showPopup = () => {\n                popup.classList.remove('popup-hidden');\n                popup.classList.add('popup-visible');\n                setTimeout(() => popupContent.style.transform = 'scale(1)', 50);\n                // Prevent showing again in the same session\n                sessionStorage.setItem('popupShown', 'true');\n            };\n\n            const hidePopup = () => {\n                popupContent.style.transform = 'scale(0.95)';\n                popup.classList.remove('popup-visible');\n                popup.classList.add('popup-hidden');\n            };\n            \n            const resetTimer = () => {\n                clearTimeout(inactivityTimer);\n                inactivityTimer = setTimeout(showPopupIfNotShown, 120000); // 120 seconds\n            };\n\n            const showPopupIfNotShown = () => {\n                if (!sessionStorage.getItem('popupShown')) {\n                    showPopup();\n                }\n            };\n            \n            // Show on exit intent\n            document.addEventListener('mouseleave', (e) => {\n                if (e.clientY < 10) { // Cursor leaves near the top of the viewport\n                    showPopupIfNotShown();\n                }\n            });\n\n            // Show after 120s of inactivity\n            window.onload = resetTimer;\n            document.onmousemove = resetTimer;\n            document.onkeypress = resetTimer;\n            document.onclick = resetTimer;\n            document.onscroll = resetTimer;\n\n            // Close button\n            closeBtn.addEventListener('click', hidePopup);\n            // Close on outside click\n            popup.addEventListener('click', (e) => {\n                if (e.target === popup) {\n                    hidePopup();\n                }\n            });\n        });\n    </script>\n\n</div>",
