    if (!sessionStorage.getItem('popupShown')) {\n                    showPopup();\n                }\n            };\n            \n            // Show on exit intent\n            document.addEventListener('mouseleave', (e) => {\n                if (e.clientY < 10) { // Cursor leaves near the top of the viewport\n                    showPopupIfNotShown();\n                }\n            });\n\n            // Show after 120s of inactivity\n            window.onload = resetTimer;\n            document.onmousemove = resetTimer;\n            document.onkeypress = resetTimer;\n            document.onclick = resetTimer;\n            document.onscroll = resetTimer;\n\n            // Close button\n            closeBtn.addEventListener('click', hidePopup);\n            // Close on outside click\n            popup.addEventListener('click', (e) => {\n                if (e.target === popup) {\n                    hidePopup();\n                }\n            });\n        });\n    </script>\n\n\n    <!-- Hero Banner -->\n    <section class=\"hero-banner text-white\">\n        <div class=\"container mx-auto px-6 py-24 md:py-32 text-center\">\n            <h1 class=\"text-4xl md:text-6xl font-extrabold leading-tight mb-4\">Premier <strong>Cassette AC Service Vadodara</strong></h1>\n            <p class=\"text-lg md:text-xl mb-8 max-w-3xl mx-auto\">Fast, Reliable &#038; Affordable Solutions for All Brands. From installation to emergency repairs, we are your trusted local experts for <strong>cassette ac service in Vadodara</strong>.</p>\n            <a href=\"#price-list\" class=\"bg-brand-gold text-white font-bold py-3 px-8 rounded-full shadow-lg cta-button text-lg\">View Prices &#038; Book Service</a>\n        </div>\n    </section>\n\n    <main class=\"container mx-auto px-6 py-12\">\n        <!-- Introduction & Key Offerings -->\n        <section class=\"text-center mb-16\">\n             <h2 class=\"text-3xl font-bold mb-4 section-title\">Your #1 Choice for <strong>Cassette AC 