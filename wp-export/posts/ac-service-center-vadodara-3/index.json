Button = document.getElementById('close-popup');\r\n            const minimizedIcon = document.getElementById('minimized-icon');\r\n\r\n            const showPopup = () => {\r\n                if (sessionStorage.getItem('popupShown') !== 'true') {\r\n                    popupOverlay.classList.add('active');\r\n                    sessionStorage.setItem('popupShown', 'true');\r\n                }\r\n            };\r\n\r\n            const closePopup = () => {\r\n                popupOverlay.classList.remove('active');\r\n                minimizedIcon.classList.remove('hidden');\r\n            };\r\n\r\n            const openPopupFromIcon = () => {\r\n                minimizedIcon.classList.add('hidden');\r\n                popupOverlay.classList.add('active');\r\n            };\r\n\r\n            // Show popup after 60 seconds\r\n            setTimeout(showPopup, 60000);\r\n\r\n            // Event listeners\r\n            closePopupButton.addEventListener('click', closePopup);\r\n            minimizedIcon.addEventListener('click', openPopupFromIcon);\r\n            \r\n            // Close popup if overlay is clicked\r\n            popupOverlay.addEventListener('click', function(e) {\r\n                if (e.target === popupOverlay) {\r\n                    closePopup();\r\n                }\r\n            });\r\n\r\n        });\r\n    </script></p>\r\n",
