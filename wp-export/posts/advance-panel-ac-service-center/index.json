tem('popupShown', 'true');\r\n                }, 60000); // 60 seconds\r\n            }\r\n\r\n            closeBtn.addEventListener('click', hidePopup);\r\n            minimizedBtn.addEventListener('click', showPopup);\r\n            \r\n            // Close popup if overlay is clicked\r\n            popupOverlay.addEventListener('click', (e) => {\r\n                if (e.target === popupOverlay) {\r\n                    hidePopup();\r\n                }\r\n            });\r\n        });\r\n    </script></p>\r\n\r\n",
